{
  "name": "Veiculo",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "codigo": {
      "type": "string",
      "description": "Código único do veículo"
    },
    "placa": {
      "type": "string"
    },
    "tipo_veiculo": {
      "type": "string",
      "enum": [
        "Caminhão",
        "Caminhonete",
        "Van",
        "Carro",
        "Moto",
        "Carreta",
        "Outro"
      ],
      "default": "Caminhão"
    },
    "modelo": {
      "type": "string"
    },
    "marca": {
      "type": "string"
    },
    "ano_fabricacao": {
      "type": "number"
    },
    "cor": {
      "type": "string"
    },
    "capacidade_peso_kg": {
      "type": "number"
    },
    "capacidade_volume_m3": {
      "type": "number"
    },
    "proprietario": {
      "type": "string",
      "enum": [
        "Próprio",
        "Agregado",
        "Terceirizado",
        "Alugado"
      ],
      "default": "Próprio"
    },
    "motorista_padrao_id": {
      "type": "string"
    },
    "km_atual": {
      "type": "number",
      "default": 0
    },
    "km_proxima_revisao": {
      "type": "number"
    },
    "data_ultima_revisao": {
      "type": "string",
      "format": "date"
    },
    "data_proxima_revisao": {
      "type": "string",
      "format": "date"
    },
    "checklist_manutencao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "periodicidade_km": {
            "type": "number"
          },
          "ultimo_km": {
            "type": "number"
          },
          "proximo_km": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "Atenção",
              "Vencido"
            ]
          }
        }
      }
    },
    "alerta_manutencao_ativo": {
      "type": "boolean",
      "default": false
    },
    "bloqueado_uso": {
      "type": "boolean",
      "default": false
    },
    "seguro_vencimento": {
      "type": "string",
      "format": "date"
    },
    "licenciamento_vencimento": {
      "type": "string",
      "format": "date"
    },
    "ipva_vencimento": {
      "type": "string",
      "format": "date"
    },
    "rastreador_instalado": {
      "type": "boolean",
      "default": false
    },
    "rastreador_codigo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Manutenção",
        "Inativo",
        "Vendido"
      ],
      "default": "Ativo"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "placa",
    "tipo_veiculo",
    "empresa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}