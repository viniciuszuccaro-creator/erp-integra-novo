{
  "name": "Departamento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código único do departamento"
    },
    "nome_departamento": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_departamento": {
      "type": "string",
      "enum": [
        "Administrativo",
        "Comercial",
        "Financeiro",
        "RH",
        "Operacional",
        "TI",
        "Logística",
        "Compras",
        "Produção",
        "Outro"
      ],
      "default": "Operacional"
    },
    "departamento_pai_id": {
      "type": "string"
    },
    "responsavel_id": {
      "type": "string"
    },
    "centro_custo_vinculado_id": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_departamento"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}