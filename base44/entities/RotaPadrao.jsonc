{
  "name": "RotaPadrao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "nome_rota": {
      "type": "string",
      "description": "Nome da rota padr\u00e3o"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_rota": {
      "type": "string",
      "enum": [
        "Urbana",
        "Interurbana",
        "Regional",
        "Estadual",
        "Nacional"
      ],
      "default": "Urbana"
    },
    "regioes_atendidas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regi\u00f5es, bairros ou cidades atendidas"
    },
    "dias_semana_operacao": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Segunda",
          "Ter\u00e7a",
          "Quarta",
          "Quinta",
          "Sexta",
          "S\u00e1bado",
          "Domingo"
        ]
      },
      "description": "Dias da semana em que esta rota opera"
    },
    "horario_saida_padrao": {
      "type": "string",
      "description": "Hor\u00e1rio de sa\u00edda padr\u00e3o (HH:MM)"
    },
    "tempo_medio_rota_horas": {
      "type": "number",
      "description": "Tempo m\u00e9dio da rota em horas"
    },
    "distancia_media_km": {
      "type": "number",
      "description": "Dist\u00e2ncia m\u00e9dia da rota em km"
    },
    "veiculo_recomendado_tipo": {
      "type": "string",
      "description": "Tipo de ve\u00edculo recomendado"
    },
    "motorista_padrao_id": {
      "type": "string",
      "description": "ID do motorista padr\u00e3o"
    },
    "transportadora_padrao_id": {
      "type": "string",
      "description": "ID da transportadora padr\u00e3o"
    },
    "custo_medio_rota": {
      "type": "number",
      "description": "Custo m\u00e9dio da rota"
    },
    "pontos_referencia": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "ordem": {
            "type": "number"
          }
        }
      },
      "description": "Pontos de refer\u00eancia na rota"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_rota",
    "empresa_id"
  ]
}