{
  "name": "Motorista",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "colaborador_vinculado_id": {
      "type": "string"
    },
    "codigo": {
      "type": "string",
      "description": "Código único do motorista"
    },
    "nome_completo": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "rg": {
      "type": "string"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date"
    },
    "telefone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "cnh_numero": {
      "type": "string"
    },
    "cnh_categoria": {
      "type": "string"
    },
    "cnh_validade": {
      "type": "string",
      "format": "date"
    },
    "cnh_primeira_habilitacao": {
      "type": "string",
      "format": "date"
    },
    "tipo_vinculo": {
      "type": "string",
      "enum": [
        "CLT",
        "Agregado",
        "Terceirizado",
        "Autônomo"
      ],
      "default": "CLT"
    },
    "data_admissao": {
      "type": "string",
      "format": "date"
    },
    "endereco": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        }
      }
    },
    "usuario_app_entrega_id": {
      "type": "string"
    },
    "veiculos_habilitados": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rotas_habilitadas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pode_dirigir_pesado": {
      "type": "boolean",
      "default": false
    },
    "certificacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "orgao_emissor": {
            "type": "string"
          },
          "validade": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "avaliacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "nota": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "comentario": {
            "type": "string"
          },
          "avaliador": {
            "type": "string"
          }
        }
      }
    },
    "nota_media": {
      "type": "number",
      "default": 5
    },
    "total_entregas": {
      "type": "number",
      "default": 0
    },
    "total_km_rodados": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Férias",
        "Afastado",
        "Inativo"
      ],
      "default": "Ativo"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_completo",
    "cnh_numero",
    "cnh_categoria",
    "cnh_validade"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}