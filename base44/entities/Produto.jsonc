{
  "name": "Produto",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa proprietária do estoque"
    },
    "empresa_dona_id": {
      "type": "string",
      "description": "Empresa que cadastrou o produto (multiempresa)"
    },
    "empresas_compartilhadas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Empresas que podem usar este produto"
    },
    "almoxarifado_id": {
      "type": "string",
      "description": "ID do almoxarifado (se controlar por localização)"
    },
    "compartilhado_grupo": {
      "type": "boolean",
      "default": false,
      "description": "Se o produto é visível para todas empresas do grupo"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do produto"
    },
    "codigo_barras": {
      "type": "string",
      "description": "Código de barras"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição do produto — único por grupo"
    },
    "descricao_seo": {
      "type": "string",
      "description": "V21.0: Descrição SEO para e-commerce gerada por IA"
    },
    "foto_produto_url": {
      "type": "string",
      "description": "URL da foto do produto"
    },
    "tipo_item": {
      "type": "string",
      "enum": [
        "Revenda",
        "Matéria-Prima Produção",
        "Produto Acabado",
        "Consumo Interno",
        "Serviço"
      ],
      "default": "Revenda",
      "description": "Tipo de item para controle"
    },
    "setor_atividade_id": {
      "type": "string",
      "description": "V21.0: ID do Setor de Atividade (Revenda, Almoxarifado, Fábrica, etc) - OBRIGATÓRIO"
    },
    "setor_atividade_nome": {
      "type": "string",
      "description": "V21.0: Nome do setor (snapshot)"
    },
    "grupo": {
      "type": "string",
      "enum": [
        "Matéria Prima",
        "Produto Acabado",
        "Insumo",
        "Material de Escritório",
        "Ferramentas",
        "EPIs",
        "Bitola",
        "Outros"
      ]
    },
    "grupo_produto_id": {
      "type": "string",
      "description": "V21.0: ID do Grupo/Linha/Classe de Produto - OBRIGATÓRIO"
    },
    "grupo_produto_nome": {
      "type": "string",
      "description": "V21.0: Nome do grupo (snapshot)"
    },
    "marca_id": {
      "type": "string",
      "description": "V21.0: ID da Marca - OBRIGATÓRIO"
    },
    "marca_nome": {
      "type": "string",
      "description": "V21.0: Nome da marca (snapshot)"
    },
    "subgrupo": {
      "type": "string"
    },
    "eh_bitola": {
      "type": "boolean",
      "default": false,
      "description": "Flag para identificar se o produto é uma bitola de aço/ferro"
    },
    "peso_teorico_kg_m": {
      "type": "number",
      "description": "Peso teórico em KG por metro linear (apenas para bitolas)"
    },
    "bitola_diametro_mm": {
      "type": "number",
      "description": "Diâmetro da bitola em mm (6.3, 8.0, 10.0, 12.5, 16.0, 20.0, 25.0, 32.0)"
    },
    "tipo_aco": {
      "type": "string",
      "enum": [
        "CA-25",
        "CA-50",
        "CA-60"
      ],
      "description": "Tipo de aço (apenas para bitolas)"
    },
    "peso_liquido_kg": {
      "type": "number",
      "default": 0,
      "description": "V21.0: Peso líquido em kg (sem embalagem) - para frete e e-commerce"
    },
    "peso_bruto_kg": {
      "type": "number",
      "default": 0,
      "description": "V21.0: Peso bruto em kg (com embalagem) - para frete e e-commerce"
    },
    "altura_cm": {
      "type": "number",
      "default": 0,
      "description": "V21.0: Altura em centímetros - para cubagem de frete"
    },
    "largura_cm": {
      "type": "number",
      "default": 0,
      "description": "V21.0: Largura em centímetros - para cubagem de frete"
    },
    "comprimento_cm": {
      "type": "number",
      "default": 0,
      "description": "V21.0: Comprimento em centímetros - para cubagem de frete"
    },
    "volume_m3": {
      "type": "number",
      "description": "V21.0: Volume em m³ (calculado: altura × largura × comprimento ÷ 1.000.000)"
    },
    "unidade_principal": {
      "type": "string",
      "enum": [
        "UN",
        "PÇ",
        "KG",
        "MT",
        "TON",
        "LT",
        "CX",
        "M2",
        "M3"
      ],
      "default": "UN",
      "description": "V21.0: Unidade principal do produto (usada em relatórios)"
    },
    "unidades_secundarias": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "UN",
          "PÇ",
          "KG",
          "MT",
          "TON",
          "BARRA",
          "LT",
          "CX",
          "M2",
          "M3"
        ]
      },
      "description": "V21.0: Unidades habilitadas para venda/compra (ex: [PÇ, KG, MT]) - MULTI-SELECT"
    },
    "fatores_conversao": {
      "type": "object",
      "properties": {
        "kg_por_peca": {
          "type": "number",
          "description": "Quantos KG tem 1 peça"
        },
        "kg_por_metro": {
          "type": "number",
          "description": "Quantos KG tem 1 metro (igual peso_teorico_kg_m)"
        },
        "metros_por_peca": {
          "type": "number",
          "description": "Quantos metros tem 1 peça"
        },
        "peca_por_ton": {
          "type": "number",
          "description": "Quantas peças tem 1 tonelada"
        },
        "kg_por_ton": {
          "type": "number",
          "default": 1000,
          "description": "1 TON = 1000 KG (fixo)"
        }
      },
      "description": "V21.0: Fatores de conversão bidirecionais calculados automaticamente"
    },
    "unidade_medida": {
      "type": "string",
      "enum": [
        "UN",
        "KG",
        "LT",
        "MT",
        "CX",
        "PC",
        "M2",
        "M3"
      ]
    },
    "unidade_compra": {
      "type": "string",
      "enum": [
        "TON",
        "KG",
        "MT",
        "BARRA",
        "FARDO",
        "UN"
      ],
      "description": "Unidade usada na compra"
    },
    "unidade_estoque": {
      "type": "string",
      "enum": [
        "KG",
        "MT",
        "UN",
        "PC"
      ],
      "default": "KG",
      "description": "V21.0: SEMPRE KG para bitolas (rastreamento financeiro)"
    },
    "unidade_venda": {
      "type": "string",
      "enum": [
        "KG",
        "MT",
        "PEÇA",
        "UN"
      ],
      "default": "KG",
      "description": "Unidade usada na venda"
    },
    "fator_conversao_compra_estoque": {
      "type": "number",
      "default": 1,
      "description": "1 unidade compra = X unidades estoque (ex: 1 TON = 1000 KG)"
    },
    "fator_conversao_estoque_venda": {
      "type": "number",
      "default": 1,
      "description": "1 unidade estoque = X unidades venda"
    },
    "unidade_alternativa": {
      "type": "string",
      "enum": [
        "UN",
        "KG",
        "LT",
        "MT",
        "BARRA",
        "CX",
        "PC",
        "M2",
        "M3"
      ],
      "description": "Unidade alternativa para conversão"
    },
    "fator_conversao": {
      "type": "number",
      "description": "Fator de conversão entre unidades (ex: 1 BARRA = 12 MT)"
    },
    "comprimento_barra_padrao_m": {
      "type": "number",
      "description": "Comprimento padrão da barra em metros (ex: 12m)"
    },
    "custo_aquisicao": {
      "type": "number"
    },
    "custo_medio": {
      "type": "number",
      "description": "Custo médio calculado automaticamente"
    },
    "preco_venda": {
      "type": "number"
    },
    "margem_minima_percentual": {
      "type": "number",
      "default": 10,
      "description": "Margem mínima de lucro permitida (%)"
    },
    "tags_busca_ia": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags geradas por IA para busca semântica"
    },
    "fornecedor_principal": {
      "type": "string"
    },
    "fornecedor_id": {
      "type": "string"
    },
    "estoque_atual": {
      "type": "number",
      "default": 0,
      "description": "V21.0: SEMPRE em KG (unidade_estoque) - saldo no depósito"
    },
    "estoque_reservado": {
      "type": "number",
      "default": 0,
      "description": "Quantidade reservada em pedidos/OPs"
    },
    "estoque_disponivel": {
      "type": "number",
      "description": "Estoque atual - reservado (calculado)"
    },
    "estoque_minimo": {
      "type": "number",
      "default": 0
    },
    "estoque_maximo": {
      "type": "number",
      "default": 0
    },
    "ponto_reposicao": {
      "type": "number",
      "description": "Ponto de reposição automática"
    },
    "localizacao": {
      "type": "string",
      "description": "Localização no almoxarifado"
    },
    "localizacao_fisica": {
      "type": "object",
      "properties": {
        "corredor": {
          "type": "string"
        },
        "rua": {
          "type": "string"
        },
        "prateleira": {
          "type": "string"
        },
        "posicao": {
          "type": "string"
        },
        "andar": {
          "type": "string"
        }
      },
      "description": "Localização detalhada para picking"
    },
    "controla_lote": {
      "type": "boolean",
      "default": false,
      "description": "Se o produto tem controle de lote"
    },
    "controla_validade": {
      "type": "boolean",
      "default": false,
      "description": "Se o produto tem controle de validade"
    },
    "prazo_validade_dias": {
      "type": "number",
      "description": "Prazo de validade padrão em dias"
    },
    "lotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero_lote": {
            "type": "string"
          },
          "data_fabricacao": {
            "type": "string",
            "format": "date"
          },
          "data_validade": {
            "type": "string",
            "format": "date"
          },
          "quantidade": {
            "type": "number"
          },
          "quantidade_disponivel": {
            "type": "number"
          },
          "quantidade_reservada": {
            "type": "number",
            "default": 0
          },
          "fornecedor": {
            "type": "string"
          },
          "nota_fiscal": {
            "type": "string"
          },
          "localizacao": {
            "type": "string"
          },
          "observacoes": {
            "type": "string"
          }
        }
      },
      "description": "Lista de lotes do produto"
    },
    "produtos_complementares": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de produtos que são frequentemente comprados juntos"
    },
    "produtos_substitutos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de produtos alternativos equivalentes"
    },
    "quantidade_vendida_30dias": {
      "type": "number",
      "default": 0,
      "description": "Total vendido nos últimos 30 dias"
    },
    "quantidade_vendida_12meses": {
      "type": "number",
      "default": 0,
      "description": "Total vendido nos últimos 12 meses"
    },
    "giro_estoque_dias": {
      "type": "number",
      "description": "Média de dias de giro do estoque"
    },
    "classificacao_abc": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "Sem Movimento"
      ],
      "description": "Classificação ABC automática"
    },
    "dias_sem_movimento": {
      "type": "number",
      "default": 0,
      "description": "Dias desde última movimentação"
    },
    "ncm": {
      "type": "string",
      "description": "Nomenclatura Comum do Mercosul"
    },
    "cest": {
      "type": "string",
      "description": "Código Especificador da Substituição Tributária"
    },
    "cfop_padrao_compra": {
      "type": "string",
      "description": "V21.0: CFOP padrão para compras (ex: 1102, 2102)"
    },
    "cfop_padrao_venda": {
      "type": "string",
      "description": "V21.0: CFOP padrão para vendas (ex: 5102, 6102)"
    },
    "origem_mercadoria": {
      "type": "string",
      "enum": [
        "0 - Nacional",
        "1 - Estrangeira Importação Direta",
        "2 - Estrangeira Mercado Interno",
        "3 - Nacional com Conteúdo Importado >40%",
        "4 - Nacional por Proc. Prod. Básico",
        "5 - Nacional com Conteúdo Importado <=40%",
        "6 - Estrangeira Importação Direta sem Similar",
        "7 - Estrangeira Mercado Interno sem Similar",
        "8 - Nacional por Importação Direta"
      ],
      "default": "0 - Nacional",
      "description": "Origem da mercadoria (NF-e)"
    },
    "regime_tributario_produto": {
      "type": "string",
      "enum": [
        "Simples Nacional",
        "Lucro Presumido",
        "Lucro Real"
      ],
      "description": "V21.0: Regime tributário aplicável ao produto"
    },
    "tributacao": {
      "type": "object",
      "properties": {
        "icms_cst": {
          "type": "string",
          "description": "CST do ICMS"
        },
        "icms_aliquota": {
          "type": "number"
        },
        "pis_cst": {
          "type": "string"
        },
        "pis_aliquota": {
          "type": "number"
        },
        "cofins_cst": {
          "type": "string"
        },
        "cofins_aliquota": {
          "type": "number"
        },
        "ipi_cst": {
          "type": "string"
        },
        "ipi_aliquota": {
          "type": "number"
        }
      },
      "description": "V21.0: Configuração tributária do produto"
    },
    "conta_contabil_id": {
      "type": "string",
      "description": "ID da conta contábil vinculada"
    },
    "exibir_no_site": {
      "type": "boolean",
      "default": false,
      "description": "Se exibe no site/e-commerce"
    },
    "exibir_no_marketplace": {
      "type": "boolean",
      "default": false,
      "description": "Se sincroniza com marketplaces"
    },
    "slug_site": {
      "type": "string",
      "description": "URL amigável para SEO"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo",
        "Descontinuado"
      ],
      "default": "Ativo"
    },
    "alerta_estoque_baixo": {
      "type": "boolean",
      "default": true,
      "description": "Enviar alerta quando abaixo do mínimo"
    },
    "ultima_compra": {
      "type": "string",
      "format": "date",
      "description": "Data da última compra"
    },
    "ultimo_preco_compra": {
      "type": "number",
      "description": "Último preço de compra"
    },
    "modo_cadastro": {
      "type": "string",
      "enum": [
        "Manual",
        "Assistido IA",
        "Automático NF-e",
        "Lote/Importação"
      ],
      "default": "Manual",
      "description": "V21.0: Como o produto foi cadastrado"
    },
    "cadastrado_via_nfe_id": {
      "type": "string",
      "description": "V21.0: ID da NF-e que originou o cadastro (se via XML)"
    },
    "confianca_ia_percentual": {
      "type": "number",
      "default": 0,
      "description": "V21.0: Confiança da IA na classificação (0-100)"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "descricao",
    "unidade_medida",
    "empresa_id"
  ]
}
