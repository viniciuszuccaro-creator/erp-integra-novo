{
  "name": "OrcamentoCliente",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que gerou o or\u00e7amento"
    },
    "numero_orcamento": {
      "type": "string",
      "description": "N\u00famero do or\u00e7amento"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "cliente_email": {
      "type": "string"
    },
    "vendedor_responsavel": {
      "type": "string"
    },
    "vendedor_responsavel_id": {
      "type": "string"
    },
    "data_criacao": {
      "type": "string",
      "format": "date"
    },
    "data_validade": {
      "type": "string",
      "format": "date"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "valor_unitario": {
            "type": "number"
          },
          "desconto_percentual": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Desconto individual persistido, entre 0 e 100%. Ausente em registros legados: inferir pelo total."
          },
          "tipo": {
            "type": "string",
            "enum": [
              "revenda",
              "fabricacao",
              "servico"
            ],
            "enumColors": [
              "blue",
              "purple",
              "yellow"
            ]
          },
          "valor_total": {
            "type": "number"
          }
        }
      }
    },
    "valor_total": {
      "type": "number"
    },
    "condicoes_pagamento": {
      "type": "string",
      "default": "\u00c0 Vista"
    },
    "prazo_entrega": {
      "type": "string",
      "default": "7 dias \u00fateis"
    },
    "observacoes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aprovado",
        "Rejeitado",
        "Convertido",
        "Expirado"
      ],
      "default": "Pendente"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Nome do aprovador"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da aprova\u00e7\u00e3o"
    },
    "assinatura_url": {
      "type": "string",
      "description": "URL da assinatura eletr\u00f4nica"
    },
    "assinatura_ip": {
      "type": "string",
      "description": "IP de onde foi assinado"
    },
    "assinatura_hash": {
      "type": "string",
      "description": "Hash MD5 da assinatura"
    },
    "motivo_rejeicao": {
      "type": "string"
    },
    "pedido_gerado_id": {
      "type": "string",
      "description": "ID do pedido gerado ap\u00f3s aprova\u00e7\u00e3o"
    },
    "conversao_pedido": {
      "type": "object",
      "description": "Controle dur\u00e1vel da convers\u00e3o, alterado somente pelo servidor ap\u00f3s autoriza\u00e7\u00e3o. N\u00e3o \u00e9 uma transa\u00e7\u00e3o entre entidades.",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "properties": {
        "operacao_id": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "versao_origem": {
          "type": "string"
        },
        "usuario_id": {
          "type": "string"
        },
        "fase": {
          "type": "string",
          "enum": [
            "preparando",
            "preparada",
            "criando",
            "revisao",
            "concluida"
          ],
          "enumColors": [
            "yellow",
            "yellow",
            "blue",
            "red",
            "green"
          ]
        },
        "destino": {
          "type": "string",
          "enum": [
            "producao",
            "entrega",
            "retira"
          ],
          "enumColors": [
            "purple",
            "blue",
            "green"
          ]
        },
        "numero_pedido": {
          "type": "string"
        },
        "pedido_id": {
          "type": "string"
        },
        "iniciada_em": {
          "type": "string",
          "format": "date-time"
        },
        "payload_hash": {
          "type": "string"
        }
      }
    },
    "derivacao_orcamento": {
      "type": "object",
      "description": "Reserva dur\u00e1vel da duplica\u00e7\u00e3o/desmembramento; somente o servidor autorizado altera este controle.",
      "rls": {
        "create": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        },
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "properties": {
        "operacao_id": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "versao_origem": {
          "type": "string"
        },
        "usuario_id": {
          "type": "string"
        },
        "acao": {
          "type": "string",
          "enum": [
            "duplicar",
            "desmembrar"
          ],
          "enumColors": [
            "blue",
            "purple"
          ]
        },
        "fase": {
          "type": "string",
          "enum": [
            "preparando",
            "preparada",
            "criando",
            "revisao",
            "vinculada",
            "concluida"
          ],
          "enumColors": [
            "yellow",
            "yellow",
            "blue",
            "red",
            "blue",
            "green"
          ]
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "numero_orcamento": {
          "type": "string"
        },
        "destino_id": {
          "type": "string"
        },
        "iniciada_em": {
          "type": "string",
          "format": "date-time"
        },
        "assinatura_origem": {
          "type": "string"
        },
        "assinatura_destino": {
          "type": "string"
        }
      }
    },
    "origem_derivacao": {
      "type": "object",
      "description": "V\u00ednculo de origem de um or\u00e7amento derivado; n\u00e3o transporta aprova\u00e7\u00e3o ou assinatura da proposta original.",
      "rls": {
        "create": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        },
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "properties": {
        "orcamento_id": {
          "type": "string"
        },
        "operacao_id": {
          "type": "string"
        },
        "acao": {
          "type": "string",
          "enum": [
            "duplicar",
            "desmembrar"
          ],
          "enumColors": [
            "blue",
            "purple"
          ]
        },
        "confirmada": {
          "type": "boolean"
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    }
  },
  "required": [
    "numero_orcamento",
    "cliente_nome",
    "valor_total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}