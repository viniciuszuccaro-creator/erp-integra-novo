{
  "name": "Servico",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "empresa_dona_id": {
      "type": "string",
      "description": "Empresa que cadastrou o serviço"
    },
    "empresas_compartilhadas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Empresas que podem usar este serviço"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do serviço"
    },
    "codigo_servico": {
      "type": "string",
      "description": "Código interno do serviço (legado)"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição do serviço — única por grupo"
    },
    "descricao_detalhada": {
      "type": "string",
      "description": "Descrição detalhada do serviço"
    },
    "tipo_servico": {
      "type": "string",
      "enum": [
        "Corte",
        "Dobra",
        "Montagem",
        "Instalação",
        "Manutenção",
        "Consultoria",
        "Projeto",
        "Outro"
      ],
      "default": "Outro"
    },
    "unidade_cobranca": {
      "type": "string",
      "enum": [
        "Hora",
        "Peça",
        "KG",
        "MT",
        "M2",
        "Job",
        "Unitário"
      ],
      "default": "Unitário"
    },
    "valor_unitario": {
      "type": "number",
      "default": 0,
      "description": "Valor unitário do serviço"
    },
    "tempo_medio_execucao": {
      "type": "number",
      "description": "Tempo médio de execução em horas"
    },
    "codigo_servico_municipal": {
      "type": "string",
      "description": "Código do serviço municipal (para ISS)"
    },
    "aliquota_iss": {
      "type": "number",
      "default": 0,
      "description": "Alíquota de ISS (%)"
    },
    "retencao_iss": {
      "type": "boolean",
      "default": false,
      "description": "Se há retenção de ISS"
    },
    "ncm_material_aplicado": {
      "type": "string",
      "description": "NCM do material aplicado (se houver)"
    },
    "exige_projeto": {
      "type": "boolean",
      "default": false,
      "description": "Se exige projeto técnico"
    },
    "colaborador_responsavel_padrao_id": {
      "type": "string",
      "description": "ID do colaborador responsável padrão"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "descricao"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}