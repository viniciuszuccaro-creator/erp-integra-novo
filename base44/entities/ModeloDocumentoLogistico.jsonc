{
  "name": "ModeloDocumentoLogistico",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "nome_modelo": {
      "type": "string",
      "description": "Nome do modelo"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "Romaneio",
        "Etiqueta Volume",
        "Checklist Carga",
        "Canhoto",
        "Ordem Separa\u00e7\u00e3o",
        "Outro"
      ],
      "description": "Tipo de documento"
    },
    "descricao": {
      "type": "string"
    },
    "layout_template": {
      "type": "string",
      "description": "Template HTML/JSON do layout"
    },
    "campos_obrigatorios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Campos obrigat\u00f3rios no documento"
    },
    "campos_opcionais": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Campos opcionais"
    },
    "incluir_logo_empresa": {
      "type": "boolean",
      "default": true
    },
    "incluir_qrcode": {
      "type": "boolean",
      "default": true,
      "description": "Se inclui QR Code para rastreamento"
    },
    "incluir_assinatura_digital": {
      "type": "boolean",
      "default": false
    },
    "formato_saida": {
      "type": "string",
      "enum": [
        "PDF",
        "HTML",
        "Imagem",
        "T\u00e9rmico"
      ],
      "default": "PDF"
    },
    "tamanho_papel": {
      "type": "string",
      "enum": [
        "A4",
        "A5",
        "T\u00e9rmico 80mm",
        "T\u00e9rmico 58mm",
        "Personalizado"
      ],
      "default": "A4"
    },
    "orientacao": {
      "type": "string",
      "enum": [
        "Retrato",
        "Paisagem"
      ],
      "default": "Retrato"
    },
    "padrao_empresa": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 o modelo padr\u00e3o da empresa"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_modelo",
    "tipo_documento"
  ]
}