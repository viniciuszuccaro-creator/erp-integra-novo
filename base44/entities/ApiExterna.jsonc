{
  "name": "ApiExterna",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tenant_id": {
      "type": "string",
      "description": "Vol 20.1: ID do tenant SaaS"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "nome_integracao": {
      "type": "string",
      "description": "Nome da integração"
    },
    "tipo_api": {
      "type": "string",
      "enum": [
        "REST",
        "GraphQL",
        "SOAP",
        "Webhook"
      ],
      "default": "REST"
    },
    "descricao": {
      "type": "string"
    },
    "url_base": {
      "type": "string",
      "description": "URL base da API"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API (armazenada como segredo server-side)"
    },
    "api_secret": {
      "type": "string",
      "description": "Secret da API (armazenada como segredo server-side)"
    },
    "headers_autenticacao": {
      "type": "object",
      "description": "Headers de autenticação"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produção",
        "Homologação",
        "Sandbox"
      ],
      "default": "Homologação",
      "description": "Vol 18.1: Ambiente da integração"
    },
    "escopo": {
      "type": "string",
      "description": "Vol 18.1: Escopo/propósito da integração (ex: emissão NF-e, consulta CEP, pagamento)"
    },
    "modulo_vinculado": {
      "type": "string",
      "enum": [
        "Comercial",
        "Financeiro",
        "Fiscal",
        "Estoque",
        "Compras",
        "Expedição",
        "Produção",
        "RH",
        "CRM",
        "Sistema"
      ],
      "description": "Vol 18.1: Módulo que consome esta API"
    },
    "responsavel_id": {
      "type": "string",
      "description": "Vol 18.1: ID do usuário responsável pela integração"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Vol 18.1: Nome do responsável"
    },
    "limite_requisicoes_por_minuto": {
      "type": "number",
      "default": 60,
      "description": "Vol 18.1: Limite de requisições por minuto (rate limit)"
    },
    "timeout_segundos": {
      "type": "number",
      "default": 30,
      "description": "Vol 18.1: Timeout da requisição"
    },
    "politica_retry": {
      "type": "object",
      "properties": {
        "max_tentativas": {
          "type": "number",
          "default": 3
        },
        "intervalo_segundos": {
          "type": "number",
          "default": 60
        },
        "backoff_exponencial": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Vol 18.1: Política de retry"
    },
    "circuit_breaker": {
      "type": "object",
      "properties": {
        "estado": {
          "type": "string",
          "enum": [
            "Fechado",
            "Aberto",
            "Half-Open"
          ],
          "default": "Fechado"
        },
        "falhas_consecutivas": {
          "type": "number",
          "default": 0
        },
        "limite_falhas": {
          "type": "number",
          "default": 5
        },
        "data_ultima_abertura": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Vol 18.3: Circuit breaker para proteção"
    },
    "fila_morta": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object"
          },
          "erro": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tentativas": {
            "type": "number"
          },
          "reprocessado": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Vol 18.3: Fila morta (dead letter queue) para requisições que falharam após todas as tentativas"
    },
    "ultima_requisicao": {
      "type": "string",
      "format": "date-time"
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Vol 18.3: Última sincronização bem-sucedida"
    },
    "total_requisicoes": {
      "type": "number",
      "default": 0
    },
    "total_erros": {
      "type": "number",
      "default": 0
    },
    "total_reprocessados": {
      "type": "number",
      "default": 0,
      "description": "Vol 18.3: Total de requisições reprocessadas da fila morta"
    },
    "latencia_media_ms": {
      "type": "number",
      "default": 0,
      "description": "Vol 18.3: Latência média das requisições"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_integracao",
    "tipo_api"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}