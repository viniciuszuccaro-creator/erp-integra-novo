{
  "name": "ConfiguracaoCobrancaEmpresa",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da configuração"
    },
    "empresa_nome": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se a configuração está ativa"
    },
    "provedor_cobranca": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Asaas",
        "Juno",
        "Pagar.me",
        "Mercado Pago",
        "Banco do Brasil",
        "Sicoob",
        "Outro"
      ],
      "default": "Nenhum",
      "description": "Provedor de cobrança"
    },
    "api_url": {
      "type": "string",
      "description": "URL base da API"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API"
    },
    "api_token": {
      "type": "string",
      "description": "Token de autenticação"
    },
    "client_id": {
      "type": "string",
      "description": "Client ID (OAuth)"
    },
    "client_secret": {
      "type": "string",
      "description": "Client Secret (OAuth)"
    },
    "conta_id": {
      "type": "string",
      "description": "ID da conta no provedor"
    },
    "habilitar_boleto": {
      "type": "boolean",
      "default": true
    },
    "habilitar_pix": {
      "type": "boolean",
      "default": true
    },
    "habilitar_cartao": {
      "type": "boolean",
      "default": false
    },
    "dias_vencimento_padrao": {
      "type": "number",
      "default": 3
    },
    "multa_pos_vencimento_percent": {
      "type": "number",
      "default": 2
    },
    "juros_ao_dia_percent": {
      "type": "number",
      "default": 0.033
    },
    "desconto_antecipacao_percent": {
      "type": "number",
      "default": 0
    },
    "mensagem_padrao_boleto": {
      "type": "string",
      "default": "Não receber após o vencimento. Sujeito a multa e juros."
    },
    "mensagem_padrao_pix": {
      "type": "string",
      "default": "PIX válido por 24h"
    },
    "webhook_url": {
      "type": "string"
    },
    "webhook_token": {
      "type": "string"
    },
    "enviar_email_automatico": {
      "type": "boolean",
      "default": true
    },
    "enviar_whatsapp_automatico": {
      "type": "boolean",
      "default": false
    },
    "modelo_email_boleto": {
      "type": "string"
    },
    "modelo_email_pix": {
      "type": "string"
    },
    "modelo_whatsapp_boleto": {
      "type": "string"
    },
    "modelo_whatsapp_pix": {
      "type": "string"
    },
    "pix_chave": {
      "type": "string"
    },
    "pix_tipo": {
      "type": "string",
      "enum": [
        "CPF",
        "CNPJ",
        "Email",
        "Telefone",
        "Aleatoria"
      ]
    },
    "modo_simulacao": {
      "type": "boolean",
      "default": true
    },
    "split_ativo": {
      "type": "boolean",
      "default": false
    },
    "split_config": {
      "type": "object",
      "additionalProperties": true
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time"
    },
    "status_conexao": {
      "type": "string",
      "enum": [
        "nao_configurado",
        "configurado",
        "ativo",
        "erro",
        "desativado"
      ],
      "default": "nao_configurado"
    },
    "mensagem_erro": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "provedor_cobranca"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}