{
  "name": "CatalogoWeb",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto no cat\u00e1logo"
    },
    "exibir_no_ecommerce": {
      "type": "boolean",
      "default": false,
      "description": "Se exibe no e-commerce pr\u00f3prio"
    },
    "exibir_no_marketplace": {
      "type": "boolean",
      "default": false,
      "description": "Se sincroniza com marketplaces"
    },
    "exibir_no_site": {
      "type": "boolean",
      "default": false,
      "description": "Se exibe no site institucional"
    },
    "exibir_no_catalogo_pdf": {
      "type": "boolean",
      "default": false,
      "description": "Se aparece no cat\u00e1logo PDF"
    },
    "exibir_no_app": {
      "type": "boolean",
      "default": false,
      "description": "Se aparece no app mobile"
    },
    "preco_exibido": {
      "type": "number",
      "description": "Pre\u00e7o a ser exibido"
    },
    "tabela_preco_vinculada_id": {
      "type": "string",
      "description": "ID da tabela de pre\u00e7o vinculada"
    },
    "categoria_navegacao": {
      "type": "string",
      "description": "Categoria para navega\u00e7\u00e3o no site/e-commerce"
    },
    "subcategoria_navegacao": {
      "type": "string"
    },
    "tags_seo": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para SEO"
    },
    "palavras_chave": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palavras-chave para busca"
    },
    "slug_url": {
      "type": "string",
      "description": "URL amig\u00e1vel"
    },
    "titulo_seo": {
      "type": "string",
      "description": "T\u00edtulo para SEO"
    },
    "meta_description": {
      "type": "string",
      "description": "Meta descri\u00e7\u00e3o para SEO"
    },
    "imagens_principais": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das imagens principais"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de v\u00eddeos do produto"
    },
    "manual_pdf_url": {
      "type": "string",
      "description": "URL do manual em PDF"
    },
    "certificado_url": {
      "type": "string",
      "description": "URL do certificado"
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 produto em destaque"
    },
    "ordem_exibicao": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de publica\u00e7\u00e3o"
    },
    "data_expiracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de expira\u00e7\u00e3o (opcional)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "produto_id"
  ]
}