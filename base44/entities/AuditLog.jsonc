{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "usuario": {
      "type": "string",
      "description": "Usuário que realizou a ação"
    },
    "usuario_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa onde a ação foi realizada"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "acao": {
      "type": "string",
      "enum": [
        "Login",
        "Logout",
        "Criação",
        "Edição",
        "Exclusão",
        "Visualização",
        "Aprovação",
        "Rejeição",
        "Exportação",
        "Importação",
        "Troca de Empresa",
        "Emissão NF-e",
        "Cancelamento NF-e",
        "Carta de Correção",
        "Inutilização",
        "Bloqueio"
      ],
      "description": "Tipo de ação realizada"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "Dashboard",
        "Comercial",
        "Financeiro",
        "Estoque",
        "Compras",
        "Expedição",
        "RH",
        "Cadastros",
        "Fiscal",
        "CRM",
        "Agenda",
        "Relatórios",
        "Contratos",
        "Produção",
        "Empresas",
        "Controle de Acesso",
        "Integrações",
        "Configurações",
        "Sistema"
      ],
      "description": "Módulo do sistema"
    },
    "tipo_auditoria": {
      "type": "string",
      "enum": [
        "ui",
        "entidade",
        "seguranca",
        "acesso",
        "gps",
        "ia",
        "integracao",
        "sistema",
        "global"
      ],
      "description": "Categoria da auditoria (ex.: ui, entidade, integracao, seguranca)"
    },
    "entidade": {
      "type": "string",
      "description": "Entidade afetada (Cliente, Pedido, etc)"
    },
    "registro_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição detalhada da ação"
    },
    "dados_anteriores": {
      "type": "object",
      "additionalProperties": true,
      "description": "Dados antes da alteração"
    },
    "dados_novos": {
      "type": "object",
      "additionalProperties": true,
      "description": "Dados após a alteração"
    },
    "ip_address": {
      "type": "string",
      "description": "IP do usuário"
    },
    "user_agent": {
      "type": "string",
      "description": "Navegador/dispositivo"
    },
    "geolocation": {
      "type": "string",
      "description": "Localização geográfica (cidade/estado)"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da ação"
    },
    "sucesso": {
      "type": "boolean",
      "default": true,
      "description": "Se a ação foi bem-sucedida"
    },
    "mensagem_erro": {
      "type": "string",
      "description": "Mensagem de erro (se houver)"
    },
    "duracao_ms": {
      "type": "number",
      "description": "Duração da operação em milissegundos"
    }
  },
  "required": [
    "usuario",
    "acao",
    "modulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}