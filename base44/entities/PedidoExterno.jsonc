{
  "name": "PedidoExterno",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Mercado Livre",
        "Shopee",
        "Amazon",
        "Site",
        "API Externa",
        "Outro"
      ],
      "description": "Origem do pedido externo"
    },
    "id_externo": {
      "type": "string",
      "description": "ID do pedido no marketplace/sistema externo"
    },
    "numero_pedido_externo": {
      "type": "string",
      "description": "N\u00famero do pedido no sistema externo"
    },
    "data_pedido_externo": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do pedido no sistema externo"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do comprador"
    },
    "cliente_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do comprador"
    },
    "cliente_email": {
      "type": "string",
      "description": "E-mail do comprador"
    },
    "cliente_telefone": {
      "type": "string",
      "description": "Telefone do comprador"
    },
    "endereco_entrega": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "referencia": {
          "type": "string"
        }
      },
      "description": "Endere\u00e7o de entrega do pedido externo"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id_item_externo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "sku_externo": {
            "type": "string"
          },
          "sku_interno": {
            "type": "string",
            "description": "SKU mapeado no sistema"
          },
          "produto_id": {
            "type": "string",
            "description": "ID do produto no sistema (se mapeado)"
          },
          "quantidade": {
            "type": "number"
          },
          "preco_unitario": {
            "type": "number"
          },
          "valor_total": {
            "type": "number"
          }
        }
      },
      "description": "Itens do pedido externo"
    },
    "valor_produtos": {
      "type": "number",
      "description": "Valor total dos produtos"
    },
    "valor_frete": {
      "type": "number",
      "description": "Valor do frete"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total do pedido"
    },
    "forma_pagamento_externa": {
      "type": "string",
      "description": "Forma de pagamento no marketplace"
    },
    "status_externo": {
      "type": "string",
      "description": "Status no sistema externo"
    },
    "status_importacao": {
      "type": "string",
      "enum": [
        "A Validar",
        "Em Revis\u00e3o",
        "Aprovado",
        "Importado",
        "Rejeitado",
        "Erro"
      ],
      "default": "A Validar",
      "description": "Status da importa\u00e7\u00e3o no ERP"
    },
    "validado": {
      "type": "boolean",
      "default": false,
      "description": "Se foi validado pelo usu\u00e1rio"
    },
    "validado_por": {
      "type": "string",
      "description": "Usu\u00e1rio que validou"
    },
    "data_validacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da valida\u00e7\u00e3o"
    },
    "pedido_erp_id": {
      "type": "string",
      "description": "ID do pedido criado no ERP (ap\u00f3s importa\u00e7\u00e3o)"
    },
    "cliente_erp_id": {
      "type": "string",
      "description": "ID do cliente criado/encontrado no ERP"
    },
    "mapeamento_automatico": {
      "type": "boolean",
      "default": false,
      "description": "Se o mapeamento de produtos foi autom\u00e1tico"
    },
    "produtos_nao_mapeados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "SKUs que n\u00e3o foram encontrados no sistema"
    },
    "validacao_estoque": {
      "type": "object",
      "properties": {
        "realizada": {
          "type": "boolean",
          "default": false
        },
        "todos_disponiveis": {
          "type": "boolean"
        },
        "itens_sem_estoque": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Valida\u00e7\u00e3o autom\u00e1tica de estoque (V16.1)"
    },
    "validacao_credito": {
      "type": "object",
      "properties": {
        "realizada": {
          "type": "boolean",
          "default": false
        },
        "aprovado": {
          "type": "boolean"
        },
        "motivo_bloqueio": {
          "type": "string"
        }
      },
      "description": "Valida\u00e7\u00e3o de cr\u00e9dito do cliente (V16.1)"
    },
    "json_completo": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON completo recebido da API externa"
    },
    "webhook_recebido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o webhook foi recebido (V16.1)"
    },
    "erros_importacao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          },
          "campo": {
            "type": "string"
          }
        }
      },
      "description": "Erros encontrados na importa\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a importa\u00e7\u00e3o"
    }
  },
  "required": [
    "origem",
    "id_externo",
    "cliente_nome",
    "valor_total"
  ]
}