{
  "name": "EventoNotificacao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo num\u00e9rico sequencial \u00fanico"
    },
    "nome_evento": {
      "type": "string",
      "description": "Nome do evento"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "Sistema",
        "Comercial",
        "Financeiro",
        "Estoque",
        "Log\u00edstica",
        "Produ\u00e7\u00e3o",
        "Fiscal",
        "RH",
        "CRM"
      ],
      "default": "Sistema"
    },
    "descricao": {
      "type": "string"
    },
    "template_mensagem": {
      "type": "string",
      "description": "Template da mensagem de notifica\u00e7\u00e3o"
    },
    "canais_notificacao": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "E-mail",
          "WhatsApp",
          "SMS",
          "Push",
          "Sistema"
        ]
      },
      "description": "Canais onde a notifica\u00e7\u00e3o ser\u00e1 enviada"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Normal",
        "Alta",
        "Urgente"
      ],
      "default": "Normal"
    },
    "destinatarios_padrao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de usu\u00e1rios que sempre receber\u00e3o"
    },
    "condicoes_disparo": {
      "type": "object",
      "description": "Condi\u00e7\u00f5es para disparar a notifica\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_evento",
    "tipo_evento"
  ]
}