{
  "name": "EventoNotificacao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "nome_evento": {
      "type": "string",
      "description": "Nome do evento"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "Sistema",
        "Comercial",
        "Financeiro",
        "Estoque",
        "Logística",
        "Produção",
        "Fiscal",
        "RH",
        "CRM"
      ],
      "default": "Sistema"
    },
    "descricao": {
      "type": "string"
    },
    "template_mensagem": {
      "type": "string",
      "description": "Template da mensagem de notificação"
    },
    "canais_notificacao": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "E-mail",
          "WhatsApp",
          "SMS",
          "Push",
          "Sistema"
        ]
      },
      "description": "Canais onde a notificação será enviada"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Normal",
        "Alta",
        "Urgente"
      ],
      "default": "Normal"
    },
    "destinatarios_padrao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de usuários que sempre receberão"
    },
    "condicoes_disparo": {
      "type": "object",
      "description": "Condições para disparar a notificação"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_evento",
    "tipo_evento"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}