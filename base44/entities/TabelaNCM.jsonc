{
  "name": "TabelaNCM",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro \u00fanico compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico do registro NCM"
    },
    "ncm": {
      "type": "string",
      "description": "C\u00f3digo NCM \u2014 \u00fanico por grupo (8 d\u00edgitos)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do NCM \u2014 \u00fanica por grupo"
    },
    "capitulo": {
      "type": "string",
      "description": "Cap\u00edtulo (2 primeiros d\u00edgitos)"
    },
    "posicao": {
      "type": "string",
      "description": "Posi\u00e7\u00e3o (4 primeiros d\u00edgitos)"
    },
    "unidade_tributavel": {
      "type": "string",
      "description": "Unidade tribut\u00e1vel"
    },
    "ipi_aliquota": {
      "type": "number",
      "description": "Al\u00edquota de IPI (%)",
      "default": 0
    },
    "icms_st_aliquota": {
      "type": "number",
      "description": "Al\u00edquota de ICMS-ST (%)"
    },
    "icms_st_mva": {
      "type": "number",
      "description": "MVA - Margem de Valor Agregado (%)"
    },
    "pis_aliquota": {
      "type": "number",
      "description": "Al\u00edquota de PIS (%)"
    },
    "cofins_aliquota": {
      "type": "number",
      "description": "Al\u00edquota de COFINS (%)"
    },
    "cest": {
      "type": "string",
      "description": "C\u00f3digo CEST (se aplic\u00e1vel)"
    },
    "ex_tipi": {
      "type": "string",
      "description": "C\u00f3digo EX TIPI (exce\u00e7\u00e3o)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Mat\u00e9ria Prima",
        "Produto Acabado",
        "Insumo",
        "Equipamento",
        "Ferramenta",
        "Outro"
      ],
      "description": "Categoria do produto"
    },
    "tipo_item": {
      "type": "string",
      "enum": [
        "00 - Mercadoria para Revenda",
        "01 - Mat\u00e9ria-Prima",
        "02 - Embalagem",
        "03 - Produto em Processo",
        "04 - Produto Acabado",
        "05 - Subproduto",
        "06 - Produto Intermedi\u00e1rio",
        "07 - Material de Uso e Consumo",
        "08 - Ativo Imobilizado",
        "09 - Servi\u00e7os",
        "10 - Outros"
      ],
      "description": "Tipo de item (SPED)"
    },
    "gtin_ean": {
      "type": "string",
      "description": "C\u00f3digo GTIN/EAN (se aplic\u00e1vel)"
    },
    "origem_mercadoria": {
      "type": "string",
      "enum": [
        "0 - Nacional",
        "1 - Estrangeira Importa\u00e7\u00e3o Direta",
        "2 - Estrangeira Mercado Interno"
      ],
      "default": "0 - Nacional",
      "description": "Origem da mercadoria"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o NCM est\u00e1 ativo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre tributa\u00e7\u00e3o"
    }
  },
  "required": [
    "ncm",
    "descricao"
  ]
}