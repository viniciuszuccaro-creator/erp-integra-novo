{
  "name": "Interacao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa responsável pela interação"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Ligação",
        "E-mail",
        "Reunião",
        "Visita",
        "WhatsApp",
        "Chat",
        "Outros"
      ],
      "description": "Tipo de interação"
    },
    "titulo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "data_interacao": {
      "type": "string",
      "format": "date-time"
    },
    "duracao": {
      "type": "number",
      "description": "Duração em minutos"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "oportunidade_id": {
      "type": "string"
    },
    "responsavel": {
      "type": "string"
    },
    "responsavel_id": {
      "type": "string"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "Positivo",
        "Neutro",
        "Negativo",
        "Sem Resposta"
      ]
    },
    "proxima_acao": {
      "type": "string"
    },
    "data_proxima_acao": {
      "type": "string",
      "format": "date"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "tipo",
    "titulo",
    "data_interacao",
    "cliente_nome",
    "responsavel"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}