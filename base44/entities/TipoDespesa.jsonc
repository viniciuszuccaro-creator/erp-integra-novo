{
  "name": "TipoDespesa",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo (se aplicável)"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa proprietária (se específico)"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa",
      "description": "Se o Tipo Despesa é do grupo ou da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do tipo de despesa"
    },
    "nome": {
      "type": "string",
      "description": "Nome do tipo de despesa"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Fixa",
        "Variável",
        "Operacional",
        "Administrativa",
        "Comercial",
        "Pessoal",
        "Marketing",
        "Fiscal",
        "Investimento",
        "Utilidades",
        "Outros"
      ]
    },
    "conta_contabil_padrao_id": {
      "type": "string",
      "description": "ID da conta contábil padrão para este tipo"
    },
    "conta_contabil_padrao_nome": {
      "type": "string",
      "description": "Nome da conta contábil padrão (snapshot)"
    },
    "centro_resultado_padrao_id": {
      "type": "string",
      "description": "ID do centro de resultado padrão para este tipo"
    },
    "centro_resultado_padrao_nome": {
      "type": "string",
      "description": "Nome do centro de resultado padrão (snapshot)"
    },
    "exige_aprovacao": {
      "type": "boolean",
      "default": false,
      "description": "Se despesas deste tipo exigem aprovação"
    },
    "limite_aprovacao_automatica": {
      "type": "number",
      "default": 0,
      "description": "Valor limite para aprovação automática (se exige_aprovacao true)"
    },
    "pode_ser_recorrente": {
      "type": "boolean",
      "default": false,
      "description": "Se este tipo de despesa pode ser configurado como recorrente"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o tipo de despesa está ativo"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "categoria"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}