{
  "name": "CondicaoComercial",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "nome_condicao": {
      "type": "string",
      "description": "Nome da condi\u00e7\u00e3o comercial"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_condicao": {
      "type": "string",
      "enum": [
        "Pagamento",
        "Desconto",
        "Frete",
        "Prazo Entrega",
        "Comiss\u00e3o"
      ],
      "default": "Pagamento"
    },
    "prazo_pagamento_dias": {
      "type": "number",
      "description": "Prazo em dias"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "\u00c0 Vista",
        "Parcelado",
        "Boleto",
        "PIX",
        "Cart\u00e3o",
        "Dep\u00f3sito"
      ],
      "default": "\u00c0 Vista"
    },
    "numero_parcelas": {
      "type": "number",
      "default": 1
    },
    "intervalo_parcelas_dias": {
      "type": "number",
      "default": 30
    },
    "desconto_percentual": {
      "type": "number",
      "default": 0
    },
    "acrescimo_percentual": {
      "type": "number",
      "default": 0
    },
    "tipo_frete": {
      "type": "string",
      "enum": [
        "CIF",
        "FOB",
        "Retira"
      ],
      "default": "CIF"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_condicao"
  ]
}