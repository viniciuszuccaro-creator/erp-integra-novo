{
  "name": "CentroCusto",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial (se criado no grupo)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se criado na empresa)"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa",
      "description": "Indica se foi criado no grupo ou na empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código do centro de custo"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição do centro de custo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Receita",
        "Despesa",
        "Investimento",
        "Misto"
      ],
      "description": "Tipo do centro de custo"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Administrativo",
        "Comercial",
        "Operacional",
        "Financeiro",
        "Marketing",
        "TI",
        "RH",
        "Logística",
        "Produção",
        "Obras"
      ],
      "description": "Categoria do centro de custo"
    },
    "centro_custo_pai_id": {
      "type": "string",
      "description": "ID do centro de custo pai (para hierarquia)"
    },
    "nivel_hierarquico": {
      "type": "number",
      "default": 1,
      "description": "Nível na hierarquia"
    },
    "responsavel": {
      "type": "string",
      "description": "Nome do responsável"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do usuário responsável"
    },
    "orcamento_mensal": {
      "type": "number",
      "default": 0,
      "description": "Orçamento mensal"
    },
    "orcamento_anual": {
      "type": "number",
      "default": 0
    },
    "realizado_mes_atual": {
      "type": "number",
      "default": 0,
      "description": "Valor realizado no mês atual"
    },
    "percentual_realizado": {
      "type": "number",
      "default": 0,
      "description": "% do orçamento já realizado"
    },
    "filial_vinculada_id": {
      "type": "string",
      "description": "ID da filial vinculada (LocalEstoque)"
    },
    "conta_contabil_padrao_id": {
      "type": "string",
      "description": "ID da conta contábil padrão"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "codigo",
    "descricao",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}