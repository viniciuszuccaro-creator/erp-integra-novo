{
  "name": "GatewayPagamento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa proprietária da configuração"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "nome": {
      "type": "string",
      "description": "Nome do Gateway (ex: Pagar.me Principal)"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "Pagar.me",
        "Stripe",
        "Asaas",
        "Juno",
        "PagSeguro",
        "Mercado Pago",
        "Adyen",
        "Cielo",
        "Rede",
        "Stone",
        "Outro"
      ],
      "description": "Provedor do gateway de pagamento"
    },
    "tipos_pagamento_suportados": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PIX",
          "Boleto",
          "Cartão Crédito",
          "Cartão Débito",
          "Transferência",
          "Link de Pagamento"
        ]
      },
      "description": "Tipos de pagamento que este gateway suporta"
    },
    "chave_api_publica": {
      "type": "string",
      "description": "Chave API pública do gateway"
    },
    "chave_api_secreta": {
      "type": "string",
      "description": "Chave API secreta (criptografada no backend)"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL de webhook para receber notificações"
    },
    "webhook_secret": {
      "type": "string",
      "description": "Secret para validar webhooks"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produção",
        "Homologação",
        "Teste"
      ],
      "default": "Teste",
      "description": "Ambiente de operação"
    },
    "configuracoes_extras": {
      "type": "object",
      "additionalProperties": true,
      "description": "Configurações específicas do gateway (JSON flexível)"
    },
    "taxas_gateway": {
      "type": "object",
      "properties": {
        "taxa_boleto_fixa": {
          "type": "number",
          "default": 0
        },
        "taxa_pix_percentual": {
          "type": "number",
          "default": 0
        },
        "taxa_cartao_debito_percentual": {
          "type": "number",
          "default": 0
        },
        "taxa_cartao_credito_percentual": {
          "type": "number",
          "default": 0
        },
        "taxa_link_pagamento_percentual": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Taxas cobradas pelo gateway"
    },
    "limites_transacao": {
      "type": "object",
      "properties": {
        "valor_minimo": {
          "type": "number",
          "default": 0
        },
        "valor_maximo": {
          "type": "number",
          "default": 0
        },
        "limite_diario": {
          "type": "number",
          "default": 0
        },
        "limite_mensal": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Limites de transação do gateway"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o gateway está ativo para uso"
    },
    "prioridade": {
      "type": "number",
      "default": 1,
      "description": "Prioridade de uso (maior = mais prioritário)"
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Última sincronização de status com o gateway"
    },
    "estatisticas": {
      "type": "object",
      "properties": {
        "total_transacoes": {
          "type": "number",
          "default": 0
        },
        "total_valor_processado": {
          "type": "number",
          "default": 0
        },
        "taxa_sucesso": {
          "type": "number",
          "default": 0
        },
        "tempo_medio_resposta_ms": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Estatísticas de uso do gateway"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "provedor",
    "empresa_id",
    "ambiente"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}