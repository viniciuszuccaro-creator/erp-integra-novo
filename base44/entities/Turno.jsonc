{
  "name": "Turno",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do turno"
    },
    "nome_turno": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "horario_inicio": {
      "type": "string"
    },
    "horario_fim": {
      "type": "string"
    },
    "intervalo_inicio": {
      "type": "string"
    },
    "intervalo_fim": {
      "type": "string"
    },
    "carga_horaria_diaria": {
      "type": "number"
    },
    "dias_semana": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Segunda",
          "Ter\u00e7a",
          "Quarta",
          "Quinta",
          "Sexta",
          "S\u00e1bado",
          "Domingo"
        ]
      }
    },
    "tipo_turno": {
      "type": "string",
      "enum": [
        "Administrativo",
        "Produ\u00e7\u00e3o",
        "Comercial",
        "Log\u00edstica",
        "Outro"
      ],
      "default": "Administrativo"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_turno",
    "horario_inicio",
    "horario_fim"
  ]
}