{
  "name": "EntregaItens",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "entrega_id": {
      "type": "string",
      "description": "ID da entrega"
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do pedido"
    },
    "pedido_item_id": {
      "type": "string",
      "description": "ID do item no pedido"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto (se item de revenda)"
    },
    "item_producao_id": {
      "type": "string",
      "description": "ID do item de produção (se produzido)"
    },
    "op_id": {
      "type": "string",
      "description": "ID da Ordem de Produção"
    },
    "tipo_item": {
      "type": "string",
      "enum": [
        "revenda",
        "producao"
      ],
      "description": "Tipo de item"
    },
    "descricao_produto": {
      "type": "string",
      "description": "Descrição do produto/item"
    },
    "codigo_sku": {
      "type": "string",
      "description": "Código SKU"
    },
    "elemento": {
      "type": "string",
      "description": "Elemento estrutural (V1, C2, etc) se for produção"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade sendo entregue"
    },
    "quantidade_pedida_original": {
      "type": "number",
      "description": "Quantidade original no pedido"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade de medida"
    },
    "peso_kg": {
      "type": "number",
      "description": "Peso do item em KG"
    },
    "volume_m3": {
      "type": "number",
      "description": "Volume em m³"
    },
    "fracionado_30kg": {
      "type": "boolean",
      "default": false,
      "description": "Se foi fracionado pela regra dos 30kg (V16.1)"
    },
    "numero_volumes_fracionados": {
      "type": "number",
      "default": 1,
      "description": "Quantidade de volumes (ex: 3 se fracionado) (V16.1)"
    },
    "etiquetas_qrcode": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequencia": {
            "type": "string",
            "description": "Ex: 1/3, 2/3, 3/3"
          },
          "qrcode_url": {
            "type": "string"
          },
          "peso_volume_kg": {
            "type": "number"
          },
          "scaneada": {
            "type": "boolean",
            "default": false
          },
          "data_scan": {
            "type": "string",
            "format": "date-time"
          },
          "usuario_scan": {
            "type": "string"
          }
        }
      },
      "description": "Etiquetas QR Code geradas (V16.1)"
    },
    "lote": {
      "type": "string",
      "description": "Número do lote (se controlar)"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "description": "Data de validade (se aplicável)"
    },
    "nfe_numero": {
      "type": "string",
      "description": "Número da NF-e que acompanha"
    },
    "romaneio_numero": {
      "type": "string",
      "description": "Número do romaneio"
    },
    "localizacao_estoque": {
      "type": "string",
      "description": "Localização no estoque antes da separação"
    },
    "separado": {
      "type": "boolean",
      "default": false,
      "description": "Se o item foi separado"
    },
    "conferido": {
      "type": "boolean",
      "default": false,
      "description": "Se o item foi conferido"
    },
    "observacao": {
      "type": "string",
      "description": "Observações sobre o item"
    }
  },
  "required": [
    "entrega_id",
    "descricao_produto",
    "quantidade"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}