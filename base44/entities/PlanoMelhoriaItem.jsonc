{
  "name": "PlanoMelhoriaItem",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "fase": {
      "type": "string",
      "description": "Fase do plano de melhoria"
    },
    "modulo": {
      "type": "string",
      "description": "Módulo relacionado"
    },
    "titulo": {
      "type": "string",
      "description": "Título da melhoria"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição objetiva da melhoria"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Média",
        "Alta",
        "Crítica"
      ],
      "default": "Média"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planejado",
        "Em Execução",
        "Validando",
        "Concluído"
      ],
      "default": "Planejado"
    },
    "percentual": {
      "type": "number",
      "default": 0
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Estabilidade",
        "Multiempresa",
        "Acesso",
        "Performance",
        "UX",
        "IA",
        "Integração",
        "Governança"
      ],
      "default": "Governança"
    },
    "impacto": {
      "type": "string",
      "description": "Impacto esperado no sistema"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "fase",
    "modulo",
    "titulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}