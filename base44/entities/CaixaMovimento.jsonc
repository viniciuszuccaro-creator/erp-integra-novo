{
  "name": "CaixaMovimento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "data_movimento": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do movimento"
    },
    "tipo_movimento": {
      "type": "string",
      "enum": [
        "Entrada",
        "Saída",
        "Abertura",
        "Fechamento",
        "Sangria",
        "Reforço"
      ],
      "description": "Tipo de movimento"
    },
    "origem": {
      "type": "string",
      "description": "Origem do movimento (Venda PDV, Liquidação, etc)"
    },
    "forma_pagamento": {
      "type": "string",
      "description": "Forma de pagamento utilizada"
    },
    "valor": {
      "type": "number",
      "description": "Valor do movimento"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição detalhada"
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do pedido vinculado (se houver)"
    },
    "conta_receber_id": {
      "type": "string",
      "description": "ID da conta a receber vinculada"
    },
    "conta_pagar_id": {
      "type": "string",
      "description": "ID da conta a pagar vinculada"
    },
    "ordem_liquidacao_id": {
      "type": "string",
      "description": "ID da ordem de liquidação vinculada"
    },
    "usuario_operador_id": {
      "type": "string",
      "description": "ID do usuário operador de caixa"
    },
    "usuario_operador_nome": {
      "type": "string",
      "description": "Nome do operador"
    },
    "operador_caixa_id": {
      "type": "string",
      "description": "ID do registro OperadorCaixa"
    },
    "caixa_aberto": {
      "type": "boolean",
      "default": true,
      "description": "Se o caixa estava aberto no momento"
    },
    "cancelado": {
      "type": "boolean",
      "default": false,
      "description": "Se o movimento foi cancelado"
    },
    "motivo_cancelamento": {
      "type": "string",
      "description": "Motivo do cancelamento"
    },
    "observacoes": {
      "type": "string"
    },
    "comprovante_url": {
      "type": "string",
      "description": "URL do comprovante (se houver)"
    }
  },
  "required": [
    "tipo_movimento",
    "valor",
    "data_movimento"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}