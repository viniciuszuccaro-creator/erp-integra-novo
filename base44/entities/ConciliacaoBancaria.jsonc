{
  "name": "ConciliacaoBancaria",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "extrato_bancario_id": {
      "type": "string",
      "description": "ID do extrato banc\u00e1rio"
    },
    "movimento_caixa_id": {
      "type": "string",
      "description": "ID do movimento de caixa vinculado"
    },
    "data_conciliacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da concilia\u00e7\u00e3o"
    },
    "valor_extrato": {
      "type": "number",
      "description": "Valor no extrato banc\u00e1rio"
    },
    "valor_movimento": {
      "type": "number",
      "description": "Valor no movimento do caixa"
    },
    "valor_diferenca": {
      "type": "number",
      "default": 0,
      "description": "Diferen\u00e7a entre extrato e movimento"
    },
    "tem_divergencia": {
      "type": "boolean",
      "default": false,
      "description": "Se h\u00e1 diverg\u00eancia de valor"
    },
    "tipo_divergencia": {
      "type": "string",
      "enum": [
        "Valor Diferente",
        "Data Diferente",
        "Tarifa Banc\u00e1ria",
        "Taxa Gateway",
        "Outro"
      ],
      "description": "Tipo de diverg\u00eancia encontrada"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "conciliado",
        "divergente",
        "resolvido",
        "desfeito"
      ],
      "default": "pendente"
    },
    "conciliado_por_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se foi conciliado automaticamente pela IA"
    },
    "score_confianca_ia": {
      "type": "number",
      "default": 0,
      "description": "Score de confian\u00e7a da IA (0-100)"
    },
    "responsavel_conciliacao": {
      "type": "string",
      "description": "Usu\u00e1rio que realizou a concilia\u00e7\u00e3o"
    },
    "responsavel_id": {
      "type": "string"
    },
    "desfeito": {
      "type": "boolean",
      "default": false,
      "description": "Vol 10.4: Se a concilia\u00e7\u00e3o foi desfeita"
    },
    "data_desfazer": {
      "type": "string",
      "format": "date-time",
      "description": "Vol 10.4: Data/hora do desfazimento"
    },
    "justificativa_desfazer": {
      "type": "string",
      "description": "Vol 10.4: Justificativa obrigat\u00f3ria para desfazer concilia\u00e7\u00e3o"
    },
    "responsavel_desfazer": {
      "type": "string",
      "description": "Vol 10.4: Usu\u00e1rio que desfez a concilia\u00e7\u00e3o"
    },
    "responsavel_desfazer_id": {
      "type": "string",
      "description": "Vol 10.4: ID do usu\u00e1rio que desfez"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "data_conciliacao"
  ]
}