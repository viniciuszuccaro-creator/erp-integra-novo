{
  "name": "Inventario",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "data_referencia": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Em Contagem",
        "Em Aprova\u00e7\u00e3o",
        "Aprovado",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Aberto"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "produto_descricao": {
            "type": "string"
          },
          "lote": {
            "type": "string"
          },
          "unidade": {
            "type": "string"
          },
          "saldo_sistema": {
            "type": "number"
          },
          "contagem": {
            "type": "number"
          },
          "ajuste": {
            "type": "number"
          },
          "observacao": {
            "type": "string"
          }
        }
      }
    },
    "aprovado_por": {
      "type": "string"
    },
    "aprovado_por_id": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "empresa_id",
    "data_referencia",
    "status"
  ]
}