{
  "name": "CentroOperacao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa responsável"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do centro operacional"
    },
    "nome_centro": {
      "type": "string",
      "description": "Nome do centro — único por grupo (Ex: CD Guarulhos, Obra Cliente X)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "CD",
        "Obra",
        "Loja",
        "Depósito",
        "Fábrica"
      ],
      "description": "Tipo de centro operacional"
    },
    "endereco": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "pais": {
          "type": "string",
          "default": "Brasil"
        }
      },
      "description": "Endereço completo do centro"
    },
    "geolocalizacao": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "google_maps_url": {
          "type": "string"
        }
      },
      "description": "Geolocalização automática (V16.1)"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do colaborador responsável"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do responsável"
    },
    "permite_estoque": {
      "type": "boolean",
      "default": true,
      "description": "Se permite controle de estoque"
    },
    "capacidade_m3": {
      "type": "number",
      "description": "Capacidade volumétrica em m³"
    },
    "area_m2": {
      "type": "number",
      "description": "Área total em m²"
    },
    "custo_mensal_aluguel": {
      "type": "number",
      "description": "Custo mensal de aluguel/operação"
    },
    "custo_por_m2": {
      "type": "number",
      "description": "Custo por m² calculado por IA"
    },
    "horario_funcionamento": {
      "type": "object",
      "properties": {
        "segunda_sexta_inicio": {
          "type": "string"
        },
        "segunda_sexta_fim": {
          "type": "string"
        },
        "sabado_inicio": {
          "type": "string"
        },
        "sabado_fim": {
          "type": "string"
        },
        "domingo": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Horário de funcionamento"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o centro está ativo"
    },
    "data_abertura": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura"
    },
    "data_encerramento": {
      "type": "string",
      "format": "date",
      "description": "Data de encerramento (se aplicável)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações sobre o centro"
    }
  },
  "required": [
    "nome_centro",
    "tipo",
    "empresa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}