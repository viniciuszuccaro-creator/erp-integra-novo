{
  "name": "ConfiguracaoIntegracaoMarketplace",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da configuração"
    },
    "marketplace": {
      "type": "string",
      "description": "Nome do marketplace (Mercado Livre, Amazon, Magalu, etc)"
    },
    "nome_integracao": {
      "type": "string",
      "description": "Nome descritivo da integração"
    },
    "tipo_integracao": {
      "type": "string",
      "enum": [
        "API REST",
        "SOAP",
        "GraphQL",
        "Webhook",
        "FTP",
        "Outro"
      ],
      "default": "API REST"
    },
    "url_base": {
      "type": "string",
      "description": "URL base da API"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API"
    },
    "api_secret": {
      "type": "string",
      "description": "Secret da API"
    },
    "token_acesso": {
      "type": "string",
      "description": "Token de acesso OAuth"
    },
    "headers_customizados": {
      "type": "object",
      "description": "Headers HTTP customizados"
    },
    "timeout_segundos": {
      "type": "number",
      "default": 30
    },
    "max_tentativas_retry": {
      "type": "number",
      "default": 3
    },
    "sincronizacao_automatica": {
      "type": "boolean",
      "default": false
    },
    "intervalo_sincronizacao_minutos": {
      "type": "number",
      "default": 60
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time"
    },
    "status_conexao": {
      "type": "string",
      "enum": [
        "Conectado",
        "Desconectado",
        "Erro",
        "Não Testado"
      ],
      "default": "Não Testado"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "descricao": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "marketplace",
    "tipo_integracao"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}