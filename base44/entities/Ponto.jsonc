{
  "name": "Ponto",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa do colaborador"
    },
    "colaborador_id": {
      "type": "string"
    },
    "colaborador_nome": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "entrada_manha": {
      "type": "string",
      "description": "Horário formato HH:MM"
    },
    "saida_almoco": {
      "type": "string"
    },
    "retorno_almoco": {
      "type": "string"
    },
    "saida_tarde": {
      "type": "string"
    },
    "horas_trabalhadas": {
      "type": "number"
    },
    "horas_extras": {
      "type": "number"
    },
    "tipo_dia": {
      "type": "string",
      "enum": [
        "Normal",
        "Feriado",
        "Fim de Semana",
        "Folga"
      ],
      "default": "Normal"
    },
    "observacoes": {
      "type": "string"
    },
    "aprovado_por": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aprovado",
        "Rejeitado"
      ],
      "default": "Pendente"
    }
  },
  "required": [
    "colaborador_nome",
    "data"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}