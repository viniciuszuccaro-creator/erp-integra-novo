{
  "name": "PerfilAcesso",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro \u00fanico compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico do perfil de acesso"
    },
    "nome_perfil": {
      "type": "string",
      "description": "Nome do perfil \u2014 \u00fanico por grupo"
    },
    "descricao": {
      "type": "string"
    },
    "nivel_perfil": {
      "type": "string",
      "enum": [
        "Administrador",
        "Gerencial",
        "Operacional",
        "Consulta",
        "Personalizado"
      ],
      "default": "Operacional"
    },
    "permissoes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Estrutura flex\u00edvel: m\u00f3dulo \u2192 se\u00e7\u00e3o \u2192 [a\u00e7\u00f5es]."
    },
    "permissoes_sensiveis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflitos_sod_detectados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo_conflito": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "severidade": {
            "type": "string",
            "enum": [
              "Baixa",
              "M\u00e9dia",
              "Alta",
              "Cr\u00edtica"
            ]
          },
          "data_deteccao": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "requer_aprovacao_especial": {
      "type": "boolean",
      "default": false
    },
    "aprovado_por": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_perfil",
    "permissoes"
  ]
}