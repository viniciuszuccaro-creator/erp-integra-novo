{
  "name": "Banco",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro \u00fanico compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico do registro"
    },
    "codigo_banco": {
      "type": "string",
      "description": "C\u00f3digo oficial do banco (ex: 001, 237, 341) \u2014 \u00fanico por grupo"
    },
    "nome_banco": {
      "type": "string"
    },
    "nome_completo": {
      "type": "string"
    },
    "pais": {
      "type": "string",
      "default": "Brasil"
    },
    "url_site": {
      "type": "string"
    },
    "integracao_disponivel": {
      "type": "boolean",
      "default": false
    },
    "tipo_integracao": {
      "type": "string",
      "enum": [
        "API",
        "OFX",
        "CNAB",
        "Open Banking",
        "Manual"
      ]
    },
    "api_url": {
      "type": "string"
    },
    "api_versao": {
      "type": "string"
    },
    "suporta_conciliacao_automatica": {
      "type": "boolean",
      "default": false
    },
    "suporta_extrato_automatico": {
      "type": "boolean",
      "default": false
    },
    "suporta_cobranca_boleto": {
      "type": "boolean",
      "default": false
    },
    "suporta_cobranca_pix": {
      "type": "boolean",
      "default": false
    },
    "logo_url": {
      "type": "string"
    },
    "cor_primaria": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "codigo_banco",
    "nome_banco"
  ]
}