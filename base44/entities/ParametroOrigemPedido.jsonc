{
  "name": "ParametroOrigemPedido",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único"
    },
    "nome": {
      "type": "string",
      "description": "Nome do canal (ex: ERP Manual, Site Automático, Chatbot)"
    },
    "canal": {
      "type": "string",
      "enum": [
        "ERP",
        "Site",
        "Chatbot",
        "WhatsApp",
        "API",
        "Marketplace",
        "E-commerce",
        "Portal Cliente",
        "App Mobile"
      ],
      "description": "Canal de onde o pedido se origina"
    },
    "tipo_criacao": {
      "type": "string",
      "enum": [
        "Manual",
        "Automático",
        "Misto"
      ],
      "default": "Manual",
      "description": "Se a criação é manual, automática ou ambas"
    },
    "origem_pedido_manual": {
      "type": "string",
      "enum": [
        "Manual",
        "E-commerce",
        "API",
        "Importado",
        "Site",
        "App",
        "WhatsApp",
        "Portal",
        "Marketplace",
        "Chatbot"
      ],
      "description": "Valor quando criado manualmente neste canal"
    },
    "origem_pedido_automatico": {
      "type": "string",
      "enum": [
        "Manual",
        "E-commerce",
        "API",
        "Importado",
        "Site",
        "App",
        "WhatsApp",
        "Portal",
        "Marketplace",
        "Chatbot"
      ],
      "description": "Valor quando criado automaticamente neste canal"
    },
    "bloquear_edicao_automatico": {
      "type": "boolean",
      "default": true,
      "description": "Se deve bloquear edição da origem quando automático"
    },
    "url_webhook": {
      "type": "string",
      "description": "URL do webhook para receber pedidos automáticos (se aplicável)"
    },
    "api_token": {
      "type": "string",
      "description": "Token de autenticação da API (se aplicável)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se este canal está ativo"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição do canal e como funciona"
    },
    "cor_badge": {
      "type": "string",
      "enum": [
        "blue",
        "green",
        "purple",
        "orange",
        "red",
        "yellow",
        "pink",
        "cyan"
      ],
      "default": "blue",
      "description": "Cor do badge visual para este canal"
    }
  },
  "required": [
    "nome",
    "canal",
    "tipo_criacao"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}