{
  "name": "ParametroCaixaDiario",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único"
    },
    "tipo_caixa": {
      "type": "string",
      "enum": [
        "Caixa Físico",
        "Caixa Loja",
        "Caixa Obra",
        "Caixa Virtual"
      ],
      "default": "Caixa Físico"
    },
    "conta_contabil_caixa_id": {
      "type": "string",
      "description": "ID da conta contábil de caixa"
    },
    "conta_contabil_suprimento_id": {
      "type": "string",
      "description": "ID da conta contábil para suprimentos"
    },
    "conta_contabil_sangria_id": {
      "type": "string",
      "description": "ID da conta contábil para sangrias"
    },
    "conta_contabil_desconto_id": {
      "type": "string",
      "description": "ID da conta contábil para descontos"
    },
    "conta_contabil_acrescimo_id": {
      "type": "string",
      "description": "ID da conta contábil para acréscimos"
    },
    "politica_arredondamento": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Centavos",
        "Real Inteiro"
      ],
      "default": "Nenhum"
    },
    "permite_desconto": {
      "type": "boolean",
      "default": true
    },
    "permite_acrescimo": {
      "type": "boolean",
      "default": true
    },
    "desconto_maximo_percentual": {
      "type": "number",
      "default": 10,
      "description": "% máximo de desconto permitido"
    },
    "acrescimo_maximo_percentual": {
      "type": "number",
      "default": 10
    },
    "tipos_movimento_permitidos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Suprimento",
          "Sangria",
          "Recebimento Cliente",
          "Pagamento Avulso",
          "Troco",
          "Outros"
        ]
      },
      "description": "Tipos de movimento permitidos neste caixa"
    },
    "formas_pagamento_disponiveis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das formas de pagamento disponíveis"
    },
    "exige_autorizacao_sangria_acima": {
      "type": "number",
      "default": 0,
      "description": "Valor acima do qual exige autorização para sangria"
    },
    "exige_autorizacao_suprimento_acima": {
      "type": "number",
      "default": 0
    },
    "permite_baixa_lote": {
      "type": "boolean",
      "default": true,
      "description": "Se permite baixa em lote de títulos"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "tipo_caixa"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}