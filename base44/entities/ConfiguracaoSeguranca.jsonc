{
  "name": "ConfiguracaoSeguranca",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (null se config do grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único"
    },
    "jwt_ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se usa JWT para autenticação"
    },
    "jwt_algoritmo": {
      "type": "string",
      "default": "HS256",
      "enum": [
        "HS256",
        "HS384",
        "HS512",
        "RS256"
      ],
      "description": "Algoritmo de assinatura JWT"
    },
    "jwt_secret_key": {
      "type": "string",
      "description": "Chave secreta JWT (criptografada)"
    },
    "jwt_validade_access_minutos": {
      "type": "number",
      "default": 15,
      "description": "Validade do access token em minutos"
    },
    "jwt_validade_refresh_dias": {
      "type": "number",
      "default": 30,
      "description": "Validade do refresh token em dias"
    },
    "jwt_rotacao_refresh": {
      "type": "boolean",
      "default": true,
      "description": "Se faz rotação de refresh tokens"
    },
    "jwt_familia_tokens": {
      "type": "boolean",
      "default": true,
      "description": "Se agrupa tokens em famílias (detecta roubo)"
    },
    "jwt_revogar_familia_em_suspeita": {
      "type": "boolean",
      "default": true,
      "description": "Revoga toda família se detectar uso suspeito"
    },
    "sessao_unica": {
      "type": "boolean",
      "default": false,
      "description": "Se permite apenas 1 sessão por usuário"
    },
    "sessoes_simultaneas_max": {
      "type": "number",
      "default": 3,
      "description": "Número máximo de sessões simultâneas"
    },
    "encerrar_sessoes_antigas_auto": {
      "type": "boolean",
      "default": true,
      "description": "Se encerra sessões antigas ao atingir o limite"
    },
    "timeout_inatividade_minutos": {
      "type": "number",
      "default": 60,
      "description": "Timeout de inatividade (minutos)"
    },
    "timeout_absoluto_horas": {
      "type": "number",
      "default": 24,
      "description": "Timeout absoluto da sessão (horas)"
    },
    "exigir_mfa": {
      "type": "boolean",
      "default": false,
      "description": "Se exige autenticação de dois fatores"
    },
    "mfa_metodos_disponiveis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Email",
          "WhatsApp",
          "SMS",
          "Authenticator"
        ]
      },
      "default": [
        "Email",
        "WhatsApp"
      ],
      "description": "Métodos de MFA disponíveis"
    },
    "mfa_validade_codigo_minutos": {
      "type": "number",
      "default": 5,
      "description": "Validade do código MFA em minutos"
    },
    "mfa_exigir_novo_ip": {
      "type": "boolean",
      "default": true,
      "description": "Exigir MFA em novo IP"
    },
    "mfa_exigir_novo_dispositivo": {
      "type": "boolean",
      "default": true,
      "description": "Exigir MFA em novo dispositivo"
    },
    "mfa_exigir_horario_incomum": {
      "type": "boolean",
      "default": false,
      "description": "Exigir MFA em horário incomum"
    },
    "tentativas_login_max": {
      "type": "number",
      "default": 5,
      "description": "Tentativas máximas antes de bloquear"
    },
    "bloqueio_tempo_minutos": {
      "type": "number",
      "default": 30,
      "description": "Tempo de bloqueio após exceder tentativas"
    },
    "bloqueio_ip_suspeito": {
      "type": "boolean",
      "default": true,
      "description": "Se bloqueia IPs com comportamento suspeito"
    },
    "ips_bloqueados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de IPs bloqueados"
    },
    "ips_whitelist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IPs sempre permitidos"
    },
    "detectar_anomalias_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se usa IA para detectar comportamento anômalo"
    },
    "ia_nivel_sensibilidade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Média",
        "Alta",
        "Máxima"
      ],
      "default": "Média",
      "description": "Sensibilidade da detecção de anomalias"
    },
    "registrar_dispositivos": {
      "type": "boolean",
      "default": true,
      "description": "Se registra dispositivos conhecidos"
    },
    "notificar_novo_dispositivo": {
      "type": "boolean",
      "default": true,
      "description": "Notificar usuário em novo dispositivo"
    },
    "notificar_novo_ip": {
      "type": "boolean",
      "default": true,
      "description": "Notificar usuário em novo IP"
    },
    "notificar_tentativas_falhas": {
      "type": "boolean",
      "default": true,
      "description": "Notificar após X tentativas falhas"
    },
    "politica_senha": {
      "type": "object",
      "properties": {
        "tamanho_minimo": {
          "type": "number",
          "default": 8
        },
        "exigir_maiusculas": {
          "type": "boolean",
          "default": true
        },
        "exigir_minusculas": {
          "type": "boolean",
          "default": true
        },
        "exigir_numeros": {
          "type": "boolean",
          "default": true
        },
        "exigir_especiais": {
          "type": "boolean",
          "default": false
        },
        "trocar_senha_dias": {
          "type": "number",
          "default": 90
        },
        "historico_senhas": {
          "type": "number",
          "default": 3
        },
        "permitir_senha_comum": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Política de senhas"
    },
    "rate_limiting": {
      "type": "object",
      "properties": {
        "ativo": {
          "type": "boolean",
          "default": true
        },
        "requisicoes_por_minuto": {
          "type": "number",
          "default": 60
        },
        "requisicoes_por_hora": {
          "type": "number",
          "default": 1000
        },
        "bloquear_apos_exceder": {
          "type": "boolean",
          "default": true
        },
        "tempo_bloqueio_minutos": {
          "type": "number",
          "default": 15
        }
      },
      "description": "Rate limiting de APIs"
    },
    "auditoria_completa": {
      "type": "boolean",
      "default": true,
      "description": "Se registra todas as ações em auditoria"
    },
    "registrar_ips_acessos": {
      "type": "boolean",
      "default": true,
      "description": "Se registra IPs de todos acessos"
    },
    "registrar_user_agents": {
      "type": "boolean",
      "default": true,
      "description": "Se registra user agents"
    },
    "estatisticas": {
      "type": "object",
      "properties": {
        "total_sessoes_criadas": {
          "type": "number",
          "default": 0
        },
        "total_sessoes_ativas": {
          "type": "number",
          "default": 0
        },
        "total_tentativas_falhas": {
          "type": "number",
          "default": 0
        },
        "total_bloqueios": {
          "type": "number",
          "default": 0
        },
        "total_mfa_validados": {
          "type": "number",
          "default": 0
        },
        "total_alertas_seguranca": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Estatísticas de segurança"
    },
    "ultima_tentativa_invasao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da última tentativa suspeita"
    },
    "configurado_por": {
      "type": "string",
      "description": "Usuário que configurou"
    },
    "configurado_por_id": {
      "type": "string"
    },
    "data_configuracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da configuração"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações sobre a configuração"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se ativo"
    }
  },
  "required": [
    "jwt_ativo",
    "sessoes_simultaneas_max",
    "timeout_inatividade_minutos"
  ]
}
