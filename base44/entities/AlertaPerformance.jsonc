{
  "name": "AlertaPerformance",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "numero_alerta": {
      "type": "string",
      "description": "Número sequencial do alerta"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da detecção"
    },
    "tipo_alerta": {
      "type": "string",
      "enum": [
        "Query Lenta",
        "API Lenta",
        "Erro Crítico",
        "CPU Alta",
        "Memória Alta",
        "Downtime",
        "Timeout",
        "Threshold Excedido",
        "Anomalia"
      ],
      "description": "Tipo do alerta"
    },
    "severidade": {
      "type": "string",
      "enum": [
        "Info",
        "Warning",
        "Error",
        "Critical"
      ],
      "default": "Warning",
      "description": "Severidade do alerta"
    },
    "modulo": {
      "type": "string",
      "description": "Módulo afetado"
    },
    "funcionalidade": {
      "type": "string",
      "description": "Funcionalidade afetada"
    },
    "metrica_tipo": {
      "type": "string",
      "enum": [
        "duracao",
        "cpu",
        "memoria",
        "taxa_erro",
        "disponibilidade",
        "throughput",
        "latencia"
      ],
      "description": "Tipo de métrica que disparou"
    },
    "valor_medido": {
      "type": "number",
      "description": "Valor medido da métrica"
    },
    "threshold_configurado": {
      "type": "number",
      "description": "Limite configurado"
    },
    "percentual_excedido": {
      "type": "number",
      "description": "% acima do threshold"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição do alerta"
    },
    "impacto_estimado": {
      "type": "string",
      "enum": [
        "Baixo",
        "Médio",
        "Alto",
        "Crítico"
      ],
      "description": "Impacto estimado no negócio"
    },
    "usuarios_afetados": {
      "type": "number",
      "description": "Número de usuários afetados"
    },
    "ocorrencias_relacionadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de logs de performance relacionados"
    },
    "quantidade_ocorrencias": {
      "type": "number",
      "default": 1,
      "description": "Número de vezes que ocorreu"
    },
    "primeira_ocorrencia": {
      "type": "string",
      "format": "date-time",
      "description": "Primeira vez que foi detectado"
    },
    "ultima_ocorrencia": {
      "type": "string",
      "format": "date-time",
      "description": "Última vez que foi detectado"
    },
    "frequencia": {
      "type": "string",
      "enum": [
        "Única",
        "Recorrente",
        "Constante"
      ],
      "description": "Frequência do problema"
    },
    "tendencia": {
      "type": "string",
      "enum": [
        "Melhorando",
        "Estável",
        "Piorando"
      ],
      "description": "Tendência do problema"
    },
    "acao_recomendada": {
      "type": "string",
      "description": "Ação recomendada para resolver"
    },
    "diagnostico_ia": {
      "type": "object",
      "properties": {
        "ativo": {
          "type": "boolean",
          "default": false
        },
        "causa_provavel": {
          "type": "string"
        },
        "solucao_sugerida": {
          "type": "string"
        },
        "confianca_percent": {
          "type": "number"
        },
        "referencias": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Diagnóstico automatizado por IA"
    },
    "status": {
      "type": "string",
      "enum": [
        "Novo",
        "Investigando",
        "Em Correção",
        "Resolvido",
        "Ignorado",
        "Falso Positivo"
      ],
      "default": "Novo",
      "description": "Status do alerta"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do responsável pela investigação"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do responsável"
    },
    "data_atribuicao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi atribuído"
    },
    "resolucao": {
      "type": "object",
      "properties": {
        "resolvido": {
          "type": "boolean",
          "default": false
        },
        "data_resolucao": {
          "type": "string",
          "format": "date-time"
        },
        "resolvido_por": {
          "type": "string"
        },
        "resolvido_por_id": {
          "type": "string"
        },
        "acao_tomada": {
          "type": "string"
        },
        "tempo_resolucao_horas": {
          "type": "number"
        },
        "observacoes": {
          "type": "string"
        }
      },
      "description": "Dados da resolução"
    },
    "notificacao_enviada": {
      "type": "boolean",
      "default": false,
      "description": "Se notificação foi enviada"
    },
    "notificacao_destinatarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "E-mails notificados"
    },
    "prioridade": {
      "type": "number",
      "default": 0,
      "description": "Prioridade calculada (0-100)"
    },
    "automaticamente_criado": {
      "type": "boolean",
      "default": true,
      "description": "Se foi criado automaticamente"
    },
    "regra_id": {
      "type": "string",
      "description": "ID da regra que disparou o alerta"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações sobre o alerta"
    }
  },
  "required": [
    "timestamp",
    "tipo_alerta",
    "severidade",
    "modulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}