{
  "name": "GrupoProduto",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial (global)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro \u00fanico compartilhado no grupo)"
    },
    "nome_grupo": {
      "type": "string",
      "description": "Nome do grupo \u2014 \u00fanico por grupo (Ex: Ferragens, Bitolas, Materiais El\u00e9tricos)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico do grupo"
    },
    "natureza": {
      "type": "string",
      "enum": [
        "Revenda",
        "Produ\u00e7\u00e3o",
        "Consumo",
        "Servi\u00e7o"
      ],
      "default": "Revenda",
      "description": "Natureza dos produtos deste grupo"
    },
    "ncm_padrao": {
      "type": "string",
      "description": "NCM padr\u00e3o para produtos deste grupo (V16.1)"
    },
    "conta_contabil_padrao_id": {
      "type": "string",
      "description": "Conta cont\u00e1bil padr\u00e3o (V16.1)"
    },
    "margem_sugerida": {
      "type": "number",
      "description": "% de margem sugerida para produtos deste grupo"
    },
    "icone": {
      "type": "string",
      "description": "Nome do \u00edcone (lucide-react)"
    },
    "cor": {
      "type": "string",
      "description": "Cor hexadecimal para UI"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o grupo est\u00e1 ativo"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_grupo",
    "natureza"
  ]
}