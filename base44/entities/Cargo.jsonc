{
  "name": "Cargo",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial (se criado no grupo)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se criado na empresa)"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa",
      "description": "Indica se foi criado no grupo ou na empresa"
    },
    "nome_cargo": {
      "type": "string",
      "description": "Nome do cargo"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do cargo"
    },
    "nivel_hierarquico": {
      "type": "string",
      "enum": [
        "Estagi\u00e1rio",
        "Auxiliar",
        "Assistente",
        "Analista",
        "Coordenador",
        "Gerente",
        "Diretor",
        "CEO",
        "Operacional"
      ],
      "default": "Operacional",
      "description": "N\u00edvel hier\u00e1rquico"
    },
    "departamento_padrao_id": {
      "type": "string",
      "description": "ID do departamento padr\u00e3o"
    },
    "salario_base_referencia": {
      "type": "number",
      "description": "Sal\u00e1rio base de refer\u00eancia"
    },
    "cbo": {
      "type": "string",
      "description": "C\u00f3digo Brasileiro de Ocupa\u00e7\u00f5es (CBO)"
    },
    "requisitos": {
      "type": "string",
      "description": "Requisitos e qualifica\u00e7\u00f5es necess\u00e1rias"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_cargo"
  ]
}