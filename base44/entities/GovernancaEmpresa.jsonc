{
  "name": "GovernancaEmpresa",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único"
    },
    "nivel_conformidade": {
      "type": "string",
      "enum": [
        "Básico",
        "ISO27001",
        "LGPD",
        "SOX",
        "Custom"
      ],
      "default": "Básico",
      "description": "Nível de conformidade adotado"
    },
    "auditoria_automatica": {
      "type": "boolean",
      "default": true,
      "description": "Se audita automaticamente todas as ações"
    },
    "backup_automatico": {
      "type": "boolean",
      "default": true,
      "description": "Se realiza backup automático"
    },
    "backup_periodo_dias": {
      "type": "number",
      "default": 1,
      "description": "Periodicidade do backup em dias"
    },
    "backup_horario": {
      "type": "string",
      "default": "02:00",
      "description": "Horário do backup (HH:MM)"
    },
    "backup_retencao_dias": {
      "type": "number",
      "default": 30,
      "description": "Dias de retenção dos backups"
    },
    "ultimo_backup": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do último backup"
    },
    "retencao_logs_dias": {
      "type": "number",
      "default": 365,
      "description": "Dias de retenção dos logs"
    },
    "retencao_documentos_anos": {
      "type": "number",
      "default": 5,
      "description": "Anos de retenção de documentos fiscais"
    },
    "exigir_mfa": {
      "type": "boolean",
      "default": false,
      "description": "Exigir autenticação de dois fatores"
    },
    "mfa_metodos_permitidos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Email",
          "WhatsApp",
          "SMS",
          "Authenticator"
        ]
      },
      "description": "Métodos de MFA permitidos"
    },
    "sessao_timeout_minutos": {
      "type": "number",
      "default": 60,
      "description": "Timeout de sessão em minutos"
    },
    "tentativas_login_max": {
      "type": "number",
      "default": 5,
      "description": "Tentativas máximas de login antes de bloquear"
    },
    "bloquear_ips_suspeitos": {
      "type": "boolean",
      "default": true,
      "description": "Se bloqueia IPs com comportamento suspeito"
    },
    "ips_bloqueados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de IPs bloqueados"
    },
    "ia_seguranca_ativa": {
      "type": "boolean",
      "default": false,
      "description": "Se usa IA para detectar anomalias"
    },
    "ia_alerta_nivel": {
      "type": "string",
      "enum": [
        "Baixo",
        "Médio",
        "Alto",
        "Crítico"
      ],
      "default": "Médio",
      "description": "Nível de sensibilidade dos alertas IA"
    },
    "politicas_senha": {
      "type": "object",
      "properties": {
        "tamanho_minimo": {
          "type": "number",
          "default": 8
        },
        "exigir_maiusculas": {
          "type": "boolean",
          "default": true
        },
        "exigir_numeros": {
          "type": "boolean",
          "default": true
        },
        "exigir_especiais": {
          "type": "boolean",
          "default": false
        },
        "trocar_senha_dias": {
          "type": "number",
          "default": 90
        },
        "historico_senhas": {
          "type": "number",
          "default": 3
        }
      }
    },
    "criptografia_dados_sensiveis": {
      "type": "boolean",
      "default": true,
      "description": "Se criptografa dados sensíveis (CPF, CNPJ, salários)"
    },
    "algoritmo_criptografia": {
      "type": "string",
      "default": "AES-256",
      "description": "Algoritmo de criptografia utilizado"
    },
    "certificacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "numero_certificado": {
            "type": "string"
          },
          "data_emissao": {
            "type": "string",
            "format": "date"
          },
          "data_validade": {
            "type": "string",
            "format": "date"
          },
          "arquivo_url": {
            "type": "string"
          }
        }
      },
      "description": "Certificações de compliance"
    },
    "proxima_auditoria": {
      "type": "string",
      "format": "date",
      "description": "Data da próxima auditoria externa"
    },
    "responsavel_compliance": {
      "type": "string",
      "description": "Responsável pela conformidade"
    },
    "responsavel_compliance_id": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se ativo"
    }
  },
  "required": [
    "empresa_id",
    "nivel_conformidade"
  ]
}
