{
  "name": "Cargo",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do cargo"
    },
    "nome_cargo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "nivel_hierarquico": {
      "type": "string",
      "enum": [
        "Estagi\u00e1rio",
        "Auxiliar",
        "Assistente",
        "Analista",
        "Coordenador",
        "Gerente",
        "Diretor",
        "CEO",
        "Operacional"
      ],
      "default": "Operacional"
    },
    "departamento_padrao_id": {
      "type": "string"
    },
    "salario_base_referencia": {
      "type": "number"
    },
    "cbo": {
      "type": "string"
    },
    "requisitos": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_cargo"
  ]
}