{
  "name": "ContaPagar",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo (se lan\u00e7ado no grupo)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se lan\u00e7ado na empresa)"
    },
    "origem": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa",
      "description": "Se foi lan\u00e7ado no grupo ou na empresa"
    },
    "origem_tipo": {
      "type": "string",
      "enum": [
        "manual",
        "pedido",
        "ordem_compra",
        "contrato",
        "recorrente",
        "marketplace",
        "tarifa",
        "outro"
      ],
      "default": "manual",
      "description": "Tipo de origem do lan\u00e7amento"
    },
    "canal_origem": {
      "type": "string",
      "enum": [
        "ERP",
        "API",
        "Marketplace",
        "Importa\u00e7\u00e3o",
        "Autom\u00e1tico",
        "WhatsApp",
        "Portal",
        "Outro"
      ],
      "default": "ERP",
      "description": "Canal de origem do lan\u00e7amento"
    },
    "config_recorrente_id": {
      "type": "string",
      "description": "ID da configura\u00e7\u00e3o recorrente que gerou este lan\u00e7amento"
    },
    "documento_grupo_id": {
      "type": "string",
      "description": "ID do documento de grupo que originou este (se vier de rateio)"
    },
    "e_replicado": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 uma c\u00f3pia de um t\u00edtulo do grupo"
    },
    "rateado_para_empresas": {
      "type": "boolean",
      "default": false,
      "description": "Se foi rateado para empresas do grupo"
    },
    "rateio_id": {
      "type": "string",
      "description": "ID do rateio que gerou este t\u00edtulo"
    },
    "descricao": {
      "type": "string"
    },
    "fornecedor": {
      "type": "string"
    },
    "fornecedor_id": {
      "type": "string"
    },
    "favorecido_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do favorecido"
    },
    "centro_custo": {
      "type": "string"
    },
    "centro_custo_id": {
      "type": "string"
    },
    "plano_contas_id": {
      "type": "string",
      "description": "ID do plano de contas vinculado"
    },
    "projeto_obra": {
      "type": "string",
      "description": "Projeto ou obra relacionada"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Fornecedores",
        "Sal\u00e1rios",
        "Impostos",
        "Aluguel",
        "Energia",
        "\u00c1gua",
        "Telefone",
        "Internet",
        "Marketing",
        "Comiss\u00f5es",
        "Contabilidade",
        "Assessoria Jur\u00eddica",
        "Manuten\u00e7\u00e3o",
        "Transporte",
        "Outros"
      ]
    },
    "valor": {
      "type": "number"
    },
    "valor_original_grupo": {
      "type": "number",
      "description": "Valor original no grupo (se vier de rateio)"
    },
    "percentual_rateio": {
      "type": "number",
      "description": "% deste t\u00edtulo em rela\u00e7\u00e3o ao grupo"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Pago",
        "Atrasado",
        "Cancelado",
        "Parcelado"
      ],
      "default": "Pendente"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aguardando Aprova\u00e7\u00e3o",
        "Aprovado",
        "Pago",
        "Rejeitado",
        "Cancelado"
      ],
      "default": "Pendente",
      "description": "Status no fluxo de aprova\u00e7\u00e3o"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Usu\u00e1rio que aprovou"
    },
    "aprovado_por_id": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de aprova\u00e7\u00e3o"
    },
    "rejeitado_por": {
      "type": "string"
    },
    "motivo_rejeicao": {
      "type": "string"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "Dinheiro",
        "Transfer\u00eancia",
        "Boleto",
        "Cart\u00e3o",
        "PIX",
        "Cheque",
        "TED",
        "DOC"
      ]
    },
    "detalhes_pagamento": {
      "type": "object",
      "properties": {
        "forma_pagamento": {
          "type": "string",
          "description": "V22.0 ETAPA 4: Forma de pagamento detalhada"
        },
        "bandeira_cartao": {
          "type": "string",
          "enum": [
            "Visa",
            "Mastercard",
            "Elo",
            "American Express",
            "Hipercard",
            "Outro"
          ],
          "description": "V22.0 ETAPA 4: Bandeira do cart\u00e3o utilizado"
        },
        "numero_autorizacao": {
          "type": "string",
          "description": "V22.0 ETAPA 4: N\u00famero de autoriza\u00e7\u00e3o da transa\u00e7\u00e3o"
        },
        "taxa_operadora": {
          "type": "number",
          "default": 0,
          "description": "V22.0 ETAPA 4: % de taxa cobrada pela operadora"
        },
        "valor_bruto": {
          "type": "number",
          "description": "V22.0 ETAPA 4: Valor antes das taxas"
        },
        "valor_liquido": {
          "type": "number",
          "description": "V22.0 ETAPA 4: Valor ap\u00f3s descontar taxas"
        },
        "data_recebido_caixa": {
          "type": "string",
          "format": "date",
          "description": "V22.0 ETAPA 4: EST\u00c1GIO 1 - Quando foi recebido/pago no caixa"
        },
        "data_compensado_banco": {
          "type": "string",
          "format": "date",
          "description": "V22.0 ETAPA 4: EST\u00c1GIO 2 - Quando compensou no banco"
        },
        "status_compensacao": {
          "type": "string",
          "enum": [
            "Aguardando",
            "Compensado",
            "Conciliado"
          ],
          "default": "Aguardando",
          "description": "V22.0 ETAPA 4: Status da compensa\u00e7\u00e3o banc\u00e1ria"
        },
        "observacoes": {
          "type": "string",
          "description": "V22.0 ETAPA 4: Observa\u00e7\u00f5es sobre a liquida\u00e7\u00e3o"
        }
      },
      "description": "V22.0 ETAPA 4: Detalhes completos do pagamento"
    },
    "numero_documento": {
      "type": "string"
    },
    "nota_fiscal_id": {
      "type": "string"
    },
    "ordem_compra_id": {
      "type": "string"
    },
    "numero_parcela": {
      "type": "string",
      "description": "Ex: 1/3"
    },
    "juros": {
      "type": "number"
    },
    "multa": {
      "type": "number"
    },
    "desconto": {
      "type": "number"
    },
    "valor_pago": {
      "type": "number"
    },
    "pago_por": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "description": "Quem efetivamente pagou"
    },
    "empresa_que_pagou_id": {
      "type": "string",
      "description": "ID da empresa que fez o pagamento (se pago_por=empresa mas t\u00edtulo \u00e9 do grupo)"
    },
    "comprovante_pagamento_url": {
      "type": "string",
      "description": "URL do comprovante de pagamento"
    },
    "marketplace_origem": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Mercado Livre",
        "Shopee",
        "Amazon",
        "Outro"
      ],
      "default": "Nenhum",
      "description": "Se veio de marketplace"
    },
    "taxa_marketplace_esperada": {
      "type": "number",
      "default": 0,
      "description": "% de taxa esperada do marketplace"
    },
    "taxa_marketplace_cobrada": {
      "type": "number",
      "default": 0,
      "description": "% de taxa efetivamente cobrada"
    },
    "alerta_taxa_divergente": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA detectou diverg\u00eancia na taxa"
    },
    "duplicidade_detectada": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA detectou poss\u00edvel duplicidade"
    },
    "contas_similares_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de contas similares detectadas pela IA"
    },
    "observacoes": {
      "type": "string"
    },
    "sincronizar_baixa_com_grupo": {
      "type": "boolean",
      "default": true,
      "description": "Se baixa aqui deve baixar no grupo"
    },
    "distribuicao_realizada": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "empresa_id": {
            "type": "string"
          },
          "empresa_nome": {
            "type": "string"
          },
          "titulo_id": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "percentual": {
            "type": "number"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "description": "Distribui\u00e7\u00e3o realizada para empresas (se origem=grupo)"
    }
  },
  "required": [
    "descricao",
    "valor",
    "data_vencimento",
    "centro_custo_id",
    "plano_contas_id"
  ]
}