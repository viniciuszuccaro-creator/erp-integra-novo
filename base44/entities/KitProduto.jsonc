{
  "name": "KitProduto",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro \u00fanico compartilhado no grupo)"
    },
    "empresa_dona_id": {
      "type": "string",
      "description": "Empresa que cadastrou o kit"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico do kit"
    },
    "codigo_kit": {
      "type": "string",
      "description": "C\u00f3digo do kit (legado)"
    },
    "nome_kit": {
      "type": "string",
      "description": "Nome do kit \u2014 \u00fanico por grupo"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do kit"
    },
    "tipo_kit": {
      "type": "string",
      "enum": [
        "Comercial",
        "Produ\u00e7\u00e3o",
        "Promocional",
        "Personalizado"
      ],
      "default": "Comercial"
    },
    "itens_kit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Produtos que comp\u00f5em o kit"
    },
    "preco_kit": {
      "type": "number",
      "description": "Pre\u00e7o do kit (pode ser diferente da soma dos itens)"
    },
    "desconto_kit_percentual": {
      "type": "number",
      "default": 0,
      "description": "Desconto aplicado ao kit"
    },
    "imagem_kit_url": {
      "type": "string",
      "description": "URL da imagem do kit"
    },
    "exibir_no_ecommerce": {
      "type": "boolean",
      "default": false
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_kit",
    "itens_kit"
  ]
}