{
  "name": "OrcamentoSite",
  "type": "object",
  "properties": {
    "origem": {
      "type": "string",
      "enum": [
        "Site Base44",
        "Portal Cliente",
        "Chatbot WhatsApp",
        "API Externa"
      ],
      "description": "Origem do or\u00e7amento"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente/visitante"
    },
    "cliente_email": {
      "type": "string",
      "description": "E-mail do cliente"
    },
    "cliente_telefone": {
      "type": "string",
      "description": "Telefone/WhatsApp"
    },
    "cliente_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ (se informado)"
    },
    "cliente_erp_id": {
      "type": "string",
      "description": "ID do cliente no ERP (se j\u00e1 cadastrado)"
    },
    "descricao_pedido": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o textual do que o cliente quer"
    },
    "arquivo_projeto_url": {
      "type": "string",
      "description": "URL do PDF/DWG enviado pelo cliente"
    },
    "arquivo_projeto_nome": {
      "type": "string",
      "description": "Nome do arquivo enviado"
    },
    "processado_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA j\u00e1 processou"
    },
    "data_processamento_ia": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a IA processou"
    },
    "resultado_ia": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON completo da an\u00e1lise da IA"
    },
    "confianca_ia": {
      "type": "number",
      "description": "% de confian\u00e7a da IA (0-100)"
    },
    "produtos_identificados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "preco_estimado": {
            "type": "number"
          },
          "produto_id_sugerido": {
            "type": "string"
          }
        }
      },
      "description": "Produtos identificados pela IA"
    },
    "valor_estimado_total": {
      "type": "number",
      "description": "Valor total estimado pela IA"
    },
    "prazo_estimado_dias": {
      "type": "number",
      "description": "Prazo estimado de entrega"
    },
    "status": {
      "type": "string",
      "enum": [
        "Recebido",
        "Processando IA",
        "Or\u00e7amento Gerado",
        "Enviado ao Cliente",
        "Aprovado",
        "Convertido em Pedido",
        "Expirado",
        "Cancelado"
      ],
      "default": "Recebido",
      "description": "Status do or\u00e7amento"
    },
    "orcamento_pdf_url": {
      "type": "string",
      "description": "URL do PDF do or\u00e7amento gerado"
    },
    "data_envio_cliente": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi enviado ao cliente"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o cliente aprovou"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "description": "Validade do or\u00e7amento"
    },
    "pedido_erp_id": {
      "type": "string",
      "description": "ID do pedido criado no ERP (ap\u00f3s convers\u00e3o)"
    },
    "responsavel_atendimento": {
      "type": "string",
      "description": "Vendedor que pegou o atendimento"
    },
    "responsavel_id": {
      "type": "string"
    },
    "notificacao_vendedor_enviada": {
      "type": "boolean",
      "default": false,
      "description": "Se vendedor foi notificado (V16.1)"
    },
    "notificacao_id": {
      "type": "string",
      "description": "ID da notifica\u00e7\u00e3o enviada (V16.1)"
    },
    "mensagens_chat": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "autor": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Cliente",
              "Vendedor",
              "Bot IA"
            ]
          }
        }
      },
      "description": "Hist\u00f3rico de conversas"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "cliente_nome",
    "cliente_email"
  ]
}