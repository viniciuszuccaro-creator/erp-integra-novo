{
  "name": "ConfiguracaoNFe",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "eNotas",
        "NFe.io",
        "Focus NFe",
        "Outro"
      ],
      "default": "eNotas",
      "description": "Provedor de NF-e"
    },
    "api_url": {
      "type": "string",
      "description": "URL da API do provedor"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API"
    },
    "certificado_digital_url": {
      "type": "string",
      "description": "URL do certificado A1"
    },
    "senha_certificado": {
      "type": "string",
      "description": "Senha do certificado digital"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produção",
        "Homologação"
      ],
      "default": "Homologação",
      "description": "Ambiente de emissão"
    },
    "serie_nfe": {
      "type": "string",
      "default": "1",
      "description": "Série da NF-e"
    },
    "proximo_numero": {
      "type": "number",
      "default": 1,
      "description": "Próximo número de NF-e"
    },
    "emitir_automatico": {
      "type": "boolean",
      "default": false,
      "description": "Se emite automaticamente após faturamento"
    },
    "enviar_email_automatico": {
      "type": "boolean",
      "default": true,
      "description": "Se envia email com DANFE automaticamente"
    },
    "ultima_emissao": {
      "type": "string",
      "format": "date-time"
    },
    "total_emissoes": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "provedor"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}