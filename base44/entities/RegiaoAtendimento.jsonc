{
  "name": "RegiaoAtendimento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "empresas_compartilhadas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico da regi\u00e3o"
    },
    "nome_regiao": {
      "type": "string"
    },
    "codigo_regiao": {
      "type": "string",
      "description": "C\u00f3digo curto da regi\u00e3o para refer\u00eancias r\u00e1pidas"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_regiao": {
      "type": "string",
      "enum": [
        "Macro Regi\u00e3o",
        "Estado",
        "Regi\u00e3o Metropolitana",
        "Microrregi\u00e3o",
        "Personalizada"
      ],
      "default": "Personalizada"
    },
    "estados_abrangidos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "AC",
          "AL",
          "AP",
          "AM",
          "BA",
          "CE",
          "DF",
          "ES",
          "GO",
          "MA",
          "MT",
          "MS",
          "MG",
          "PA",
          "PB",
          "PR",
          "PE",
          "PI",
          "RJ",
          "RN",
          "RS",
          "RO",
          "RR",
          "SC",
          "SP",
          "SE",
          "TO"
        ]
      }
    },
    "cidades_abrangidas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cidade": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "cep_inicial": {
            "type": "string"
          },
          "cep_final": {
            "type": "string"
          }
        }
      }
    },
    "cor_identificacao": {
      "type": "string"
    },
    "vendedores_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transportadoras_preferenciais_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logistica": {
      "type": "object",
      "properties": {
        "prazo_entrega_padrao_dias": {
          "type": "number",
          "default": 0
        },
        "custo_frete_base": {
          "type": "number",
          "default": 0
        },
        "permite_entrega_expressa": {
          "type": "boolean",
          "default": false
        },
        "prazo_entrega_expressa_dias": {
          "type": "number"
        },
        "acrescimo_frete_expresso_percentual": {
          "type": "number"
        },
        "distancia_centro_distribuicao_km": {
          "type": "number"
        },
        "dificuldade_acesso": {
          "type": "string",
          "enum": [
            "F\u00e1cil",
            "Moderado",
            "Dif\u00edcil"
          ],
          "default": "F\u00e1cil"
        }
      }
    },
    "comercial": {
      "type": "object",
      "properties": {
        "meta_vendas_mensal": {
          "type": "number",
          "default": 0
        },
        "comissao_extra_percentual": {
          "type": "number",
          "default": 0
        },
        "desconto_maximo_permitido_percentual": {
          "type": "number",
          "default": 0
        },
        "exige_aprovacao_acima_valor": {
          "type": "number",
          "default": 0
        },
        "prioridade_atendimento": {
          "type": "string",
          "enum": [
            "Baixa",
            "Normal",
            "Alta",
            "Urgente"
          ],
          "default": "Normal"
        }
      }
    },
    "metricas": {
      "type": "object",
      "properties": {
        "total_clientes": {
          "type": "number",
          "default": 0
        },
        "total_pedidos_mes": {
          "type": "number",
          "default": 0
        },
        "valor_vendido_mes": {
          "type": "number",
          "default": 0
        },
        "ticket_medio": {
          "type": "number",
          "default": 0
        },
        "tempo_medio_entrega_dias": {
          "type": "number",
          "default": 0
        },
        "taxa_sucesso_entregas_percentual": {
          "type": "number",
          "default": 100
        },
        "ultima_atualizacao_metricas": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ia_insights": {
      "type": "object",
      "properties": {
        "potencial_crescimento": {
          "type": "string",
          "enum": [
            "Baixo",
            "M\u00e9dio",
            "Alto",
            "Muito Alto"
          ]
        },
        "saturacao_mercado": {
          "type": "string",
          "enum": [
            "Baixa",
            "M\u00e9dia",
            "Alta"
          ]
        },
        "recomendacoes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "produtos_mais_vendidos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "produto_id": {
                "type": "string"
              },
              "descricao": {
                "type": "string"
              },
              "quantidade_vendida": {
                "type": "number"
              }
            }
          }
        },
        "ultima_analise_ia": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_regiao"
  ]
}