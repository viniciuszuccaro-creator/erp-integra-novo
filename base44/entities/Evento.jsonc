{
  "name": "Evento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa vinculada ao evento"
    },
    "titulo": {
      "type": "string",
      "description": "Título do evento"
    },
    "descricao": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Reunião",
        "Ligação",
        "Visita",
        "Tarefa",
        "Follow-up",
        "Evento",
        "Lembrete"
      ],
      "default": "Reunião"
    },
    "data_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de início"
    },
    "data_fim": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de fim"
    },
    "dia_inteiro": {
      "type": "boolean",
      "default": false
    },
    "local": {
      "type": "string"
    },
    "participantes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de participantes"
    },
    "responsavel": {
      "type": "string"
    },
    "responsavel_id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "fornecedor_id": {
      "type": "string"
    },
    "fornecedor_nome": {
      "type": "string"
    },
    "oportunidade_id": {
      "type": "string"
    },
    "pedido_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Agendado",
        "Confirmado",
        "Em Andamento",
        "Concluído",
        "Cancelado",
        "Adiado"
      ],
      "default": "Agendado"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Normal",
        "Alta",
        "Urgente"
      ],
      "default": "Normal"
    },
    "lembrete": {
      "type": "boolean",
      "default": true
    },
    "tempo_lembrete": {
      "type": "number",
      "description": "Minutos antes do evento",
      "default": 30
    },
    "recorrente": {
      "type": "boolean",
      "default": false
    },
    "frequencia_recorrencia": {
      "type": "string",
      "enum": [
        "Diária",
        "Semanal",
        "Quinzenal",
        "Mensal",
        "Anual"
      ]
    },
    "link_reuniao": {
      "type": "string",
      "description": "Link para reunião online"
    },
    "observacoes": {
      "type": "string"
    },
    "cor": {
      "type": "string",
      "description": "Cor do evento no calendário",
      "default": "#3b82f6"
    }
  },
  "required": [
    "titulo",
    "data_inicio",
    "data_fim"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}