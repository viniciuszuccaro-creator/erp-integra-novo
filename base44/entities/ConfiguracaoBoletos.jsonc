{
  "name": "ConfiguracaoBoletos",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico da configura\u00e7\u00e3o"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "Asaas",
        "Juno",
        "Mercado Pago",
        "PagSeguro",
        "Outro"
      ],
      "default": "Asaas",
      "description": "Provedor de boletos e PIX"
    },
    "api_url": {
      "type": "string",
      "description": "URL da API"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API"
    },
    "wallet_id": {
      "type": "string",
      "description": "ID da carteira/conta"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produ\u00e7\u00e3o",
        "Sandbox"
      ],
      "default": "Sandbox"
    },
    "gerar_boleto_automatico": {
      "type": "boolean",
      "default": false,
      "description": "Gera boleto automaticamente para novas contas a receber"
    },
    "gerar_pix_automatico": {
      "type": "boolean",
      "default": true,
      "description": "Gera PIX automaticamente"
    },
    "dias_vencimento_padrao": {
      "type": "number",
      "default": 3,
      "description": "Dias at\u00e9 vencimento (padr\u00e3o)"
    },
    "multa_percentual": {
      "type": "number",
      "default": 2,
      "description": "% de multa por atraso"
    },
    "juros_diario_percentual": {
      "type": "number",
      "default": 0.033,
      "description": "% de juros ao dia"
    },
    "desconto_antecipacao_percentual": {
      "type": "number",
      "default": 0,
      "description": "% desconto se pagar antes do vencimento"
    },
    "enviar_email_cobranca": {
      "type": "boolean",
      "default": true
    },
    "enviar_whatsapp_cobranca": {
      "type": "boolean",
      "default": true
    },
    "webhook_url": {
      "type": "string",
      "description": "URL para receber notifica\u00e7\u00f5es de pagamento"
    },
    "ultima_cobranca_gerada": {
      "type": "string",
      "format": "date-time"
    },
    "total_cobrangas_geradas": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "provedor"
  ]
}