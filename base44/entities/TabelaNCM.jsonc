{
  "name": "TabelaNCM",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do registro NCM"
    },
    "ncm": {
      "type": "string",
      "description": "Código NCM — único por grupo (8 dígitos)"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição do NCM — única por grupo"
    },
    "capitulo": {
      "type": "string",
      "description": "Capítulo (2 primeiros dígitos)"
    },
    "posicao": {
      "type": "string",
      "description": "Posição (4 primeiros dígitos)"
    },
    "unidade_tributavel": {
      "type": "string",
      "description": "Unidade tributável"
    },
    "ipi_aliquota": {
      "type": "number",
      "description": "Alíquota de IPI (%)",
      "default": 0
    },
    "icms_st_aliquota": {
      "type": "number",
      "description": "Alíquota de ICMS-ST (%)"
    },
    "icms_st_mva": {
      "type": "number",
      "description": "MVA - Margem de Valor Agregado (%)"
    },
    "pis_aliquota": {
      "type": "number",
      "description": "Alíquota de PIS (%)"
    },
    "cofins_aliquota": {
      "type": "number",
      "description": "Alíquota de COFINS (%)"
    },
    "cest": {
      "type": "string",
      "description": "Código CEST (se aplicável)"
    },
    "ex_tipi": {
      "type": "string",
      "description": "Código EX TIPI (exceção)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Matéria Prima",
        "Produto Acabado",
        "Insumo",
        "Equipamento",
        "Ferramenta",
        "Outro"
      ],
      "description": "Categoria do produto"
    },
    "tipo_item": {
      "type": "string",
      "enum": [
        "00 - Mercadoria para Revenda",
        "01 - Matéria-Prima",
        "02 - Embalagem",
        "03 - Produto em Processo",
        "04 - Produto Acabado",
        "05 - Subproduto",
        "06 - Produto Intermediário",
        "07 - Material de Uso e Consumo",
        "08 - Ativo Imobilizado",
        "09 - Serviços",
        "10 - Outros"
      ],
      "description": "Tipo de item (SPED)"
    },
    "gtin_ean": {
      "type": "string",
      "description": "Código GTIN/EAN (se aplicável)"
    },
    "origem_mercadoria": {
      "type": "string",
      "enum": [
        "0 - Nacional",
        "1 - Estrangeira Importação Direta",
        "2 - Estrangeira Mercado Interno"
      ],
      "default": "0 - Nacional",
      "description": "Origem da mercadoria"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o NCM está ativo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações sobre tributação"
    }
  },
  "required": [
    "ncm",
    "descricao"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}