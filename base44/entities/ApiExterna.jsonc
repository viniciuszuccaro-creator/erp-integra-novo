{
  "name": "ApiExterna",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo num\u00e9rico sequencial \u00fanico"
    },
    "nome_integracao": {
      "type": "string",
      "description": "Nome da integra\u00e7\u00e3o"
    },
    "tipo_api": {
      "type": "string",
      "enum": [
        "REST",
        "GraphQL",
        "SOAP",
        "Webhook"
      ],
      "default": "REST"
    },
    "descricao": {
      "type": "string"
    },
    "url_base": {
      "type": "string",
      "description": "URL base da API"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API"
    },
    "api_secret": {
      "type": "string",
      "description": "Secret da API"
    },
    "headers_autenticacao": {
      "type": "object",
      "description": "Headers de autentica\u00e7\u00e3o"
    },
    "timeout_segundos": {
      "type": "number",
      "default": 30
    },
    "ultima_requisicao": {
      "type": "string",
      "format": "date-time"
    },
    "total_requisicoes": {
      "type": "number",
      "default": 0
    },
    "total_erros": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_integracao",
    "tipo_api"
  ]
}