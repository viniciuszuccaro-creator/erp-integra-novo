{
  "name": "ImportacaoXMLNFe",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que importou"
    },
    "fornecedor_id": {
      "type": "string",
      "description": "ID do fornecedor emissor da NF-e"
    },
    "fornecedor_nome": {
      "type": "string",
      "description": "Nome do fornecedor (snapshot)"
    },
    "fornecedor_cnpj": {
      "type": "string",
      "description": "CNPJ do fornecedor (snapshot)"
    },
    "numero_nfe": {
      "type": "string",
      "description": "N\u00famero da NF-e"
    },
    "serie_nfe": {
      "type": "string",
      "description": "S\u00e9rie da NF-e"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso de 44 d\u00edgitos"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data de emiss\u00e3o da NF-e"
    },
    "data_importacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da importa\u00e7\u00e3o"
    },
    "natureza_operacao": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o da NF-e"
    },
    "valor_produtos": {
      "type": "number",
      "default": 0,
      "description": "Valor total dos produtos"
    },
    "valor_frete": {
      "type": "number",
      "default": 0,
      "description": "Valor do frete"
    },
    "valor_desconto": {
      "type": "number",
      "default": 0,
      "description": "Valor de desconto"
    },
    "valor_icms": {
      "type": "number",
      "default": 0,
      "description": "Valor ICMS"
    },
    "valor_ipi": {
      "type": "number",
      "default": 0,
      "description": "Valor IPI"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total da NF-e"
    },
    "xml_content": {
      "type": "string",
      "description": "Conte\u00fado completo do XML"
    },
    "xml_url": {
      "type": "string",
      "description": "URL do arquivo XML armazenado"
    },
    "status_processamento": {
      "type": "string",
      "enum": [
        "pendente",
        "processando",
        "processado",
        "erro",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status do processamento"
    },
    "qtd_itens": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens na NF-e"
    },
    "qtd_produtos_criados": {
      "type": "number",
      "default": 0,
      "description": "Quantos produtos novos foram criados"
    },
    "qtd_produtos_casados": {
      "type": "number",
      "default": 0,
      "description": "Quantos produtos foram casados com existentes"
    },
    "qtd_produtos_ignorados": {
      "type": "number",
      "default": 0,
      "description": "Quantos produtos foram ignorados"
    },
    "validacao_ia": {
      "type": "object",
      "properties": {
        "status_geral": {
          "type": "string",
          "enum": [
            "ok",
            "atencao",
            "bloqueante"
          ]
        },
        "score_confiabilidade": {
          "type": "number"
        },
        "alertas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tipo": {
                "type": "string"
              },
              "mensagem": {
                "type": "string"
              },
              "severidade": {
                "type": "string"
              }
            }
          }
        },
        "recomendacoes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "V21.0: Resultado da valida\u00e7\u00e3o IA Fiscal"
    },
    "movimentacoes_geradas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das movimenta\u00e7\u00f5es de estoque geradas"
    },
    "conta_pagar_id": {
      "type": "string",
      "description": "ID da conta a pagar gerada"
    },
    "ordem_compra_id": {
      "type": "string",
      "description": "ID da ordem de compra relacionada (se houver)"
    },
    "detalhes_processamento": {
      "type": "object",
      "properties": {
        "inicio": {
          "type": "string",
          "format": "date-time"
        },
        "fim": {
          "type": "string",
          "format": "date-time"
        },
        "duracao_segundos": {
          "type": "number"
        },
        "usuario": {
          "type": "string"
        },
        "erros": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Detalhes t\u00e9cnicos do processamento"
    },
    "itens_processados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero_item": {
            "type": "number"
          },
          "codigo_produto": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "valor_unitario": {
            "type": "number"
          },
          "valor_total": {
            "type": "number"
          },
          "acao_tomada": {
            "type": "string",
            "enum": [
              "casar_existente",
              "criar_novo",
              "ignorar"
            ]
          },
          "produto_id": {
            "type": "string"
          },
          "confianca_match": {
            "type": "number"
          }
        }
      },
      "description": "Detalhes dos itens processados"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "importado_por": {
      "type": "string",
      "description": "Email do usu\u00e1rio que importou"
    }
  },
  "required": [
    "numero_nfe",
    "chave_acesso",
    "valor_total",
    "empresa_id"
  ]
}