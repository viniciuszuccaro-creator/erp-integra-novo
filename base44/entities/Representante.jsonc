{
  "name": "Representante",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_dona_id": {
      "type": "string",
      "description": "Empresa que cadastrou o representante"
    },
    "empresas_compartilhadas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Empresas que podem usar este representante"
    },
    "tipo_representante": {
      "type": "string",
      "enum": [
        "Representante Comercial",
        "Construtor",
        "Arquiteto",
        "Engenheiro",
        "Influenciador",
        "Parceiro",
        "Outro"
      ],
      "default": "Representante Comercial",
      "description": "V21.5: Tipo de indicador para comiss\u00e3o/cashback"
    },
    "tipo_pessoa": {
      "type": "string",
      "enum": [
        "Pessoa F\u00edsica",
        "Pessoa Jur\u00eddica"
      ],
      "default": "Pessoa F\u00edsica"
    },
    "nome": {
      "type": "string",
      "description": "Nome do representante"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social (se PJ)"
    },
    "cpf": {
      "type": "string",
      "description": "CPF (se PF)"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ (se PJ)"
    },
    "crea_cau": {
      "type": "string",
      "description": "V21.5: CREA ou CAU (para engenheiros/arquitetos)"
    },
    "registro_profissional": {
      "type": "string",
      "description": "V21.5: N\u00famero de registro profissional"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telefone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "endereco": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        }
      }
    },
    "regioes_atendimento": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regi\u00f5es/cidades atendidas"
    },
    "tipo_comissao": {
      "type": "string",
      "enum": [
        "Percentual",
        "Valor Fixo por Venda",
        "Cashback Percentual",
        "Cashback Fixo",
        "Misto"
      ],
      "default": "Percentual",
      "description": "V21.5: Tipo de remunera\u00e7\u00e3o"
    },
    "percentual_comissao": {
      "type": "number",
      "default": 0,
      "description": "% de comiss\u00e3o padr\u00e3o sobre vendas"
    },
    "valor_fixo_comissao": {
      "type": "number",
      "default": 0,
      "description": "Valor fixo por venda indicada"
    },
    "percentual_cashback": {
      "type": "number",
      "default": 0,
      "description": "V21.5: % de cashback para construtores/arquitetos"
    },
    "limite_mensal_comissao": {
      "type": "number",
      "default": 0,
      "description": "V21.5: Limite m\u00e1ximo de comiss\u00e3o mensal (0 = sem limite)"
    },
    "clientes_vinculados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de clientes vinculados"
    },
    "clientes_indicados_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "V21.5: IDs de clientes que ele indicou"
    },
    "total_vendas_indicadas": {
      "type": "number",
      "default": 0,
      "description": "V21.5: Total de vendas das indica\u00e7\u00f5es (R$)"
    },
    "total_comissao_gerada": {
      "type": "number",
      "default": 0,
      "description": "V21.5: Total de comiss\u00e3o gerada (R$)"
    },
    "total_comissao_paga": {
      "type": "number",
      "default": 0,
      "description": "V21.5: Total j\u00e1 pago (R$)"
    },
    "total_comissao_pendente": {
      "type": "number",
      "default": 0,
      "description": "V21.5: Total pendente de pagamento (R$)"
    },
    "data_inicio_contrato": {
      "type": "string",
      "format": "date"
    },
    "data_fim_contrato": {
      "type": "string",
      "format": "date"
    },
    "forma_pagamento_comissao": {
      "type": "string",
      "enum": [
        "PIX",
        "Transfer\u00eancia",
        "Boleto",
        "Dinheiro",
        "Cr\u00e9dito em Conta"
      ],
      "default": "PIX",
      "description": "V21.5: Como prefere receber comiss\u00e3o"
    },
    "dados_bancarios": {
      "type": "object",
      "properties": {
        "banco": {
          "type": "string"
        },
        "agencia": {
          "type": "string"
        },
        "conta": {
          "type": "string"
        },
        "tipo_conta": {
          "type": "string",
          "enum": [
            "Corrente",
            "Poupan\u00e7a"
          ]
        },
        "pix_chave": {
          "type": "string"
        },
        "tipo_pix": {
          "type": "string",
          "enum": [
            "CPF",
            "CNPJ",
            "E-mail",
            "Telefone",
            "Aleat\u00f3ria"
          ]
        }
      },
      "description": "V21.5: Dados para pagamento de comiss\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo",
        "Suspenso"
      ],
      "default": "Ativo"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo_representante"
  ]
}