{
  "name": "LogPerformance",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da medição"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "query",
        "api_call",
        "page_load",
        "integration",
        "export",
        "import",
        "calculation",
        "other"
      ],
      "description": "Tipo de operação medida"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "Dashboard",
        "Comercial",
        "Financeiro",
        "Estoque",
        "Compras",
        "Expedicao",
        "Producao",
        "RH",
        "Fiscal",
        "CRM",
        "Relatorios",
        "Sistema",
        "Outro"
      ],
      "description": "Módulo do sistema"
    },
    "funcionalidade": {
      "type": "string",
      "description": "Funcionalidade específica (ex: listar_pedidos, criar_nfe)"
    },
    "duracao_ms": {
      "type": "number",
      "description": "Duração em milissegundos"
    },
    "duracao_segundos": {
      "type": "number",
      "description": "Duração em segundos (para facilitar queries)"
    },
    "query_sql": {
      "type": "string",
      "description": "Query SQL executada (se aplicável)"
    },
    "query_tipo": {
      "type": "string",
      "enum": [
        "SELECT",
        "INSERT",
        "UPDATE",
        "DELETE",
        "AGGREGATE",
        "JOIN"
      ],
      "description": "Tipo de query"
    },
    "entidade": {
      "type": "string",
      "description": "Entidade principal acessada"
    },
    "registros_afetados": {
      "type": "number",
      "description": "Quantidade de registros retornados/afetados"
    },
    "tamanho_resultado_kb": {
      "type": "number",
      "description": "Tamanho do resultado em KB"
    },
    "endpoint": {
      "type": "string",
      "description": "Endpoint da API (se for API call)"
    },
    "metodo_http": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH"
      ],
      "description": "Método HTTP"
    },
    "status_code": {
      "type": "number",
      "description": "Código de status HTTP"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usuário que executou"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usuário"
    },
    "sessao_id": {
      "type": "string",
      "description": "ID da sessão"
    },
    "ip_address": {
      "type": "string",
      "description": "IP do usuário"
    },
    "user_agent": {
      "type": "string",
      "description": "Navegador/dispositivo"
    },
    "memoria_usada_mb": {
      "type": "number",
      "description": "Memória usada na operação"
    },
    "cpu_percent": {
      "type": "number",
      "description": "% de CPU usado"
    },
    "cache_hit": {
      "type": "boolean",
      "description": "Se usou cache"
    },
    "cache_tipo": {
      "type": "string",
      "enum": [
        "memory",
        "redis",
        "database",
        "none"
      ],
      "description": "Tipo de cache usado"
    },
    "lento": {
      "type": "boolean",
      "default": false,
      "description": "Se foi considerado lento (> threshold)"
    },
    "threshold_ms": {
      "type": "number",
      "description": "Limite de tempo considerado normal"
    },
    "percentual_acima_threshold": {
      "type": "number",
      "description": "% acima do threshold"
    },
    "erro": {
      "type": "boolean",
      "default": false,
      "description": "Se houve erro"
    },
    "erro_mensagem": {
      "type": "string",
      "description": "Mensagem de erro"
    },
    "erro_stack": {
      "type": "string",
      "description": "Stack trace do erro"
    },
    "erro_tipo": {
      "type": "string",
      "enum": [
        "timeout",
        "database_error",
        "api_error",
        "validation_error",
        "business_logic",
        "network",
        "other"
      ],
      "description": "Tipo de erro"
    },
    "correlacao_id": {
      "type": "string",
      "description": "ID para correlacionar operações relacionadas"
    },
    "parent_operacao_id": {
      "type": "string",
      "description": "ID da operação pai (para tracing distribuído)"
    },
    "parametros": {
      "type": "object",
      "additionalProperties": true,
      "description": "Parâmetros da operação (filtros, IDs, etc)"
    },
    "metricas_adicionais": {
      "type": "object",
      "properties": {
        "tempo_db_ms": {
          "type": "number"
        },
        "tempo_network_ms": {
          "type": "number"
        },
        "tempo_processamento_ms": {
          "type": "number"
        },
        "queries_executadas": {
          "type": "number"
        },
        "cache_misses": {
          "type": "number"
        }
      },
      "description": "Métricas detalhadas"
    },
    "alerta_gerado": {
      "type": "boolean",
      "default": false,
      "description": "Se gerou alerta de performance"
    },
    "alerta_id": {
      "type": "string",
      "description": "ID do alerta gerado"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "producao",
        "homologacao",
        "desenvolvimento"
      ],
      "default": "producao",
      "description": "Ambiente onde ocorreu"
    },
    "versao_sistema": {
      "type": "string",
      "description": "Versão do sistema"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para categorização"
    }
  },
  "required": [
    "timestamp",
    "tipo_operacao",
    "modulo",
    "duracao_ms"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}