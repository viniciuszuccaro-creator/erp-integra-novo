{
  "name": "Empresa",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "codigo": {
      "type": "string",
      "description": "Código único da empresa"
    },
    "razao_social": {
      "type": "string",
      "description": "Razão social da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "inscricao_estadual": {
      "type": "string",
      "description": "Inscrição estadual"
    },
    "inscricao_municipal": {
      "type": "string",
      "description": "Inscrição municipal"
    },
    "regime_tributario": {
      "type": "string",
      "enum": [
        "Simples Nacional",
        "Lucro Presumido",
        "Lucro Real",
        "MEI"
      ],
      "default": "Simples Nacional",
      "description": "Regime tributário da empresa"
    },
    "regime_apuracao_impostos": {
      "type": "string",
      "enum": [
        "Mensal",
        "Trimestral",
        "Anual"
      ],
      "default": "Mensal",
      "description": "Regime de apuração de impostos"
    },
    "certificado_digital": {
      "type": "object",
      "properties": {
        "certificado_url": {
          "type": "string",
          "description": "URL do certificado digital (.pfx)"
        },
        "senha_certificado": {
          "type": "string",
          "description": "Senha do certificado (armazenada como segredo)"
        },
        "data_validade": {
          "type": "string",
          "format": "date",
          "description": "Data de validade do certificado"
        },
        "emissor": {
          "type": "string"
        }
      },
      "description": "Dados do certificado digital para NF-e"
    },
    "tipo_ambiente_fiscal": {
      "type": "string",
      "enum": [
        "Produção",
        "Homologação"
      ],
      "default": "Homologação",
      "description": "Ambiente fiscal (produção ou homologação)"
    },
    "endereco_fiscal_principal": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "pais": {
          "type": "string",
          "default": "Brasil"
        },
        "codigo_municipio_ibge": {
          "type": "string"
        }
      },
      "description": "Endereço fiscal principal"
    },
    "dados_contador": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string"
        },
        "crc": {
          "type": "string",
          "description": "CRC do contador"
        },
        "cpf_cnpj": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "telefone": {
          "type": "string"
        },
        "observacoes": {
          "type": "string"
        }
      },
      "description": "Dados do contador responsável"
    },
    "parametros_fiscais_proprios": {
      "type": "object",
      "properties": {
        "is_contribuinte_icms": {
          "type": "boolean",
          "default": true,
          "description": "Se é contribuinte de ICMS"
        },
        "is_simples_nacional": {
          "type": "boolean",
          "default": false,
          "description": "Se está no Simples Nacional"
        },
        "tem_substituicao_tributaria": {
          "type": "boolean",
          "default": false,
          "description": "Se opera com substituição tributária"
        },
        "estados_st": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Estados onde aplica ST"
        },
        "percentual_credito_simples": {
          "type": "number",
          "default": 0,
          "description": "% de crédito de ICMS no Simples"
        },
        "aliquota_interna_icms": {
          "type": "number",
          "description": "Alíquota interna de ICMS do estado"
        }
      },
      "description": "Parâmetros fiscais específicos da empresa"
    },
    "parametros_financeiros_proprios": {
      "type": "object",
      "properties": {
        "banco_principal_id": {
          "type": "string",
          "description": "ID do banco principal"
        },
        "conta_bancaria_principal_id": {
          "type": "string",
          "description": "ID da conta bancária principal"
        },
        "forma_recebimento_padrao_id": {
          "type": "string",
          "description": "ID da forma de recebimento padrão"
        },
        "tipo_cobranca_principal": {
          "type": "string",
          "enum": [
            "Boleto",
            "PIX",
            "Cartão",
            "Dinheiro",
            "Depósito"
          ],
          "default": "Boleto"
        },
        "prazo_pagamento_padrao_dias": {
          "type": "number",
          "default": 30
        }
      },
      "description": "Parâmetros financeiros específicos da empresa"
    },
    "locais_estoque_vinculados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos locais de estoque vinculados a esta empresa"
    },
    "usa_multiempresa": {
      "type": "boolean",
      "default": false,
      "description": "Se esta empresa opera em modo multiempresa"
    },
    "empresas_compartilhamento": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de outras empresas com as quais compartilha dados"
    },
    "logo_url": {
      "type": "string",
      "description": "URL da logo da empresa"
    },
    "cor_primaria": {
      "type": "string",
      "description": "Cor primária da empresa (hex)"
    },
    "cor_secundaria": {
      "type": "string",
      "description": "Cor secundária da empresa (hex)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativa",
        "Inativa",
        "Suspensa"
      ],
      "default": "Ativa"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "razao_social",
    "cnpj",
    "regime_tributario"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}