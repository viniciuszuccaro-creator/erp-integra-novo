{
  "name": "SetorAtividade",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do setor"
    },
    "nome": {
      "type": "string",
      "description": "Nome do setor — único por grupo"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "Revenda",
        "Produção",
        "Serviço",
        "Consumo Interno",
        "Logística"
      ],
      "default": "Revenda"
    },
    "icone": {
      "type": "string"
    },
    "cor": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}