{
  "name": "ConfiguracaoBackup",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (null se configura\u00e7\u00e3o do grupo)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o backup autom\u00e1tico est\u00e1 ativo"
    },
    "frequencia": {
      "type": "string",
      "enum": [
        "Di\u00e1rio",
        "Semanal",
        "Quinzenal",
        "Mensal"
      ],
      "default": "Di\u00e1rio",
      "description": "Frequ\u00eancia dos backups"
    },
    "horario_execucao": {
      "type": "string",
      "default": "02:00",
      "description": "Hor\u00e1rio de execu\u00e7\u00e3o (HH:MM)"
    },
    "dia_semana": {
      "type": "string",
      "enum": [
        "Domingo",
        "Segunda",
        "Ter\u00e7a",
        "Quarta",
        "Quinta",
        "Sexta",
        "S\u00e1bado"
      ],
      "description": "Dia da semana (se frequ\u00eancia semanal)"
    },
    "dia_mes": {
      "type": "number",
      "description": "Dia do m\u00eas (1-31) se frequ\u00eancia mensal",
      "minimum": 1,
      "maximum": 31
    },
    "tipo_backup_padrao": {
      "type": "string",
      "enum": [
        "Completo",
        "Incremental",
        "Diferencial"
      ],
      "default": "Completo",
      "description": "Tipo padr\u00e3o de backup"
    },
    "backup_completo_frequencia": {
      "type": "string",
      "enum": [
        "Semanal",
        "Quinzenal",
        "Mensal"
      ],
      "default": "Semanal",
      "description": "Frequ\u00eancia de backups completos (se usar incrementais)"
    },
    "retencao_dias": {
      "type": "number",
      "default": 30,
      "description": "Dias de reten\u00e7\u00e3o dos backups"
    },
    "retencao_backups_completos": {
      "type": "number",
      "default": 4,
      "description": "Quantidade de backups completos a manter"
    },
    "retencao_backups_incrementais": {
      "type": "number",
      "default": 30,
      "description": "Quantidade de backups incrementais a manter"
    },
    "provider_storage": {
      "type": "string",
      "enum": [
        "Base44 Cloud",
        "AWS S3",
        "Google Cloud Storage",
        "Azure Blob",
        "Local"
      ],
      "default": "Base44 Cloud",
      "description": "Provedor de armazenamento"
    },
    "aws_s3_config": {
      "type": "object",
      "properties": {
        "bucket_name": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "access_key_id": {
          "type": "string"
        },
        "secret_access_key": {
          "type": "string"
        },
        "storage_class": {
          "type": "string",
          "enum": [
            "STANDARD",
            "GLACIER",
            "DEEP_ARCHIVE"
          ],
          "default": "STANDARD"
        }
      },
      "description": "Configura\u00e7\u00e3o AWS S3"
    },
    "google_cloud_config": {
      "type": "object",
      "properties": {
        "bucket_name": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "credentials_json": {
          "type": "string"
        },
        "storage_class": {
          "type": "string",
          "enum": [
            "STANDARD",
            "NEARLINE",
            "COLDLINE",
            "ARCHIVE"
          ],
          "default": "STANDARD"
        }
      },
      "description": "Configura\u00e7\u00e3o Google Cloud Storage"
    },
    "azure_blob_config": {
      "type": "object",
      "properties": {
        "account_name": {
          "type": "string"
        },
        "account_key": {
          "type": "string"
        },
        "container_name": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "Hot",
            "Cool",
            "Archive"
          ],
          "default": "Cool"
        }
      },
      "description": "Configura\u00e7\u00e3o Azure Blob Storage"
    },
    "criptografia_ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se criptografa os backups"
    },
    "algoritmo_criptografia": {
      "type": "string",
      "default": "AES-256-GCM",
      "description": "Algoritmo de criptografia"
    },
    "chave_criptografia": {
      "type": "string",
      "description": "Chave de criptografia (armazenada criptografada)"
    },
    "compressao_ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se comprime os backups"
    },
    "algoritmo_compressao": {
      "type": "string",
      "default": "gzip",
      "enum": [
        "gzip",
        "bzip2",
        "lz4",
        "zstd"
      ],
      "description": "Algoritmo de compress\u00e3o"
    },
    "nivel_compressao": {
      "type": "number",
      "default": 6,
      "minimum": 1,
      "maximum": 9,
      "description": "N\u00edvel de compress\u00e3o (1-9)"
    },
    "modulos_incluir": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "M\u00f3dulos a incluir (vazio = todos)",
      "default": []
    },
    "modulos_excluir": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "M\u00f3dulos a excluir",
      "default": []
    },
    "incluir_anexos": {
      "type": "boolean",
      "default": true,
      "description": "Se inclui arquivos anexados (PDFs, imagens, etc.)"
    },
    "incluir_logs": {
      "type": "boolean",
      "default": false,
      "description": "Se inclui logs de auditoria"
    },
    "incluir_configuracoes": {
      "type": "boolean",
      "default": true,
      "description": "Se inclui configura\u00e7\u00f5es do sistema"
    },
    "notificar_email": {
      "type": "boolean",
      "default": true,
      "description": "Se envia e-mail ao concluir"
    },
    "emails_notificacao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "E-mails para notifica\u00e7\u00e3o",
      "default": []
    },
    "notificar_apenas_erro": {
      "type": "boolean",
      "default": false,
      "description": "Notificar apenas em caso de erro"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL de webhook para notifica\u00e7\u00f5es"
    },
    "webhook_token": {
      "type": "string",
      "description": "Token de seguran\u00e7a do webhook"
    },
    "validar_integridade": {
      "type": "boolean",
      "default": true,
      "description": "Se valida integridade ap\u00f3s backup"
    },
    "testar_restauracao": {
      "type": "boolean",
      "default": false,
      "description": "Se testa restaura\u00e7\u00e3o automaticamente"
    },
    "replicacao_geografica": {
      "type": "boolean",
      "default": false,
      "description": "Se replica para m\u00faltiplas regi\u00f5es"
    },
    "regioes_replicacao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regi\u00f5es para replica\u00e7\u00e3o (us-east-1, sa-east-1, etc.)"
    },
    "ultimo_backup_id": {
      "type": "string",
      "description": "ID do \u00faltimo backup executado"
    },
    "ultimo_backup_sucesso": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo backup bem-sucedido"
    },
    "ultimo_backup_erro": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo erro"
    },
    "total_backups_executados": {
      "type": "number",
      "default": 0,
      "description": "Total de backups executados"
    },
    "total_backups_sucesso": {
      "type": "number",
      "default": 0,
      "description": "Total de backups bem-sucedidos"
    },
    "total_backups_erro": {
      "type": "number",
      "default": 0,
      "description": "Total de backups com erro"
    },
    "taxa_sucesso_percentual": {
      "type": "number",
      "description": "% de taxa de sucesso"
    },
    "espaco_total_usado_gb": {
      "type": "number",
      "default": 0,
      "description": "Espa\u00e7o total usado em GB"
    },
    "proximo_backup_agendado": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do pr\u00f3ximo backup agendado"
    },
    "configurado_por": {
      "type": "string",
      "description": "Usu\u00e1rio que configurou"
    },
    "configurado_por_id": {
      "type": "string"
    },
    "data_configuracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da configura\u00e7\u00e3o"
    },
    "historico_alteracoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          },
          "campo": {
            "type": "string"
          },
          "valor_anterior": {
            "type": "string"
          },
          "valor_novo": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de altera\u00e7\u00f5es na configura\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a configura\u00e7\u00e3o"
    }
  },
  "required": [
    "ativo",
    "frequencia",
    "horario_execucao",
    "provider_storage"
  ]
}