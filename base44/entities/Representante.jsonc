{
  "name": "Representante",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro \u00fanico compartilhado no grupo)"
    },
    "empresa_dona_id": {
      "type": "string"
    },
    "empresas_compartilhadas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico do representante"
    },
    "tipo_representante": {
      "type": "string",
      "enum": [
        "Representante Comercial",
        "Construtor",
        "Arquiteto",
        "Engenheiro",
        "Influenciador",
        "Parceiro",
        "Outro"
      ],
      "default": "Representante Comercial"
    },
    "tipo_pessoa": {
      "type": "string",
      "enum": [
        "Pessoa F\u00edsica",
        "Pessoa Jur\u00eddica"
      ],
      "default": "Pessoa F\u00edsica"
    },
    "nome": {
      "type": "string",
      "description": "Nome completo do representante \u2014 \u00fanico por grupo"
    },
    "razao_social": {
      "type": "string"
    },
    "cpf": {
      "type": "string",
      "description": "CPF \u00fanico do representante"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ \u00fanico do representante"
    },
    "crea_cau": {
      "type": "string"
    },
    "registro_profissional": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telefone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "endereco": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        }
      }
    },
    "regioes_atendimento": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tipo_comissao": {
      "type": "string",
      "enum": [
        "Percentual",
        "Valor Fixo por Venda",
        "Cashback Percentual",
        "Cashback Fixo",
        "Misto"
      ],
      "default": "Percentual"
    },
    "percentual_comissao": {
      "type": "number",
      "default": 0
    },
    "valor_fixo_comissao": {
      "type": "number",
      "default": 0
    },
    "percentual_cashback": {
      "type": "number",
      "default": 0
    },
    "limite_mensal_comissao": {
      "type": "number",
      "default": 0
    },
    "clientes_vinculados": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clientes_indicados_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_vendas_indicadas": {
      "type": "number",
      "default": 0
    },
    "total_comissao_gerada": {
      "type": "number",
      "default": 0
    },
    "total_comissao_paga": {
      "type": "number",
      "default": 0
    },
    "total_comissao_pendente": {
      "type": "number",
      "default": 0
    },
    "data_inicio_contrato": {
      "type": "string",
      "format": "date"
    },
    "data_fim_contrato": {
      "type": "string",
      "format": "date"
    },
    "forma_pagamento_comissao": {
      "type": "string",
      "enum": [
        "PIX",
        "Transfer\u00eancia",
        "Boleto",
        "Dinheiro",
        "Cr\u00e9dito em Conta"
      ],
      "default": "PIX"
    },
    "dados_bancarios": {
      "type": "object",
      "properties": {
        "banco": {
          "type": "string"
        },
        "agencia": {
          "type": "string"
        },
        "conta": {
          "type": "string"
        },
        "tipo_conta": {
          "type": "string",
          "enum": [
            "Corrente",
            "Poupan\u00e7a"
          ]
        },
        "pix_chave": {
          "type": "string"
        },
        "tipo_pix": {
          "type": "string",
          "enum": [
            "CPF",
            "CNPJ",
            "E-mail",
            "Telefone",
            "Aleat\u00f3ria"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo",
        "Suspenso"
      ],
      "default": "Ativo"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo_representante"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}