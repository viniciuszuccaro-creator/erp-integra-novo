{
  "name": "AuditoriaAcesso",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usuário"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usuário"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usuário"
    },
    "tipo_acao": {
      "type": "string",
      "enum": [
        "Login",
        "Logout",
        "Troca Empresa",
        "Troca Contexto",
        "Acesso Negado",
        "Tentativa Falha",
        "MFA Enviado",
        "MFA Validado",
        "Sessão Expirada"
      ],
      "description": "Tipo de ação de acesso"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa acessada"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "contexto": {
      "type": "string",
      "enum": [
        "empresa",
        "grupo"
      ],
      "description": "Contexto selecionado"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do acesso"
    },
    "ip_address": {
      "type": "string",
      "description": "Endereço IP"
    },
    "ip_localizacao": {
      "type": "string",
      "description": "Localização geográfica do IP (cidade/estado/país)"
    },
    "user_agent": {
      "type": "string",
      "description": "Navegador e dispositivo"
    },
    "dispositivo_tipo": {
      "type": "string",
      "enum": [
        "Desktop",
        "Mobile",
        "Tablet",
        "Desconhecido"
      ],
      "description": "Tipo de dispositivo"
    },
    "sistema_operacional": {
      "type": "string",
      "description": "Sistema operacional detectado"
    },
    "navegador": {
      "type": "string",
      "description": "Navegador utilizado"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude (se permitido pelo usuário)"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude (se permitido pelo usuário)"
    },
    "sucesso": {
      "type": "boolean",
      "default": true,
      "description": "Se a ação foi bem-sucedida"
    },
    "motivo_falha": {
      "type": "string",
      "description": "Motivo da falha (senha incorreta, sem permissão, etc.)"
    },
    "tentativas_falhas_consecutivas": {
      "type": "number",
      "default": 0,
      "description": "Número de tentativas falhas consecutivas"
    },
    "bloqueado_temporariamente": {
      "type": "boolean",
      "default": false,
      "description": "Se o usuário foi bloqueado por tentativas excessivas"
    },
    "duracao_sessao_segundos": {
      "type": "number",
      "description": "Duração da sessão em segundos (para logout)"
    },
    "mfa_utilizado": {
      "type": "boolean",
      "default": false,
      "description": "Se utilizou autenticação de dois fatores"
    },
    "mfa_metodo": {
      "type": "string",
      "enum": [
        "Email",
        "WhatsApp",
        "SMS",
        "Authenticator"
      ],
      "description": "Método de MFA utilizado"
    },
    "url_destino": {
      "type": "string",
      "description": "URL acessada após login/troca"
    },
    "contexto_anterior": {
      "type": "object",
      "properties": {
        "empresa_id": {
          "type": "string"
        },
        "empresa_nome": {
          "type": "string"
        },
        "contexto": {
          "type": "string"
        }
      },
      "description": "Contexto anterior (em trocas de empresa)"
    },
    "dados_extras": {
      "type": "object",
      "additionalProperties": true,
      "description": "Dados adicionais de contexto"
    }
  },
  "required": [
    "usuario_id",
    "tipo_acao",
    "data_hora",
    "ip_address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}