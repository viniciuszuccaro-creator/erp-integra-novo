{
  "name": "IAConfig",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se configuração específica)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da configuração de IA"
    },
    "chave": {
      "type": "string",
      "description": "Chave única da configuração"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "Comercial",
        "Producao",
        "Logistica",
        "Financeiro",
        "CRM",
        "Estoque",
        "Geral"
      ],
      "description": "Módulo que usa esta IA"
    },
    "funcionalidade": {
      "type": "string",
      "description": "Ex: leitura_projeto, upsell, refugo, roteirizacao"
    },
    "objetivo": {
      "type": "string",
      "description": "Vol 19.1: Objetivo claro da IA — o que ela faz e por quê"
    },
    "dados_usados": {
      "type": "string",
      "description": "Vol 19.1: Descrição dos dados consumidos pela IA"
    },
    "limites": {
      "type": "string",
      "description": "Vol 19.1: O que a IA NÃO pode fazer (limites explícitos)"
    },
    "periodicidade": {
      "type": "string",
      "enum": [
        "Tempo Real",
        "Por Evento",
        "Horária",
        "Diária",
        "Semanal",
        "Mensal",
        "Sob Demanda"
      ],
      "default": "Sob Demanda",
      "description": "Vol 19.1: Periodicidade de execução"
    },
    "acao_permitida": {
      "type": "string",
      "enum": [
        "Sugerir",
        "Classificar",
        "Resumir",
        "Prever",
        "Detectar Anomalia",
        "Automatizar (com aprovação)",
        "Automatizar (sem aprovação)"
      ],
      "default": "Sugerir",
      "description": "Vol 19.1: Nível máximo de ação permitida à IA"
    },
    "risco_nivel": {
      "type": "string",
      "enum": [
        "Baixo",
        "Médio",
        "Alto",
        "Crítico"
      ],
      "default": "Médio",
      "description": "Vol 19.1: Nível de risco associado a esta IA"
    },
    "explicacao_habilitada": {
      "type": "boolean",
      "default": true,
      "description": "Vol 19.1: Se a IA deve fornecer explicação para suas sugestões"
    },
    "aprovacao_humana_obrigatoria": {
      "type": "boolean",
      "default": true,
      "description": "Vol 19.1: Se decisões críticas exigem aprovação humana antes de executar"
    },
    "responsavel": {
      "type": "string",
      "description": "Vol 19.1: Nome do responsável por esta IA"
    },
    "responsavel_id": {
      "type": "string",
      "description": "Vol 19.1: ID do usuário responsável"
    },
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA está ativa"
    },
    "modo_treinamento": {
      "type": "boolean",
      "default": false,
      "description": "Se está em modo de treinamento"
    },
    "modelo_base": {
      "type": "string",
      "description": "Nome do modelo (GPT-4, GPT-4o, Custom)",
      "default": "GPT-4o"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "OpenAI",
        "Azure OpenAI",
        "Custom",
        "Local"
      ],
      "default": "OpenAI"
    },
    "endpoint_url": {
      "type": "string",
      "description": "URL do endpoint da IA"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API"
    },
    "limite_tokens": {
      "type": "number",
      "default": 8192,
      "description": "Limite de tokens por requisição"
    },
    "confianca_minima": {
      "type": "number",
      "default": 75,
      "description": "% mínimo de confiança para aceitar resultado"
    },
    "temperatura": {
      "type": "number",
      "default": 0.7,
      "description": "Temperatura do modelo (0-1)"
    },
    "timeout_segundos": {
      "type": "number",
      "default": 60,
      "description": "Timeout da requisição"
    },
    "empresas_habilitadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vol 19.1: Opt-in por empresa — IDs das empresas autorizadas"
    },
    "usuarios_autorizados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos usuários autorizados"
    },
    "configuracoes_especificas": {
      "type": "object",
      "additionalProperties": true,
      "description": "Configurações específicas por funcionalidade"
    },
    "total_execucoes": {
      "type": "number",
      "default": 0,
      "description": "Total de execuções"
    },
    "total_sucesso": {
      "type": "number",
      "default": 0,
      "description": "Total de execuções bem-sucedidas"
    },
    "total_erro": {
      "type": "number",
      "default": 0,
      "description": "Total de erros"
    },
    "taxa_sucesso_percentual": {
      "type": "number",
      "description": "% de taxa de sucesso"
    },
    "custo_total_estimado": {
      "type": "number",
      "default": 0,
      "description": "Custo total estimado de uso da IA"
    },
    "ultima_execucao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da última execução"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "chave",
    "modulo",
    "funcionalidade"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}