{
  "name": "ChatbotInteracao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "sessao_id": {
      "type": "string",
      "description": "ID único da sessão de chat"
    },
    "canal": {
      "type": "string",
      "enum": [
        "WhatsApp",
        "Portal",
        "Site",
        "App",
        "Telegram",
        "Messenger",
        "Instagram"
      ],
      "description": "Canal de origem"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente (se autenticado)"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "contato_pendente_cadastro": {
      "type": "boolean",
      "default": false,
      "description": "Vol 15.1: Se o contato ainda não foi cadastrado no CRM"
    },
    "autenticado": {
      "type": "boolean",
      "default": false,
      "description": "Se o cliente está autenticado"
    },
    "mensagem_usuario": {
      "type": "string",
      "description": "Mensagem enviada pelo usuário"
    },
    "intent_detectado": {
      "type": "string",
      "description": "Intent identificado pela IA"
    },
    "confianca_intent": {
      "type": "number",
      "description": "% de confiança na detecção (0-100)"
    },
    "requer_autenticacao": {
      "type": "boolean",
      "default": false
    },
    "autenticacao_solicitada": {
      "type": "boolean",
      "default": false
    },
    "resposta_bot": {
      "type": "string",
      "description": "Resposta gerada pelo bot"
    },
    "acao_executada": {
      "type": "string",
      "enum": [
        "nenhuma",
        "consultar_boleto",
        "consultar_pedido",
        "criar_orcamento",
        "falar_vendedor",
        "consultar_estoque",
        "enviar_boleto",
        "enviar_pix",
        "enviar_link_pagamento",
        "enviar_documento",
        "criar_chamado",
        "criar_lead"
      ],
      "default": "nenhuma",
      "description": "Vol 15.2/15.3: Ação automática executada pelo bot"
    },
    "oportunidade_gerada_id": {
      "type": "string",
      "description": "Vol 15.3: ID da oportunidade CRM gerada (Lead alimenta CRM)"
    },
    "pedido_gerado_id": {
      "type": "string",
      "description": "Vol 15.3: ID do pedido gerado a partir da conversa"
    },
    "chamado_gerado_id": {
      "type": "string",
      "description": "Vol 15.3: ID do chamado gerado (Ocorrência cria chamado)"
    },
    "sentimento_detectado": {
      "type": "string",
      "enum": [
        "Positivo",
        "Neutro",
        "Frustrado",
        "Urgente"
      ],
      "description": "Sentimento da mensagem"
    },
    "palavras_chave_sentimento": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palavras que indicaram o sentimento"
    },
    "transferido_atendente": {
      "type": "boolean",
      "default": false,
      "description": "Se foi transferido para atendente humano"
    },
    "motivo_transferencia": {
      "type": "string",
      "enum": [
        "solicitado_usuario",
        "risco_detectado",
        "frustracao",
        "regra_intencao",
        "limite_tentativas",
        "manual"
      ],
      "description": "Vol 15.2: Motivo da transferência para humano"
    },
    "vendedor_notificado_id": {
      "type": "string",
      "description": "ID do vendedor notificado (transbordo)"
    },
    "fila_atendimento": {
      "type": "string",
      "enum": [
        "nao_atribuida",
        "pendente",
        "em_atendimento",
        "aguardando_cliente",
        "encerrada",
        "escalada"
      ],
      "default": "nao_atribuida",
      "description": "Vol 15.1: Status da conversa na inbox unificada"
    },
    "atendente_id": {
      "type": "string",
      "description": "Vol 15.1: ID do atendente humano responsável"
    },
    "sla_minutos": {
      "type": "number",
      "description": "Vol 15.4: SLA de resposta em minutos"
    },
    "data_primeira_resposta": {
      "type": "string",
      "format": "date-time",
      "description": "Vol 15.4: Quando o atendente respondeu pela primeira vez"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "sessao_id",
    "canal",
    "mensagem_usuario"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}