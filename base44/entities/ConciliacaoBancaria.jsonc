{
  "name": "ConciliacaoBancaria",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "extrato_bancario_id": {
      "type": "string",
      "description": "ID do extrato bancário"
    },
    "movimento_caixa_id": {
      "type": "string",
      "description": "ID do movimento de caixa vinculado"
    },
    "data_conciliacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da conciliação"
    },
    "valor_extrato": {
      "type": "number",
      "description": "Valor no extrato bancário"
    },
    "valor_movimento": {
      "type": "number",
      "description": "Valor no movimento do caixa"
    },
    "valor_diferenca": {
      "type": "number",
      "default": 0,
      "description": "Diferença entre extrato e movimento"
    },
    "tem_divergencia": {
      "type": "boolean",
      "default": false,
      "description": "Se há divergência de valor"
    },
    "tipo_divergencia": {
      "type": "string",
      "enum": [
        "Valor Diferente",
        "Data Diferente",
        "Tarifa Bancária",
        "Taxa Gateway",
        "Outro"
      ],
      "description": "Tipo de divergência encontrada"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "conciliado",
        "divergente",
        "resolvido",
        "desfeito"
      ],
      "default": "pendente"
    },
    "conciliado_por_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se foi conciliado automaticamente pela IA"
    },
    "score_confianca_ia": {
      "type": "number",
      "default": 0,
      "description": "Score de confiança da IA (0-100)"
    },
    "responsavel_conciliacao": {
      "type": "string",
      "description": "Usuário que realizou a conciliação"
    },
    "responsavel_id": {
      "type": "string"
    },
    "desfeito": {
      "type": "boolean",
      "default": false,
      "description": "Vol 10.4: Se a conciliação foi desfeita"
    },
    "data_desfazer": {
      "type": "string",
      "format": "date-time",
      "description": "Vol 10.4: Data/hora do desfazimento"
    },
    "justificativa_desfazer": {
      "type": "string",
      "description": "Vol 10.4: Justificativa obrigatória para desfazer conciliação"
    },
    "responsavel_desfazer": {
      "type": "string",
      "description": "Vol 10.4: Usuário que desfez a conciliação"
    },
    "responsavel_desfazer_id": {
      "type": "string",
      "description": "Vol 10.4: ID do usuário que desfez"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "data_conciliacao"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}