{
  "name": "InspecaoQualidade",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa respons\u00e1vel"
    },
    "op_id": {
      "type": "string",
      "description": "ID da Ordem de Produ\u00e7\u00e3o"
    },
    "numero_op": {
      "type": "string",
      "description": "N\u00famero da OP inspecionada"
    },
    "item_op_id": {
      "type": "string",
      "description": "ID do item espec\u00edfico da OP (se houver)"
    },
    "item_elemento": {
      "type": "string",
      "description": "C\u00f3digo do elemento (V1, C2, B1...)"
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do pedido vinculado"
    },
    "numero_pedido": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "numero_inspecao": {
      "type": "string",
      "description": "N\u00famero sequencial da inspe\u00e7\u00e3o"
    },
    "data_inspecao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da inspe\u00e7\u00e3o"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do colaborador inspetor"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do inspetor"
    },
    "setor": {
      "type": "string",
      "enum": [
        "Corte",
        "Dobra",
        "Montagem",
        "Arma\u00e7\u00e3o",
        "Acabamento",
        "Final"
      ],
      "description": "Setor onde foi inspecionado"
    },
    "tipo_producao": {
      "type": "string",
      "enum": [
        "corte_dobra",
        "armado",
        "bloco",
        "sapata",
        "estaca",
        "outro"
      ],
      "description": "Tipo de produ\u00e7\u00e3o inspecionada"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "Aprovado",
        "Reprovado",
        "Revisar",
        "Aprovado com Ressalva"
      ],
      "default": "Aprovado",
      "description": "Resultado final da inspe\u00e7\u00e3o"
    },
    "motivo_reprovacao": {
      "type": "string",
      "description": "Motivo da reprova\u00e7\u00e3o (obrigat\u00f3rio se reprovado)"
    },
    "observacao_geral": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais da inspe\u00e7\u00e3o"
    },
    "foto_inspecao_url": {
      "type": "string",
      "description": "URL da foto principal"
    },
    "fotos_adicionais": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Fotos adicionais da inspe\u00e7\u00e3o"
    },
    "assinatura_responsavel_url": {
      "type": "string",
      "description": "URL da assinatura digital do inspetor"
    },
    "tempo_inspecao_min": {
      "type": "number",
      "description": "Tempo gasto na inspe\u00e7\u00e3o (minutos)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Em Inspe\u00e7\u00e3o",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Aberto"
    },
    "checklist_corte_dobra": {
      "type": "object",
      "properties": {
        "bitola_conforme": {
          "type": "boolean",
          "default": false
        },
        "bitola_medida_mm": {
          "type": "number"
        },
        "bitola_variacao_mm": {
          "type": "number"
        },
        "comprimento_conforme": {
          "type": "boolean",
          "default": false
        },
        "comprimento_medido_mm": {
          "type": "number"
        },
        "comprimento_variacao_mm": {
          "type": "number"
        },
        "dobra_conforme": {
          "type": "boolean",
          "default": false
        },
        "angulo_dobra_medido": {
          "type": "number"
        },
        "angulo_dobra_variacao": {
          "type": "number"
        },
        "perda_percentual": {
          "type": "number"
        },
        "perda_conforme": {
          "type": "boolean",
          "default": false
        },
        "estribos_conformes": {
          "type": "boolean",
          "default": false
        },
        "acabamento_ok": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Checklist espec\u00edfico para corte e dobra"
    },
    "checklist_armado": {
      "type": "object",
      "properties": {
        "bitola_principal_ok": {
          "type": "boolean",
          "default": false
        },
        "bitola_estribo_ok": {
          "type": "boolean",
          "default": false
        },
        "espacamento_estribo_mm": {
          "type": "number"
        },
        "espacamento_conforme": {
          "type": "boolean",
          "default": false
        },
        "dimensoes_largura_mm": {
          "type": "number"
        },
        "dimensoes_altura_mm": {
          "type": "number"
        },
        "dimensoes_conformes": {
          "type": "boolean",
          "default": false
        },
        "peso_medido_kg": {
          "type": "number"
        },
        "peso_diferenca_percent": {
          "type": "number"
        },
        "peso_conforme": {
          "type": "boolean",
          "default": false
        },
        "integridade_visual_ok": {
          "type": "boolean",
          "default": false
        },
        "amarracao_arame_ok": {
          "type": "boolean",
          "default": false
        },
        "reforcos_ok": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Checklist espec\u00edfico para arma\u00e7\u00e3o"
    },
    "checklist_bloco": {
      "type": "object",
      "properties": {
        "dimensao_total_ok": {
          "type": "boolean",
          "default": false
        },
        "dimensao_medida_comprimento": {
          "type": "number"
        },
        "dimensao_medida_largura": {
          "type": "number"
        },
        "dimensao_medida_altura": {
          "type": "number"
        },
        "ferros_lado1_ok": {
          "type": "boolean",
          "default": false
        },
        "ferros_lado2_ok": {
          "type": "boolean",
          "default": false
        },
        "quantidade_ferros_lado1": {
          "type": "number"
        },
        "quantidade_ferros_lado2": {
          "type": "number"
        },
        "costelas_ok": {
          "type": "boolean",
          "default": false
        },
        "estribos_automaticos_ok": {
          "type": "boolean",
          "default": false
        },
        "esquadro_ok": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Checklist espec\u00edfico para blocos"
    },
    "medicoes_realizadas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string"
          },
          "valor_esperado": {
            "type": "number"
          },
          "valor_medido": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "variacao": {
            "type": "number"
          },
          "conforme": {
            "type": "boolean"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Medi\u00e7\u00f5es detalhadas realizadas"
    },
    "ia_verificacao": {
      "type": "object",
      "properties": {
        "ativa": {
          "type": "boolean",
          "default": false
        },
        "foto_analisada_url": {
          "type": "string"
        },
        "data_analise": {
          "type": "string",
          "format": "date-time"
        },
        "resultado_bitola": {
          "type": "string"
        },
        "resultado_medidas": {
          "type": "object"
        },
        "confianca_percent": {
          "type": "number"
        },
        "aprovado_ia": {
          "type": "boolean"
        },
        "requer_validacao_humana": {
          "type": "boolean",
          "default": true
        },
        "observacoes_ia": {
          "type": "string"
        }
      },
      "description": "Resultado da verifica\u00e7\u00e3o por IA (preparado)"
    },
    "nao_conformidades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Bitola Errada",
              "Medida Fora do Padr\u00e3o",
              "Dobra Incorreta",
              "Falta Estribo",
              "Espa\u00e7amento Errado",
              "Peso Divergente",
              "Defeito Visual",
              "Outro"
            ]
          },
          "gravidade": {
            "type": "string",
            "enum": [
              "Baixa",
              "M\u00e9dia",
              "Alta",
              "Cr\u00edtica"
            ],
            "default": "M\u00e9dia"
          },
          "descricao": {
            "type": "string"
          },
          "acao_corretiva": {
            "type": "string"
          },
          "responsavel_correcao": {
            "type": "string"
          },
          "prazo_correcao": {
            "type": "string",
            "format": "date"
          },
          "corrigido": {
            "type": "boolean",
            "default": false
          },
          "data_correcao": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Lista de n\u00e3o conformidades detectadas"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Quem aprovou (se diferente do inspetor)"
    },
    "aprovado_por_id": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time"
    },
    "reprovado_por": {
      "type": "string"
    },
    "reprovado_por_id": {
      "type": "string"
    },
    "data_reprovacao": {
      "type": "string",
      "format": "date-time"
    },
    "reinspecao": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 uma reinspe\u00e7\u00e3o de item reprovado"
    },
    "inspecao_anterior_id": {
      "type": "string",
      "description": "ID da inspe\u00e7\u00e3o anterior (se for reinspe\u00e7\u00e3o)"
    },
    "historico_reinspecoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "resultado": {
            "type": "string"
          },
          "responsavel": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de reinspe\u00e7\u00f5es"
    },
    "liberar_para_expedicao": {
      "type": "boolean",
      "default": false,
      "description": "Se deve liberar automaticamente para expedi\u00e7\u00e3o"
    },
    "expedicao_liberada": {
      "type": "boolean",
      "default": false
    },
    "data_liberacao_expedicao": {
      "type": "string",
      "format": "date-time"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Foto",
              "PDF",
              "Relat\u00f3rio",
              "Certificado",
              "Outro"
            ]
          },
          "url": {
            "type": "string"
          },
          "nome_arquivo": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Anexos da inspe\u00e7\u00e3o"
    }
  },
  "required": [
    "empresa_id",
    "op_id",
    "numero_inspecao",
    "data_inspecao",
    "resultado"
  ]
}