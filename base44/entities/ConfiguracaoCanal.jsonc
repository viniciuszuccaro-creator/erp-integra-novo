{
  "name": "ConfiguracaoCanal",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da configuração"
    },
    "canal": {
      "type": "string",
      "enum": [
        "WhatsApp",
        "Instagram",
        "Facebook",
        "Telegram",
        "Email",
        "WebChat",
        "Portal",
        "Site",
        "App",
        "SMS",
        "VoIP"
      ],
      "description": "Canal de comunicação"
    },
    "ativo": {
      "type": "boolean",
      "default": false
    },
    "modo_atendimento": {
      "type": "string",
      "enum": [
        "Apenas Bot",
        "Bot com Transbordo",
        "Apenas Humano",
        "Híbrido",
        "IA Avançada"
      ],
      "default": "Bot com Transbordo"
    },
    "mensagem_boas_vindas": {
      "type": "string"
    },
    "mensagem_ausencia": {
      "type": "string"
    },
    "mensagem_fila_espera": {
      "type": "string"
    },
    "mensagem_transferencia": {
      "type": "string"
    },
    "mensagem_encerramento": {
      "type": "string"
    },
    "tempo_timeout_minutos": {
      "type": "number",
      "default": 30
    },
    "tempo_inatividade_aviso_minutos": {
      "type": "number",
      "default": 20
    },
    "horario_atendimento": {
      "type": "object",
      "properties": {
        "segunda": {
          "type": "object",
          "properties": {
            "inicio": {
              "type": "string"
            },
            "fim": {
              "type": "string"
            },
            "ativo": {
              "type": "boolean"
            }
          }
        },
        "terca": {
          "type": "object",
          "properties": {
            "inicio": {
              "type": "string"
            },
            "fim": {
              "type": "string"
            },
            "ativo": {
              "type": "boolean"
            }
          }
        },
        "quarta": {
          "type": "object",
          "properties": {
            "inicio": {
              "type": "string"
            },
            "fim": {
              "type": "string"
            },
            "ativo": {
              "type": "boolean"
            }
          }
        },
        "quinta": {
          "type": "object",
          "properties": {
            "inicio": {
              "type": "string"
            },
            "fim": {
              "type": "string"
            },
            "ativo": {
              "type": "boolean"
            }
          }
        },
        "sexta": {
          "type": "object",
          "properties": {
            "inicio": {
              "type": "string"
            },
            "fim": {
              "type": "string"
            },
            "ativo": {
              "type": "boolean"
            }
          }
        },
        "sabado": {
          "type": "object",
          "properties": {
            "inicio": {
              "type": "string"
            },
            "fim": {
              "type": "string"
            },
            "ativo": {
              "type": "boolean"
            }
          }
        },
        "domingo": {
          "type": "object",
          "properties": {
            "inicio": {
              "type": "string"
            },
            "fim": {
              "type": "string"
            },
            "ativo": {
              "type": "boolean"
            }
          }
        }
      },
      "description": "V21.6: Horário de atendimento por dia"
    },
    "feriados_bloqueados": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "sla_config": {
      "type": "object",
      "properties": {
        "tempo_primeira_resposta_minutos": {
          "type": "number",
          "default": 5
        },
        "tempo_resolucao_minutos": {
          "type": "number",
          "default": 60
        },
        "tempo_espera_fila_maximo_minutos": {
          "type": "number",
          "default": 10
        },
        "alertar_gestores": {
          "type": "boolean",
          "default": true
        },
        "escalar_automaticamente": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "roteamento": {
      "type": "object",
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "round_robin",
            "menor_carga",
            "especialidade",
            "aleatorio",
            "ia"
          ]
        },
        "priorizar_atendente_anterior": {
          "type": "boolean",
          "default": true
        },
        "limite_conversas_simultaneas": {
          "type": "number",
          "default": 5
        },
        "considerar_especialidade": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "equipe_atendimento_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "departamentos_destino": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acoes_automaticas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string"
          },
          "acao": {
            "type": "string"
          },
          "parametros": {
            "type": "object",
            "additionalProperties": true
          },
          "ativo": {
            "type": "boolean"
          }
        }
      }
    },
    "regras_transbordo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condicao": {
            "type": "string",
            "enum": [
              "sentimento_negativo",
              "confianca_baixa",
              "solicitacao_humano",
              "intent_especifico",
              "tempo_excedido",
              "palavras_chave"
            ]
          },
          "valor": {
            "type": "string"
          },
          "departamento_destino": {
            "type": "string"
          },
          "prioridade": {
            "type": "string"
          },
          "ativo": {
            "type": "boolean"
          }
        }
      }
    },
    "intents_transbordo_automatico": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "palavras_chave_urgente": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_conhecimento": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "pergunta": {
            "type": "string"
          },
          "resposta": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ativo": {
            "type": "boolean"
          },
          "uso_count": {
            "type": "number"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "templates_mensagem": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "conteudo": {
            "type": "string"
          },
          "variaveis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "atalho": {
            "type": "string"
          },
          "ativo": {
            "type": "boolean"
          }
        }
      }
    },
    "webhook_url": {
      "type": "string"
    },
    "webhook_secret": {
      "type": "string"
    },
    "credenciais": {
      "type": "object",
      "properties": {
        "api_key": {
          "type": "string"
        },
        "api_secret": {
          "type": "string"
        },
        "access_token": {
          "type": "string"
        },
        "phone_number_id": {
          "type": "string"
        },
        "business_account_id": {
          "type": "string"
        },
        "verify_token": {
          "type": "string"
        }
      }
    },
    "personalizacao": {
      "type": "object",
      "properties": {
        "cor_primaria": {
          "type": "string"
        },
        "cor_secundaria": {
          "type": "string"
        },
        "logo_url": {
          "type": "string"
        },
        "nome_exibicao": {
          "type": "string"
        },
        "avatar_url": {
          "type": "string"
        },
        "tema": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ]
        }
      }
    },
    "ia_config": {
      "type": "object",
      "properties": {
        "modelo": {
          "type": "string",
          "default": "gpt-4"
        },
        "temperatura": {
          "type": "number",
          "default": 0.7
        },
        "max_tokens": {
          "type": "number",
          "default": 500
        },
        "contexto_sistema": {
          "type": "string"
        },
        "usar_historico_cliente": {
          "type": "boolean",
          "default": true
        },
        "usar_base_conhecimento": {
          "type": "boolean",
          "default": true
        },
        "detectar_idioma": {
          "type": "boolean",
          "default": true
        },
        "traduzir_automaticamente": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "notificacoes": {
      "type": "object",
      "properties": {
        "nova_mensagem": {
          "type": "boolean",
          "default": true
        },
        "transbordo": {
          "type": "boolean",
          "default": true
        },
        "sla_alerta": {
          "type": "boolean",
          "default": true
        },
        "cliente_insatisfeito": {
          "type": "boolean",
          "default": true
        },
        "canais": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "email",
              "sistema",
              "whatsapp",
              "push"
            ]
          }
        }
      }
    },
    "metricas_habilitadas": {
      "type": "boolean",
      "default": true
    },
    "gravacao_habilitada": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "canal",
    "empresa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}