{
  "name": "CaixaOrdemLiquidacao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "Recebimento",
        "Pagamento",
        "Transferência"
      ],
      "description": "Tipo de operação financeira"
    },
    "origem": {
      "type": "string",
      "description": "Origem da ordem (Contas a Receber, Contas a Pagar, PDV, etc)"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total da ordem"
    },
    "forma_pagamento_pretendida": {
      "type": "string",
      "description": "Forma de pagamento que se pretende usar"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Em Processamento",
        "Processado",
        "Cancelado"
      ],
      "default": "Pendente",
      "description": "Status da ordem"
    },
    "titulos_vinculados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo_id": {
            "type": "string"
          },
          "tipo_titulo": {
            "type": "string"
          },
          "numero_titulo": {
            "type": "string"
          },
          "cliente_fornecedor_nome": {
            "type": "string"
          },
          "valor_titulo": {
            "type": "number"
          }
        }
      },
      "description": "Títulos vinculados a esta ordem"
    },
    "eh_rateio": {
      "type": "boolean",
      "default": false,
      "description": "Vol 10.2: Se é um rateio de pagamento entre múltiplos clientes/pedidos"
    },
    "rateio_detalhes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cliente_id": {
            "type": "string"
          },
          "cliente_nome": {
            "type": "string"
          },
          "pedido_id": {
            "type": "string"
          },
          "valor_rateado": {
            "type": "number"
          },
          "percentual": {
            "type": "number"
          },
          "titulo_id": {
            "type": "string"
          }
        }
      },
      "description": "Vol 10.2: Detalhes do rateio — permite dividir um pagamento entre 2+ clientes/pedidos"
    },
    "meios_pagamento": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "forma_pagamento": {
            "type": "string",
            "enum": [
              "Dinheiro",
              "PIX",
              "Boleto",
              "Transferência",
              "Cheque",
              "Cartão Crédito",
              "Cartão Débito",
              "Crédito Loja"
            ]
          },
          "valor": {
            "type": "number"
          },
          "referencia": {
            "type": "string",
            "description": "NSU, comprovante, ID da transação, etc"
          }
        }
      },
      "description": "Vol 10.2: Múltiplos meios de pagamento no mesmo lote"
    },
    "valor_diferenca": {
      "type": "number",
      "default": 0,
      "description": "Vol 10.2: Diferença entre valor total e soma dos meios/títulos"
    },
    "acrescimo": {
      "type": "number",
      "default": 0,
      "description": "Vol 10.1: Acréscimo aplicado (juros, multa)"
    },
    "desconto": {
      "type": "number",
      "default": 0,
      "description": "Vol 10.1: Desconto aplicado"
    },
    "data_ordem": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da criação da ordem"
    },
    "data_processamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do processamento"
    },
    "usuario_processou": {
      "type": "string",
      "description": "Usuário que processou"
    },
    "usuario_processou_id": {
      "type": "string"
    },
    "operador_caixa_id": {
      "type": "string",
      "description": "Vol 10.2: ID do operador de caixa responsável"
    },
    "detalhes_processamento": {
      "type": "object",
      "additionalProperties": true,
      "description": "Detalhes do processamento (bandeira, taxa, etc)"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "tipo_operacao",
    "valor_total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}