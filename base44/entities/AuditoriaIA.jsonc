{
  "name": "AuditoriaIA",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "modulo": {
      "type": "string",
      "description": "Módulo que executou a IA"
    },
    "funcionalidade": {
      "type": "string",
      "description": "Funcionalidade específica (leitura_projeto, upsell, etc.)"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usuário que disparou"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usuário"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da execução"
    },
    "input_prompt": {
      "type": "string",
      "description": "Prompt enviado para a IA"
    },
    "input_dados": {
      "type": "object",
      "additionalProperties": true,
      "description": "Dados de entrada"
    },
    "arquivo_entrada_url": {
      "type": "string",
      "description": "URL do arquivo processado (se aplicável)"
    },
    "output_resultado": {
      "type": "object",
      "additionalProperties": true,
      "description": "Resultado retornado pela IA"
    },
    "confianca_percentual": {
      "type": "number",
      "description": "% de confiança do resultado (0-100)"
    },
    "tokens_usados": {
      "type": "number",
      "description": "Total de tokens consumidos"
    },
    "tempo_resposta_ms": {
      "type": "number",
      "description": "Tempo de resposta em milissegundos"
    },
    "custo_estimado": {
      "type": "number",
      "description": "Custo estimado da execução"
    },
    "status": {
      "type": "string",
      "enum": [
        "Sucesso",
        "Erro",
        "Timeout",
        "Confiança Baixa"
      ],
      "description": "Status da execução"
    },
    "mensagem_erro": {
      "type": "string",
      "description": "Mensagem de erro (se houver)"
    },
    "modelo_usado": {
      "type": "string",
      "description": "Nome do modelo IA utilizado"
    },
    "aceito_usuario": {
      "type": "boolean",
      "default": false,
      "description": "Se o usuário aceitou/aprovou o resultado"
    },
    "rejeitado_motivo": {
      "type": "string",
      "description": "Motivo da rejeição (se aplicável)"
    },
    "documentos_gerados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de documentos gerados a partir desta execução"
    }
  },
  "required": [
    "modulo",
    "funcionalidade",
    "data_hora",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}