{
  "name": "Rota",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico da rota"
    },
    "nome_rota": {
      "type": "string",
      "description": "Nome da rota \u2014 \u00fanico por grupo"
    },
    "descricao": {
      "type": "string"
    },
    "data_rota": {
      "type": "string",
      "format": "date"
    },
    "motorista": {
      "type": "string"
    },
    "motorista_id": {
      "type": "string"
    },
    "veiculo": {
      "type": "string"
    },
    "veiculo_id": {
      "type": "string"
    },
    "romaneio_id": {
      "type": "string",
      "description": "Romaneio vinculado"
    },
    "pontos_entrega": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequencia": {
            "type": "number"
          },
          "entrega_id": {
            "type": "string"
          },
          "cliente_nome": {
            "type": "string"
          },
          "endereco_completo": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "janela_entrega_preferencial": {
            "type": "string",
            "enum": [
              "Manh\u00e3",
              "Tarde",
              "Noite",
              "Indiferente"
            ],
            "description": "Lido do cadastro do cliente (V16.1)"
          },
          "tipo_descarga": {
            "type": "string",
            "enum": [
              "Manual",
              "Empilhadeira",
              "Munck",
              "Outro"
            ],
            "description": "Tipo de descarga necess\u00e1ria (V16.1)"
          },
          "tempo_estimado_parada_minutos": {
            "type": "number",
            "default": 15
          },
          "horario_previsto": {
            "type": "string"
          },
          "horario_chegada_real": {
            "type": "string"
          },
          "horario_saida_real": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pendente",
              "Entregue",
              "Frustrada",
              "Pulada"
            ]
          },
          "observacoes": {
            "type": "string"
          }
        }
      },
      "description": "Lista ordenada de pontos de entrega"
    },
    "otimizacao_ia": {
      "type": "object",
      "properties": {
        "otimizada": {
          "type": "boolean",
          "default": false
        },
        "data_otimizacao": {
          "type": "string",
          "format": "date-time"
        },
        "criterio": {
          "type": "string",
          "enum": [
            "Menor Dist\u00e2ncia",
            "Menor Tempo",
            "Janelas de Entrega",
            "Ecol\u00f3gica"
          ],
          "default": "Menor Dist\u00e2ncia"
        },
        "economia_km": {
          "type": "number",
          "description": "KM economizados vs. rota manual"
        },
        "economia_tempo_min": {
          "type": "number",
          "description": "Minutos economizados"
        },
        "economia_combustivel_l": {
          "type": "number",
          "description": "Litros economizados (V16.1)"
        },
        "reducao_co2_kg": {
          "type": "number",
          "description": "Redu\u00e7\u00e3o de CO2 (V16.1)"
        }
      },
      "description": "Resultado da otimiza\u00e7\u00e3o por IA (V16.1)"
    },
    "distancia_total_km": {
      "type": "number",
      "description": "Dist\u00e2ncia total calculada"
    },
    "tempo_total_previsto_minutos": {
      "type": "number",
      "description": "Tempo total previsto"
    },
    "tempo_real_minutos": {
      "type": "number",
      "description": "Tempo real gasto"
    },
    "origem_endereco": {
      "type": "string",
      "description": "Endere\u00e7o de sa\u00edda (empresa/dep\u00f3sito)"
    },
    "origem_latitude": {
      "type": "number"
    },
    "origem_longitude": {
      "type": "number"
    },
    "google_maps_route_json": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON completo da rota do Google Maps"
    },
    "google_maps_route_url": {
      "type": "string",
      "description": "Link direto do Google Maps"
    },
    "otimizada": {
      "type": "boolean",
      "default": false,
      "description": "Se a ordem foi otimizada pelo algoritmo"
    },
    "algoritmo_usado": {
      "type": "string",
      "enum": [
        "Manual",
        "Google Maps",
        "Interno",
        "IA"
      ],
      "description": "Algoritmo de otimiza\u00e7\u00e3o usado"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planejada",
        "Aprovada",
        "Em Andamento",
        "Conclu\u00edda",
        "Cancelada"
      ],
      "default": "Planejada"
    },
    "progresso_percentual": {
      "type": "number",
      "default": 0,
      "description": "% de entregas conclu\u00eddas"
    },
    "entregas_concluidas": {
      "type": "number",
      "default": 0
    },
    "entregas_frustradas": {
      "type": "number",
      "default": 0
    },
    "custo_estimado": {
      "type": "number"
    },
    "custo_real": {
      "type": "number"
    },
    "observacoes": {
      "type": "string"
    },
    "criado_por": {
      "type": "string"
    },
    "criado_por_id": {
      "type": "string"
    }
  },
  "required": [
    "nome_rota",
    "empresa_id",
    "data_rota"
  ]
}