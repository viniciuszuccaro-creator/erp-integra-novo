{
  "name": "Entrega",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa respons\u00e1vel pela entrega"
    },
    "regiao_entrega_id": {
      "type": "string",
      "description": "ID da regi\u00e3o de entrega"
    },
    "regiao_entrega_nome": {
      "type": "string",
      "description": "Nome da regi\u00e3o (snapshot)"
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do pedido"
    },
    "numero_pedido": {
      "type": "string"
    },
    "op_id": {
      "type": "string",
      "description": "ID da ordem de produ\u00e7\u00e3o (se vier da produ\u00e7\u00e3o)"
    },
    "nfe_id": {
      "type": "string",
      "description": "ID da nota fiscal vinculada"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "endereco_entrega_id": {
      "type": "string",
      "description": "ID do local de entrega cadastrado no cliente"
    },
    "endereco_entrega_completo": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "pais": {
          "type": "string",
          "default": "Brasil"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "referencia": {
          "type": "string"
        },
        "link_google_maps": {
          "type": "string"
        }
      },
      "description": "Snapshot do endere\u00e7o usado na entrega"
    },
    "contato_entrega": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string"
        },
        "telefone": {
          "type": "string"
        },
        "whatsapp": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "cargo": {
          "type": "string"
        },
        "instrucoes_especiais": {
          "type": "string"
        }
      },
      "description": "Contato para a entrega"
    },
    "data_separacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da separa\u00e7\u00e3o"
    },
    "data_saida": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da sa\u00edda para entrega"
    },
    "data_previsao": {
      "type": "string",
      "format": "date"
    },
    "data_entrega": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora real da entrega"
    },
    "janela_entrega_inicio": {
      "type": "string",
      "description": "Hor\u00e1rio in\u00edcio (HH:MM)"
    },
    "janela_entrega_fim": {
      "type": "string",
      "description": "Hor\u00e1rio fim (HH:MM)"
    },
    "transportadora": {
      "type": "string"
    },
    "transportadora_id": {
      "type": "string"
    },
    "tipo_frete": {
      "type": "string",
      "enum": [
        "CIF",
        "FOB",
        "Retira",
        "Outro"
      ],
      "default": "CIF"
    },
    "motorista": {
      "type": "string"
    },
    "motorista_id": {
      "type": "string"
    },
    "motorista_telefone": {
      "type": "string"
    },
    "veiculo": {
      "type": "string"
    },
    "veiculo_id": {
      "type": "string"
    },
    "placa": {
      "type": "string"
    },
    "codigo_rastreamento": {
      "type": "string",
      "description": "C\u00f3digo de rastreio da transportadora"
    },
    "link_rastreamento": {
      "type": "string",
      "description": "Link de rastreamento (campo preparado para integra\u00e7\u00e3o)"
    },
    "qr_code": {
      "type": "string",
      "description": "QR Code \u00fanico para rastreamento interno"
    },
    "rota_id": {
      "type": "string",
      "description": "ID da rota (se fizer parte de roteiriza\u00e7\u00e3o)"
    },
    "romaneio_id": {
      "type": "string",
      "description": "ID do romaneio que cont\u00e9m esta entrega"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Normal",
        "Alta",
        "Urgente"
      ],
      "default": "Normal"
    },
    "volumes": {
      "type": "number",
      "description": "Quantidade de volumes"
    },
    "peso_total_kg": {
      "type": "number"
    },
    "volume_total_m3": {
      "type": "number",
      "description": "Volume total estimado em m\u00b3 (para restri\u00e7\u00f5es de capacidade)"
    },
    "valor_frete": {
      "type": "number"
    },
    "valor_mercadoria": {
      "type": "number",
      "description": "Valor declarado para seguro"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aguardando Separa\u00e7\u00e3o",
        "Em Separa\u00e7\u00e3o",
        "Pronto para Expedir",
        "Saiu para Entrega",
        "Em Tr\u00e2nsito",
        "Entregue",
        "Entrega Frustrada",
        "Devolvido",
        "Cancelado"
      ],
      "default": "Aguardando Separa\u00e7\u00e3o"
    },
    "comprovante_entrega": {
      "type": "object",
      "properties": {
        "foto_comprovante": {
          "type": "string",
          "description": "URL da foto do comprovante"
        },
        "assinatura_digital": {
          "type": "string",
          "description": "URL da assinatura digital"
        },
        "nome_recebedor": {
          "type": "string"
        },
        "documento_recebedor": {
          "type": "string"
        },
        "cargo_recebedor": {
          "type": "string"
        },
        "data_hora_recebimento": {
          "type": "string",
          "format": "date-time"
        },
        "latitude_entrega": {
          "type": "number"
        },
        "longitude_entrega": {
          "type": "number"
        },
        "observacoes_recebimento": {
          "type": "string"
        }
      }
    },
    "entrega_frustrada": {
      "type": "object",
      "properties": {
        "motivo": {
          "type": "string",
          "enum": [
            "Cliente Ausente",
            "Endere\u00e7o Incorreto",
            "Recusa de Recebimento",
            "\u00c1rea de Risco",
            "Hor\u00e1rio Inadequado",
            "Ve\u00edculo Quebrado",
            "Condi\u00e7\u00f5es Clim\u00e1ticas",
            "Outros"
          ]
        },
        "detalhes": {
          "type": "string"
        },
        "tentativa_numero": {
          "type": "number"
        },
        "reagendamento": {
          "type": "string",
          "format": "date"
        },
        "foto_ocorrencia": {
          "type": "string"
        }
      }
    },
    "notificacoes_enviadas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Separa\u00e7\u00e3o",
              "Sa\u00edda",
              "Em Tr\u00e2nsito",
              "Chegada",
              "Entregue",
              "Frustrada"
            ]
          },
          "canal": {
            "type": "string",
            "enum": [
              "WhatsApp",
              "E-mail",
              "SMS",
              "Sistema"
            ]
          },
          "destinatario": {
            "type": "string"
          },
          "data_envio": {
            "type": "string",
            "format": "date-time"
          },
          "status_envio": {
            "type": "string",
            "enum": [
              "Enviado",
              "Entregue",
              "Lido",
              "Falhou"
            ]
          },
          "mensagem": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de notifica\u00e7\u00f5es enviadas"
    },
    "historico_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "data_hora": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          },
          "localizacao": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            }
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Timeline de mudan\u00e7as de status"
    },
    "ocorrencias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Atraso",
              "Avaria",
              "Extravio",
              "Devolu\u00e7\u00e3o Parcial",
              "Problema Ve\u00edculo",
              "Outros"
            ]
          },
          "descricao": {
            "type": "string"
          },
          "data_hora": {
            "type": "string",
            "format": "date-time"
          },
          "responsavel": {
            "type": "string"
          },
          "resolucao": {
            "type": "string"
          },
          "foto_url": {
            "type": "string"
          }
        }
      },
      "description": "Ocorr\u00eancias durante o transporte"
    },
    "avaliacao_entrega": {
      "type": "object",
      "properties": {
        "nota": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "comentario": {
          "type": "string"
        },
        "data_avaliacao": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "custo_operacional": {
      "type": "number",
      "description": "Custo real da entrega"
    },
    "km_rodado": {
      "type": "number"
    },
    "tempo_total_minutos": {
      "type": "number"
    },
    "link_publico_rastreamento": {
      "type": "string",
      "description": "Link p\u00fablico para rastreamento sem login (V16.1)"
    },
    "rastreamento_habilitado": {
      "type": "boolean",
      "default": true,
      "description": "Se o rastreamento est\u00e1 habilitado (V16.1)"
    },
    "rastreamento_ultima_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima atualiza\u00e7\u00e3o de GPS (V16.1)"
    },
    "logistica_reversa": {
      "type": "object",
      "properties": {
        "ativada": {
          "type": "boolean",
          "default": false
        },
        "motivo": {
          "type": "string",
          "enum": [
            "Recusa Total",
            "Recusa Parcial",
            "Avaria",
            "Troca",
            "Outro"
          ]
        },
        "data_ocorrencia": {
          "type": "string",
          "format": "date-time"
        },
        "responsavel": {
          "type": "string"
        },
        "quantidade_devolvida": {
          "type": "number"
        },
        "valor_devolvido": {
          "type": "number"
        },
        "movimentacao_estoque_id": {
          "type": "string",
          "description": "ID da entrada de devolu\u00e7\u00e3o"
        },
        "notificacao_financeiro_id": {
          "type": "string",
          "description": "ID da notifica\u00e7\u00e3o para bloquear cobran\u00e7a"
        },
        "observacoes_devolucao": {
          "type": "string"
        }
      },
      "description": "Dados de log\u00edstica reversa (V16.1)"
    },
    "observacoes": {
      "type": "string"
    },
    "salvar_endereco_no_cliente": {
      "type": "boolean",
      "default": false,
      "description": "Se deve salvar endere\u00e7o no cadastro do cliente"
    },
    "salvar_contato_no_cliente": {
      "type": "boolean",
      "default": false,
      "description": "Se deve salvar contato no cadastro do cliente"
    },
    "usuario_responsavel": {
      "type": "string"
    },
    "usuario_responsavel_id": {
      "type": "string"
    }
  },
  "required": [
    "cliente_nome",
    "endereco_entrega_completo",
    "empresa_id"
  ]
}