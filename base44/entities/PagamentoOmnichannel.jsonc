{
  "name": "PagamentoOmnichannel",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "origem_pagamento": {
      "type": "string",
      "enum": [
        "Site",
        "App Mobile",
        "Marketplace",
        "Chatbot",
        "Link Pagamento",
        "Portal Cliente",
        "E-commerce"
      ],
      "description": "Canal de origem do pagamento"
    },
    "id_pedido_vinculado": {
      "type": "string",
      "description": "ID do pedido vinculado"
    },
    "id_cliente": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (snapshot)"
    },
    "cliente_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do cliente"
    },
    "valor_bruto": {
      "type": "number",
      "description": "Valor bruto da transação"
    },
    "valor_liquido": {
      "type": "number",
      "description": "Valor líquido após taxas"
    },
    "taxas_gateway": {
      "type": "number",
      "default": 0,
      "description": "Taxas cobradas pelo gateway"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "Cartão Crédito",
        "Cartão Débito",
        "PIX",
        "Boleto",
        "Carteira Digital",
        "Transferência"
      ],
      "description": "Forma de pagamento utilizada"
    },
    "bandeira_cartao": {
      "type": "string",
      "description": "Bandeira do cartão (se aplicável)"
    },
    "parcelas": {
      "type": "number",
      "default": 1,
      "description": "Número de parcelas"
    },
    "data_transacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da transação"
    },
    "id_transacao_gateway": {
      "type": "string",
      "description": "ID da transação no gateway"
    },
    "gateway_utilizado": {
      "type": "string",
      "description": "Nome do gateway (MercadoPago, PagSeguro, Asaas, etc)"
    },
    "status_transacao": {
      "type": "string",
      "enum": [
        "Pendente",
        "Autorizado",
        "Capturado",
        "Cancelado",
        "Estornado",
        "Recusado"
      ],
      "default": "Pendente",
      "description": "Status da transação no gateway"
    },
    "status_conferencia": {
      "type": "string",
      "enum": [
        "Pendente",
        "Conciliado",
        "Divergente",
        "Em Análise"
      ],
      "default": "Pendente",
      "description": "Status da conferência interna"
    },
    "data_credito_prevista": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de crédito na conta"
    },
    "data_credito_efetiva": {
      "type": "string",
      "format": "date",
      "description": "Data efetiva do crédito (após conciliação)"
    },
    "conta_receber_id": {
      "type": "string",
      "description": "ID do título a receber vinculado"
    },
    "caixa_ordem_liquidacao_id": {
      "type": "string",
      "description": "ID da ordem de liquidação gerada"
    },
    "link_pagamento": {
      "type": "string",
      "description": "Link de pagamento gerado (se aplicável)"
    },
    "link_expiracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de expiração do link"
    },
    "ip_cliente": {
      "type": "string",
      "description": "IP do cliente na transação"
    },
    "dados_adicionais_gateway": {
      "type": "object",
      "description": "Dados extras retornados pelo gateway (JSON livre)"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "origem_pagamento",
    "valor_bruto",
    "forma_pagamento",
    "status_transacao"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}