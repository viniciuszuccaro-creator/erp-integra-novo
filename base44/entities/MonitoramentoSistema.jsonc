{
  "name": "MonitoramentoSistema",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se espec\u00edfico)"
    },
    "tenant_id": {
      "type": "string",
      "description": "Vol 20.1/23.3: ID do tenant SaaS"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da coleta"
    },
    "metrica_tipo": {
      "type": "string",
      "enum": [
        "CPU",
        "Mem\u00f3ria",
        "Lat\u00eancia",
        "Requisi\u00e7\u00f5es",
        "Erros",
        "Uptime",
        "Database",
        "Storage",
        "Integra\u00e7\u00f5es",
        "Jobs"
      ],
      "description": "Tipo de m\u00e9trica"
    },
    "modulo": {
      "type": "string",
      "description": "Vol 23.3: M\u00f3dulo monitorado (Comercial, Financeiro, Estoque, etc.) para erros por m\u00f3dulo"
    },
    "cpu_uso_percent": {
      "type": "number",
      "description": "% de uso de CPU"
    },
    "memoria_uso_mb": {
      "type": "number",
      "description": "Mem\u00f3ria usada em MB"
    },
    "memoria_disponivel_mb": {
      "type": "number",
      "description": "Mem\u00f3ria dispon\u00edvel em MB"
    },
    "latencia_media_ms": {
      "type": "number",
      "description": "Lat\u00eancia m\u00e9dia de requisi\u00e7\u00f5es em ms"
    },
    "latencia_p95_ms": {
      "type": "number",
      "description": "Lat\u00eancia percentil 95 em ms"
    },
    "latencia_p99_ms": {
      "type": "number",
      "description": "Vol 23.3: Lat\u00eancia percentil 99 em ms (outliers)"
    },
    "requisicoes_por_segundo": {
      "type": "number",
      "description": "Taxa de requisi\u00e7\u00f5es/segundo"
    },
    "requisicoes_total": {
      "type": "number",
      "description": "Total de requisi\u00e7\u00f5es no per\u00edodo"
    },
    "requisicoes_sucesso": {
      "type": "number",
      "description": "Requisi\u00e7\u00f5es bem-sucedidas"
    },
    "requisicoes_erro": {
      "type": "number",
      "description": "Requisi\u00e7\u00f5es com erro"
    },
    "taxa_erro_percent": {
      "type": "number",
      "description": "% de taxa de erro"
    },
    "erros_por_modulo": {
      "type": "object",
      "additionalProperties": true,
      "description": "Vol 23.3: Contagem de erros por m\u00f3dulo (ex: {Comercial: 5, Financeiro: 2})"
    },
    "consultas_lentas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "query_id": {
            "type": "string"
          },
          "tempo_ms": {
            "type": "number"
          },
          "modulo": {
            "type": "string"
          },
          "entidade": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Vol 23.3: Consultas lentas registradas"
    },
    "uptime_percent": {
      "type": "number",
      "description": "% de uptime"
    },
    "downtime_segundos": {
      "type": "number",
      "description": "Tempo de inatividade em segundos"
    },
    "usuarios_ativos": {
      "type": "number",
      "description": "Usu\u00e1rios ativos no momento"
    },
    "sessoes_simultaneas": {
      "type": "number",
      "description": "Sess\u00f5es simult\u00e2neas"
    },
    "database_conexoes_ativas": {
      "type": "number",
      "description": "Conex\u00f5es ativas no banco"
    },
    "database_queries_por_segundo": {
      "type": "number",
      "description": "Queries por segundo"
    },
    "database_tempo_medio_query_ms": {
      "type": "number",
      "description": "Tempo m\u00e9dio de query em ms"
    },
    "storage_usado_gb": {
      "type": "number",
      "description": "Storage usado em GB"
    },
    "storage_disponivel_gb": {
      "type": "number",
      "description": "Storage dispon\u00edvel em GB"
    },
    "cache_hit_rate_percent": {
      "type": "number",
      "description": "% de acerto do cache"
    },
    "jobs_atrasados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "nome_job": {
            "type": "string"
          },
          "data_prevista": {
            "type": "string",
            "format": "date-time"
          },
          "minutos_atraso": {
            "type": "number"
          }
        }
      },
      "description": "Vol 23.3: Jobs agendados atrasados"
    },
    "apis_indisponiveis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome_api": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "ultima_verificacao": {
            "type": "string",
            "format": "date-time"
          },
          "status_code": {
            "type": "number"
          },
          "erro": {
            "type": "string"
          }
        }
      },
      "description": "Vol 23.3: APIs externas indispon\u00edveis no momento da coleta"
    },
    "alertas_gerados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "severidade": {
            "type": "string",
            "enum": [
              "Info",
              "Warning",
              "Error",
              "Critical"
            ]
          },
          "mensagem": {
            "type": "string"
          },
          "valor_metrica": {
            "type": "number"
          },
          "modulo": {
            "type": "string"
          },
          "acao_recomendada": {
            "type": "string",
            "description": "Vol 23.3: A\u00e7\u00e3o recomendada para resolver o alerta"
          }
        }
      },
      "description": "Alertas gerados nesta coleta"
    },
    "status_geral": {
      "type": "string",
      "enum": [
        "Saud\u00e1vel",
        "Aten\u00e7\u00e3o",
        "Cr\u00edtico",
        "Offline"
      ],
      "default": "Saud\u00e1vel",
      "description": "Status geral do sistema"
    },
    "intervalo_coleta_segundos": {
      "type": "number",
      "default": 60,
      "description": "Intervalo de coleta das m\u00e9tricas"
    }
  },
  "required": [
    "timestamp",
    "metrica_tipo"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}