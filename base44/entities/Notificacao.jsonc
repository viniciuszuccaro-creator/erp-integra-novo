{
  "name": "Notificacao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único"
    },
    "titulo": {
      "type": "string",
      "description": "Título da notificação"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem completa"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "info",
        "sucesso",
        "aviso",
        "erro",
        "urgente"
      ],
      "default": "info",
      "description": "Tipo de notificação"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Sistema",
        "Comercial",
        "Financeiro",
        "Estoque",
        "RH",
        "Fiscal",
        "Geral"
      ],
      "default": "Geral",
      "description": "Categoria da notificação"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Normal",
        "Alta",
        "Urgente"
      ],
      "default": "Normal",
      "description": "Nível de prioridade"
    },
    "destinatario_id": {
      "type": "string",
      "description": "ID do usuário destinatário"
    },
    "destinatario_email": {
      "type": "string",
      "description": "E-mail do destinatário"
    },
    "remetente": {
      "type": "string",
      "description": "Nome do remetente ou sistema"
    },
    "link_acao": {
      "type": "string",
      "description": "URL para ação relacionada"
    },
    "entidade_relacionada": {
      "type": "string",
      "description": "Tipo de entidade (Pedido, Cliente, etc)"
    },
    "registro_id": {
      "type": "string",
      "description": "ID do registro relacionado"
    },
    "lida": {
      "type": "boolean",
      "default": false,
      "description": "Se a notificação foi lida"
    },
    "data_leitura": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que foi lida"
    },
    "arquivada": {
      "type": "boolean",
      "default": false,
      "description": "Se foi arquivada"
    },
    "acao_tomada": {
      "type": "boolean",
      "default": false,
      "description": "Se alguma ação foi tomada"
    },
    "expira_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de expiração"
    },
    "dados_adicionais": {
      "type": "object",
      "additionalProperties": true,
      "description": "Dados extras em JSON"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se ativo"
    }
  },
  "required": [
    "titulo",
    "mensagem",
    "tipo"
  ]
}
