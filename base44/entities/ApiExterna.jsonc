{
  "name": "ApiExterna",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tenant_id": {
      "type": "string",
      "description": "Vol 20.1: ID do tenant SaaS"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo num\u00e9rico sequencial \u00fanico"
    },
    "nome_integracao": {
      "type": "string",
      "description": "Nome da integra\u00e7\u00e3o"
    },
    "tipo_api": {
      "type": "string",
      "enum": [
        "REST",
        "GraphQL",
        "SOAP",
        "Webhook"
      ],
      "default": "REST"
    },
    "descricao": {
      "type": "string"
    },
    "url_base": {
      "type": "string",
      "description": "URL base da API"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API (armazenada como segredo server-side)"
    },
    "api_secret": {
      "type": "string",
      "description": "Secret da API (armazenada como segredo server-side)"
    },
    "headers_autenticacao": {
      "type": "object",
      "description": "Headers de autentica\u00e7\u00e3o"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produ\u00e7\u00e3o",
        "Homologa\u00e7\u00e3o",
        "Sandbox"
      ],
      "default": "Homologa\u00e7\u00e3o",
      "description": "Vol 18.1: Ambiente da integra\u00e7\u00e3o"
    },
    "escopo": {
      "type": "string",
      "description": "Vol 18.1: Escopo/prop\u00f3sito da integra\u00e7\u00e3o (ex: emiss\u00e3o NF-e, consulta CEP, pagamento)"
    },
    "modulo_vinculado": {
      "type": "string",
      "enum": [
        "Comercial",
        "Financeiro",
        "Fiscal",
        "Estoque",
        "Compras",
        "Expedi\u00e7\u00e3o",
        "Produ\u00e7\u00e3o",
        "RH",
        "CRM",
        "Sistema"
      ],
      "description": "Vol 18.1: M\u00f3dulo que consome esta API"
    },
    "responsavel_id": {
      "type": "string",
      "description": "Vol 18.1: ID do usu\u00e1rio respons\u00e1vel pela integra\u00e7\u00e3o"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Vol 18.1: Nome do respons\u00e1vel"
    },
    "limite_requisicoes_por_minuto": {
      "type": "number",
      "default": 60,
      "description": "Vol 18.1: Limite de requisi\u00e7\u00f5es por minuto (rate limit)"
    },
    "timeout_segundos": {
      "type": "number",
      "default": 30,
      "description": "Vol 18.1: Timeout da requisi\u00e7\u00e3o"
    },
    "politica_retry": {
      "type": "object",
      "properties": {
        "max_tentativas": {
          "type": "number",
          "default": 3
        },
        "intervalo_segundos": {
          "type": "number",
          "default": 60
        },
        "backoff_exponencial": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Vol 18.1: Pol\u00edtica de retry"
    },
    "circuit_breaker": {
      "type": "object",
      "properties": {
        "estado": {
          "type": "string",
          "enum": [
            "Fechado",
            "Aberto",
            "Half-Open"
          ],
          "default": "Fechado"
        },
        "falhas_consecutivas": {
          "type": "number",
          "default": 0
        },
        "limite_falhas": {
          "type": "number",
          "default": 5
        },
        "data_ultima_abertura": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Vol 18.3: Circuit breaker para prote\u00e7\u00e3o"
    },
    "fila_morta": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object"
          },
          "erro": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tentativas": {
            "type": "number"
          },
          "reprocessado": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Vol 18.3: Fila morta (dead letter queue) para requisi\u00e7\u00f5es que falharam ap\u00f3s todas as tentativas"
    },
    "ultima_requisicao": {
      "type": "string",
      "format": "date-time"
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Vol 18.3: \u00daltima sincroniza\u00e7\u00e3o bem-sucedida"
    },
    "total_requisicoes": {
      "type": "number",
      "default": 0
    },
    "total_erros": {
      "type": "number",
      "default": 0
    },
    "total_reprocessados": {
      "type": "number",
      "default": 0,
      "description": "Vol 18.3: Total de requisi\u00e7\u00f5es reprocessadas da fila morta"
    },
    "latencia_media_ms": {
      "type": "number",
      "default": 0,
      "description": "Vol 18.3: Lat\u00eancia m\u00e9dia das requisi\u00e7\u00f5es"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_integracao",
    "tipo_api"
  ]
}