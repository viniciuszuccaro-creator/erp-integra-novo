{
  "name": "AuditoriaGlobal",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa onde ocorreu a ação"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usuário que executou"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usuário"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usuário"
    },
    "usuario_perfil": {
      "type": "string",
      "description": "Perfil de acesso do usuário"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da ação"
    },
    "acao": {
      "type": "string",
      "enum": [
        "Login",
        "Logout",
        "Criar",
        "Editar",
        "Excluir",
        "Visualizar",
        "Aprovar",
        "Rejeitar",
        "Exportar",
        "Importar",
        "Troca Empresa",
        "Troca Contexto",
        "API Call",
        "IA Execution",
        "Integração",
        "Backup",
        "Restore",
        "Config Change"
      ],
      "description": "Tipo de ação executada"
    },
    "modulo": {
      "type": "string",
      "description": "Módulo do sistema"
    },
    "entidade_afetada": {
      "type": "string",
      "description": "Nome da entidade (Cliente, Pedido, etc.)"
    },
    "registro_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "registro_chave": {
      "type": "string",
      "description": "Chave/número do registro (PEDXYZ, NF123)"
    },
    "campos_alterados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string"
          },
          "valor_anterior": {
            "type": "string"
          },
          "valor_novo": {
            "type": "string"
          }
        }
      },
      "description": "Lista de campos alterados"
    },
    "dados_antes": {
      "type": "object",
      "additionalProperties": true,
      "description": "Snapshot dos dados antes da alteração"
    },
    "dados_depois": {
      "type": "object",
      "additionalProperties": true,
      "description": "Snapshot dos dados após a alteração"
    },
    "ip_address": {
      "type": "string",
      "description": "Endereço IP de origem"
    },
    "ip_localizacao": {
      "type": "string",
      "description": "Geolocalização do IP"
    },
    "user_agent": {
      "type": "string",
      "description": "Navegador e dispositivo"
    },
    "dispositivo_tipo": {
      "type": "string",
      "enum": [
        "Desktop",
        "Mobile",
        "Tablet",
        "API",
        "Bot"
      ],
      "description": "Tipo de dispositivo"
    },
    "contexto_sessao": {
      "type": "object",
      "properties": {
        "empresa_contexto": {
          "type": "string"
        },
        "grupo_contexto": {
          "type": "string"
        },
        "nivel_acesso": {
          "type": "string"
        }
      },
      "description": "Contexto da sessão"
    },
    "sucesso": {
      "type": "boolean",
      "default": true,
      "description": "Se a ação foi bem-sucedida"
    },
    "mensagem_erro": {
      "type": "string",
      "description": "Mensagem de erro (se houver)"
    },
    "duracao_ms": {
      "type": "number",
      "description": "Duração da operação em ms"
    },
    "nivel_risco": {
      "type": "string",
      "enum": [
        "Baixo",
        "Médio",
        "Alto",
        "Crítico"
      ],
      "default": "Baixo",
      "description": "Nível de risco da ação (calculado por IA)"
    },
    "alerta_ia_gerado": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA detectou comportamento anômalo"
    },
    "tipo_alerta": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Login Suspeito",
        "Horário Incomum",
        "IP Novo",
        "Ação Repetitiva",
        "Volume Alto",
        "Acesso Negado Múltiplo"
      ],
      "description": "Tipo de alerta gerado"
    },
    "requer_investigacao": {
      "type": "boolean",
      "default": false,
      "description": "Se requer investigação manual"
    },
    "investigado": {
      "type": "boolean",
      "default": false
    },
    "investigado_por": {
      "type": "string"
    },
    "investigacao_resultado": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para categorização"
    }
  },
  "required": [
    "usuario_id",
    "data_hora",
    "acao",
    "modulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}