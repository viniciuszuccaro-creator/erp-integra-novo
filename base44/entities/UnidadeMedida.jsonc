{
  "name": "UnidadeMedida",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da unidade de medida"
    },
    "sigla": {
      "type": "string",
      "description": "Sigla da unidade (UN, KG, MT, etc.) — único por grupo"
    },
    "nome_completo": {
      "type": "string",
      "description": "Nome completo da unidade — único por grupo"
    },
    "tipo_grandeza": {
      "type": "string",
      "enum": [
        "Massa",
        "Comprimento",
        "Volume",
        "Área",
        "Unidade",
        "Tempo",
        "Outro"
      ],
      "default": "Unidade"
    },
    "permite_conversao": {
      "type": "boolean",
      "default": true
    },
    "unidade_base_conversao": {
      "type": "string"
    },
    "fator_conversao_para_base": {
      "type": "number",
      "default": 1
    },
    "usa_em_estoque": {
      "type": "boolean",
      "default": true
    },
    "usa_em_compras": {
      "type": "boolean",
      "default": true
    },
    "usa_em_vendas": {
      "type": "boolean",
      "default": true
    },
    "usa_em_producao": {
      "type": "boolean",
      "default": false
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "sigla",
    "nome_completo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}