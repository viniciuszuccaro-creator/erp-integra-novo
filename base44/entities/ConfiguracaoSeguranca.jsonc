{
  "name": "ConfiguracaoSeguranca",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (null se config do grupo)"
    },
    "jwt_ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se usa JWT para autentica\u00e7\u00e3o"
    },
    "jwt_algoritmo": {
      "type": "string",
      "default": "HS256",
      "enum": [
        "HS256",
        "HS384",
        "HS512",
        "RS256"
      ],
      "description": "Algoritmo de assinatura JWT"
    },
    "jwt_secret_key": {
      "type": "string",
      "description": "Chave secreta JWT (criptografada)"
    },
    "jwt_validade_access_minutos": {
      "type": "number",
      "default": 15,
      "description": "Validade do access token em minutos"
    },
    "jwt_validade_refresh_dias": {
      "type": "number",
      "default": 30,
      "description": "Validade do refresh token em dias"
    },
    "jwt_rotacao_refresh": {
      "type": "boolean",
      "default": true,
      "description": "Se faz rota\u00e7\u00e3o de refresh tokens"
    },
    "jwt_familia_tokens": {
      "type": "boolean",
      "default": true,
      "description": "Se agrupa tokens em fam\u00edlias (detecta roubo)"
    },
    "jwt_revogar_familia_em_suspeita": {
      "type": "boolean",
      "default": true,
      "description": "Revoga toda fam\u00edlia se detectar uso suspeito"
    },
    "sessao_unica": {
      "type": "boolean",
      "default": false,
      "description": "Se permite apenas 1 sess\u00e3o por usu\u00e1rio"
    },
    "sessoes_simultaneas_max": {
      "type": "number",
      "default": 3,
      "description": "N\u00famero m\u00e1ximo de sess\u00f5es simult\u00e2neas"
    },
    "encerrar_sessoes_antigas_auto": {
      "type": "boolean",
      "default": true,
      "description": "Se encerra sess\u00f5es antigas ao atingir o limite"
    },
    "timeout_inatividade_minutos": {
      "type": "number",
      "default": 60,
      "description": "Timeout de inatividade (minutos)"
    },
    "timeout_absoluto_horas": {
      "type": "number",
      "default": 24,
      "description": "Timeout absoluto da sess\u00e3o (horas)"
    },
    "exigir_mfa": {
      "type": "boolean",
      "default": false,
      "description": "Se exige autentica\u00e7\u00e3o de dois fatores"
    },
    "mfa_metodos_disponiveis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Email",
          "WhatsApp",
          "SMS",
          "Authenticator"
        ]
      },
      "default": [
        "Email",
        "WhatsApp"
      ],
      "description": "M\u00e9todos de MFA dispon\u00edveis"
    },
    "mfa_validade_codigo_minutos": {
      "type": "number",
      "default": 5,
      "description": "Validade do c\u00f3digo MFA em minutos"
    },
    "mfa_exigir_novo_ip": {
      "type": "boolean",
      "default": true,
      "description": "Exigir MFA em novo IP"
    },
    "mfa_exigir_novo_dispositivo": {
      "type": "boolean",
      "default": true,
      "description": "Exigir MFA em novo dispositivo"
    },
    "mfa_exigir_horario_incomum": {
      "type": "boolean",
      "default": false,
      "description": "Exigir MFA em hor\u00e1rio incomum"
    },
    "tentativas_login_max": {
      "type": "number",
      "default": 5,
      "description": "Tentativas m\u00e1ximas antes de bloquear"
    },
    "bloqueio_tempo_minutos": {
      "type": "number",
      "default": 30,
      "description": "Tempo de bloqueio ap\u00f3s exceder tentativas"
    },
    "bloqueio_ip_suspeito": {
      "type": "boolean",
      "default": true,
      "description": "Se bloqueia IPs com comportamento suspeito"
    },
    "ips_bloqueados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de IPs bloqueados"
    },
    "ips_whitelist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IPs sempre permitidos"
    },
    "detectar_anomalias_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se usa IA para detectar comportamento an\u00f4malo"
    },
    "ia_nivel_sensibilidade": {
      "type": "string",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "M\u00e1xima"
      ],
      "default": "M\u00e9dia",
      "description": "Sensibilidade da detec\u00e7\u00e3o de anomalias"
    },
    "registrar_dispositivos": {
      "type": "boolean",
      "default": true,
      "description": "Se registra dispositivos conhecidos"
    },
    "notificar_novo_dispositivo": {
      "type": "boolean",
      "default": true,
      "description": "Notificar usu\u00e1rio em novo dispositivo"
    },
    "notificar_novo_ip": {
      "type": "boolean",
      "default": true,
      "description": "Notificar usu\u00e1rio em novo IP"
    },
    "notificar_tentativas_falhas": {
      "type": "boolean",
      "default": true,
      "description": "Notificar ap\u00f3s X tentativas falhas"
    },
    "politica_senha": {
      "type": "object",
      "properties": {
        "tamanho_minimo": {
          "type": "number",
          "default": 8
        },
        "exigir_maiusculas": {
          "type": "boolean",
          "default": true
        },
        "exigir_minusculas": {
          "type": "boolean",
          "default": true
        },
        "exigir_numeros": {
          "type": "boolean",
          "default": true
        },
        "exigir_especiais": {
          "type": "boolean",
          "default": false
        },
        "trocar_senha_dias": {
          "type": "number",
          "default": 90
        },
        "historico_senhas": {
          "type": "number",
          "default": 3
        },
        "permitir_senha_comum": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Pol\u00edtica de senhas"
    },
    "rate_limiting": {
      "type": "object",
      "properties": {
        "ativo": {
          "type": "boolean",
          "default": true
        },
        "requisicoes_por_minuto": {
          "type": "number",
          "default": 60
        },
        "requisicoes_por_hora": {
          "type": "number",
          "default": 1000
        },
        "bloquear_apos_exceder": {
          "type": "boolean",
          "default": true
        },
        "tempo_bloqueio_minutos": {
          "type": "number",
          "default": 15
        }
      },
      "description": "Rate limiting de APIs"
    },
    "auditoria_completa": {
      "type": "boolean",
      "default": true,
      "description": "Se registra todas as a\u00e7\u00f5es em auditoria"
    },
    "registrar_ips_acessos": {
      "type": "boolean",
      "default": true,
      "description": "Se registra IPs de todos acessos"
    },
    "registrar_user_agents": {
      "type": "boolean",
      "default": true,
      "description": "Se registra user agents"
    },
    "estatisticas": {
      "type": "object",
      "properties": {
        "total_sessoes_criadas": {
          "type": "number",
          "default": 0
        },
        "total_sessoes_ativas": {
          "type": "number",
          "default": 0
        },
        "total_tentativas_falhas": {
          "type": "number",
          "default": 0
        },
        "total_bloqueios": {
          "type": "number",
          "default": 0
        },
        "total_mfa_validados": {
          "type": "number",
          "default": 0
        },
        "total_alertas_seguranca": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Estat\u00edsticas de seguran\u00e7a"
    },
    "ultima_tentativa_invasao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima tentativa suspeita"
    },
    "configurado_por": {
      "type": "string",
      "description": "Usu\u00e1rio que configurou"
    },
    "configurado_por_id": {
      "type": "string"
    },
    "data_configuracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da configura\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a configura\u00e7\u00e3o"
    }
  },
  "required": [
    "jwt_ativo",
    "sessoes_simultaneas_max",
    "timeout_inatividade_minutos"
  ]
}