{
  "name": "TabelaDIFAL",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do registro DIFAL"
    },
    "uf_origem": {
      "type": "string",
      "description": "UF de origem da mercadoria"
    },
    "uf_destino": {
      "type": "string",
      "description": "UF de destino da mercadoria"
    },
    "aliquota_interna_origem": {
      "type": "number",
      "description": "Alíquota interna do estado de origem (%)"
    },
    "aliquota_interna_destino": {
      "type": "number",
      "description": "Alíquota interna do estado de destino (%)"
    },
    "aliquota_interestadual": {
      "type": "number",
      "description": "Alíquota interestadual aplicável (%)"
    },
    "fcp_percentual": {
      "type": "number",
      "default": 0,
      "description": "% do Fundo de Combate à Pobreza"
    },
    "ano_vigencia": {
      "type": "number",
      "description": "Ano de vigência desta tabela"
    },
    "data_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da última atualização pela IA"
    },
    "fonte_dados": {
      "type": "string",
      "description": "Fonte da informação (Confaz, Sefaz, etc)"
    },
    "atualizado_por_ia": {
      "type": "boolean",
      "default": true,
      "description": "Se foi atualizado automaticamente pela IA"
    },
    "validado": {
      "type": "boolean",
      "default": false,
      "description": "Se foi validado por um humano"
    },
    "validado_por": {
      "type": "string"
    },
    "validado_em": {
      "type": "string",
      "format": "date-time"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "uf_origem",
    "uf_destino",
    "aliquota_interna_destino",
    "aliquota_interestadual",
    "ano_vigencia"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}