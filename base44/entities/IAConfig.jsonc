{
  "name": "IAConfig",
  "type": "object",
  "properties": {
    "grupo_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se configura\u00e7\u00e3o espec\u00edfica)"
    },
    "chave": {
      "type": "string",
      "description": "Chave \u00fanica da configura\u00e7\u00e3o"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "Comercial",
        "Producao",
        "Logistica",
        "Financeiro",
        "CRM",
        "Estoque",
        "Geral"
      ],
      "description": "M\u00f3dulo que usa esta IA"
    },
    "funcionalidade": {
      "type": "string",
      "description": "Ex: leitura_projeto, upsell, refugo, roteirizacao"
    },
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA est\u00e1 ativa"
    },
    "modo_treinamento": {
      "type": "boolean",
      "default": false,
      "description": "Se est\u00e1 em modo de treinamento"
    },
    "modelo_base": {
      "type": "string",
      "description": "Nome do modelo (GPT-4, GPT-4o, Custom)",
      "default": "GPT-4o"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "OpenAI",
        "Azure OpenAI",
        "Custom",
        "Local"
      ],
      "default": "OpenAI"
    },
    "endpoint_url": {
      "type": "string",
      "description": "URL do endpoint da IA"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API"
    },
    "limite_tokens": {
      "type": "number",
      "default": 8192,
      "description": "Limite de tokens por requisi\u00e7\u00e3o"
    },
    "confianca_minima": {
      "type": "number",
      "default": 75,
      "description": "% m\u00ednimo de confian\u00e7a para aceitar resultado"
    },
    "temperatura": {
      "type": "number",
      "default": 0.7,
      "description": "Temperatura do modelo (0-1)"
    },
    "timeout_segundos": {
      "type": "number",
      "default": 60,
      "description": "Timeout da requisi\u00e7\u00e3o"
    },
    "empresas_habilitadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das empresas autorizadas a usar"
    },
    "usuarios_autorizados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos usu\u00e1rios autorizados"
    },
    "configuracoes_especificas": {
      "type": "object",
      "additionalProperties": true,
      "description": "Configura\u00e7\u00f5es espec\u00edficas por funcionalidade"
    },
    "total_execucoes": {
      "type": "number",
      "default": 0,
      "description": "Total de execu\u00e7\u00f5es"
    },
    "total_sucesso": {
      "type": "number",
      "default": 0,
      "description": "Total de execu\u00e7\u00f5es bem-sucedidas"
    },
    "total_erro": {
      "type": "number",
      "default": 0,
      "description": "Total de erros"
    },
    "taxa_sucesso_percentual": {
      "type": "number",
      "description": "% de taxa de sucesso"
    },
    "custo_total_estimado": {
      "type": "number",
      "default": 0,
      "description": "Custo total estimado de uso da IA"
    },
    "ultima_execucao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima execu\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "chave",
    "modulo",
    "funcionalidade"
  ]
}