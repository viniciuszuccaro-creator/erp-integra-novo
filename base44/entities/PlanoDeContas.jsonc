{
  "name": "PlanoDeContas",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "grupo"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do registro"
    },
    "codigo_conta": {
      "type": "string",
      "description": "Código da conta contábil (ex: 1.1.1.01)"
    },
    "nome_conta": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_conta": {
      "type": "string",
      "enum": [
        "Receita",
        "Despesa",
        "Ativo",
        "Passivo",
        "Patrimônio Líquido"
      ]
    },
    "natureza": {
      "type": "string",
      "enum": [
        "Devedora",
        "Credora"
      ]
    },
    "conta_pai_id": {
      "type": "string"
    },
    "nivel_hierarquico": {
      "type": "number"
    },
    "eh_analitica": {
      "type": "boolean",
      "default": true
    },
    "eh_sintetica": {
      "type": "boolean",
      "default": false
    },
    "centro_resultado_padrao_id": {
      "type": "string"
    },
    "aceita_lancamento_manual": {
      "type": "boolean",
      "default": true
    },
    "usa_em_sped": {
      "type": "boolean",
      "default": false
    },
    "usa_apenas_gerencial": {
      "type": "boolean",
      "default": false
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "codigo_conta",
    "nome_conta",
    "tipo_conta"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}