{
  "name": "ConfiguracaoDespesaRecorrente",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo (se aplicável)"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa que terá a despesa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da configuração"
    },
    "origem": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa"
    },
    "tipo_despesa_id": {
      "type": "string",
      "description": "ID do TipoDespesa vinculado"
    },
    "tipo_despesa_nome": {
      "type": "string",
      "description": "Nome do TipoDespesa (snapshot)"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição da despesa recorrente"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria da despesa (snapshot do TipoDespesa)"
    },
    "fornecedor_id": {
      "type": "string"
    },
    "fornecedor_nome": {
      "type": "string"
    },
    "valor_base": {
      "type": "number",
      "description": "Valor base da despesa"
    },
    "ajuste_inflacao": {
      "type": "boolean",
      "default": false
    },
    "indice_ajuste": {
      "type": "string",
      "enum": [
        "IPCA",
        "IGP-M",
        "INPC",
        "CDI",
        "Nenhum"
      ],
      "default": "Nenhum"
    },
    "percentual_ajuste_anual": {
      "type": "number",
      "default": 0
    },
    "periodicidade": {
      "type": "string",
      "enum": [
        "Mensal",
        "Bimestral",
        "Trimestral",
        "Semestral",
        "Anual",
        "Semanal",
        "Quinzenal"
      ],
      "default": "Mensal"
    },
    "dia_vencimento": {
      "type": "number",
      "description": "Dia do mês para vencimento (1-31)"
    },
    "dia_semana_vencimento": {
      "type": "string",
      "enum": [
        "Segunda",
        "Terça",
        "Quarta",
        "Quinta",
        "Sexta",
        "Sábado",
        "Domingo"
      ]
    },
    "meses_aplicacao": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 1,
        "maximum": 12
      }
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_fim": {
      "type": "string",
      "format": "date"
    },
    "forma_pagamento_id": {
      "type": "string"
    },
    "forma_pagamento_nome": {
      "type": "string"
    },
    "centro_custo_id": {
      "type": "string"
    },
    "centro_custo_nome": {
      "type": "string"
    },
    "conta_contabil_id": {
      "type": "string"
    },
    "conta_contabil_nome": {
      "type": "string"
    },
    "centro_resultado_id": {
      "type": "string"
    },
    "centro_resultado_nome": {
      "type": "string"
    },
    "projeto_obra": {
      "type": "string"
    },
    "gerar_automaticamente": {
      "type": "boolean",
      "default": true
    },
    "antecedencia_dias": {
      "type": "number",
      "default": 5
    },
    "notificar_criacao": {
      "type": "boolean",
      "default": true
    },
    "usuarios_notificacao": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rateio_automatico": {
      "type": "boolean",
      "default": false
    },
    "empresas_rateio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "empresa_id": {
            "type": "string"
          },
          "empresa_nome": {
            "type": "string"
          },
          "percentual": {
            "type": "number"
          }
        }
      }
    },
    "historico_geracao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data_geracao": {
            "type": "string",
            "format": "date-time"
          },
          "conta_pagar_id": {
            "type": "string"
          },
          "valor_gerado": {
            "type": "number"
          },
          "mes_referencia": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se a configuração está ativa"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativa",
        "Pausada",
        "Encerrada"
      ],
      "default": "Ativa"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "tipo_despesa_id",
    "descricao",
    "valor_base",
    "periodicidade",
    "empresa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}