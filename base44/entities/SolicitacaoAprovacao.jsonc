{
  "name": "SolicitacaoAprovacao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa solicitante"
    },
    "solicitante_id": {
      "type": "string"
    },
    "solicitante_nome": {
      "type": "string"
    },
    "aprovador_id": {
      "type": "string",
      "description": "Usuário designado a aprovar (opcional)"
    },
    "perfil_aprovador_necessario": {
      "type": "string",
      "description": "Perfil exigido (ex: Gerente Comercial)"
    },
    "tipo_solicitacao": {
      "type": "string",
      "enum": [
        "desconto_pedido",
        "alteracao_preco",
        "cadastro_fornecedor",
        "aprovacao_compra",
        "liberar_credito",
        "estorno_financeiro",
        "cancelamento_nf",
        "outro"
      ],
      "default": "desconto_pedido"
    },
    "entidade_alvo": {
      "type": "string"
    },
    "entidade_alvo_id": {
      "type": "string"
    },
    "dados_propostos": {
      "type": "object",
      "additionalProperties": true
    },
    "justificativa": {
      "type": "string"
    },
    "valor_solicitado": {
      "type": "number",
      "default": 0,
      "description": "Vol 6.1: Valor financeiro envolvido na solicitação (para alçada)"
    },
    "categoria_alcada": {
      "type": "string",
      "enum": [
        "Comercial",
        "Compras",
        "Financeiro",
        "Fiscal",
        "RH",
        "Operacional",
        "Sistema"
      ],
      "description": "Vol 6.1: Categoria da alçada (define limites por área)"
    },
    "nivel_alcada": {
      "type": "string",
      "enum": [
        "Vendedor",
        "Supervisor",
        "Gerente",
        "Diretor",
        "Admin"
      ],
      "description": "Vol 6.1/3.2: Nível de alçada necessário para aprovar"
    },
    "valor_limite_alcada": {
      "type": "number",
      "default": 0,
      "description": "Vol 6.1: Valor máximo que o aprovador deste nível pode autorizar"
    },
    "concessao_temporaria": {
      "type": "boolean",
      "default": false,
      "description": "Vol 3.2: Se é uma concessão temporária de permissão"
    },
    "data_expiracao_concessao": {
      "type": "string",
      "format": "date-time",
      "description": "Vol 3.2: Data de expiração da concessão temporária"
    },
    "excecao_aprovada_superior": {
      "type": "boolean",
      "default": false,
      "description": "Vol 3.2: Se foi aprovada como exceção por superior (fluxo de exceção)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado",
        "cancelado",
        "expirado"
      ],
      "default": "pendente"
    },
    "comentarios_aprovacao": {
      "type": "string"
    },
    "data_solicitacao": {
      "type": "string",
      "format": "date-time"
    },
    "data_decisao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tipo_solicitacao",
    "entidade_alvo",
    "entidade_alvo_id",
    "dados_propostos",
    "justificativa"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}