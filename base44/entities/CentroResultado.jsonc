{
  "name": "CentroResultado",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se específico da empresa)"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa",
      "description": "Indica se foi criado no grupo ou na empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do centro de resultado"
    },
    "nome": {
      "type": "string",
      "description": "Nome do centro de resultado"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_centro": {
      "type": "string",
      "enum": [
        "Produto",
        "Serviço",
        "Departamento",
        "Projeto",
        "Cliente",
        "Regional",
        "Outro"
      ],
      "default": "Departamento"
    },
    "centro_pai_id": {
      "type": "string",
      "description": "ID do centro de resultado pai (para hierarquia)"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do usuário responsável"
    },
    "meta_receita_mensal": {
      "type": "number",
      "default": 0
    },
    "meta_despesa_mensal": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}