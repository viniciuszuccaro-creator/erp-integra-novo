{
  "name": "PerfilAcesso",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "nome_perfil": {
      "type": "string",
      "description": "Nome do perfil de acesso"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do perfil"
    },
    "nivel_perfil": {
      "type": "string",
      "enum": [
        "Administrador",
        "Gerencial",
        "Operacional",
        "Consulta",
        "Personalizado"
      ],
      "default": "Operacional",
      "description": "N\u00edvel hier\u00e1rquico do perfil"
    },
    "permissoes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Estrutura flex\u00edvel: m\u00f3dulo \u2192 se\u00e7\u00e3o \u2192 [a\u00e7\u00f5es]. Aceita qualquer m\u00f3dulo/se\u00e7\u00e3o dinamicamente sem restri\u00e7\u00f5es de schema fixo."
    },
    "permissoes_sensiveis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de permiss\u00f5es consideradas sens\u00edveis (para IA de SoD)"
    },
    "conflitos_sod_detectados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo_conflito": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "severidade": {
            "type": "string",
            "enum": [
              "Baixa",
              "M\u00e9dia",
              "Alta",
              "Cr\u00edtica"
            ]
          },
          "data_deteccao": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Conflitos de Segrega\u00e7\u00e3o de Fun\u00e7\u00f5es detectados pela IA"
    },
    "requer_aprovacao_especial": {
      "type": "boolean",
      "default": false,
      "description": "Se a atribui\u00e7\u00e3o deste perfil requer aprova\u00e7\u00e3o especial"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Usu\u00e1rio que aprovou este perfil"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_perfil",
    "permissoes"
  ]
}