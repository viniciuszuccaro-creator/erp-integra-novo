{
  "name": "TabelaFiscal",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa para a qual esta regra fiscal se aplica - OBRIGATÓRIO"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "nome_regra": {
      "type": "string",
      "description": "Nome descritivo da regra fiscal"
    },
    "regime_tributario": {
      "type": "string",
      "enum": [
        "Simples Nacional",
        "Lucro Presumido",
        "Lucro Real"
      ],
      "description": "Regime tributário da empresa"
    },
    "cenario_operacao": {
      "type": "string",
      "enum": [
        "Venda Consumidor Final",
        "Venda para Revenda",
        "Venda Industrialização",
        "Devolução",
        "Remessa",
        "Transferência",
        "Compra Nacional",
        "Importação"
      ],
      "description": "Cenário de operação"
    },
    "ncm": {
      "type": "string",
      "description": "NCM do produto"
    },
    "cfop": {
      "type": "string",
      "description": "CFOP aplicável (Ex: 5102, 6102)"
    },
    "destino_operacao": {
      "type": "string",
      "enum": [
        "Dentro do Estado",
        "Fora do Estado",
        "Exterior"
      ],
      "default": "Dentro do Estado"
    },
    "tipo_cliente": {
      "type": "string",
      "enum": [
        "Pessoa Física",
        "Pessoa Jurídica",
        "Contribuinte ICMS",
        "Não Contribuinte"
      ],
      "description": "Tipo de cliente/fornecedor"
    },
    "icms_cst_csosn": {
      "type": "string",
      "description": "CST (regime normal) ou CSOSN (Simples Nacional)"
    },
    "icms_aliquota": {
      "type": "number",
      "default": 0
    },
    "icms_reducao_base": {
      "type": "number",
      "default": 0,
      "description": "% de redução da base de cálculo"
    },
    "icms_st_aliquota": {
      "type": "number",
      "default": 0
    },
    "icms_st_mva": {
      "type": "number",
      "default": 0,
      "description": "MVA - Margem de Valor Agregado para ST"
    },
    "pis_cst": {
      "type": "string",
      "description": "CST do PIS"
    },
    "pis_aliquota": {
      "type": "number",
      "default": 0
    },
    "cofins_cst": {
      "type": "string",
      "description": "CST do COFINS"
    },
    "cofins_aliquota": {
      "type": "number",
      "default": 0
    },
    "ipi_cst": {
      "type": "string",
      "description": "CST do IPI"
    },
    "ipi_aliquota": {
      "type": "number",
      "default": 0
    },
    "fcp_aliquota": {
      "type": "number",
      "default": 0,
      "description": "Alíquota do FCP - Fundo de Combate à Pobreza"
    },
    "diferencial_aliquota": {
      "type": "number",
      "default": 0,
      "description": "DIFAL - Diferencial de Alíquota"
    },
    "origem_mercadoria": {
      "type": "string",
      "enum": [
        "0 - Nacional",
        "1 - Estrangeira Importação Direta",
        "2 - Estrangeira Mercado Interno"
      ],
      "default": "0 - Nacional"
    },
    "modalidade_base_calculo": {
      "type": "string",
      "enum": [
        "Margem Valor Agregado",
        "Pauta",
        "Preço Tabelado",
        "Valor da Operação"
      ],
      "default": "Valor da Operação"
    },
    "regra_ativa": {
      "type": "boolean",
      "default": true
    },
    "prioridade": {
      "type": "number",
      "default": 100,
      "description": "Prioridade de aplicação (quanto maior, mais prioritária)"
    },
    "validado_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA validou esta configuração"
    },
    "confianca_ia": {
      "type": "number",
      "default": 0,
      "description": "% de confiança da IA (0-100)"
    },
    "ultima_validacao_ia": {
      "type": "string",
      "format": "date-time"
    },
    "sugerida_por_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se foi sugerida automaticamente pela IA"
    },
    "aprovada_por": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time"
    },
    "observacoes": {
      "type": "string"
    },
    "legislacao_base": {
      "type": "string",
      "description": "Referência à legislação que embasa esta configuração"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a regra fiscal está ativa"
    }
  },
  "required": [
    "empresa_id",
    "nome_regra",
    "regime_tributario",
    "cfop"
  ]
}
