{
  "name": "UnidadeMedida",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "sigla": {
      "type": "string",
      "description": "Sigla da unidade (UN, KG, MT, etc.)"
    },
    "nome_completo": {
      "type": "string",
      "description": "Nome completo da unidade"
    },
    "tipo_grandeza": {
      "type": "string",
      "enum": [
        "Massa",
        "Comprimento",
        "Volume",
        "\u00c1rea",
        "Unidade",
        "Tempo",
        "Outro"
      ],
      "default": "Unidade"
    },
    "permite_conversao": {
      "type": "boolean",
      "default": true,
      "description": "Se permite convers\u00e3o com outras unidades"
    },
    "unidade_base_conversao": {
      "type": "string",
      "description": "Unidade base para convers\u00e3o (ex: KG para massa, MT para comprimento)"
    },
    "fator_conversao_para_base": {
      "type": "number",
      "default": 1,
      "description": "Fator de convers\u00e3o para a unidade base"
    },
    "usa_em_estoque": {
      "type": "boolean",
      "default": true
    },
    "usa_em_compras": {
      "type": "boolean",
      "default": true
    },
    "usa_em_vendas": {
      "type": "boolean",
      "default": true
    },
    "usa_em_producao": {
      "type": "boolean",
      "default": false
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "sigla",
    "nome_completo"
  ]
}