{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa proprietária"
    },
    "empresa_dona_id": {
      "type": "string",
      "description": "Empresa que cadastrou/é dona do cliente"
    },
    "empresas_compartilhadas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das empresas que podem atender este cliente"
    },
    "codigo": {
      "type": "string",
      "description": "Código único do cliente"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Pessoa Física",
        "Pessoa Jurídica"
      ],
      "description": "Tipo de cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo",
        "Prospect",
        "Bloqueado"
      ],
      "default": "Prospect"
    },
    "status_fiscal_receita": {
      "type": "string",
      "enum": [
        "Ativa",
        "Inapta",
        "Suspensa",
        "Baixada",
        "Não Verificado"
      ],
      "default": "Não Verificado",
      "description": "Status na Receita Federal consultado por IA"
    },
    "motivo_inatividade": {
      "type": "string",
      "description": "Motivo de inativação/bloqueio"
    },
    "nome": {
      "type": "string",
      "description": "Nome do cliente ou Razão Social"
    },
    "razao_social": {
      "type": "string"
    },
    "nome_fantasia": {
      "type": "string"
    },
    "cpf": {
      "type": "string",
      "description": "CPF (apenas PF)"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ único do cliente"
    },
    "rg": {
      "type": "string",
      "description": "RG (apenas PF)"
    },
    "inscricao_estadual": {
      "type": "string",
      "description": "IE (apenas PJ)"
    },
    "inscricao_municipal": {
      "type": "string"
    },
    "cnae_principal": {
      "type": "string",
      "description": "CNAE principal (consultado via IA)"
    },
    "ramo_atividade": {
      "type": "string",
      "description": "Ramo de atividade (sugerido por IA)"
    },
    "porte_empresa": {
      "type": "string",
      "enum": [
        "MEI",
        "Micro",
        "Pequena",
        "Média",
        "Grande"
      ],
      "description": "Porte da empresa (sugerido por IA)"
    },
    "segmento_cliente_id": {
      "type": "string",
      "description": "ID do segmento do cliente"
    },
    "regiao_atendimento_id": {
      "type": "string",
      "description": "ID da região de atendimento do cliente"
    },
    "regiao_atendimento_nome": {
      "type": "string",
      "description": "Nome da região (snapshot)"
    },
    "origem_cadastro": {
      "type": "string",
      "enum": [
        "ERP",
        "Portal",
        "Site",
        "Marketplace",
        "Chatbot",
        "WhatsApp",
        "API",
        "E-commerce"
      ],
      "default": "ERP",
      "description": "Origem do cadastro"
    },
    "status_validacao_kyc": {
      "type": "string",
      "enum": [
        "Pendente",
        "Em Análise",
        "Aprovado",
        "Reprovado"
      ],
      "default": "Pendente",
      "description": "Status de validação KYC/KYB"
    },
    "risco_cadastro_ia": {
      "type": "string",
      "enum": [
        "Baixo",
        "Médio",
        "Alto"
      ],
      "default": "Baixo",
      "description": "Risco de cadastro calculado por IA"
    },
    "data_validacao_kyc": {
      "type": "string",
      "format": "date-time",
      "description": "Data da validação KYC"
    },
    "endereco_principal": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "pais": {
          "type": "string",
          "default": "Brasil"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "mapa_url": {
          "type": "string"
        }
      }
    },
    "contatos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "cargo": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Telefone",
              "WhatsApp",
              "E-mail",
              "Celular"
            ]
          },
          "valor": {
            "type": "string"
          },
          "principal": {
            "type": "boolean",
            "default": false
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Múltiplos contatos do cliente"
    },
    "contatos_b2b_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos contatos B2B vinculados"
    },
    "historico_comunicacao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "WhatsApp",
              "E-mail",
              "Telefone",
              "Reunião",
              "Visita"
            ]
          },
          "assunto": {
            "type": "string"
          },
          "resumo": {
            "type": "string"
          },
          "responsavel": {
            "type": "string"
          },
          "anexo_url": {
            "type": "string"
          }
        }
      },
      "description": "Histórico de comunicações"
    },
    "condicao_comercial": {
      "type": "object",
      "properties": {
        "tabela_preco_id": {
          "type": "string"
        },
        "tabela_preco_nome": {
          "type": "string"
        },
        "forma_pagamento_padrao_id": {
          "type": "string"
        },
        "forma_pagamento_padrao_nome": {
          "type": "string"
        },
        "percentual_desconto": {
          "type": "number"
        },
        "condicao_pagamento": {
          "type": "string",
          "enum": [
            "À Vista",
            "7 dias",
            "15 dias",
            "30 dias",
            "45 dias",
            "60 dias",
            "Parcelado"
          ],
          "default": "À Vista"
        },
        "prazo_pagamento_dias": {
          "type": "number"
        },
        "limite_credito": {
          "type": "number",
          "default": 0
        },
        "limite_credito_grupo": {
          "type": "number",
          "default": 0
        },
        "limite_credito_utilizado": {
          "type": "number",
          "default": 0
        },
        "limite_aprovado_por": {
          "type": "string"
        },
        "limite_aprovado_em": {
          "type": "string",
          "format": "date"
        },
        "vigencia_desconto_ate": {
          "type": "string",
          "format": "date"
        },
        "dia_vencimento_preferencial": {
          "type": "number"
        },
        "situacao_credito": {
          "type": "string",
          "enum": [
            "OK",
            "Alerta",
            "Bloqueado"
          ],
          "default": "OK"
        }
      }
    },
    "locais_entrega": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "apelido": {
            "type": "string"
          },
          "tipo_endereco": {
            "type": "string",
            "enum": [
              "Entrega",
              "Cobrança",
              "Matriz",
              "Obra",
              "Outro"
            ],
            "default": "Entrega"
          },
          "cep": {
            "type": "string"
          },
          "logradouro": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "complemento": {
            "type": "string"
          },
          "bairro": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "mapa_url": {
            "type": "string"
          },
          "horario_inicio": {
            "type": "string"
          },
          "horario_fim": {
            "type": "string"
          },
          "janela_entrega_preferencial": {
            "type": "string",
            "enum": [
              "Manhã",
              "Tarde",
              "Noite",
              "Indiferente"
            ],
            "default": "Indiferente"
          },
          "tipo_descarga": {
            "type": "string",
            "enum": [
              "Manual",
              "Empilhadeira",
              "Munck",
              "Outro"
            ],
            "default": "Manual"
          },
          "contato_nome": {
            "type": "string"
          },
          "contato_telefone": {
            "type": "string"
          },
          "observacoes": {
            "type": "string"
          },
          "principal": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Múltiplos endereços de entrega"
    },
    "configuracao_fiscal": {
      "type": "object",
      "properties": {
        "regime_tributario": {
          "type": "string",
          "enum": [
            "Simples Nacional",
            "Lucro Presumido",
            "Lucro Real",
            "MEI"
          ],
          "default": "Simples Nacional"
        },
        "cfop_padrao_venda": {
          "type": "string",
          "default": "5102"
        },
        "isento_ipi": {
          "type": "boolean",
          "default": false
        },
        "isento_icms": {
          "type": "boolean",
          "default": false
        },
        "contribuinte_icms": {
          "type": "boolean",
          "default": true
        },
        "tipo_contribuinte": {
          "type": "string",
          "enum": [
            "1 - Contribuinte",
            "2 - Isento",
            "9 - Não Contribuinte"
          ],
          "default": "1 - Contribuinte"
        },
        "substituicao_tributaria_especial": {
          "type": "boolean",
          "default": false
        },
        "utilizar_nfe_interna": {
          "type": "boolean",
          "default": false
        },
        "nfe_interna_aprovado_por": {
          "type": "string"
        },
        "nfe_interna_aprovado_em": {
          "type": "string",
          "format": "date-time"
        },
        "observacoes_fiscais": {
          "type": "string"
        }
      }
    },
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Contrato Social",
              "Certidão Negativa",
              "Inscrição Estadual",
              "Comprovante Endereço",
              "Referência Comercial",
              "Proposta Comercial",
              "RG",
              "CPF",
              "Outros"
            ]
          },
          "nome_arquivo": {
            "type": "string"
          },
          "url_arquivo": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date"
          },
          "data_validade": {
            "type": "string",
            "format": "date"
          },
          "observacao": {
            "type": "string"
          },
          "upload_por": {
            "type": "string"
          }
        }
      },
      "description": "Documentos anexados"
    },
    "vendedor_responsavel": {
      "type": "string",
      "description": "V21.5: Nome do vendedor (preenchido automático)"
    },
    "vendedor_responsavel_id": {
      "type": "string",
      "description": "V21.5: ID do vendedor (preenchido automático com usuário logado)"
    },
    "indicador_nome": {
      "type": "string",
      "description": "V21.5: Nome de quem indicou (Representante/Construtor/Arquiteto/Engenheiro)"
    },
    "indicador_id": {
      "type": "string",
      "description": "V21.5: ID do indicador no cadastro de Representantes"
    },
    "tipo_indicador": {
      "type": "string",
      "enum": [
        "Representante Comercial",
        "Construtor",
        "Arquiteto",
        "Engenheiro",
        "Influenciador",
        "Parceiro",
        "Outro"
      ],
      "description": "V21.5: Tipo do indicador (snapshot do Representante)"
    },
    "percentual_comissao_indicador": {
      "type": "number",
      "default": 0,
      "description": "V21.5: % de comissão do indicador (snapshot)"
    },
    "representante_id": {
      "type": "string",
      "description": "ID do representante vinculado"
    },
    "classificacao_abc": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "Novo"
      ],
      "default": "Novo",
      "description": "Classificação automática por volume de compras"
    },
    "valor_compras_12meses": {
      "type": "number",
      "default": 0
    },
    "data_primeira_compra": {
      "type": "string",
      "format": "date"
    },
    "data_ultima_compra": {
      "type": "string",
      "format": "date"
    },
    "quantidade_pedidos": {
      "type": "number",
      "default": 0
    },
    "ticket_medio": {
      "type": "number",
      "default": 0
    },
    "dias_sem_comprar": {
      "type": "number",
      "default": 0,
      "description": "Dias desde última compra (calculado por IA)"
    },
    "risco_churn": {
      "type": "string",
      "enum": [
        "Baixo",
        "Médio",
        "Alto",
        "Crítico"
      ],
      "default": "Baixo",
      "description": "Risco de perda calculado por IA"
    },
    "produtos_mais_comprados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "quantidade_total": {
            "type": "number"
          },
          "ultima_compra": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "Top 10 produtos mais comprados"
    },
    "score_pagamento": {
      "type": "number",
      "default": 100,
      "description": "Score de 0-100 baseado em histórico de pagamento"
    },
    "score_confianca_ia": {
      "type": "number",
      "default": 50,
      "description": "Score de confiança gerado pela IA (0-100)"
    },
    "score_saude_cliente": {
      "type": "number",
      "default": 100,
      "description": "Score de saúde do relacionamento (0-100)"
    },
    "dias_atraso_medio": {
      "type": "number",
      "default": 0
    },
    "pontos_fidelidade": {
      "type": "number",
      "default": 0
    },
    "cashback_disponivel": {
      "type": "number",
      "default": 0
    },
    "proxima_acao": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "format": "date"
        },
        "descricao": {
          "type": "string"
        },
        "responsavel": {
          "type": "string"
        }
      },
      "description": "Próxima ação do CRM"
    },
    "canal_preferencial": {
      "type": "string",
      "enum": [
        "Portal",
        "WhatsApp",
        "E-mail",
        "Telefone",
        "Presencial"
      ],
      "description": "Canal de comunicação preferencial calculado por IA"
    },
    "uso_portal": {
      "type": "object",
      "properties": {
        "total_acessos": {
          "type": "number",
          "default": 0
        },
        "ultimo_acesso": {
          "type": "string",
          "format": "date-time"
        },
        "tempo_medio_sessao_min": {
          "type": "number"
        },
        "abas_mais_usadas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dispositivo_preferencial": {
          "type": "string",
          "enum": [
            "Desktop",
            "Mobile",
            "Tablet"
          ]
        }
      },
      "description": "Métricas de uso do portal"
    },
    "uso_canais": {
      "type": "object",
      "properties": {
        "total_whatsapp": {
          "type": "number",
          "default": 0
        },
        "total_email": {
          "type": "number",
          "default": 0
        },
        "total_telefone": {
          "type": "number",
          "default": 0
        },
        "total_portal": {
          "type": "number",
          "default": 0
        },
        "canal_mais_usado": {
          "type": "string"
        }
      },
      "description": "IA de Preferência de Canal"
    },
    "pode_ver_portal": {
      "type": "boolean",
      "default": false,
      "description": "Se tem acesso ao Portal do Cliente"
    },
    "pode_ver_financeiro_no_portal": {
      "type": "boolean",
      "default": true,
      "description": "Se pode ver boletos/contas no portal"
    },
    "pode_aprovar_orcamento_portal": {
      "type": "boolean",
      "default": false,
      "description": "Se pode aprovar orçamentos pelo portal"
    },
    "pode_atualizar_cadastro_portal": {
      "type": "boolean",
      "default": true,
      "description": "Se pode atualizar dados pelo portal"
    },
    "portal_usuario_id": {
      "type": "string",
      "description": "ID do usuário no portal (se cadastrado)"
    },
    "lgpd_autorizacoes": {
      "type": "object",
      "properties": {
        "autoriza_comunicacao_comercial": {
          "type": "boolean",
          "default": false
        },
        "autoriza_email_marketing": {
          "type": "boolean",
          "default": false
        },
        "autoriza_whatsapp_marketing": {
          "type": "boolean",
          "default": false
        },
        "autoriza_sms": {
          "type": "boolean",
          "default": false
        },
        "data_aceite_termos": {
          "type": "string",
          "format": "date-time"
        },
        "ip_aceite": {
          "type": "string"
        }
      },
      "description": "Autorizações LGPD"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo"
  ]
}
