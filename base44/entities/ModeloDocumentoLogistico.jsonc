{
  "name": "ModeloDocumentoLogistico",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do modelo"
    },
    "nome_modelo": {
      "type": "string",
      "description": "Nome do modelo — único por grupo"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "Romaneio",
        "Etiqueta Volume",
        "Checklist Carga",
        "Canhoto",
        "Ordem Separação",
        "Outro"
      ],
      "description": "Tipo de documento"
    },
    "descricao": {
      "type": "string"
    },
    "layout_template": {
      "type": "string",
      "description": "Template HTML/JSON do layout"
    },
    "campos_obrigatorios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Campos obrigatórios no documento"
    },
    "campos_opcionais": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Campos opcionais"
    },
    "incluir_logo_empresa": {
      "type": "boolean",
      "default": true
    },
    "incluir_qrcode": {
      "type": "boolean",
      "default": true,
      "description": "Se inclui QR Code para rastreamento"
    },
    "incluir_assinatura_digital": {
      "type": "boolean",
      "default": false
    },
    "formato_saida": {
      "type": "string",
      "enum": [
        "PDF",
        "HTML",
        "Imagem",
        "Térmico"
      ],
      "default": "PDF"
    },
    "tamanho_papel": {
      "type": "string",
      "enum": [
        "A4",
        "A5",
        "Térmico 80mm",
        "Térmico 58mm",
        "Personalizado"
      ],
      "default": "A4"
    },
    "orientacao": {
      "type": "string",
      "enum": [
        "Retrato",
        "Paisagem"
      ],
      "default": "Retrato"
    },
    "padrao_empresa": {
      "type": "boolean",
      "default": false,
      "description": "Se é o modelo padrão da empresa"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_modelo",
    "tipo_documento"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}