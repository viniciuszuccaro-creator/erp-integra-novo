{
  "name": "FormaPagamento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se espec\u00edfico por empresa)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico da forma de pagamento"
    },
    "descricao": {
      "type": "string",
      "description": "Nome da forma de pagamento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Dinheiro",
        "PIX",
        "Boleto",
        "Cart\u00e3o Cr\u00e9dito",
        "Cart\u00e3o D\u00e9bito",
        "Transfer\u00eancia",
        "Cheque",
        "Cr\u00e9dito em Conta",
        "Fidelidade/Cashback",
        "Outro"
      ],
      "description": "Tipo base da forma de pagamento"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativa para uso"
    },
    "aceita_desconto": {
      "type": "boolean",
      "default": true,
      "description": "Se permite desconto"
    },
    "percentual_desconto_padrao": {
      "type": "number",
      "default": 0,
      "description": "% de desconto padr\u00e3o"
    },
    "aplicar_acrescimo": {
      "type": "boolean",
      "default": false,
      "description": "Se aplica acr\u00e9scimo/taxa"
    },
    "percentual_acrescimo_padrao": {
      "type": "number",
      "default": 0,
      "description": "% de acr\u00e9scimo (ex: taxa cart\u00e3o)"
    },
    "prazo_compensacao_dias": {
      "type": "number",
      "default": 0,
      "description": "Dias para compensa\u00e7\u00e3o/recebimento"
    },
    "gerar_cobranca_online": {
      "type": "boolean",
      "default": false,
      "description": "Se gera cobran\u00e7a via gateway"
    },
    "integracao_obrigatoria": {
      "type": "boolean",
      "default": false,
      "description": "Se requer integra\u00e7\u00e3o ativa para usar"
    },
    "banco_vinculado_id": {
      "type": "string",
      "description": "ID do banco vinculado para cobran\u00e7a online (PIX/Boleto banc\u00e1rio)"
    },
    "gateway_pagamento_id": {
      "type": "string",
      "description": "ID do gateway de pagamento vinculado (Pagar.me, Stripe, etc)"
    },
    "gateway_pagamento_nome": {
      "type": "string",
      "description": "Nome do gateway (snapshot)"
    },
    "usa_gateway": {
      "type": "boolean",
      "default": false,
      "description": "Se usa gateway de pagamento ao inv\u00e9s de banco direto"
    },
    "permite_parcelamento": {
      "type": "boolean",
      "default": false,
      "description": "Se permite parcelar"
    },
    "maximo_parcelas": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero m\u00e1ximo de parcelas"
    },
    "intervalo_parcelas_dias": {
      "type": "number",
      "default": 30,
      "description": "Dias entre parcelas (gen\u00e9rico)"
    },
    "taxa_por_parcela": {
      "type": "number",
      "default": 0,
      "description": "Taxa % por parcela (gen\u00e9rica)"
    },
    "configuracao_parcelas_cartao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero_parcela": {
            "type": "number",
            "description": "N\u00famero da parcela (1, 2, 3...)"
          },
          "dias_vencimento": {
            "type": "number",
            "description": "Dias corridos at\u00e9 vencimento desta parcela"
          },
          "taxa_percentual": {
            "type": "number",
            "description": "Taxa % espec\u00edfica desta parcela"
          }
        }
      },
      "description": "Configura\u00e7\u00e3o individual de cada parcela para Cart\u00e3o de Cr\u00e9dito"
    },
    "icone": {
      "type": "string",
      "description": "Nome do \u00edcone (lucide-react)"
    },
    "cor": {
      "type": "string",
      "description": "Cor hexadecimal para UI"
    },
    "ordem_exibicao": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o na lista"
    },
    "disponivel_ecommerce": {
      "type": "boolean",
      "default": false,
      "description": "Se aparece no e-commerce (futuro)"
    },
    "disponivel_pdv": {
      "type": "boolean",
      "default": true,
      "description": "Se aparece no PDV/App"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "descricao",
    "tipo"
  ]
}