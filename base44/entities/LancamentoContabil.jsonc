{
  "name": "LancamentoContabil",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date",
      "description": "Data do lançamento contábil"
    },
    "historico": {
      "type": "string",
      "description": "Histórico do lançamento"
    },
    "documento": {
      "type": "string",
      "description": "Número do documento (NF, Pedido, etc.)"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "NF-e",
        "Pedido",
        "Conta a Pagar",
        "Conta a Receber",
        "Movimentação Estoque",
        "Ordem de Produção",
        "Transferência",
        "Manual",
        "Outro"
      ],
      "description": "Tipo do documento origem"
    },
    "documento_origem_id": {
      "type": "string",
      "description": "ID do documento que gerou o lançamento"
    },
    "conta_debito_id": {
      "type": "string",
      "description": "ID da conta debitada"
    },
    "conta_debito_codigo": {
      "type": "string",
      "description": "Código da conta debitada"
    },
    "conta_debito_descricao": {
      "type": "string",
      "description": "Descrição da conta debitada"
    },
    "conta_credito_id": {
      "type": "string",
      "description": "ID da conta creditada"
    },
    "conta_credito_codigo": {
      "type": "string",
      "description": "Código da conta creditada"
    },
    "conta_credito_descricao": {
      "type": "string",
      "description": "Descrição da conta creditada"
    },
    "valor": {
      "type": "number",
      "description": "Valor do lançamento"
    },
    "centro_custo_id": {
      "type": "string",
      "description": "Centro de custo vinculado"
    },
    "centro_custo_nome": {
      "type": "string"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Financeiro",
        "Fiscal",
        "Estoque",
        "Produção",
        "Folha de Pagamento",
        "Manual",
        "Importação",
        "Ajuste"
      ],
      "description": "Origem do lançamento"
    },
    "automatico": {
      "type": "boolean",
      "default": false,
      "description": "Se foi gerado automaticamente pelo sistema"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Efetivado",
        "Estornado",
        "Cancelado"
      ],
      "default": "Efetivado"
    },
    "lote": {
      "type": "string",
      "description": "Número do lote de lançamentos"
    },
    "data_estorno": {
      "type": "string",
      "format": "date-time",
      "description": "Data do estorno (se aplicável)"
    },
    "lancamento_estorno_id": {
      "type": "string",
      "description": "ID do lançamento de estorno"
    },
    "usuario_responsavel": {
      "type": "string",
      "description": "Usuário que criou o lançamento"
    },
    "usuario_responsavel_id": {
      "type": "string"
    },
    "periodo_competencia": {
      "type": "string",
      "description": "Período de competência (YYYY-MM)"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "data_lancamento",
    "conta_debito_id",
    "conta_credito_id",
    "valor",
    "empresa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}