{
  "name": "SeparacaoConferencia",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa respons\u00e1vel"
    },
    "numero_separacao": {
      "type": "string",
      "description": "N\u00famero sequencial da separa\u00e7\u00e3o"
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do pedido"
    },
    "numero_pedido": {
      "type": "string"
    },
    "op_id": {
      "type": "string",
      "description": "ID da OP (se for item de produ\u00e7\u00e3o)"
    },
    "numero_op": {
      "type": "string"
    },
    "entrega_id": {
      "type": "string",
      "description": "ID da entrega vinculada"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "separacao",
        "conferencia"
      ],
      "default": "separacao",
      "description": "Tipo de opera\u00e7\u00e3o"
    },
    "data_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de in\u00edcio"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de conclus\u00e3o"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do colaborador respons\u00e1vel"
    },
    "responsavel_nome": {
      "type": "string"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_pedido_id": {
            "type": "string"
          },
          "produto_id": {
            "type": "string"
          },
          "item_producao_id": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "tipo_item": {
            "type": "string",
            "enum": [
              "revenda",
              "producao"
            ]
          },
          "quantidade_pedida": {
            "type": "number"
          },
          "quantidade_separada": {
            "type": "number"
          },
          "quantidade_conferida": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "lote": {
            "type": "string"
          },
          "localizacao_estoque": {
            "type": "string"
          },
          "status_item": {
            "type": "string",
            "enum": [
              "ok",
              "faltando",
              "substituido",
              "divergente",
              "aguardando"
            ],
            "default": "aguardando"
          },
          "divergencia": {
            "type": "boolean",
            "default": false
          },
          "motivo_divergencia": {
            "type": "string"
          },
          "observacao_item": {
            "type": "string"
          },
          "foto_item_url": {
            "type": "string"
          }
        }
      },
      "description": "Itens sendo separados/conferidos"
    },
    "rota_picking_otimizada": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequencia": {
            "type": "number"
          },
          "item_id": {
            "type": "string"
          },
          "localizacao": {
            "type": "string"
          },
          "distancia_anterior_m": {
            "type": "number"
          }
        }
      },
      "description": "Rota otimizada pela IA de Picking (V16.1)"
    },
    "tempo_picking_estimado_min": {
      "type": "number",
      "description": "Tempo estimado pela IA (V16.1)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "em_andamento",
        "concluido",
        "com_divergencia",
        "cancelado"
      ],
      "default": "aberto"
    },
    "tem_divergencia": {
      "type": "boolean",
      "default": false,
      "description": "Se possui alguma diverg\u00eancia"
    },
    "divergencias_resumo": {
      "type": "string",
      "description": "Resumo das diverg\u00eancias encontradas"
    },
    "acao_divergencia": {
      "type": "string",
      "enum": [
        "retornar_producao",
        "solicitar_estoque",
        "informar_cliente",
        "substituir_item",
        "aguardar_definicao"
      ],
      "description": "A\u00e7\u00e3o tomada para resolver diverg\u00eancia"
    },
    "tempo_separacao_min": {
      "type": "number",
      "description": "Tempo gasto na separa\u00e7\u00e3o (minutos)"
    },
    "checklist": {
      "type": "object",
      "properties": {
        "conferiu_quantidade": {
          "type": "boolean",
          "default": false
        },
        "conferiu_qualidade": {
          "type": "boolean",
          "default": false
        },
        "conferiu_embalagem": {
          "type": "boolean",
          "default": false
        },
        "conferiu_etiquetas": {
          "type": "boolean",
          "default": false
        },
        "conferiu_documentos": {
          "type": "boolean",
          "default": false
        },
        "observacoes_checklist": {
          "type": "string"
        }
      },
      "description": "Checklist de confer\u00eancia"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Foto",
              "PDF",
              "Lista",
              "Outro"
            ]
          },
          "url": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Anexos da separa\u00e7\u00e3o"
    },
    "assinatura_conferente_url": {
      "type": "string",
      "description": "Assinatura digital do conferente"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "pedido_id",
    "tipo",
    "data_inicio"
  ]
}