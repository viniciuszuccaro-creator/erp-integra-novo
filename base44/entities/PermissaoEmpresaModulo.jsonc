{
  "name": "PermissaoEmpresaModulo",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da permissão"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usuário"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usuário"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "Dashboard",
        "Comercial e Vendas",
        "Financeiro e Contábil",
        "Estoque e Almoxarifado",
        "Compras e Suprimentos",
        "Expedição e Logística",
        "Produção e Manufatura",
        "Recursos Humanos",
        "Fiscal e Tributário",
        "Cadastros Gerais",
        "CRM - Relacionamento",
        "Agenda e Calendário",
        "Relatórios e Análises",
        "Contratos",
        "Gestão de Empresas",
        "Controle de Acesso",
        "Integrações",
        "Configurações"
      ],
      "description": "Módulo do sistema"
    },
    "submodulo": {
      "type": "string",
      "description": "Submódulo específico (ex: Clientes, Pedidos, Notas Fiscais)"
    },
    "aba": {
      "type": "string",
      "description": "Aba específica dentro do submódulo"
    },
    "nivel_acesso": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Visualizar",
        "Editar",
        "Criar",
        "Excluir",
        "Aprovar"
      ],
      "default": "Nenhum",
      "description": "Nível de acesso concedido"
    },
    "data_concessao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de concessão da permissão"
    },
    "data_alteracao": {
      "type": "string",
      "format": "date-time",
      "description": "Última alteração"
    },
    "alterado_por": {
      "type": "string",
      "description": "Usuário que fez a última alteração"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a permissão está ativa"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "usuario_id",
    "empresa_id",
    "modulo",
    "nivel_acesso"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}