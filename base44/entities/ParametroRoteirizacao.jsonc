{
  "name": "ParametroRoteirizacao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico do par\u00e2metro"
    },
    "usa_google_maps": {
      "type": "boolean",
      "default": true,
      "description": "Se usa Google Maps API"
    },
    "google_maps_api_id": {
      "type": "string",
      "description": "ID da ApiExterna do Google Maps"
    },
    "prioridade_roteirizacao": {
      "type": "string",
      "enum": [
        "Menor Dist\u00e2ncia",
        "Menor Tempo",
        "Respeitar Janelas",
        "Balanceado"
      ],
      "default": "Balanceado",
      "description": "Prioridade na cria\u00e7\u00e3o de rotas"
    },
    "considera_janela_entrega": {
      "type": "boolean",
      "default": true,
      "description": "Se considera janelas de entrega"
    },
    "considera_tipo_descarga": {
      "type": "boolean",
      "default": true,
      "description": "Se considera tipo de descarga"
    },
    "agrupa_por_regiao": {
      "type": "boolean",
      "default": true
    },
    "agrupa_por_rota_padrao": {
      "type": "boolean",
      "default": true
    },
    "agrupa_por_transportadora": {
      "type": "boolean",
      "default": false
    },
    "max_entregas_por_rota": {
      "type": "number",
      "default": 20,
      "description": "M\u00e1ximo de entregas por rota"
    },
    "max_peso_por_veiculo_kg": {
      "type": "number",
      "description": "M\u00e1ximo de peso por ve\u00edculo"
    },
    "max_volume_por_veiculo_m3": {
      "type": "number",
      "description": "M\u00e1ximo de volume por ve\u00edculo"
    },
    "tempo_medio_descarga_minutos": {
      "type": "number",
      "default": 15,
      "description": "Tempo m\u00e9dio para descarga"
    },
    "velocidade_media_urbana_kmh": {
      "type": "number",
      "default": 30
    },
    "velocidade_media_rodovia_kmh": {
      "type": "number",
      "default": 80
    },
    "adicionar_margem_tempo_percentual": {
      "type": "number",
      "default": 20,
      "description": "Margem de tempo adicional (%)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id"
  ]
}