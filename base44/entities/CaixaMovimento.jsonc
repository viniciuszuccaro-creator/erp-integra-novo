{
  "name": "CaixaMovimento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "data_movimento": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do movimento"
    },
    "tipo_movimento": {
      "type": "string",
      "enum": [
        "Entrada",
        "Sa\u00edda",
        "Abertura",
        "Fechamento",
        "Sangria",
        "Refor\u00e7o"
      ],
      "description": "Tipo de movimento"
    },
    "origem": {
      "type": "string",
      "description": "Origem do movimento (Venda PDV, Liquida\u00e7\u00e3o, etc)"
    },
    "forma_pagamento": {
      "type": "string",
      "description": "Forma de pagamento utilizada"
    },
    "valor": {
      "type": "number",
      "description": "Valor do movimento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do pedido vinculado (se houver)"
    },
    "conta_receber_id": {
      "type": "string",
      "description": "ID da conta a receber vinculada"
    },
    "conta_pagar_id": {
      "type": "string",
      "description": "ID da conta a pagar vinculada"
    },
    "ordem_liquidacao_id": {
      "type": "string",
      "description": "ID da ordem de liquida\u00e7\u00e3o vinculada"
    },
    "usuario_operador_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio operador de caixa"
    },
    "usuario_operador_nome": {
      "type": "string",
      "description": "Nome do operador"
    },
    "operador_caixa_id": {
      "type": "string",
      "description": "ID do registro OperadorCaixa"
    },
    "caixa_aberto": {
      "type": "boolean",
      "default": true,
      "description": "Se o caixa estava aberto no momento"
    },
    "cancelado": {
      "type": "boolean",
      "default": false,
      "description": "Se o movimento foi cancelado"
    },
    "motivo_cancelamento": {
      "type": "string",
      "description": "Motivo do cancelamento"
    },
    "observacoes": {
      "type": "string"
    },
    "comprovante_url": {
      "type": "string",
      "description": "URL do comprovante (se houver)"
    }
  },
  "required": [
    "tipo_movimento",
    "valor",
    "data_movimento"
  ]
}