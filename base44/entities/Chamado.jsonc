{
  "type": "object",
  "name": "Chamado",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente que abriu o chamado"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "origem_chamado": {
      "type": "string",
      "enum": [
        "Portal",
        "WhatsApp",
        "E-mail",
        "Telefone",
        "Chatbot",
        "Site"
      ],
      "default": "Portal",
      "description": "Canal de abertura (V16.1)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do chamado"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do chamado"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Suporte T\u00e9cnico",
        "Financeiro",
        "Comercial",
        "Entrega",
        "Produto",
        "Outro"
      ],
      "default": "Suporte T\u00e9cnico",
      "description": "Categoria do chamado"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Urgente"
      ],
      "default": "M\u00e9dia",
      "description": "Prioridade do chamado"
    },
    "prioridade_ia": {
      "type": "number",
      "description": "Prioridade calculada por IA baseada em sentimento (0-100) (V16.1)"
    },
    "sentimento_detectado": {
      "type": "string",
      "enum": [
        "Positivo",
        "Neutro",
        "Negativo",
        "Urgente",
        "Frustrado"
      ],
      "description": "Sentimento da abertura (V16.1)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Em Andamento",
        "Aguardando Cliente",
        "Resolvido",
        "Fechado"
      ],
      "default": "Aberto",
      "description": "Status atual do chamado"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do colaborador respons\u00e1vel"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "data_abertura": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura do chamado"
    },
    "data_resolucao": {
      "type": "string",
      "format": "date",
      "description": "Data de resolu\u00e7\u00e3o do chamado"
    },
    "tempo_primeira_resposta_min": {
      "type": "number",
      "description": "Tempo at\u00e9 primeira resposta (SLA) (V16.1)"
    },
    "tempo_resolucao_horas": {
      "type": "number",
      "description": "Tempo total de resolu\u00e7\u00e3o (V16.1)"
    },
    "pedido_relacionado_id": {
      "type": "string",
      "description": "ID do pedido relacionado (V16.1)"
    },
    "entrega_relacionada_id": {
      "type": "string",
      "description": "ID da entrega relacionada (V16.1)"
    },
    "mensagens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "autor": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Cliente",
              "Atendente",
              "Bot IA"
            ]
          }
        }
      },
      "description": "Hist\u00f3rico de mensagens do chamado"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs dos anexos"
    },
    "avaliacao": {
      "type": "object",
      "properties": {
        "nota": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "comentario": {
          "type": "string"
        }
      },
      "description": "Avalia\u00e7\u00e3o do atendimento"
    }
  },
  "required": [
    "cliente_id",
    "titulo",
    "descricao",
    "categoria"
  ]
}