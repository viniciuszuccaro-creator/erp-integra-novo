{
  "name": "Or\u00e7amento Site \u2192 Pedido (onOrcamentoConfirmed)",
  "description": "Quando OrcamentoSite \u00e9 confirmado, converte para Pedido oficial sem redigita\u00e7\u00e3o. Atende \u00a78.3.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"Confirmado\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "OrcamentoSite"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "or_amento_site_pedido_onorcamentoconfirmed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onOrcamentoConfirmed",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onOrcamentoConfirmed"
  }
}