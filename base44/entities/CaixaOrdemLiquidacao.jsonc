{
  "name": "CaixaOrdemLiquidacao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "Recebimento",
        "Pagamento",
        "Transfer\u00eancia"
      ],
      "description": "Tipo de opera\u00e7\u00e3o financeira"
    },
    "origem": {
      "type": "string",
      "description": "Origem da ordem (Contas a Receber, Contas a Pagar, PDV, etc)"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total da ordem"
    },
    "forma_pagamento_pretendida": {
      "type": "string",
      "description": "Forma de pagamento que se pretende usar"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Em Processamento",
        "Processado",
        "Cancelado"
      ],
      "default": "Pendente",
      "description": "Status da ordem"
    },
    "titulos_vinculados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo_id": {
            "type": "string"
          },
          "tipo_titulo": {
            "type": "string"
          },
          "numero_titulo": {
            "type": "string"
          },
          "cliente_fornecedor_nome": {
            "type": "string"
          },
          "valor_titulo": {
            "type": "number"
          }
        }
      },
      "description": "T\u00edtulos vinculados a esta ordem"
    },
    "data_ordem": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da cria\u00e7\u00e3o da ordem"
    },
    "data_processamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do processamento"
    },
    "usuario_processou": {
      "type": "string",
      "description": "Usu\u00e1rio que processou"
    },
    "usuario_processou_id": {
      "type": "string"
    },
    "detalhes_processamento": {
      "type": "object",
      "additionalProperties": true,
      "description": "Detalhes do processamento (bandeira, taxa, etc)"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "tipo_operacao",
    "valor_total"
  ]
}