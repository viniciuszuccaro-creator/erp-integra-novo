{
  "name": "JobAgendado",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo num\u00e9rico sequencial \u00fanico"
    },
    "nome_job": {
      "type": "string",
      "description": "Nome do job"
    },
    "tipo_job": {
      "type": "string",
      "enum": [
        "IA_Fiscal",
        "IA_PriceBrain",
        "IA_Churn",
        "IA_KYC",
        "IA_Governanca",
        "IA_Logistica",
        "IA_Recomendacao",
        "Sincronizacao",
        "Backup",
        "Limpeza",
        "Relatorio"
      ],
      "default": "IA_Fiscal"
    },
    "descricao": {
      "type": "string"
    },
    "frequencia": {
      "type": "string",
      "enum": [
        "Hor\u00e1ria",
        "Di\u00e1ria",
        "Semanal",
        "Mensal",
        "Personalizada"
      ],
      "default": "Di\u00e1ria"
    },
    "horario_execucao": {
      "type": "string",
      "description": "Hor\u00e1rio de execu\u00e7\u00e3o (HH:MM)"
    },
    "dias_semana": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dias da semana (Segunda, Ter\u00e7a, etc)"
    },
    "parametros_execucao": {
      "type": "object",
      "description": "Par\u00e2metros customizados para execu\u00e7\u00e3o"
    },
    "ultima_execucao": {
      "type": "string",
      "format": "date-time"
    },
    "proxima_execucao": {
      "type": "string",
      "format": "date-time"
    },
    "total_execucoes": {
      "type": "number",
      "default": 0
    },
    "total_sucessos": {
      "type": "number",
      "default": 0
    },
    "total_falhas": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_job",
    "tipo_job",
    "frequencia"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}