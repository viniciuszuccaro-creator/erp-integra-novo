{
  "name": "MovimentoCartao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "caixa_movimento_id": {
      "type": "string",
      "description": "ID do movimento de caixa vinculado"
    },
    "conta_receber_id": {
      "type": "string",
      "description": "ID da conta a receber vinculada"
    },
    "pedido_id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "data_transacao": {
      "type": "string",
      "format": "date-time"
    },
    "valor_bruto": {
      "type": "number",
      "description": "Valor total da transação"
    },
    "bandeira": {
      "type": "string",
      "enum": [
        "Visa",
        "Mastercard",
        "Elo",
        "American Express",
        "Hipercard",
        "Outros"
      ],
      "description": "Bandeira do cartão"
    },
    "adquirente": {
      "type": "string",
      "enum": [
        "Cielo",
        "Rede",
        "Stone",
        "PagSeguro",
        "Mercado Pago",
        "GetNet",
        "SafraPay",
        "Outros"
      ],
      "description": "Adquirente/operadora"
    },
    "nsu": {
      "type": "string",
      "description": "Número Sequencial Único da transação"
    },
    "codigo_autorizacao": {
      "type": "string"
    },
    "numero_parcelas": {
      "type": "number",
      "default": 1
    },
    "taxa_mdr_percentual": {
      "type": "number",
      "description": "Taxa MDR (Merchant Discount Rate)"
    },
    "valor_taxa": {
      "type": "number",
      "description": "Valor da taxa cobrada"
    },
    "valor_liquido": {
      "type": "number",
      "description": "Valor que será recebido após taxas"
    },
    "previsao_recebimento": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de recebimento"
    },
    "data_recebimento_efetivo": {
      "type": "string",
      "format": "date"
    },
    "status_compensacao": {
      "type": "string",
      "enum": [
        "Em Trânsito",
        "A Compensar",
        "Compensado",
        "Cancelado",
        "Divergente",
        "Chargeback Solicitado",
        "Chargeback Confirmado"
      ],
      "default": "Em Trânsito"
    },
    "chargeback": {
      "type": "boolean",
      "default": false,
      "description": "Vol 10.3: Se houve chargeback (contestação pelo cliente)"
    },
    "data_chargeback": {
      "type": "string",
      "format": "date-time",
      "description": "Vol 10.3: Data/hora da solicitação de chargeback"
    },
    "motivo_chargeback": {
      "type": "string",
      "enum": [
        "Fraude",
        "Produto não recebido",
        "Produto divergente",
        "Duplicidade",
        "Cancelamento pelo cliente",
        "Valor divergente",
        "Outro"
      ],
      "description": "Vol 10.3: Motivo do chargeback"
    },
    "valor_chargeback": {
      "type": "number",
      "default": 0,
      "description": "Vol 10.3: Valor contestado (parcial ou total)"
    },
    "chargeback_resolvido": {
      "type": "boolean",
      "default": false,
      "description": "Vol 10.3: Se o chargeback foi resolvido (aceito ou revertido)"
    },
    "antecipacao": {
      "type": "boolean",
      "default": false,
      "description": "Vol 10.3: Se foi antecipado pelo adquirente"
    },
    "taxa_antecipacao": {
      "type": "number",
      "default": 0,
      "description": "Vol 10.3: Taxa cobrada pela antecipação"
    },
    "conciliacao_bancaria_id": {
      "type": "string",
      "description": "ID da conciliação bancária quando compensado"
    },
    "extrato_bancario_id": {
      "type": "string",
      "description": "ID do extrato bancário correspondente"
    },
    "divergencia_valor": {
      "type": "number",
      "default": 0,
      "description": "Diferença entre previsto e recebido"
    },
    "motivo_divergencia": {
      "type": "string"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "Crédito",
        "Débito"
      ],
      "default": "Crédito"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "data_transacao",
    "valor_bruto",
    "bandeira",
    "adquirente"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}