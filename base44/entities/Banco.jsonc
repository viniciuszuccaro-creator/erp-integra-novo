{
  "name": "Banco",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "codigo_banco": {
      "type": "string",
      "description": "C\u00f3digo do banco (ex: 001, 237, 341)"
    },
    "nome_banco": {
      "type": "string",
      "description": "Nome do banco"
    },
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do banco"
    },
    "pais": {
      "type": "string",
      "default": "Brasil"
    },
    "url_site": {
      "type": "string",
      "description": "Site do banco"
    },
    "integracao_disponivel": {
      "type": "boolean",
      "default": false,
      "description": "Se possui integra\u00e7\u00e3o dispon\u00edvel"
    },
    "tipo_integracao": {
      "type": "string",
      "enum": [
        "API",
        "OFX",
        "CNAB",
        "Open Banking",
        "Manual"
      ],
      "description": "Tipo de integra\u00e7\u00e3o"
    },
    "api_url": {
      "type": "string",
      "description": "URL da API do banco"
    },
    "api_versao": {
      "type": "string",
      "description": "Vers\u00e3o da API"
    },
    "suporta_conciliacao_automatica": {
      "type": "boolean",
      "default": false
    },
    "suporta_extrato_automatico": {
      "type": "boolean",
      "default": false
    },
    "suporta_cobranca_boleto": {
      "type": "boolean",
      "default": false
    },
    "suporta_cobranca_pix": {
      "type": "boolean",
      "default": false
    },
    "logo_url": {
      "type": "string",
      "description": "URL da logo do banco"
    },
    "cor_primaria": {
      "type": "string",
      "description": "Cor prim\u00e1ria do banco (hex)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "codigo_banco",
    "nome_banco"
  ]
}