{
  "name": "JobAgendado",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "nome_job": {
      "type": "string",
      "description": "Nome do job"
    },
    "tipo_job": {
      "type": "string",
      "enum": [
        "IA_Fiscal",
        "IA_PriceBrain",
        "IA_Churn",
        "IA_KYC",
        "IA_Governanca",
        "IA_Logistica",
        "IA_Recomendacao",
        "Sincronizacao",
        "Backup",
        "Limpeza",
        "Relatorio"
      ],
      "default": "IA_Fiscal"
    },
    "descricao": {
      "type": "string"
    },
    "frequencia": {
      "type": "string",
      "enum": [
        "Horária",
        "Diária",
        "Semanal",
        "Mensal",
        "Personalizada"
      ],
      "default": "Diária"
    },
    "horario_execucao": {
      "type": "string",
      "description": "Horário de execução (HH:MM)"
    },
    "dias_semana": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dias da semana (Segunda, Terça, etc)"
    },
    "parametros_execucao": {
      "type": "object",
      "description": "Parâmetros customizados para execução"
    },
    "ultima_execucao": {
      "type": "string",
      "format": "date-time"
    },
    "proxima_execucao": {
      "type": "string",
      "format": "date-time"
    },
    "total_execucoes": {
      "type": "number",
      "default": 0
    },
    "total_sucessos": {
      "type": "number",
      "default": 0
    },
    "total_falhas": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_job",
    "tipo_job",
    "frequencia"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}