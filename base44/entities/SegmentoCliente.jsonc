{
  "name": "SegmentoCliente",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do segmento"
    },
    "nome_segmento": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_segmento": {
      "type": "string",
      "enum": [
        "Industrial",
        "Comercial",
        "Constru\u00e7\u00e3o Civil",
        "Consumidor Final",
        "Governo",
        "Outro"
      ],
      "default": "Comercial"
    },
    "caracteristicas": {
      "type": "object",
      "properties": {
        "ticket_medio_esperado": {
          "type": "number"
        },
        "prazo_pagamento_comum": {
          "type": "number"
        },
        "frequencia_compra": {
          "type": "string",
          "enum": [
            "Alta",
            "M\u00e9dia",
            "Baixa"
          ]
        },
        "sazonalidade": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "politica_comercial_padrao": {
      "type": "object",
      "properties": {
        "tabela_preco_sugerida_id": {
          "type": "string"
        },
        "desconto_maximo_permitido": {
          "type": "number"
        },
        "prazo_pagamento_padrao": {
          "type": "string"
        }
      }
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_segmento"
  ]
}