{
  "name": "LogFiscal",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "nfe_id": {
      "type": "string",
      "description": "ID da nota fiscal"
    },
    "numero_nfe": {
      "type": "string",
      "description": "Número da NF-e"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso (se gerada)"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da tentativa"
    },
    "acao": {
      "type": "string",
      "enum": [
        "gerar_xml",
        "validar",
        "enviar_sefaz",
        "consultar_status",
        "cancelar",
        "carta_correcao",
        "inutilizar",
        "download_xml",
        "download_pdf"
      ],
      "description": "Ação realizada"
    },
    "provedor": {
      "type": "string",
      "description": "Provedor usado (eNotas, NFe.io, etc)"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produção",
        "Homologação"
      ]
    },
    "payload_enviado": {
      "type": "object",
      "additionalProperties": true,
      "description": "Dados enviados para a API"
    },
    "retorno_recebido": {
      "type": "object",
      "additionalProperties": true,
      "description": "Resposta da API"
    },
    "status": {
      "type": "string",
      "enum": [
        "sucesso",
        "erro",
        "timeout",
        "pendente"
      ],
      "description": "Status da operação"
    },
    "codigo_status": {
      "type": "string",
      "description": "Código de status retornado"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem de retorno"
    },
    "tempo_resposta_ms": {
      "type": "number",
      "description": "Tempo de resposta em milissegundos"
    },
    "aprendizado_ia": {
      "type": "object",
      "properties": {
        "erro_sefaz_codigo": {
          "type": "string"
        },
        "erro_sefaz_mensagem": {
          "type": "string"
        },
        "causa_provavel": {
          "type": "string"
        },
        "correcao_sugerida": {
          "type": "string"
        },
        "aprendido": {
          "type": "boolean",
          "default": false
        },
        "data_aprendizado": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Aprendizado contínuo da IA com erros da SEFAZ (V16.1)"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usuário que executou"
    },
    "usuario_nome": {
      "type": "string"
    },
    "ip_address": {
      "type": "string",
      "description": "IP do usuário"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "nfe_id",
    "data_hora",
    "acao",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}