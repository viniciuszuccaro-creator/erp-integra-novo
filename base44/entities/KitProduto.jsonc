{
  "name": "KitProduto",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "empresa_dona_id": {
      "type": "string",
      "description": "Empresa que cadastrou o kit"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do kit"
    },
    "codigo_kit": {
      "type": "string",
      "description": "Código do kit (legado)"
    },
    "nome_kit": {
      "type": "string",
      "description": "Nome do kit — único por grupo"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição do kit"
    },
    "tipo_kit": {
      "type": "string",
      "enum": [
        "Comercial",
        "Produção",
        "Promocional",
        "Personalizado"
      ],
      "default": "Comercial"
    },
    "itens_kit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Produtos que compõem o kit"
    },
    "preco_kit": {
      "type": "number",
      "description": "Preço do kit (pode ser diferente da soma dos itens)"
    },
    "desconto_kit_percentual": {
      "type": "number",
      "default": 0,
      "description": "Desconto aplicado ao kit"
    },
    "imagem_kit_url": {
      "type": "string",
      "description": "URL da imagem do kit"
    },
    "exibir_no_ecommerce": {
      "type": "boolean",
      "default": false
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_kit",
    "itens_kit"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}