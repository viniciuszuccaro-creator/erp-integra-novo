{
  "name": "SyncReport",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tipo_sync": {
      "type": "string",
      "enum": [
        "Hub Cadastros",
        "Integrações API",
        "Fluxo Golden Thread",
        "Sincronização Marketplace",
        "Job Agendado"
      ],
      "description": "Tipo de sincronização testada"
    },
    "data_teste": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do teste"
    },
    "status_geral": {
      "type": "string",
      "enum": [
        "OK",
        "Aviso",
        "Erro",
        "Crítico"
      ],
      "default": "OK",
      "description": "Status geral da sincronização"
    },
    "total_verificacoes": {
      "type": "number",
      "description": "Total de verificações realizadas"
    },
    "verificacoes_ok": {
      "type": "number",
      "default": 0
    },
    "verificacoes_erro": {
      "type": "number",
      "default": 0
    },
    "detalhes_verificacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modulo": {
            "type": "string"
          },
          "componente": {
            "type": "string"
          },
          "acao_testada": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "Erro"
            ]
          },
          "mensagem": {
            "type": "string"
          },
          "campos_validados": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "campos_faltando": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Detalhamento de cada verificação"
    },
    "botoes_testados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grupo": {
            "type": "string"
          },
          "botao_label": {
            "type": "string"
          },
          "tem_acao": {
            "type": "boolean"
          },
          "abre_modal": {
            "type": "boolean"
          },
          "formulario_completo": {
            "type": "boolean"
          }
        }
      },
      "description": "Lista de botões testados"
    },
    "entidades_conectadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Entidades que estão corretamente conectadas"
    },
    "entidades_desconectadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Entidades sem conexão"
    },
    "ias_ativas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome_ia": {
            "type": "string"
          },
          "modulo": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Ativa",
              "Inativa",
              "Erro"
            ]
          }
        }
      },
      "description": "IAs testadas e seus status"
    },
    "recomendacoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recomendações de melhoria"
    },
    "executado_por": {
      "type": "string"
    },
    "executado_por_id": {
      "type": "string"
    },
    "automatico": {
      "type": "boolean",
      "default": false,
      "description": "Se foi executado automaticamente"
    },
    "notificacao_enviada": {
      "type": "boolean",
      "default": false
    },
    "notificacao_id": {
      "type": "string"
    }
  },
  "required": [
    "tipo_sync",
    "data_teste",
    "status_geral",
    "total_verificacoes"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}