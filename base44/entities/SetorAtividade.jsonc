{
  "name": "SetorAtividade",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "nome": {
      "type": "string",
      "description": "Nome do setor (Revenda, Almoxarifado, F\u00e1brica, etc.)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do setor de atividade"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "Revenda",
        "Produ\u00e7\u00e3o",
        "Servi\u00e7o",
        "Consumo Interno",
        "Log\u00edstica"
      ],
      "default": "Revenda",
      "description": "Tipo de opera\u00e7\u00e3o principal"
    },
    "icone": {
      "type": "string",
      "description": "\u00cdcone representativo (opcional)"
    },
    "cor": {
      "type": "string",
      "description": "Cor para identifica\u00e7\u00e3o visual"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome"
  ]
}