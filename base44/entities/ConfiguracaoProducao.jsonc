{
  "name": "ConfiguracaoProducao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (configuração por empresa)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único"
    },
    "chave": {
      "type": "string",
      "description": "Identificador único da configuração"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Configuração Geral",
        "Perda Aço",
        "Perda Arame",
        "Preço por KG",
        "Tempo Produção",
        "Outro"
      ],
      "description": "Tipo de configuração"
    },
    "perda_aco_percentual": {
      "type": "number",
      "default": 5,
      "description": "Percentual de perda de aço (%)"
    },
    "perda_arame_percentual": {
      "type": "number",
      "default": 10,
      "description": "Percentual de perda de arame recozido (%)"
    },
    "preco_aco_kg": {
      "type": "number",
      "description": "Preço do aço por KG"
    },
    "preco_arame_kg": {
      "type": "number",
      "description": "Preço do arame por KG"
    },
    "tempo_corte_por_barra": {
      "type": "number",
      "description": "Tempo médio de corte por barra (minutos)"
    },
    "tempo_dobra_por_barra": {
      "type": "number",
      "description": "Tempo médio de dobra por barra (minutos)"
    },
    "tempo_armacao_por_peca": {
      "type": "number",
      "description": "Tempo médio de armação por peça (minutos)"
    },
    "bloqueado_edicao": {
      "type": "boolean",
      "default": false,
      "description": "Se true, apenas admin pode editar"
    },
    "bloqueado_por": {
      "type": "string",
      "description": "Usuário que bloqueou"
    },
    "bloqueado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do bloqueio"
    },
    "gerar_op_ao_aprovar": {
      "type": "boolean",
      "default": false,
      "description": "Se deve gerar OP automaticamente ao aprovar pedido"
    },
    "gerar_op_ao_faturar": {
      "type": "boolean",
      "default": false,
      "description": "Se deve gerar OP automaticamente ao faturar pedido"
    },
    "permitir_op_sem_pedido": {
      "type": "boolean",
      "default": true,
      "description": "Se permite criar OP manualmente sem pedido"
    },
    "modo_integracao_estoque": {
      "type": "string",
      "enum": [
        "reserva",
        "reserva_baixa",
        "manual"
      ],
      "default": "reserva",
      "description": "Modo de integração com estoque"
    },
    "permitir_baixa_maior_teorico": {
      "type": "boolean",
      "default": false,
      "description": "Permite consumo real maior que o planejado"
    },
    "produto_arame_recozido_id": {
      "type": "string",
      "description": "ID do produto padrão de arame recozido"
    },
    "produto_sucata_id": {
      "type": "string",
      "description": "ID do produto padrão de sucata/retalho"
    },
    "exigir_bitola_cadastrada": {
      "type": "boolean",
      "default": true,
      "description": "Exige que bitola exista no cadastro de produtos"
    },
    "bloquear_op_sem_estoque": {
      "type": "boolean",
      "default": false,
      "description": "Bloqueia liberação se não tiver material em estoque"
    },
    "gerar_etiqueta_automatica": {
      "type": "boolean",
      "default": false,
      "description": "Gera etiquetas com QR Code ao criar OP"
    },
    "prazo_padrao_op_dias": {
      "type": "number",
      "default": 7,
      "description": "Prazo padrão em dias para conclusão"
    },
    "historico_alteracoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          },
          "campo": {
            "type": "string"
          },
          "valor_anterior": {},
          "valor_novo": {}
        }
      },
      "description": "Histórico de todas as alterações"
    },
    "observacoes": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se ativo"
    }
  },
  "required": [
    "empresa_id",
    "chave",
    "tipo"
  ]
}
