{
  "name": "LancamentoContabil",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date",
      "description": "Data do lan\u00e7amento cont\u00e1bil"
    },
    "historico": {
      "type": "string",
      "description": "Hist\u00f3rico do lan\u00e7amento"
    },
    "documento": {
      "type": "string",
      "description": "N\u00famero do documento (NF, Pedido, etc.)"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "NF-e",
        "Pedido",
        "Conta a Pagar",
        "Conta a Receber",
        "Movimenta\u00e7\u00e3o Estoque",
        "Ordem de Produ\u00e7\u00e3o",
        "Transfer\u00eancia",
        "Manual",
        "Outro"
      ],
      "description": "Tipo do documento origem"
    },
    "documento_origem_id": {
      "type": "string",
      "description": "ID do documento que gerou o lan\u00e7amento"
    },
    "conta_debito_id": {
      "type": "string",
      "description": "ID da conta debitada"
    },
    "conta_debito_codigo": {
      "type": "string",
      "description": "C\u00f3digo da conta debitada"
    },
    "conta_debito_descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta debitada"
    },
    "conta_credito_id": {
      "type": "string",
      "description": "ID da conta creditada"
    },
    "conta_credito_codigo": {
      "type": "string",
      "description": "C\u00f3digo da conta creditada"
    },
    "conta_credito_descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta creditada"
    },
    "valor": {
      "type": "number",
      "description": "Valor do lan\u00e7amento"
    },
    "centro_custo_id": {
      "type": "string",
      "description": "Centro de custo vinculado"
    },
    "centro_custo_nome": {
      "type": "string"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Financeiro",
        "Fiscal",
        "Estoque",
        "Produ\u00e7\u00e3o",
        "Folha de Pagamento",
        "Manual",
        "Importa\u00e7\u00e3o",
        "Ajuste"
      ],
      "description": "Origem do lan\u00e7amento"
    },
    "automatico": {
      "type": "boolean",
      "default": false,
      "description": "Se foi gerado automaticamente pelo sistema"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Efetivado",
        "Estornado",
        "Cancelado"
      ],
      "default": "Efetivado"
    },
    "lote": {
      "type": "string",
      "description": "N\u00famero do lote de lan\u00e7amentos"
    },
    "data_estorno": {
      "type": "string",
      "format": "date-time",
      "description": "Data do estorno (se aplic\u00e1vel)"
    },
    "lancamento_estorno_id": {
      "type": "string",
      "description": "ID do lan\u00e7amento de estorno"
    },
    "usuario_responsavel": {
      "type": "string",
      "description": "Usu\u00e1rio que criou o lan\u00e7amento"
    },
    "usuario_responsavel_id": {
      "type": "string"
    },
    "periodo_competencia": {
      "type": "string",
      "description": "Per\u00edodo de compet\u00eancia (YYYY-MM)"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "data_lancamento",
    "conta_debito_id",
    "conta_credito_id",
    "valor",
    "empresa_id"
  ]
}