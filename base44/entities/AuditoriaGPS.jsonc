{
  "name": "AuditoriaGPS",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "romaneio_id": {
      "type": "string",
      "description": "ID do romaneio"
    },
    "entrega_id": {
      "type": "string",
      "description": "ID da entrega"
    },
    "motorista_id": {
      "type": "string",
      "description": "ID do motorista"
    },
    "motorista_nome": {
      "type": "string",
      "description": "Nome do motorista"
    },
    "veiculo_id": {
      "type": "string",
      "description": "ID do veículo"
    },
    "placa": {
      "type": "string",
      "description": "Placa do veículo"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "Saída",
        "Posição Atualizada",
        "Parada",
        "Retorno",
        "Entrega Iniciada",
        "Entrega Concluída",
        "Desvio de Rota",
        "Velocidade Excessiva",
        "Bateria Baixa",
        "Offline"
      ],
      "description": "Tipo de evento GPS"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do evento"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude"
    },
    "precisao_metros": {
      "type": "number",
      "description": "Precisão do GPS em metros"
    },
    "velocidade_kmh": {
      "type": "number",
      "description": "Velocidade em km/h"
    },
    "endereco_aproximado": {
      "type": "string",
      "description": "Endereço aproximado"
    },
    "dentro_cerca_eletronica": {
      "type": "boolean",
      "default": false,
      "description": "Se está dentro da cerca eletrônica (geofence)"
    },
    "distancia_destino_km": {
      "type": "number",
      "description": "Distância até o destino"
    },
    "eta_minutos": {
      "type": "number",
      "description": "Tempo estimado de chegada em minutos"
    },
    "desvio_rota": {
      "type": "boolean",
      "default": false,
      "description": "Se houve desvio da rota planejada"
    },
    "alerta_gerado": {
      "type": "boolean",
      "default": false,
      "description": "Se gerou algum alerta"
    },
    "tipo_alerta": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Desvio",
        "Velocidade",
        "Parada Longa",
        "Bateria",
        "Offline"
      ],
      "description": "Tipo de alerta gerado"
    },
    "conectividade": {
      "type": "string",
      "enum": [
        "WiFi",
        "4G",
        "3G",
        "Offline"
      ]
    },
    "bateria_nivel": {
      "type": "number",
      "description": "Nível de bateria (%)"
    },
    "app_versao": {
      "type": "string",
      "description": "Versão do app móvel"
    }
  },
  "required": [
    "data_hora",
    "latitude",
    "longitude"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}