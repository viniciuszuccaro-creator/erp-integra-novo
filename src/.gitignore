# NUNCA VERSIONAR ARTEFATOS
# Se aparecerem, são bugs da plataforma — não devem ser commitados

# ===== ARTEFATOS PERIGOSOS =====
**/*.md.jsx
**/*.md.js
**/*.json.jsx
**/*.json.js
**/*.config.jsx
**/*.config.js

# ===== DIRETÓRIOS COM INJEÇÕES =====
src/components/**/*.md.jsx
src/components/**/*.md.js
src/build-tools/
build-tools/

# ===== PADRÃO ABSOLUTO =====
# Qualquer arquivo .jsx/.js que deveria ser .md ou .json
src/**/*.md.{jsx,js}
src/**/*.json.{jsx,js}

# ===== DEPENDÊNCIAS =====
node_modules/
.npm
package-lock.json
yarn.lock

# ===== BUILD =====
dist/
build/
.next/
out/

# ===== DESENVOLVIMENTO =====
.vite/
.env.local
.env.*.local
.DS_Store
*.log
*.swp
*.swo
*~

# ===== IDE =====
.vscode/
.idea/
*.iml
.eslintcache
.prettierignore