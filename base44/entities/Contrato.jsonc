{
  "name": "Contrato",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa responsável pelo contrato"
    },
    "numero_contrato": {
      "type": "string",
      "description": "Número único do contrato"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Cliente",
        "Fornecedor",
        "Prestação de Serviço",
        "Locação",
        "Parceria",
        "Outro"
      ],
      "default": "Cliente",
      "description": "Tipo de contrato"
    },
    "parte_contratante": {
      "type": "string",
      "description": "Nome da empresa/pessoa"
    },
    "parte_contratante_id": {
      "type": "string",
      "description": "ID do cliente ou fornecedor"
    },
    "objeto": {
      "type": "string",
      "description": "Objeto do contrato"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição detalhada"
    },
    "modelo_documento_id": {
      "type": "string",
      "description": "Vol 13.1: ID do modelo de documento autorizado usado como base"
    },
    "versao_atual": {
      "type": "number",
      "default": 1,
      "description": "Vol 13.1: Número da versão atual do contrato"
    },
    "versoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero_versao": {
            "type": "number"
          },
          "data_versao": {
            "type": "string",
            "format": "date-time"
          },
          "usuario_id": {
            "type": "string"
          },
          "usuario_nome": {
            "type": "string"
          },
          "conteudo_anterior": {
            "type": "object",
            "additionalProperties": true,
            "description": "Snapshot antes da alteração"
          },
          "conteudo_novo": {
            "type": "object",
            "additionalProperties": true,
            "description": "Snapshot após a alteração"
          },
          "motivo_alteracao": {
            "type": "string"
          },
          "arquivo_pdf_url": {
            "type": "string"
          }
        }
      },
      "description": "Vol 13.1: Histórico de versões com antes/depois para auditoria"
    },
    "clausulas_sensiveis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "identificador": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "perfis_autorizados": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Perfis que podem visualizar/editar esta cláusula"
          }
        }
      },
      "description": "Vol 13.2: Permissões por cláusula sensível"
    },
    "valor_mensal": {
      "type": "number",
      "description": "Valor mensal do contrato"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total do contrato"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de início"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data de término"
    },
    "data_assinatura": {
      "type": "string",
      "format": "date",
      "description": "Data de assinatura"
    },
    "vigencia_meses": {
      "type": "number",
      "description": "Vigência em meses"
    },
    "renovacao_automatica": {
      "type": "boolean",
      "default": false,
      "description": "Renovação automática ao vencer"
    },
    "prazo_aviso_renovacao": {
      "type": "number",
      "default": 30,
      "description": "Dias de antecedência para aviso de renovação"
    },
    "indice_reajuste": {
      "type": "string",
      "enum": [
        "IPCA",
        "IGPM",
        "INPC",
        "CDI",
        "Fixo",
        "Outro"
      ],
      "description": "Índice de reajuste"
    },
    "percentual_reajuste": {
      "type": "number",
      "description": "Percentual de reajuste anual"
    },
    "data_proximo_reajuste": {
      "type": "string",
      "format": "date",
      "description": "Data do próximo reajuste"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "Boleto",
        "Transferência",
        "Cartão",
        "PIX",
        "Cheque"
      ],
      "default": "Boleto"
    },
    "dia_vencimento": {
      "type": "number",
      "description": "Dia do vencimento (1-31)"
    },
    "responsavel_empresa": {
      "type": "string",
      "description": "Responsável pela empresa"
    },
    "testemunhas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de testemunhas"
    },
    "clausulas_especiais": {
      "type": "string",
      "description": "Cláusulas especiais"
    },
    "multa_rescisao": {
      "type": "number",
      "description": "Multa por rescisão antecipada (%)"
    },
    "arquivo_contrato": {
      "type": "string",
      "description": "URL do arquivo PDF"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Aguardando Assinatura",
        "Vigente",
        "Vencido",
        "Rescindido",
        "Renovado",
        "Arquivado"
      ],
      "default": "Rascunho"
    },
    "observacoes": {
      "type": "string"
    },
    "assinado": {
      "type": "boolean",
      "default": false,
      "description": "Se o contrato foi assinado eletronicamente"
    },
    "assinatura_digital": {
      "type": "object",
      "description": "Dados da assinatura eletrônica",
      "properties": {
        "nome_completo": {
          "type": "string"
        },
        "cpf": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "cargo": {
          "type": "string"
        },
        "assinatura_imagem": {
          "type": "string"
        },
        "data_hora": {
          "type": "string",
          "format": "date-time"
        },
        "ip_address": {
          "type": "string"
        },
        "dispositivo": {
          "type": "string"
        },
        "navegador": {
          "type": "string"
        },
        "geolocation": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      }
    },
    "gerar_cobranca_automatica": {
      "type": "boolean",
      "default": true,
      "description": "Gerar boletos/contas automaticamente"
    },
    "ultima_cobranca_gerada": {
      "type": "string",
      "format": "date",
      "description": "Data da última cobrança gerada"
    },
    "proxima_cobranca": {
      "type": "string",
      "format": "date",
      "description": "Data da próxima cobrança"
    },
    "contas_geradas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das contas a receber geradas"
    },
    "historico_renovacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data_renovacao": {
            "type": "string",
            "format": "date"
          },
          "valor_anterior": {
            "type": "number"
          },
          "valor_novo": {
            "type": "number"
          },
          "percentual_reajuste": {
            "type": "number"
          },
          "indice_utilizado": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Histórico de renovações e reajustes"
    },
    "historico_aditivos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date"
          },
          "tipo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "valor_anterior": {
            "type": "number"
          },
          "valor_novo": {
            "type": "number"
          }
        }
      },
      "description": "Histórico de aditivos contratuais"
    },
    "alertas_enviados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Vencimento",
              "Reajuste",
              "Renovação",
              "Inadimplência"
            ]
          },
          "data_envio": {
            "type": "string",
            "format": "date-time"
          },
          "destinatario": {
            "type": "string"
          },
          "enviado": {
            "type": "boolean"
          }
        }
      },
      "description": "Histórico de alertas enviados"
    },
    "proximo_alerta_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data do próximo alerta de vencimento"
    },
    "proximo_alerta_reajuste": {
      "type": "string",
      "format": "date",
      "description": "Data do próximo alerta de reajuste"
    }
  },
  "required": [
    "numero_contrato",
    "tipo",
    "parte_contratante",
    "objeto",
    "data_inicio"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}