{
  "name": "Webhook",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "nome_webhook": {
      "type": "string",
      "description": "Nome do webhook"
    },
    "descricao": {
      "type": "string"
    },
    "evento_gatilho": {
      "type": "string",
      "enum": [
        "pagamento_recebido",
        "pedido_aprovado",
        "pedido_faturado",
        "entrega_enviada",
        "entrega_concluida",
        "nfe_autorizada",
        "nfe_cancelada",
        "conta_vencida",
        "estoque_baixo",
        "producao_concluida",
        "cliente_cadastrado",
        "outro"
      ],
      "description": "Evento que dispara o webhook"
    },
    "url_destino": {
      "type": "string",
      "description": "URL de destino do webhook"
    },
    "metodo_http": {
      "type": "string",
      "enum": [
        "POST",
        "PUT",
        "GET"
      ],
      "default": "POST"
    },
    "formato_payload": {
      "type": "string",
      "enum": [
        "JSON",
        "XML",
        "Form-Data"
      ],
      "default": "JSON"
    },
    "headers_customizados": {
      "type": "object",
      "description": "Headers HTTP customizados"
    },
    "payload_template": {
      "type": "object",
      "description": "Template do payload a ser enviado"
    },
    "secret_assinatura": {
      "type": "string",
      "description": "Vol 18.1: Secret usado para assinar o payload (HMAC-SHA256) e validar integridade"
    },
    "header_assinatura": {
      "type": "string",
      "default": "X-Webhook-Signature",
      "description": "Vol 18.1: Nome do header onde a assinatura é enviada"
    },
    "idempotencia_habilitada": {
      "type": "boolean",
      "default": true,
      "description": "Vol 18.1: Se idempotência está ativa (evita duplicação de processamento)"
    },
    "chave_idempotencia_campo": {
      "type": "string",
      "default": "event_id",
      "description": "Vol 18.1: Campo do payload usado como chave de idempotência"
    },
    "politica_retry": {
      "type": "object",
      "properties": {
        "max_tentativas": {
          "type": "number",
          "default": 3
        },
        "intervalo_segundos": {
          "type": "number",
          "default": 60
        },
        "backoff_exponencial": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "destinatarios_notificacao_erro": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "E-mails para notificar em caso de falha"
    },
    "ultimo_envio": {
      "type": "string",
      "format": "date-time"
    },
    "ultimo_status": {
      "type": "string",
      "enum": [
        "Sucesso",
        "Erro",
        "Timeout",
        "Não Enviado"
      ],
      "default": "Não Enviado"
    },
    "total_envios": {
      "type": "number",
      "default": 0
    },
    "total_sucessos": {
      "type": "number",
      "default": 0
    },
    "total_falhas": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_webhook",
    "evento_gatilho",
    "url_destino"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}