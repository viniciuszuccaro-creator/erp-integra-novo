{
  "name": "FormaPagamento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se específico por empresa)"
    },
    "codigo": {
      "type": "string",
      "description": "Código único da forma de pagamento"
    },
    "descricao": {
      "type": "string",
      "description": "Nome da forma de pagamento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Dinheiro",
        "PIX",
        "Boleto",
        "Cartão Crédito",
        "Cartão Débito",
        "Transferência",
        "Cheque",
        "Crédito em Conta",
        "Fidelidade/Cashback",
        "Outro"
      ],
      "description": "Tipo base da forma de pagamento"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se está ativa para uso"
    },
    "aceita_desconto": {
      "type": "boolean",
      "default": true,
      "description": "Se permite desconto"
    },
    "percentual_desconto_padrao": {
      "type": "number",
      "default": 0,
      "description": "% de desconto padrão"
    },
    "aplicar_acrescimo": {
      "type": "boolean",
      "default": false,
      "description": "Se aplica acréscimo/taxa"
    },
    "percentual_acrescimo_padrao": {
      "type": "number",
      "default": 0,
      "description": "% de acréscimo (ex: taxa cartão)"
    },
    "prazo_compensacao_dias": {
      "type": "number",
      "default": 0,
      "description": "Dias para compensação/recebimento"
    },
    "gerar_cobranca_online": {
      "type": "boolean",
      "default": false,
      "description": "Se gera cobrança via gateway"
    },
    "integracao_obrigatoria": {
      "type": "boolean",
      "default": false,
      "description": "Se requer integração ativa para usar"
    },
    "banco_vinculado_id": {
      "type": "string",
      "description": "ID do banco vinculado para cobrança online (PIX/Boleto bancário)"
    },
    "gateway_pagamento_id": {
      "type": "string",
      "description": "ID do gateway de pagamento vinculado (Pagar.me, Stripe, etc)"
    },
    "gateway_pagamento_nome": {
      "type": "string",
      "description": "Nome do gateway (snapshot)"
    },
    "usa_gateway": {
      "type": "boolean",
      "default": false,
      "description": "Se usa gateway de pagamento ao invés de banco direto"
    },
    "permite_parcelamento": {
      "type": "boolean",
      "default": false,
      "description": "Se permite parcelar"
    },
    "maximo_parcelas": {
      "type": "number",
      "default": 1,
      "description": "Número máximo de parcelas"
    },
    "intervalo_parcelas_dias": {
      "type": "number",
      "default": 30,
      "description": "Dias entre parcelas (genérico)"
    },
    "taxa_por_parcela": {
      "type": "number",
      "default": 0,
      "description": "Taxa % por parcela (genérica)"
    },
    "configuracao_parcelas_cartao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero_parcela": {
            "type": "number",
            "description": "Número da parcela (1, 2, 3...)"
          },
          "dias_vencimento": {
            "type": "number",
            "description": "Dias corridos até vencimento desta parcela"
          },
          "taxa_percentual": {
            "type": "number",
            "description": "Taxa % específica desta parcela"
          }
        }
      },
      "description": "Configuração individual de cada parcela para Cartão de Crédito"
    },
    "icone": {
      "type": "string",
      "description": "Nome do ícone (lucide-react)"
    },
    "cor": {
      "type": "string",
      "description": "Cor hexadecimal para UI"
    },
    "ordem_exibicao": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibição na lista"
    },
    "disponivel_ecommerce": {
      "type": "boolean",
      "default": false,
      "description": "Se aparece no e-commerce (futuro)"
    },
    "disponivel_pdv": {
      "type": "boolean",
      "default": true,
      "description": "Se aparece no PDV/App"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "descricao",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}