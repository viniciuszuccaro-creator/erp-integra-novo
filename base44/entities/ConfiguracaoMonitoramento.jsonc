{
  "name": "ConfiguracaoMonitoramento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (null se configura\u00e7\u00e3o do grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico da configura\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o monitoramento est\u00e1 ativo"
    },
    "nivel_monitoramento": {
      "type": "string",
      "enum": [
        "B\u00e1sico",
        "Intermedi\u00e1rio",
        "Avan\u00e7ado",
        "Completo"
      ],
      "default": "Intermedi\u00e1rio"
    },
    "coleta_automatica": {
      "type": "boolean",
      "default": true
    },
    "intervalo_coleta_segundos": {
      "type": "number",
      "default": 60
    },
    "retencao_logs_dias": {
      "type": "number",
      "default": 30
    },
    "retencao_logs_criticos_dias": {
      "type": "number",
      "default": 365
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "query_lenta_ms": {
          "type": "number",
          "default": 1000
        },
        "api_lenta_ms": {
          "type": "number",
          "default": 2000
        },
        "page_load_lenta_ms": {
          "type": "number",
          "default": 3000
        },
        "export_lento_ms": {
          "type": "number",
          "default": 10000
        },
        "cpu_alta_percent": {
          "type": "number",
          "default": 80
        },
        "memoria_alta_percent": {
          "type": "number",
          "default": 85
        },
        "taxa_erro_percent": {
          "type": "number",
          "default": 5
        },
        "disponibilidade_minima_percent": {
          "type": "number",
          "default": 99
        }
      }
    },
    "monitorar_queries": {
      "type": "boolean",
      "default": true
    },
    "monitorar_apis": {
      "type": "boolean",
      "default": true
    },
    "monitorar_integracao": {
      "type": "boolean",
      "default": true
    },
    "monitorar_exports": {
      "type": "boolean",
      "default": true
    },
    "detectar_anomalias_ia": {
      "type": "boolean",
      "default": false
    },
    "ia_confianca_minima": {
      "type": "number",
      "default": 75
    },
    "gerar_alertas_automaticos": {
      "type": "boolean",
      "default": true
    },
    "alertar_apenas_criticos": {
      "type": "boolean",
      "default": false
    },
    "notificar_email": {
      "type": "boolean",
      "default": true
    },
    "emails_notificacao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notificar_slack": {
      "type": "boolean",
      "default": false
    },
    "slack_webhook_url": {
      "type": "string"
    },
    "agrupar_alertas_similares": {
      "type": "boolean",
      "default": true
    },
    "janela_agrupamento_minutos": {
      "type": "number",
      "default": 15
    },
    "modulos_monitorados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "modulos_ignorados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "samplear_requisicoes": {
      "type": "boolean",
      "default": false
    },
    "taxa_amostragem_percent": {
      "type": "number",
      "default": 100
    },
    "profiling_ativo": {
      "type": "boolean",
      "default": false
    },
    "profiling_funcoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integracao_apm_externa": {
      "type": "object",
      "properties": {
        "ativa": {
          "type": "boolean",
          "default": false
        },
        "provedor": {
          "type": "string",
          "enum": [
            "New Relic",
            "DataDog",
            "Dynatrace",
            "AppDynamics",
            "Custom"
          ]
        },
        "api_key": {
          "type": "string"
        },
        "endpoint_url": {
          "type": "string"
        },
        "enviar_logs": {
          "type": "boolean",
          "default": true
        },
        "enviar_metricas": {
          "type": "boolean",
          "default": true
        },
        "enviar_traces": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "dashboard_publico": {
      "type": "boolean",
      "default": false
    },
    "dashboard_url": {
      "type": "string"
    },
    "ultimo_alerta_id": {
      "type": "string"
    },
    "ultimo_alerta_data": {
      "type": "string",
      "format": "date-time"
    },
    "total_alertas_gerados": {
      "type": "number",
      "default": 0
    },
    "total_alertas_resolvidos": {
      "type": "number",
      "default": 0
    },
    "mttr_horas": {
      "type": "number"
    },
    "configurado_por": {
      "type": "string"
    },
    "configurado_por_id": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "ativo",
    "nivel_monitoramento"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}