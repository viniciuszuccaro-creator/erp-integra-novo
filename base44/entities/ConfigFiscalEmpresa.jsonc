{
  "name": "ConfigFiscalEmpresa",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico da configura\u00e7\u00e3o fiscal"
    },
    "empresa_nome": {
      "type": "string"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o Social"
    },
    "nome_fantasia": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "inscricao_estadual": {
      "type": "string"
    },
    "inscricao_municipal": {
      "type": "string"
    },
    "regime_tributario": {
      "type": "string",
      "enum": [
        "Simples Nacional",
        "Lucro Presumido",
        "Lucro Real",
        "MEI"
      ],
      "description": "Regime tribut\u00e1rio"
    },
    "tipo_certificado": {
      "type": "string",
      "enum": [
        "A1",
        "A3"
      ],
      "default": "A1"
    },
    "arquivo_certificado": {
      "type": "string",
      "description": "URL do arquivo .pfx (A1)"
    },
    "senha_certificado": {
      "type": "string"
    },
    "data_validade_certificado": {
      "type": "string",
      "format": "date"
    },
    "titular_certificado": {
      "type": "string"
    },
    "emissor_certificado": {
      "type": "string"
    },
    "serie_nfe": {
      "type": "string",
      "default": "1"
    },
    "proximo_numero_nfe": {
      "type": "number",
      "default": 1
    },
    "serie_nfce": {
      "type": "string",
      "default": "1"
    },
    "proximo_numero_nfce": {
      "type": "number",
      "default": 1
    },
    "serie_nfse": {
      "type": "string",
      "default": "1"
    },
    "proximo_numero_nfse": {
      "type": "number",
      "default": 1
    },
    "cfop_padrao_dentro_estado": {
      "type": "string",
      "default": "5102"
    },
    "cfop_padrao_fora_estado": {
      "type": "string",
      "default": "6102"
    },
    "csc_nfce": {
      "type": "string"
    },
    "id_csc_nfce": {
      "type": "string"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produ\u00e7\u00e3o",
        "Homologa\u00e7\u00e3o"
      ],
      "default": "Homologa\u00e7\u00e3o"
    },
    "cnpj_emitente": {
      "type": "string"
    },
    "uf_emitente": {
      "type": "string"
    },
    "aliquota_padrao_icms": {
      "type": "number",
      "default": 18
    },
    "aliquota_padrao_pis": {
      "type": "number",
      "default": 1.65
    },
    "aliquota_padrao_cofins": {
      "type": "number",
      "default": 7.6
    },
    "aliquota_padrao_ipi": {
      "type": "number",
      "default": 0
    },
    "aliquota_padrao_iss": {
      "type": "number",
      "default": 5
    },
    "observacoes_padrao_nfe": {
      "type": "string"
    },
    "informacoes_complementares_padrao": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "emite_nfe": {
      "type": "boolean",
      "default": true
    },
    "emite_nfce": {
      "type": "boolean",
      "default": false
    },
    "emite_nfse": {
      "type": "boolean",
      "default": false
    },
    "permite_emissao_sem_estoque": {
      "type": "boolean",
      "default": false
    },
    "integracao_nfe": {
      "type": "object",
      "properties": {
        "ativa": {
          "type": "boolean",
          "default": false
        },
        "provedor": {
          "type": "string",
          "enum": [
            "eNotas",
            "NFe.io",
            "Bling",
            "Focus NFe",
            "WebMania",
            "Outro"
          ]
        },
        "api_url": {
          "type": "string"
        },
        "api_key": {
          "type": "string"
        },
        "empresa_id_provedor": {
          "type": "string"
        },
        "emitir_automaticamente": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "historico_alteracoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          },
          "campo_alterado": {
            "type": "string"
          },
          "valor_anterior": {
            "type": "string"
          },
          "valor_novo": {
            "type": "string"
          }
        }
      }
    },
    "data_ultima_verificacao_certificado": {
      "type": "string",
      "format": "date-time"
    },
    "certificado_expira_em_dias": {
      "type": "number"
    },
    "alertas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "certificado_vencendo",
              "certificado_vencido",
              "serie_esgotando",
              "configuracao_incompleta"
            ]
          },
          "mensagem": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "empresa_id",
    "cnpj_emitente",
    "uf_emitente",
    "regime_tributario"
  ]
}