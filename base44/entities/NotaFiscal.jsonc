{
  "name": "NotaFiscal",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string"
    },
    "serie": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "NF-e (Sa\u00edda)",
        "NF-e (Entrada)",
        "NFC-e",
        "NFS-e"
      ],
      "default": "NF-e (Sa\u00edda)"
    },
    "modelo": {
      "type": "string",
      "default": "55"
    },
    "natureza_operacao": {
      "type": "string"
    },
    "cliente_fornecedor": {
      "type": "string"
    },
    "cliente_fornecedor_id": {
      "type": "string"
    },
    "cliente_cpf_cnpj": {
      "type": "string"
    },
    "cliente_endereco": {
      "type": "object",
      "properties": {
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "cep": {
          "type": "string"
        }
      }
    },
    "pedido_id": {
      "type": "string"
    },
    "numero_pedido": {
      "type": "string"
    },
    "empresa_faturamento_id": {
      "type": "string",
      "description": "Empresa que emite a NF (usa o certificado dela)"
    },
    "empresa_atendimento_id": {
      "type": "string",
      "description": "Empresa que atendeu/produziu o pedido"
    },
    "empresa_origem_id": {
      "type": "string",
      "description": "Empresa de onde sai a mercadoria"
    },
    "group_id": {
      "type": "string",
      "description": "Grupo empresarial"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "data_saida": {
      "type": "string",
      "format": "date"
    },
    "hora_emissao": {
      "type": "string"
    },
    "hora_saida": {
      "type": "string"
    },
    "valor_produtos": {
      "type": "number"
    },
    "valor_servicos": {
      "type": "number"
    },
    "valor_desconto": {
      "type": "number"
    },
    "valor_frete": {
      "type": "number"
    },
    "valor_seguro": {
      "type": "number"
    },
    "outras_despesas": {
      "type": "number"
    },
    "valor_total": {
      "type": "number"
    },
    "base_calculo_icms": {
      "type": "number"
    },
    "valor_icms": {
      "type": "number"
    },
    "base_calculo_st": {
      "type": "number"
    },
    "valor_icms_st": {
      "type": "number"
    },
    "valor_ipi": {
      "type": "number"
    },
    "valor_pis": {
      "type": "number"
    },
    "valor_cofins": {
      "type": "number"
    },
    "valor_iss": {
      "type": "number"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de 44 d\u00edgitos"
    },
    "protocolo_autorizacao": {
      "type": "string"
    },
    "data_autorizacao": {
      "type": "string",
      "format": "date-time"
    },
    "numero_lote": {
      "type": "string"
    },
    "recibo_lote": {
      "type": "string"
    },
    "digest_value": {
      "type": "string"
    },
    "xml_nfe": {
      "type": "string",
      "description": "URL do XML da NF-e"
    },
    "pdf_danfe": {
      "type": "string",
      "description": "URL do PDF DANFE"
    },
    "xml_cancelamento": {
      "type": "string",
      "description": "URL do XML de cancelamento"
    },
    "xml_carta_correcao": {
      "type": "string",
      "description": "URL do XML da carta de corre\u00e7\u00e3o"
    },
    "cfop": {
      "type": "string",
      "description": "CFOP principal"
    },
    "finalidade": {
      "type": "string",
      "enum": [
        "Normal",
        "Complementar",
        "Ajuste",
        "Devolu\u00e7\u00e3o"
      ],
      "default": "Normal"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produ\u00e7\u00e3o",
        "Homologa\u00e7\u00e3o"
      ],
      "default": "Homologa\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string"
    },
    "informacoes_complementares": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Processando",
        "Aguardando Lote",
        "Em Processamento",
        "Autorizada",
        "Cancelada",
        "Denegada",
        "Rejeitada",
        "Inutilizada"
      ],
      "default": "Rascunho"
    },
    "mensagem_sefaz": {
      "type": "string",
      "description": "Mensagem de retorno da SEFAZ"
    },
    "codigo_status_sefaz": {
      "type": "string",
      "description": "C\u00f3digo de status da SEFAZ"
    },
    "motivo_rejeicao": {
      "type": "string"
    },
    "validacao_ia_pre_emissao": {
      "type": "object",
      "properties": {
        "validada": {
          "type": "boolean",
          "default": false
        },
        "data_validacao": {
          "type": "string",
          "format": "date-time"
        },
        "conflitos_detectados": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tipo": {
                "type": "string",
                "enum": [
                  "Regime Incompat\u00edvel",
                  "CFOP Incorreto",
                  "NCM Inv\u00e1lido",
                  "Destaque ICMS",
                  "Outro"
                ]
              },
              "descricao": {
                "type": "string"
              },
              "severidade": {
                "type": "string",
                "enum": [
                  "Info",
                  "Aviso",
                  "Bloqueante"
                ]
              },
              "campo_afetado": {
                "type": "string"
              }
            }
          }
        },
        "bloqueio_emissao": {
          "type": "boolean",
          "default": false
        },
        "recomendacao_ia": {
          "type": "string"
        }
      },
      "description": "Valida\u00e7\u00e3o pr\u00e9-emiss\u00e3o da IA Fiscal (V16.1)"
    },
    "emitir_dentro_estado": {
      "type": "boolean",
      "default": false,
      "description": "Emitir como opera\u00e7\u00e3o interna para evitar DIFAL"
    },
    "justificativa_interna": {
      "type": "string",
      "description": "Justificativa para emiss\u00e3o interna"
    },
    "cancelamento": {
      "type": "object",
      "properties": {
        "data_cancelamento": {
          "type": "string",
          "format": "date-time"
        },
        "protocolo_cancelamento": {
          "type": "string"
        },
        "motivo": {
          "type": "string"
        },
        "justificativa": {
          "type": "string"
        },
        "usuario": {
          "type": "string"
        }
      }
    },
    "carta_correcao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequencia": {
            "type": "number"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "correcao": {
            "type": "string"
          },
          "protocolo": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          }
        }
      }
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero_item": {
            "type": "number"
          },
          "produto_id": {
            "type": "string"
          },
          "codigo_produto": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "cest": {
            "type": "string"
          },
          "cfop": {
            "type": "string"
          },
          "unidade": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "valor_unitario": {
            "type": "number"
          },
          "valor_total": {
            "type": "number"
          },
          "valor_desconto": {
            "type": "number"
          },
          "valor_frete": {
            "type": "number"
          },
          "icms_situacao_tributaria": {
            "type": "string"
          },
          "icms_origem": {
            "type": "string"
          },
          "icms_base_calculo": {
            "type": "number"
          },
          "icms_aliquota": {
            "type": "number"
          },
          "icms_valor": {
            "type": "number"
          },
          "ipi_situacao_tributaria": {
            "type": "string"
          },
          "ipi_base_calculo": {
            "type": "number"
          },
          "ipi_aliquota": {
            "type": "number"
          },
          "ipi_valor": {
            "type": "number"
          },
          "pis_situacao_tributaria": {
            "type": "string"
          },
          "pis_base_calculo": {
            "type": "number"
          },
          "pis_aliquota": {
            "type": "number"
          },
          "pis_valor": {
            "type": "number"
          },
          "cofins_situacao_tributaria": {
            "type": "string"
          },
          "cofins_base_calculo": {
            "type": "number"
          },
          "cofins_aliquota": {
            "type": "number"
          },
          "cofins_valor": {
            "type": "number"
          }
        }
      },
      "description": "Itens da nota fiscal"
    },
    "transportadora": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string"
        },
        "cpf_cnpj": {
          "type": "string"
        },
        "inscricao_estadual": {
          "type": "string"
        },
        "endereco": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "modalidade_frete": {
          "type": "string",
          "enum": [
            "CIF",
            "FOB",
            "Sem Frete",
            "Pr\u00f3prio"
          ]
        },
        "placa_veiculo": {
          "type": "string"
        },
        "uf_veiculo": {
          "type": "string"
        },
        "volumes": {
          "type": "number"
        },
        "especie": {
          "type": "string"
        },
        "peso_bruto": {
          "type": "number"
        },
        "peso_liquido": {
          "type": "number"
        }
      },
      "description": "Dados da transportadora"
    },
    "duplicatas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "vencimento": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "Duplicatas/Parcelas"
    },
    "historico": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data_hora": {
            "type": "string",
            "format": "date-time"
          },
          "evento": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          },
          "detalhes": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de eventos da nota"
    },
    "api_resposta": {
      "type": "object",
      "additionalProperties": true,
      "description": "Resposta completa da API do provedor"
    },
    "tentativas_envio": {
      "type": "number",
      "default": 0
    },
    "ultima_tentativa": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "numero",
    "serie",
    "tipo",
    "cliente_fornecedor",
    "data_emissao",
    "valor_total"
  ]
}