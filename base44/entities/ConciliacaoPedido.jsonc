{
  "name": "ConciliacaoPedido",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa responsável"
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do pedido vinculado"
    },
    "numero_pedido": {
      "type": "string",
      "description": "Número do pedido"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "data_pedido": {
      "type": "string",
      "format": "date",
      "description": "Data de criação do pedido"
    },
    "data_aprovacao_pedido": {
      "type": "string",
      "format": "date",
      "description": "Data de aprovação do pedido"
    },
    "data_entrega": {
      "type": "string",
      "format": "date",
      "description": "Data real da entrega"
    },
    "data_faturamento": {
      "type": "string",
      "format": "date",
      "description": "Data da emissão da NF-e"
    },
    "data_recebimento": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento/recebimento"
    },
    "valor_pedido": {
      "type": "number",
      "description": "Valor total do pedido"
    },
    "valor_faturado": {
      "type": "number",
      "description": "Valor total da NF-e"
    },
    "valor_recebido": {
      "type": "number",
      "description": "Valor efetivamente recebido"
    },
    "diferenca_faturamento": {
      "type": "number",
      "description": "Diferença entre pedido e NF (pedido - faturado)"
    },
    "diferenca_pagamento": {
      "type": "number",
      "description": "Diferença entre NF e pagamento (faturado - recebido)"
    },
    "entrega_id": {
      "type": "string",
      "description": "ID da entrega vinculada"
    },
    "entrega_status": {
      "type": "string",
      "description": "Status da entrega"
    },
    "nfe_id": {
      "type": "string",
      "description": "ID da nota fiscal"
    },
    "nfe_numero": {
      "type": "string",
      "description": "Número da NF-e"
    },
    "nfe_chave_acesso": {
      "type": "string",
      "description": "Chave de acesso da NF-e"
    },
    "conta_receber_id": {
      "type": "string",
      "description": "ID da conta a receber"
    },
    "titulos_vinculados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de todos os títulos a receber vinculados"
    },
    "status_conciliacao": {
      "type": "string",
      "enum": [
        "Conciliado",
        "Divergente",
        "Pendente",
        "Parcial",
        "Em Análise"
      ],
      "default": "Pendente",
      "description": "Status geral da conciliação"
    },
    "status_fluxo": {
      "type": "string",
      "enum": [
        "Pedido Criado",
        "Em Produção",
        "Pronto para Expedir",
        "Entregue",
        "Faturado",
        "Recebido",
        "Finalizado"
      ],
      "default": "Pedido Criado",
      "description": "Etapa atual do fluxo"
    },
    "divergencias_detectadas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Entrega sem NF",
              "NF sem entrega",
              "Pagamento sem NF",
              "NF sem pagamento",
              "Valor divergente pedido-NF",
              "Valor divergente NF-pagamento",
              "Pedido sem produção",
              "Prazo vencido",
              "Outro"
            ]
          },
          "descricao": {
            "type": "string"
          },
          "valor_divergente": {
            "type": "number"
          },
          "data_deteccao": {
            "type": "string",
            "format": "date-time"
          },
          "criticidade": {
            "type": "string",
            "enum": [
              "Baixa",
              "Média",
              "Alta",
              "Crítica"
            ],
            "default": "Média"
          },
          "resolvido": {
            "type": "boolean",
            "default": false
          },
          "resolucao": {
            "type": "string"
          },
          "resolvido_por": {
            "type": "string"
          },
          "data_resolucao": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Lista de divergências encontradas"
    },
    "tempo_pedido_entrega_dias": {
      "type": "number",
      "description": "Dias entre pedido e entrega"
    },
    "tempo_entrega_faturamento_dias": {
      "type": "number",
      "description": "Dias entre entrega e emissão NF"
    },
    "tempo_faturamento_recebimento_dias": {
      "type": "number",
      "description": "Dias entre NF e recebimento"
    },
    "tempo_total_ciclo_dias": {
      "type": "number",
      "description": "Tempo total do ciclo (pedido → recebimento)"
    },
    "producao_concluida": {
      "type": "boolean",
      "default": false,
      "description": "Se a produção foi concluída"
    },
    "op_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das OPs vinculadas"
    },
    "rentabilidade": {
      "type": "object",
      "properties": {
        "custo_total": {
          "type": "number"
        },
        "receita_total": {
          "type": "number"
        },
        "margem_valor": {
          "type": "number"
        },
        "margem_percentual": {
          "type": "number"
        }
      },
      "description": "Análise de rentabilidade do pedido"
    },
    "conciliado_manualmente": {
      "type": "boolean",
      "default": false,
      "description": "Se foi conciliado manualmente (override)"
    },
    "justificativa_manual": {
      "type": "string",
      "description": "Justificativa para conciliação manual"
    },
    "conciliado_por": {
      "type": "string",
      "description": "Usuário que conciliou"
    },
    "conciliado_por_id": {
      "type": "string"
    },
    "data_conciliacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da conciliação"
    },
    "documentos_anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "NF-e XML",
              "NF-e PDF",
              "Comprovante Entrega",
              "Comprovante Pagamento",
              "Foto",
              "Outro"
            ]
          },
          "url": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Documentos anexados"
    },
    "alertas_enviados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "data_envio": {
            "type": "string",
            "format": "date-time"
          },
          "destinatario": {
            "type": "string"
          },
          "canal": {
            "type": "string",
            "enum": [
              "Email",
              "WhatsApp",
              "Sistema"
            ]
          },
          "enviado": {
            "type": "boolean"
          }
        }
      },
      "description": "Alertas enviados sobre divergências"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "score_qualidade": {
      "type": "number",
      "default": 100,
      "description": "Score de qualidade do processo (0-100)"
    },
    "requer_atencao": {
      "type": "boolean",
      "default": false,
      "description": "Se requer atenção imediata"
    },
    "ultima_verificacao": {
      "type": "string",
      "format": "date-time",
      "description": "Última vez que foi verificado automaticamente"
    }
  },
  "required": [
    "pedido_id",
    "cliente_id",
    "empresa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}