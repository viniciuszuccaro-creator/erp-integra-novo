{
  "name": "Comissao",
  "type": "object",
  "properties": {
    "vendedor": {
      "type": "string"
    },
    "vendedor_id": {
      "type": "string"
    },
    "pedido_id": {
      "type": "string"
    },
    "numero_pedido": {
      "type": "string"
    },
    "cliente": {
      "type": "string"
    },
    "data_venda": {
      "type": "string",
      "format": "date"
    },
    "valor_venda": {
      "type": "number"
    },
    "percentual_comissao": {
      "type": "number",
      "description": "Percentual de comiss\u00e3o"
    },
    "valor_comissao": {
      "type": "number"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aprovada",
        "Paga",
        "Cancelada"
      ],
      "default": "Pendente"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "vendedor",
    "pedido_id",
    "valor_venda",
    "percentual_comissao",
    "valor_comissao"
  ]
