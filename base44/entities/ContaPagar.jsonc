{
  "name": "ContaPagar",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo (se lançado no grupo)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se lançado na empresa)"
    },
    "origem": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa",
      "description": "Se foi lançado no grupo ou na empresa"
    },
    "origem_tipo": {
      "type": "string",
      "enum": [
        "manual",
        "pedido",
        "ordem_compra",
        "contrato",
        "recorrente",
        "marketplace",
        "tarifa",
        "outro"
      ],
      "default": "manual",
      "description": "Tipo de origem do lançamento"
    },
    "canal_origem": {
      "type": "string",
      "enum": [
        "ERP",
        "API",
        "Marketplace",
        "Importação",
        "Automático",
        "WhatsApp",
        "Portal",
        "Outro"
      ],
      "default": "ERP",
      "description": "Canal de origem do lançamento"
    },
    "config_recorrente_id": {
      "type": "string",
      "description": "ID da configuração recorrente que gerou este lançamento"
    },
    "documento_grupo_id": {
      "type": "string",
      "description": "ID do documento de grupo que originou este (se vier de rateio)"
    },
    "e_replicado": {
      "type": "boolean",
      "default": false,
      "description": "Se é uma cópia de um título do grupo"
    },
    "rateado_para_empresas": {
      "type": "boolean",
      "default": false,
      "description": "Se foi rateado para empresas do grupo"
    },
    "rateio_id": {
      "type": "string",
      "description": "ID do rateio que gerou este título"
    },
    "descricao": {
      "type": "string"
    },
    "fornecedor": {
      "type": "string"
    },
    "fornecedor_id": {
      "type": "string"
    },
    "favorecido_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do favorecido"
    },
    "centro_custo": {
      "type": "string"
    },
    "centro_custo_id": {
      "type": "string"
    },
    "plano_contas_id": {
      "type": "string",
      "description": "ID do plano de contas vinculado"
    },
    "projeto_obra": {
      "type": "string",
      "description": "Projeto ou obra relacionada"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Fornecedores",
        "Salários",
        "Impostos",
        "Aluguel",
        "Energia",
        "Água",
        "Telefone",
        "Internet",
        "Marketing",
        "Comissões",
        "Contabilidade",
        "Assessoria Jurídica",
        "Manutenção",
        "Transporte",
        "Outros"
      ]
    },
    "valor": {
      "type": "number"
    },
    "valor_original_grupo": {
      "type": "number",
      "description": "Valor original no grupo (se vier de rateio)"
    },
    "percentual_rateio": {
      "type": "number",
      "description": "% deste título em relação ao grupo"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Pago",
        "Atrasado",
        "Cancelado",
        "Parcelado"
      ],
      "default": "Pendente"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aguardando Aprovação",
        "Aprovado",
        "Pago",
        "Rejeitado",
        "Cancelado"
      ],
      "default": "Pendente",
      "description": "Status no fluxo de aprovação"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Usuário que aprovou"
    },
    "aprovado_por_id": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de aprovação"
    },
    "rejeitado_por": {
      "type": "string"
    },
    "motivo_rejeicao": {
      "type": "string"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "Dinheiro",
        "Transferência",
        "Boleto",
        "Cartão",
        "PIX",
        "Cheque",
        "TED",
        "DOC"
      ]
    },
    "detalhes_pagamento": {
      "type": "object",
      "properties": {
        "forma_pagamento": {
          "type": "string",
          "description": "V22.0 ETAPA 4: Forma de pagamento detalhada"
        },
        "bandeira_cartao": {
          "type": "string",
          "enum": [
            "Visa",
            "Mastercard",
            "Elo",
            "American Express",
            "Hipercard",
            "Outro"
          ],
          "description": "V22.0 ETAPA 4: Bandeira do cartão utilizado"
        },
        "numero_autorizacao": {
          "type": "string",
          "description": "V22.0 ETAPA 4: Número de autorização da transação"
        },
        "taxa_operadora": {
          "type": "number",
          "default": 0,
          "description": "V22.0 ETAPA 4: % de taxa cobrada pela operadora"
        },
        "valor_bruto": {
          "type": "number",
          "description": "V22.0 ETAPA 4: Valor antes das taxas"
        },
        "valor_liquido": {
          "type": "number",
          "description": "V22.0 ETAPA 4: Valor após descontar taxas"
        },
        "data_recebido_caixa": {
          "type": "string",
          "format": "date",
          "description": "V22.0 ETAPA 4: ESTÁGIO 1 - Quando foi recebido/pago no caixa"
        },
        "data_compensado_banco": {
          "type": "string",
          "format": "date",
          "description": "V22.0 ETAPA 4: ESTÁGIO 2 - Quando compensou no banco"
        },
        "status_compensacao": {
          "type": "string",
          "enum": [
            "Aguardando",
            "Compensado",
            "Conciliado"
          ],
          "default": "Aguardando",
          "description": "V22.0 ETAPA 4: Status da compensação bancária"
        },
        "observacoes": {
          "type": "string",
          "description": "V22.0 ETAPA 4: Observações sobre a liquidação"
        }
      },
      "description": "V22.0 ETAPA 4: Detalhes completos do pagamento"
    },
    "numero_documento": {
      "type": "string"
    },
    "nota_fiscal_id": {
      "type": "string"
    },
    "ordem_compra_id": {
      "type": "string"
    },
    "numero_parcela": {
      "type": "string",
      "description": "Ex: 1/3"
    },
    "juros": {
      "type": "number"
    },
    "multa": {
      "type": "number"
    },
    "desconto": {
      "type": "number"
    },
    "valor_pago": {
      "type": "number"
    },
    "pago_por": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "description": "Quem efetivamente pagou"
    },
    "empresa_que_pagou_id": {
      "type": "string",
      "description": "ID da empresa que fez o pagamento (se pago_por=empresa mas título é do grupo)"
    },
    "comprovante_pagamento_url": {
      "type": "string",
      "description": "URL do comprovante de pagamento"
    },
    "marketplace_origem": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Mercado Livre",
        "Shopee",
        "Amazon",
        "Outro"
      ],
      "default": "Nenhum",
      "description": "Se veio de marketplace"
    },
    "taxa_marketplace_esperada": {
      "type": "number",
      "default": 0,
      "description": "% de taxa esperada do marketplace"
    },
    "taxa_marketplace_cobrada": {
      "type": "number",
      "default": 0,
      "description": "% de taxa efetivamente cobrada"
    },
    "alerta_taxa_divergente": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA detectou divergência na taxa"
    },
    "duplicidade_detectada": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA detectou possível duplicidade"
    },
    "contas_similares_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de contas similares detectadas pela IA"
    },
    "observacoes": {
      "type": "string"
    },
    "sincronizar_baixa_com_grupo": {
      "type": "boolean",
      "default": true,
      "description": "Se baixa aqui deve baixar no grupo"
    },
    "distribuicao_realizada": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "empresa_id": {
            "type": "string"
          },
          "empresa_nome": {
            "type": "string"
          },
          "titulo_id": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "percentual": {
            "type": "number"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "description": "Distribuição realizada para empresas (se origem=grupo)"
    },
    "auditoria_pagamento": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "usuario_id": {
            "type": "string"
          },
          "usuario_email": {
            "type": "string"
          },
          "acao": {
            "type": "string",
            "enum": [
              "baixa",
              "cancelamento",
              "alteracao_valor"
            ]
          },
          "data_hora": {
            "type": "string",
            "format": "date-time"
          },
          "valor_anterior": {
            "type": "number"
          },
          "valor_novo": {
            "type": "number"
          },
          "motivo": {
            "type": "string"
          }
        }
      },
      "description": "P3: Auditoria completa de ações sensíveis em RBAC"
    }
  },
  "required": [
    "descricao",
    "valor",
    "data_vencimento",
    "centro_custo_id",
    "plano_contas_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}