{
  "name": "OrcamentoSite",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Site Base44",
        "Portal Cliente",
        "Chatbot WhatsApp",
        "API Externa"
      ],
      "description": "Origem do orçamento"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente/visitante"
    },
    "cliente_email": {
      "type": "string",
      "description": "E-mail do cliente"
    },
    "cliente_telefone": {
      "type": "string",
      "description": "Telefone/WhatsApp"
    },
    "cliente_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ (se informado)"
    },
    "cliente_erp_id": {
      "type": "string",
      "description": "ID do cliente no ERP (se já cadastrado)"
    },
    "descricao_pedido": {
      "type": "string",
      "description": "Descrição textual do que o cliente quer"
    },
    "arquivo_projeto_url": {
      "type": "string",
      "description": "URL do PDF/DWG enviado pelo cliente"
    },
    "arquivo_projeto_nome": {
      "type": "string",
      "description": "Nome do arquivo enviado"
    },
    "processado_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA já processou"
    },
    "data_processamento_ia": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a IA processou"
    },
    "resultado_ia": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON completo da análise da IA"
    },
    "confianca_ia": {
      "type": "number",
      "description": "% de confiança da IA (0-100)"
    },
    "produtos_identificados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "preco_estimado": {
            "type": "number"
          },
          "produto_id_sugerido": {
            "type": "string"
          }
        }
      },
      "description": "Produtos identificados pela IA"
    },
    "valor_estimado_total": {
      "type": "number",
      "description": "Valor total estimado pela IA"
    },
    "prazo_estimado_dias": {
      "type": "number",
      "description": "Prazo estimado de entrega"
    },
    "status": {
      "type": "string",
      "enum": [
        "Recebido",
        "Processando IA",
        "Orçamento Gerado",
        "Enviado ao Cliente",
        "Aprovado",
        "Convertido em Pedido",
        "Expirado",
        "Cancelado"
      ],
      "default": "Recebido",
      "description": "Status do orçamento"
    },
    "orcamento_pdf_url": {
      "type": "string",
      "description": "URL do PDF do orçamento gerado"
    },
    "data_envio_cliente": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi enviado ao cliente"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o cliente aprovou"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "description": "Validade do orçamento"
    },
    "pedido_erp_id": {
      "type": "string",
      "description": "ID do pedido criado no ERP (após conversão)"
    },
    "responsavel_atendimento": {
      "type": "string",
      "description": "Vendedor que pegou o atendimento"
    },
    "responsavel_id": {
      "type": "string"
    },
    "notificacao_vendedor_enviada": {
      "type": "boolean",
      "default": false,
      "description": "Se vendedor foi notificado (V16.1)"
    },
    "notificacao_id": {
      "type": "string",
      "description": "ID da notificação enviada (V16.1)"
    },
    "mensagens_chat": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "autor": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Cliente",
              "Vendedor",
              "Bot IA"
            ]
          }
        }
      },
      "description": "Histórico de conversas"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "cliente_nome",
    "cliente_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}