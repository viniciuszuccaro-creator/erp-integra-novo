{
  "name": "TipoFrete",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do tipo de frete"
    },
    "nome": {
      "type": "string",
      "description": "Nome do tipo de frete — único por grupo"
    },
    "descricao": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "CIF",
        "FOB",
        "Retira",
        "Cortesia",
        "Outro"
      ],
      "default": "CIF",
      "description": "Tipo de frete"
    },
    "responsavel_pagamento": {
      "type": "string",
      "enum": [
        "Remetente",
        "Destinatário",
        "Terceiro"
      ],
      "default": "Remetente"
    },
    "calculo_frete": {
      "type": "string",
      "enum": [
        "Fixo",
        "Por Peso",
        "Por Volume",
        "Por Distância",
        "Tabela",
        "Negociado"
      ],
      "default": "Tabela"
    },
    "valor_fixo": {
      "type": "number",
      "default": 0,
      "description": "Valor fixo do frete (se aplicável)"
    },
    "valor_por_kg": {
      "type": "number",
      "default": 0
    },
    "valor_por_km": {
      "type": "number",
      "default": 0
    },
    "valor_minimo": {
      "type": "number",
      "default": 0,
      "description": "Valor mínimo de frete"
    },
    "icone": {
      "type": "string",
      "description": "Ícone representativo"
    },
    "cor": {
      "type": "string",
      "description": "Cor de identificação (hex)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}