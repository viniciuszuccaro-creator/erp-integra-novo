{
  "name": "Chamado",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa responsável pelo atendimento"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente que abriu o chamado"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "origem_chamado": {
      "type": "string",
      "enum": [
        "Portal",
        "WhatsApp",
        "E-mail",
        "Telefone",
        "Chatbot",
        "Site"
      ],
      "default": "Portal",
      "description": "Canal de abertura"
    },
    "titulo": {
      "type": "string",
      "description": "Título do chamado"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição detalhada do chamado"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Suporte Técnico",
        "Financeiro",
        "Comercial",
        "Entrega",
        "Produto",
        "Outro"
      ],
      "default": "Suporte Técnico",
      "description": "Categoria do chamado"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Média",
        "Alta",
        "Urgente"
      ],
      "default": "Média",
      "description": "Prioridade do chamado"
    },
    "prioridade_ia": {
      "type": "number",
      "description": "Prioridade calculada por IA baseada em sentimento (0-100)"
    },
    "sentimento_detectado": {
      "type": "string",
      "enum": [
        "Positivo",
        "Neutro",
        "Negativo",
        "Urgente",
        "Frustrado"
      ],
      "description": "Sentimento da abertura"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Em Andamento",
        "Aguardando Cliente",
        "Resolvido",
        "Fechado"
      ],
      "default": "Aberto",
      "description": "Status atual do chamado"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do colaborador responsável"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do responsável"
    },
    "data_abertura": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura do chamado"
    },
    "data_resolucao": {
      "type": "string",
      "format": "date",
      "description": "Data de resolução do chamado"
    },
    "tempo_primeira_resposta_min": {
      "type": "number",
      "description": "Tempo até primeira resposta (SLA)"
    },
    "tempo_resolucao_horas": {
      "type": "number",
      "description": "Tempo total de resolução"
    },
    "pedido_relacionado_id": {
      "type": "string",
      "description": "ID do pedido relacionado"
    },
    "entrega_relacionada_id": {
      "type": "string",
      "description": "ID da entrega relacionada"
    },
    "mensagens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "autor": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Cliente",
              "Atendente",
              "Bot IA"
            ]
          }
        }
      },
      "description": "Histórico de mensagens do chamado"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs dos anexos"
    },
    "avaliacao": {
      "type": "object",
      "properties": {
        "nota": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "comentario": {
          "type": "string"
        }
      },
      "description": "Avaliação do atendimento"
    }
  },
  "required": [
    "cliente_id",
    "titulo",
    "descricao",
    "categoria"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}