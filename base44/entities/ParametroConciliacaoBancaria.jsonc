{
  "name": "ParametroConciliacaoBancaria",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "banco_id": {
      "type": "string",
      "description": "ID do banco"
    },
    "conta_bancaria_id": {
      "type": "string",
      "description": "ID da conta banc\u00e1ria"
    },
    "tipo_lancamento": {
      "type": "string",
      "enum": [
        "Cr\u00e9dito",
        "D\u00e9bito",
        "Ambos"
      ],
      "default": "Ambos"
    },
    "identificadores_matching": {
      "type": "object",
      "properties": {
        "usar_nsu": {
          "type": "boolean",
          "default": true
        },
        "usar_historico": {
          "type": "boolean",
          "default": true
        },
        "usar_convenio": {
          "type": "boolean",
          "default": true
        },
        "usar_nosso_numero": {
          "type": "boolean",
          "default": true
        },
        "usar_codigo_barras": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "prioridade_matching": {
      "type": "string",
      "enum": [
        "Por Valor",
        "Por Data",
        "Por Documento",
        "Combina\u00e7\u00e3o Inteligente"
      ],
      "default": "Combina\u00e7\u00e3o Inteligente"
    },
    "tolerancia_diferenca_valor": {
      "type": "number",
      "default": 0.01,
      "description": "Toler\u00e2ncia de diferen\u00e7a em valor (R$)"
    },
    "tolerancia_diferenca_dias": {
      "type": "number",
      "default": 2,
      "description": "Toler\u00e2ncia de diferen\u00e7a em dias"
    },
    "conta_contabil_nao_identificado": {
      "type": "string",
      "description": "Conta cont\u00e1bil para lan\u00e7amentos n\u00e3o identificados"
    },
    "usar_ia_aprendizado": {
      "type": "boolean",
      "default": true,
      "description": "Se usa IA para aprender com concilia\u00e7\u00f5es anteriores"
    },
    "conciliacao_automatica_ativa": {
      "type": "boolean",
      "default": false,
      "description": "Se faz concilia\u00e7\u00e3o autom\u00e1tica"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "banco_id"
  ]
}