{
  "name": "PosicaoVeiculo",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "entrega_id": {
      "type": "string",
      "description": "ID da entrega vinculada"
    },
    "romaneio_id": {
      "type": "string",
      "description": "ID do romaneio vinculado"
    },
    "rota_id": {
      "type": "string",
      "description": "ID da rota vinculada"
    },
    "veiculo_id": {
      "type": "string",
      "description": "ID do veículo"
    },
    "placa": {
      "type": "string",
      "description": "Placa do veículo"
    },
    "motorista_id": {
      "type": "string",
      "description": "ID do motorista"
    },
    "motorista_nome": {
      "type": "string",
      "description": "Nome do motorista"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da captura da posição"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude GPS"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude GPS"
    },
    "precisao_metros": {
      "type": "number",
      "description": "Precisão do GPS em metros"
    },
    "velocidade_kmh": {
      "type": "number",
      "description": "Velocidade em km/h"
    },
    "direcao_graus": {
      "type": "number",
      "description": "Direção em graus (0-360)"
    },
    "altitude_metros": {
      "type": "number",
      "description": "Altitude em metros"
    },
    "endereco_aproximado": {
      "type": "string",
      "description": "Endereço aproximado (reverse geocoding)"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade atual"
    },
    "estado": {
      "type": "string",
      "description": "Estado atual"
    },
    "distancia_proxima_entrega_km": {
      "type": "number",
      "description": "Distância até a próxima entrega em km"
    },
    "tempo_estimado_proxima_entrega_min": {
      "type": "number",
      "description": "Tempo estimado até próxima entrega em minutos"
    },
    "status_movimento": {
      "type": "string",
      "enum": [
        "Parado",
        "Em Movimento",
        "Em Entrega",
        "Retornando"
      ],
      "description": "Status do movimento do veículo"
    },
    "bateria_nivel": {
      "type": "number",
      "description": "Nível de bateria do dispositivo (%)"
    },
    "conectividade": {
      "type": "string",
      "enum": [
        "WiFi",
        "4G",
        "3G",
        "Offline"
      ],
      "description": "Tipo de conexão"
    },
    "dispositivo_id": {
      "type": "string",
      "description": "ID do dispositivo móvel"
    },
    "app_versao": {
      "type": "string",
      "description": "Versão do app móvel"
    },
    "sincronizado": {
      "type": "boolean",
      "default": true,
      "description": "Se foi sincronizado com sucesso"
    }
  },
  "required": [
    "entrega_id",
    "data_hora",
    "latitude",
    "longitude"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}