{
  "name": "PerfilAcesso",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do perfil de acesso"
    },
    "nome_perfil": {
      "type": "string",
      "description": "Nome do perfil — único por grupo"
    },
    "descricao": {
      "type": "string"
    },
    "nivel_perfil": {
      "type": "string",
      "enum": [
        "Administrador",
        "Gerencial",
        "Operacional",
        "Consulta",
        "Personalizado"
      ],
      "default": "Operacional"
    },
    "permissoes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Estrutura flexível: módulo → seção → [ações]."
    },
    "permissoes_sensiveis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflitos_sod_detectados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo_conflito": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "severidade": {
            "type": "string",
            "enum": [
              "Baixa",
              "Média",
              "Alta",
              "Crítica"
            ]
          },
          "data_deteccao": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "requer_aprovacao_especial": {
      "type": "boolean",
      "default": false
    },
    "aprovado_por": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_perfil",
    "permissoes"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}