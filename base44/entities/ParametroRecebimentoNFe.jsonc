{
  "name": "ParametroRecebimentoNFe",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "sugerir_cadastro_automatico_produto": {
      "type": "boolean",
      "default": true,
      "description": "Se deve sugerir cadastro autom\u00e1tico de produtos novos"
    },
    "usar_ia_para_classificacao": {
      "type": "boolean",
      "default": true,
      "description": "Se usa IA para sugerir grupo, setor, marca"
    },
    "vincular_produtos_fornecedor": {
      "type": "boolean",
      "default": true,
      "description": "Se deve vincular produtos do fornecedor a produtos internos"
    },
    "exigir_conferencia_quantidade": {
      "type": "boolean",
      "default": true,
      "description": "Se exige confer\u00eancia de quantidade no recebimento"
    },
    "exigir_conferencia_impostos": {
      "type": "boolean",
      "default": false,
      "description": "Se exige confer\u00eancia de impostos"
    },
    "alertar_divergencia_preco": {
      "type": "boolean",
      "default": true,
      "description": "Se alerta diverg\u00eancia de pre\u00e7o com ordem de compra"
    },
    "percentual_tolerancia_preco": {
      "type": "number",
      "default": 5,
      "description": "% de toler\u00e2ncia de diferen\u00e7a de pre\u00e7o"
    },
    "gerar_movimentacao_estoque_automatica": {
      "type": "boolean",
      "default": true,
      "description": "Se gera movimenta\u00e7\u00e3o de estoque ao receber"
    },
    "atualizar_custo_medio_automatico": {
      "type": "boolean",
      "default": true,
      "description": "Se atualiza custo m\u00e9dio automaticamente"
    },
    "local_estoque_padrao_id": {
      "type": "string",
      "description": "ID do local de estoque padr\u00e3o para recebimento"
    },
    "exigir_foto_comprovante": {
      "type": "boolean",
      "default": false,
      "description": "Se exige foto do recebimento"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id"
  ]
}