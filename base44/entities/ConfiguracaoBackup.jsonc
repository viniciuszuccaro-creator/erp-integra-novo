{
  "name": "ConfiguracaoBackup",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (null se configuração do grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da configuração"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o backup automático está ativo"
    },
    "frequencia": {
      "type": "string",
      "enum": [
        "Diário",
        "Semanal",
        "Quinzenal",
        "Mensal"
      ],
      "default": "Diário",
      "description": "Se backup é diário, semanal, quinzenal ou mensal"
    },
    "horario_execucao": {
      "type": "string",
      "default": "02:00"
    },
    "dia_semana": {
      "type": "string",
      "enum": [
        "Domingo",
        "Segunda",
        "Terça",
        "Quarta",
        "Quinta",
        "Sexta",
        "Sábado"
      ]
    },
    "dia_mes": {
      "type": "number",
      "minimum": 1,
      "maximum": 31
    },
    "tipo_backup_padrao": {
      "type": "string",
      "enum": [
        "Completo",
        "Incremental",
        "Diferencial"
      ],
      "default": "Completo"
    },
    "backup_completo_frequencia": {
      "type": "string",
      "enum": [
        "Semanal",
        "Quinzenal",
        "Mensal"
      ],
      "default": "Semanal"
    },
    "retencao_dias": {
      "type": "number",
      "default": 30
    },
    "retencao_backups_completos": {
      "type": "number",
      "default": 4
    },
    "retencao_backups_incrementais": {
      "type": "number",
      "default": 30
    },
    "provider_storage": {
      "type": "string",
      "enum": [
        "Base44 Cloud",
        "AWS S3",
        "Google Cloud Storage",
        "Azure Blob",
        "Local"
      ],
      "default": "Base44 Cloud"
    },
    "aws_s3_config": {
      "type": "object",
      "properties": {
        "bucket_name": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "access_key_id": {
          "type": "string"
        },
        "secret_access_key": {
          "type": "string"
        },
        "storage_class": {
          "type": "string",
          "enum": [
            "STANDARD",
            "GLACIER",
            "DEEP ARCHIVE"
          ],
          "default": "STANDARD"
        }
      }
    },
    "google_cloud_config": {
      "type": "object",
      "properties": {
        "bucket_name": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "credentials_json": {
          "type": "string"
        },
        "storage_class": {
          "type": "string",
          "enum": [
            "STANDARD",
            "NEARLINE",
            "COLDLINE",
            "ARCHIVE"
          ],
          "default": "STANDARD"
        }
      }
    },
    "azure_blob_config": {
      "type": "object",
      "properties": {
        "account_name": {
          "type": "string"
        },
        "account_key": {
          "type": "string"
        },
        "container_name": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "Hot",
            "Cool",
            "Archive"
          ],
          "default": "Cool"
        }
      }
    },
    "criptografia_ativa": {
      "type": "boolean",
      "default": true
    },
    "algoritmo_criptografia": {
      "type": "string",
      "default": "AES-256-GCM"
    },
    "chave_criptografia": {
      "type": "string"
    },
    "compressao_ativa": {
      "type": "boolean",
      "default": true
    },
    "algoritmo_compressao": {
      "type": "string",
      "enum": [
        "gzip",
        "bzip2",
        "lz4",
        "zstd"
      ],
      "default": "gzip"
    },
    "nivel_compressao": {
      "type": "number",
      "default": 6,
      "minimum": 1,
      "maximum": 9
    },
    "modulos_incluir": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "modulos_excluir": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "incluir_anexos": {
      "type": "boolean",
      "default": true
    },
    "incluir_logs": {
      "type": "boolean",
      "default": false
    },
    "incluir_configuracoes": {
      "type": "boolean",
      "default": true
    },
    "notificar_email": {
      "type": "boolean",
      "default": true
    },
    "emails_notificacao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notificar_apenas_erro": {
      "type": "boolean",
      "default": false
    },
    "webhook_url": {
      "type": "string"
    },
    "webhook_token": {
      "type": "string"
    },
    "validar_integridade": {
      "type": "boolean",
      "default": true
    },
    "testar_restauracao": {
      "type": "boolean",
      "default": false
    },
    "replicacao_geografica": {
      "type": "boolean",
      "default": false
    },
    "regioes_replicacao": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ultimo_backup_id": {
      "type": "string"
    },
    "ultimo_backup_sucesso": {
      "type": "string",
      "format": "date-time"
    },
    "ultimo_backup_erro": {
      "type": "string",
      "format": "date-time"
    },
    "total_backups_executados": {
      "type": "number",
      "default": 0
    },
    "total_backups_sucesso": {
      "type": "number",
      "default": 0
    },
    "total_backups_erro": {
      "type": "number",
      "default": 0
    },
    "taxa_sucesso_percentual": {
      "type": "number"
    },
    "espaco_total_usado_gb": {
      "type": "number",
      "default": 0
    },
    "proximo_backup_agendado": {
      "type": "string",
      "format": "date-time"
    },
    "configurado_por": {
      "type": "string"
    },
    "configurado_por_id": {
      "type": "string"
    },
    "data_configuracao": {
      "type": "string",
      "format": "date-time"
    },
    "historico_alteracoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          },
          "campo": {
            "type": "string"
          },
          "valor_anterior": {
            "type": "string"
          },
          "valor_novo": {
            "type": "string"
          }
        }
      }
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "ativo",
    "frequencia",
    "horario_execucao",
    "provider_storage"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}