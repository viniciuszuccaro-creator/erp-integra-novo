{
  "name": "LocalEstoque",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "empresa_dona_id": {
      "type": "string",
      "description": "Empresa que cadastrou o local"
    },
    "empresas_compartilhadas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Empresas que podem usar este local"
    },
    "nome": {
      "type": "string",
      "description": "Nome do local — único por grupo (Ex: Almoxarifado Central, Depósito A)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do local"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Almoxarifado",
        "Depósito",
        "Loja",
        "Produção",
        "Expedição",
        "Quarentena",
        "Outro"
      ],
      "default": "Almoxarifado"
    },
    "endereco_completo": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        }
      }
    },
    "estrutura_fisica": {
      "type": "object",
      "properties": {
        "tem_corredores": {
          "type": "boolean",
          "default": false
        },
        "tem_prateleiras": {
          "type": "boolean",
          "default": false
        },
        "tem_andares": {
          "type": "boolean",
          "default": false
        },
        "quantidade_corredores": {
          "type": "number"
        },
        "quantidade_ruas": {
          "type": "number"
        }
      },
      "description": "Estrutura física para picking"
    },
    "capacidade_m3": {
      "type": "number",
      "description": "Capacidade em m³"
    },
    "ocupacao_atual_m3": {
      "type": "number",
      "default": 0
    },
    "responsavel_nome": {
      "type": "string"
    },
    "responsavel_id": {
      "type": "string"
    },
    "controla_temperatura": {
      "type": "boolean",
      "default": false
    },
    "temperatura_min": {
      "type": "number"
    },
    "temperatura_max": {
      "type": "number"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}