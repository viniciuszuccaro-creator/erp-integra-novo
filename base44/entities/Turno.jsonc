{
  "name": "Turno",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código único do turno"
    },
    "nome_turno": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "horario_inicio": {
      "type": "string"
    },
    "horario_fim": {
      "type": "string"
    },
    "intervalo_inicio": {
      "type": "string"
    },
    "intervalo_fim": {
      "type": "string"
    },
    "carga_horaria_diaria": {
      "type": "number"
    },
    "dias_semana": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Segunda",
          "Terça",
          "Quarta",
          "Quinta",
          "Sexta",
          "Sábado",
          "Domingo"
        ]
      }
    },
    "tipo_turno": {
      "type": "string",
      "enum": [
        "Administrativo",
        "Produção",
        "Comercial",
        "Logística",
        "Outro"
      ],
      "default": "Administrativo"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_turno",
    "horario_inicio",
    "horario_fim"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}