{
  "name": "RotaPadrao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico da rota"
    },
    "nome_rota": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_rota": {
      "type": "string",
      "enum": [
        "Urbana",
        "Interurbana",
        "Regional",
        "Estadual",
        "Nacional"
      ],
      "default": "Urbana"
    },
    "regioes_atendidas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dias_semana_operacao": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Segunda",
          "Ter\u00e7a",
          "Quarta",
          "Quinta",
          "Sexta",
          "S\u00e1bado",
          "Domingo"
        ]
      }
    },
    "horario_saida_padrao": {
      "type": "string"
    },
    "tempo_medio_rota_horas": {
      "type": "number"
    },
    "distancia_media_km": {
      "type": "number"
    },
    "veiculo_recomendado_tipo": {
      "type": "string"
    },
    "motorista_padrao_id": {
      "type": "string"
    },
    "transportadora_padrao_id": {
      "type": "string"
    },
    "custo_medio_rota": {
      "type": "number"
    },
    "pontos_referencia": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "ordem": {
            "type": "number"
          }
        }
      }
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_rota",
    "empresa_id"
  ]
}