{
  "name": "ModeloDocumento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa dona do modelo (null = global)"
    },
    "nome_modelo": {
      "type": "string",
      "description": "Nome do modelo"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "Romaneio",
        "Ordem de Carga",
        "Etiqueta Produto",
        "Canhoto",
        "Termo de Entrega",
        "Or\u00e7amento",
        "Proposta Comercial"
      ],
      "description": "Tipo de documento"
    },
    "descricao": {
      "type": "string"
    },
    "template_html": {
      "type": "string",
      "description": "Template HTML com vari\u00e1veis {{variavel}}"
    },
    "template_css": {
      "type": "string",
      "description": "CSS customizado do template"
    },
    "variaveis_disponiveis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variavel": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "exemplo": {
            "type": "string"
          }
        }
      },
      "description": "Lista de vari\u00e1veis que podem ser usadas"
    },
    "orientacao_pagina": {
      "type": "string",
      "enum": [
        "Retrato",
        "Paisagem"
      ],
      "default": "Retrato"
    },
    "tamanho_papel": {
      "type": "string",
      "enum": [
        "A4",
        "A5",
        "Etiqueta 10x15",
        "Carta"
      ],
      "default": "A4"
    },
    "logo_empresa_url": {
      "type": "string",
      "description": "URL da logo que aparece no documento"
    },
    "cabecalho_html": {
      "type": "string",
      "description": "HTML do cabe\u00e7alho"
    },
    "rodape_html": {
      "type": "string",
      "description": "HTML do rodap\u00e9"
    },
    "padrao_sistema": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 modelo padr\u00e3o do sistema (n\u00e3o pode ser exclu\u00eddo)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_modelo",
    "tipo_documento"
  ]
}