{
  "name": "CatalogoWeb",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto no catálogo"
    },
    "exibir_no_ecommerce": {
      "type": "boolean",
      "default": false,
      "description": "Se exibe no e-commerce próprio"
    },
    "exibir_no_marketplace": {
      "type": "boolean",
      "default": false,
      "description": "Se sincroniza com marketplaces"
    },
    "exibir_no_site": {
      "type": "boolean",
      "default": false,
      "description": "Se exibe no site institucional"
    },
    "exibir_no_catalogo_pdf": {
      "type": "boolean",
      "default": false,
      "description": "Se aparece no catálogo PDF"
    },
    "exibir_no_app": {
      "type": "boolean",
      "default": false,
      "description": "Se aparece no app mobile"
    },
    "preco_exibido": {
      "type": "number",
      "description": "Preço a ser exibido"
    },
    "tabela_preco_vinculada_id": {
      "type": "string",
      "description": "ID da tabela de preço vinculada"
    },
    "categoria_navegacao": {
      "type": "string",
      "description": "Categoria para navegação no site/e-commerce"
    },
    "subcategoria_navegacao": {
      "type": "string"
    },
    "tags_seo": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para SEO"
    },
    "palavras_chave": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palavras-chave para busca"
    },
    "slug_url": {
      "type": "string",
      "description": "URL amigável"
    },
    "titulo_seo": {
      "type": "string",
      "description": "Título para SEO"
    },
    "meta_description": {
      "type": "string",
      "description": "Meta descrição para SEO"
    },
    "imagens_principais": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das imagens principais"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de vídeos do produto"
    },
    "manual_pdf_url": {
      "type": "string",
      "description": "URL do manual em PDF"
    },
    "certificado_url": {
      "type": "string",
      "description": "URL do certificado"
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Se é produto em destaque"
    },
    "ordem_exibicao": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibição"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de publicação"
    },
    "data_expiracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de expiração (opcional)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "produto_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}