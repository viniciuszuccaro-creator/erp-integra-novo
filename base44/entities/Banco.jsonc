{
  "name": "Banco",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do registro"
    },
    "codigo_banco": {
      "type": "string",
      "description": "Código oficial do banco (ex: 001, 237, 341) — único por grupo"
    },
    "nome_banco": {
      "type": "string"
    },
    "nome_completo": {
      "type": "string"
    },
    "pais": {
      "type": "string",
      "default": "Brasil"
    },
    "url_site": {
      "type": "string"
    },
    "integracao_disponivel": {
      "type": "boolean",
      "default": false
    },
    "tipo_integracao": {
      "type": "string",
      "enum": [
        "API",
        "OFX",
        "CNAB",
        "Open Banking",
        "Manual"
      ]
    },
    "api_url": {
      "type": "string"
    },
    "api_versao": {
      "type": "string"
    },
    "suporta_conciliacao_automatica": {
      "type": "boolean",
      "default": false
    },
    "suporta_extrato_automatico": {
      "type": "boolean",
      "default": false
    },
    "suporta_cobranca_boleto": {
      "type": "boolean",
      "default": false
    },
    "suporta_cobranca_pix": {
      "type": "boolean",
      "default": false
    },
    "logo_url": {
      "type": "string"
    },
    "cor_primaria": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "codigo_banco",
    "nome_banco"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}