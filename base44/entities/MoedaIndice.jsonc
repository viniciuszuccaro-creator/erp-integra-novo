{
  "name": "MoedaIndice",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro \u00fanico compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico (BRL, USD, EUR, SELIC, IPCA, CDI)"
    },
    "nome": {
      "type": "string",
      "description": "Nome completo \u2014 \u00fanico por grupo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Moeda",
        "\u00cdndice Econ\u00f4mico"
      ],
      "description": "Tipo"
    },
    "simbolo": {
      "type": "string",
      "description": "S\u00edmbolo (R$, $, \u20ac, %)"
    },
    "valor_atual": {
      "type": "number",
      "description": "Valor/cota\u00e7\u00e3o atual"
    },
    "data_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o"
    },
    "fonte_dados": {
      "type": "string",
      "description": "Fonte (BCB, IBGE, API Awesome)"
    },
    "atualiza_automaticamente": {
      "type": "boolean",
      "default": false,
      "description": "Se atualiza via IA/API autom\u00e1tica"
    },
    "frequencia_atualizacao": {
      "type": "string",
      "enum": [
        "Tempo Real",
        "Di\u00e1rio",
        "Semanal",
        "Mensal"
      ],
      "description": "Frequ\u00eancia de atualiza\u00e7\u00e3o"
    },
    "historico_valores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date"
          },
          "valor": {
            "type": "number"
          }
        }
      },
      "description": "Hist\u00f3rico de cota\u00e7\u00f5es"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "codigo",
    "nome",
    "tipo"
  ]
}