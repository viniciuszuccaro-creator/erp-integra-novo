{
  "name": "ModeloDocumento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa dona do modelo (null = global)"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "nome_modelo": {
      "type": "string",
      "description": "Nome do modelo"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "Romaneio",
        "Ordem de Carga",
        "Etiqueta Produto",
        "Canhoto",
        "Termo de Entrega",
        "Orçamento",
        "Proposta Comercial"
      ],
      "description": "Tipo de documento"
    },
    "descricao": {
      "type": "string"
    },
    "template_html": {
      "type": "string",
      "description": "Template HTML com variáveis {{variavel}}"
    },
    "template_css": {
      "type": "string",
      "description": "CSS customizado do template"
    },
    "variaveis_disponiveis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variavel": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "exemplo": {
            "type": "string"
          }
        }
      },
      "description": "Lista de variáveis que podem ser usadas"
    },
    "orientacao_pagina": {
      "type": "string",
      "enum": [
        "Retrato",
        "Paisagem"
      ],
      "default": "Retrato"
    },
    "tamanho_papel": {
      "type": "string",
      "enum": [
        "A4",
        "A5",
        "Etiqueta 10x15",
        "Carta"
      ],
      "default": "A4"
    },
    "logo_empresa_url": {
      "type": "string",
      "description": "URL da logo que aparece no documento"
    },
    "cabecalho_html": {
      "type": "string",
      "description": "HTML do cabeçalho"
    },
    "rodape_html": {
      "type": "string",
      "description": "HTML do rodapé"
    },
    "padrao_sistema": {
      "type": "boolean",
      "default": false,
      "description": "Se é modelo padrão do sistema (não pode ser excluído)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_modelo",
    "tipo_documento"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}