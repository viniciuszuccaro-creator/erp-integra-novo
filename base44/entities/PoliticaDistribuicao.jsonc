{
  "name": "PoliticaDistribuicao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da política"
    },
    "nome": {
      "type": "string",
      "description": "Nome da política — único por grupo (ex: Distribuição Financeiro Padrão)"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "financeiro_pagar",
        "financeiro_receber",
        "pedido_compra",
        "pedido_venda_interno",
        "centro_custo",
        "rateio_despesa",
        "folha_pagamento",
        "estoque",
        "producao",
        "geral"
      ],
      "description": "Tipo de documento que esta política se aplica"
    },
    "criterio": {
      "type": "string",
      "enum": [
        "percentual",
        "por_faturamento",
        "fixo_por_empresa",
        "manual"
      ],
      "default": "percentual",
      "description": "Critério de distribuição"
    },
    "definicoes": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON com definições por empresa"
    },
    "empresas_participantes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "empresa_id": {
            "type": "string"
          },
          "empresa_nome": {
            "type": "string"
          },
          "percentual": {
            "type": "number",
            "description": "% se critério for percentual"
          },
          "valor_fixo": {
            "type": "number",
            "description": "Valor fixo se critério for fixo"
          },
          "ativo": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "description": "Lista de empresas participantes da distribuição"
    },
    "ativa": {
      "type": "boolean",
      "default": true
    },
    "padrao_para_tipo": {
      "type": "boolean",
      "default": false,
      "description": "Se é a política padrão para este tipo de documento"
    },
    "permite_ajuste_manual": {
      "type": "boolean",
      "default": true,
      "description": "Se permite ajuste manual dos valores na hora da distribuição"
    },
    "historico_uso": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "documento_tipo": {
            "type": "string"
          },
          "documento_id": {
            "type": "string"
          },
          "valor_total": {
            "type": "number"
          },
          "distribuicao_realizada": {
            "type": "object"
          }
        }
      },
      "description": "Histórico de documentos que usaram esta política"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "nome",
    "tipo_documento",
    "criterio"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}