{
  "name": "Entrega",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa responsável pela entrega"
    },
    "regiao_entrega_id": {
      "type": "string",
      "description": "ID da região de entrega"
    },
    "regiao_entrega_nome": {
      "type": "string",
      "description": "Nome da região (snapshot)"
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do pedido"
    },
    "numero_pedido": {
      "type": "string"
    },
    "op_id": {
      "type": "string",
      "description": "ID da ordem de produção (se vier da produção)"
    },
    "nfe_id": {
      "type": "string",
      "description": "ID da nota fiscal vinculada"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "endereco_entrega_id": {
      "type": "string",
      "description": "ID do local de entrega cadastrado no cliente"
    },
    "endereco_entrega_completo": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "pais": {
          "type": "string",
          "default": "Brasil"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "referencia": {
          "type": "string"
        },
        "link_google_maps": {
          "type": "string"
        }
      },
      "description": "Snapshot do endereço usado na entrega"
    },
    "contato_entrega": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string"
        },
        "telefone": {
          "type": "string"
        },
        "whatsapp": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "cargo": {
          "type": "string"
        },
        "instrucoes_especiais": {
          "type": "string"
        }
      },
      "description": "Contato para a entrega"
    },
    "data_separacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da separação"
    },
    "data_saida": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da saída para entrega"
    },
    "data_previsao": {
      "type": "string",
      "format": "date"
    },
    "data_entrega": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora real da entrega"
    },
    "janela_entrega_inicio": {
      "type": "string",
      "description": "Horário início (HH:MM)"
    },
    "janela_entrega_fim": {
      "type": "string",
      "description": "Horário fim (HH:MM)"
    },
    "transportadora": {
      "type": "string"
    },
    "transportadora_id": {
      "type": "string"
    },
    "tipo_frete": {
      "type": "string",
      "enum": [
        "CIF",
        "FOB",
        "Retira",
        "Outro"
      ],
      "default": "CIF"
    },
    "motorista": {
      "type": "string"
    },
    "motorista_id": {
      "type": "string"
    },
    "motorista_telefone": {
      "type": "string"
    },
    "veiculo": {
      "type": "string"
    },
    "veiculo_id": {
      "type": "string"
    },
    "placa": {
      "type": "string"
    },
    "codigo_rastreamento": {
      "type": "string",
      "description": "Código de rastreio da transportadora"
    },
    "link_rastreamento": {
      "type": "string",
      "description": "Link de rastreamento (campo preparado para integração)"
    },
    "qr_code": {
      "type": "string",
      "description": "QR Code único para rastreamento interno"
    },
    "rota_id": {
      "type": "string",
      "description": "ID da rota (se fizer parte de roteirização)"
    },
    "romaneio_id": {
      "type": "string",
      "description": "ID do romaneio que contém esta entrega"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Normal",
        "Alta",
        "Urgente"
      ],
      "default": "Normal"
    },
    "volumes": {
      "type": "number",
      "description": "Quantidade de volumes"
    },
    "peso_total_kg": {
      "type": "number"
    },
    "volume_total_m3": {
      "type": "number",
      "description": "Volume total estimado em m³ (para restrições de capacidade)"
    },
    "valor_frete": {
      "type": "number"
    },
    "valor_mercadoria": {
      "type": "number",
      "description": "Valor declarado para seguro"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aguardando Separação",
        "Em Separação",
        "Pronto para Expedir",
        "Saiu para Entrega",
        "Em Trânsito",
        "Entregue",
        "Entrega Frustrada",
        "Devolvido",
        "Cancelado"
      ],
      "default": "Aguardando Separação"
    },
    "comprovante_entrega": {
      "type": "object",
      "properties": {
        "foto_comprovante": {
          "type": "string",
          "description": "URL da foto do comprovante"
        },
        "assinatura_digital": {
          "type": "string",
          "description": "URL da assinatura digital"
        },
        "nome_recebedor": {
          "type": "string"
        },
        "documento_recebedor": {
          "type": "string"
        },
        "cargo_recebedor": {
          "type": "string"
        },
        "data_hora_recebimento": {
          "type": "string",
          "format": "date-time"
        },
        "latitude_entrega": {
          "type": "number"
        },
        "longitude_entrega": {
          "type": "number"
        },
        "observacoes_recebimento": {
          "type": "string"
        }
      }
    },
    "entrega_frustrada": {
      "type": "object",
      "properties": {
        "motivo": {
          "type": "string",
          "enum": [
            "Cliente Ausente",
            "Endereço Incorreto",
            "Recusa de Recebimento",
            "Área de Risco",
            "Horário Inadequado",
            "Veículo Quebrado",
            "Condições Climáticas",
            "Outros"
          ]
        },
        "detalhes": {
          "type": "string"
        },
        "tentativa_numero": {
          "type": "number"
        },
        "reagendamento": {
          "type": "string",
          "format": "date"
        },
        "foto_ocorrencia": {
          "type": "string"
        }
      }
    },
    "notificacoes_enviadas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Separação",
              "Saída",
              "Em Trânsito",
              "Chegada",
              "Entregue",
              "Frustrada"
            ]
          },
          "canal": {
            "type": "string",
            "enum": [
              "WhatsApp",
              "E-mail",
              "SMS",
              "Sistema"
            ]
          },
          "destinatario": {
            "type": "string"
          },
          "data_envio": {
            "type": "string",
            "format": "date-time"
          },
          "status_envio": {
            "type": "string",
            "enum": [
              "Enviado",
              "Entregue",
              "Lido",
              "Falhou"
            ]
          },
          "mensagem": {
            "type": "string"
          }
        }
      },
      "description": "Histórico de notificações enviadas"
    },
    "historico_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "data_hora": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          },
          "localizacao": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            }
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Timeline de mudanças de status"
    },
    "ocorrencias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Atraso",
              "Avaria",
              "Extravio",
              "Devolução Parcial",
              "Problema Veículo",
              "Outros"
            ]
          },
          "descricao": {
            "type": "string"
          },
          "data_hora": {
            "type": "string",
            "format": "date-time"
          },
          "responsavel": {
            "type": "string"
          },
          "resolucao": {
            "type": "string"
          },
          "foto_url": {
            "type": "string"
          }
        }
      },
      "description": "Ocorrências durante o transporte"
    },
    "avaliacao_entrega": {
      "type": "object",
      "properties": {
        "nota": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "comentario": {
          "type": "string"
        },
        "data_avaliacao": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "custo_operacional": {
      "type": "number",
      "description": "Custo real da entrega"
    },
    "km_rodado": {
      "type": "number"
    },
    "tempo_total_minutos": {
      "type": "number"
    },
    "link_publico_rastreamento": {
      "type": "string",
      "description": "Link público para rastreamento sem login (V16.1)"
    },
    "rastreamento_habilitado": {
      "type": "boolean",
      "default": true,
      "description": "Se o rastreamento está habilitado (V16.1)"
    },
    "rastreamento_ultima_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Última atualização de GPS (V16.1)"
    },
    "logistica_reversa": {
      "type": "object",
      "properties": {
        "ativada": {
          "type": "boolean",
          "default": false
        },
        "motivo": {
          "type": "string",
          "enum": [
            "Recusa Total",
            "Recusa Parcial",
            "Avaria",
            "Troca",
            "Outro"
          ]
        },
        "data_ocorrencia": {
          "type": "string",
          "format": "date-time"
        },
        "responsavel": {
          "type": "string"
        },
        "quantidade_devolvida": {
          "type": "number"
        },
        "valor_devolvido": {
          "type": "number"
        },
        "movimentacao_estoque_id": {
          "type": "string",
          "description": "ID da entrada de devolução"
        },
        "notificacao_financeiro_id": {
          "type": "string",
          "description": "ID da notificação para bloquear cobrança"
        },
        "observacoes_devolucao": {
          "type": "string"
        }
      },
      "description": "Dados de logística reversa (V16.1)"
    },
    "observacoes": {
      "type": "string"
    },
    "salvar_endereco_no_cliente": {
      "type": "boolean",
      "default": false,
      "description": "Se deve salvar endereço no cadastro do cliente"
    },
    "salvar_contato_no_cliente": {
      "type": "boolean",
      "default": false,
      "description": "Se deve salvar contato no cadastro do cliente"
    },
    "usuario_responsavel": {
      "type": "string"
    },
    "usuario_responsavel_id": {
      "type": "string"
    }
  },
  "required": [
    "cliente_nome",
    "endereco_entrega_completo",
    "empresa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}