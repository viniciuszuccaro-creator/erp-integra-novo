{
  "name": "LogFiscal",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "nfe_id": {
      "type": "string",
      "description": "ID da nota fiscal"
    },
    "numero_nfe": {
      "type": "string",
      "description": "N\u00famero da NF-e"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso (se gerada)"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da tentativa"
    },
    "acao": {
      "type": "string",
      "enum": [
        "gerar_xml",
        "validar",
        "enviar_sefaz",
        "consultar_status",
        "cancelar",
        "carta_correcao",
        "inutilizar",
        "download_xml",
        "download_pdf"
      ],
      "description": "A\u00e7\u00e3o realizada"
    },
    "provedor": {
      "type": "string",
      "description": "Provedor usado (eNotas, NFe.io, etc)"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produ\u00e7\u00e3o",
        "Homologa\u00e7\u00e3o"
      ]
    },
    "payload_enviado": {
      "type": "object",
      "additionalProperties": true,
      "description": "Dados enviados para a API"
    },
    "retorno_recebido": {
      "type": "object",
      "additionalProperties": true,
      "description": "Resposta da API"
    },
    "status": {
      "type": "string",
      "enum": [
        "sucesso",
        "erro",
        "timeout",
        "pendente"
      ],
      "description": "Status da opera\u00e7\u00e3o"
    },
    "codigo_status": {
      "type": "string",
      "description": "C\u00f3digo de status retornado"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem de retorno"
    },
    "tempo_resposta_ms": {
      "type": "number",
      "description": "Tempo de resposta em milissegundos"
    },
    "aprendizado_ia": {
      "type": "object",
      "properties": {
        "erro_sefaz_codigo": {
          "type": "string"
        },
        "erro_sefaz_mensagem": {
          "type": "string"
        },
        "causa_provavel": {
          "type": "string"
        },
        "correcao_sugerida": {
          "type": "string"
        },
        "aprendido": {
          "type": "boolean",
          "default": false
        },
        "data_aprendizado": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Aprendizado cont\u00ednuo da IA com erros da SEFAZ (V16.1)"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que executou"
    },
    "usuario_nome": {
      "type": "string"
    },
    "ip_address": {
      "type": "string",
      "description": "IP do usu\u00e1rio"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "nfe_id",
    "data_hora",
    "acao",
    "status"
  ]
}