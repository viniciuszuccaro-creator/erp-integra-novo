{
  "name": "LogsIA",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tipo_ia": {
      "type": "string",
      "enum": [
        "IA_Fiscal",
        "IA_PriceBrain",
        "IA_Churn",
        "IA_KYC",
        "IA_Governanca",
        "IA_Logistica",
        "IA_Producao",
        "IA_Chatbot",
        "IA_SEO",
        "IA_Recomendacao",
        "IA_LeadScoring",
        "IA_MonitoramentoAPI",
        "Outro"
      ],
      "description": "Tipo de IA executada"
    },
    "contexto_execucao": {
      "type": "string",
      "enum": [
        "Cadastro",
        "Financeiro",
        "Logística",
        "Comercial",
        "Estoque",
        "Produção",
        "Fiscal",
        "RH",
        "Sistema"
      ],
      "description": "Contexto da execução"
    },
    "entidade_relacionada": {
      "type": "string",
      "description": "Nome da entidade relacionada (ex: Cliente, Produto, Pedido)"
    },
    "entidade_id": {
      "type": "string",
      "description": "ID do registro relacionado"
    },
    "acao_sugerida": {
      "type": "string",
      "description": "Ação ou sugestão da IA"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "Aceito",
        "Rejeitado",
        "Automático",
        "Parcial",
        "Pendente"
      ],
      "default": "Pendente",
      "description": "Resultado da execução"
    },
    "confianca_ia": {
      "type": "number",
      "default": 0,
      "description": "Nível de confiança da IA (0-100)"
    },
    "dados_entrada": {
      "type": "object",
      "description": "Dados de entrada fornecidos à IA"
    },
    "dados_saida": {
      "type": "object",
      "description": "Dados de saída gerados pela IA"
    },
    "tempo_execucao_ms": {
      "type": "number",
      "description": "Tempo de execução em milissegundos"
    },
    "usuario_responsavel": {
      "type": "string",
      "description": "Usuário que disparou ou aprovou"
    },
    "usuario_id": {
      "type": "string"
    },
    "data_execucao": {
      "type": "string",
      "format": "date-time"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "tipo_ia",
    "contexto_execucao",
    "acao_sugerida"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}