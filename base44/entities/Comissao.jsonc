{
  "name": "Comissao",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que paga a comissão"
    },
    "vendedor": {
      "type": "string"
    },
    "vendedor_id": {
      "type": "string"
    },
    "pedido_id": {
      "type": "string"
    },
    "numero_pedido": {
      "type": "string"
    },
    "cliente": {
      "type": "string"
    },
    "data_venda": {
      "type": "string",
      "format": "date"
    },
    "valor_venda": {
      "type": "number"
    },
    "percentual_comissao": {
      "type": "number",
      "description": "Percentual de comissão"
    },
    "valor_comissao": {
      "type": "number"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aprovada",
        "Paga",
        "Cancelada"
      ],
      "default": "Pendente"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "vendedor",
    "pedido_id",
    "valor_venda",
    "percentual_comissao",
    "valor_comissao"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}