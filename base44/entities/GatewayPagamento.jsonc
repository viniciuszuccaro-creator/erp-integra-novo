{
  "name": "GatewayPagamento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa propriet\u00e1ria da configura\u00e7\u00e3o"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo num\u00e9rico sequencial \u00fanico"
    },
    "nome": {
      "type": "string",
      "description": "Nome do Gateway (ex: Pagar.me Principal)"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "Pagar.me",
        "Stripe",
        "Asaas",
        "Juno",
        "PagSeguro",
        "Mercado Pago",
        "Adyen",
        "Cielo",
        "Rede",
        "Stone",
        "Outro"
      ],
      "description": "Provedor do gateway de pagamento"
    },
    "tipos_pagamento_suportados": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PIX",
          "Boleto",
          "Cart\u00e3o Cr\u00e9dito",
          "Cart\u00e3o D\u00e9bito",
          "Transfer\u00eancia",
          "Link de Pagamento"
        ]
      },
      "description": "Tipos de pagamento que este gateway suporta"
    },
    "chave_api_publica": {
      "type": "string",
      "description": "Chave API p\u00fablica do gateway"
    },
    "chave_api_secreta": {
      "type": "string",
      "description": "Chave API secreta (criptografada no backend)"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL de webhook para receber notifica\u00e7\u00f5es"
    },
    "webhook_secret": {
      "type": "string",
      "description": "Secret para validar webhooks"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produ\u00e7\u00e3o",
        "Homologa\u00e7\u00e3o",
        "Teste"
      ],
      "default": "Teste",
      "description": "Ambiente de opera\u00e7\u00e3o"
    },
    "configuracoes_extras": {
      "type": "object",
      "additionalProperties": true,
      "description": "Configura\u00e7\u00f5es espec\u00edficas do gateway (JSON flex\u00edvel)"
    },
    "taxas_gateway": {
      "type": "object",
      "properties": {
        "taxa_boleto_fixa": {
          "type": "number",
          "default": 0
        },
        "taxa_pix_percentual": {
          "type": "number",
          "default": 0
        },
        "taxa_cartao_debito_percentual": {
          "type": "number",
          "default": 0
        },
        "taxa_cartao_credito_percentual": {
          "type": "number",
          "default": 0
        },
        "taxa_link_pagamento_percentual": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Taxas cobradas pelo gateway"
    },
    "limites_transacao": {
      "type": "object",
      "properties": {
        "valor_minimo": {
          "type": "number",
          "default": 0
        },
        "valor_maximo": {
          "type": "number",
          "default": 0
        },
        "limite_diario": {
          "type": "number",
          "default": 0
        },
        "limite_mensal": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Limites de transa\u00e7\u00e3o do gateway"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o gateway est\u00e1 ativo para uso"
    },
    "prioridade": {
      "type": "number",
      "default": 1,
      "description": "Prioridade de uso (maior = mais priorit\u00e1rio)"
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima sincroniza\u00e7\u00e3o de status com o gateway"
    },
    "estatisticas": {
      "type": "object",
      "properties": {
        "total_transacoes": {
          "type": "number",
          "default": 0
        },
        "total_valor_processado": {
          "type": "number",
          "default": 0
        },
        "taxa_sucesso": {
          "type": "number",
          "default": 0
        },
        "tempo_medio_resposta_ms": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Estat\u00edsticas de uso do gateway"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "provedor",
    "empresa_id",
    "ambiente"
  ]
}