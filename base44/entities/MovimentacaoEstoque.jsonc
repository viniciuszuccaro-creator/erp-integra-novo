{
  "name": "MovimentacaoEstoque",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa onde ocorreu a movimentação"
    },
    "origem_movimento": {
      "type": "string",
      "enum": [
        "compra",
        "producao",
        "pedido",
        "transferencia",
        "ajuste",
        "inventario",
        "nfe",
        "devolucao"
      ],
      "description": "Origem da movimentação"
    },
    "origem_documento_id": {
      "type": "string",
      "description": "ID do documento origem (pedido, OP, NF, etc)"
    },
    "tipo_movimento": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "transferencia",
        "reserva",
        "liberacao_reserva",
        "ajuste"
      ],
      "description": "Tipo de movimentação"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "produto_descricao": {
      "type": "string",
      "description": "Descrição do produto"
    },
    "codigo_produto": {
      "type": "string",
      "description": "Código do produto"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade movimentada"
    },
    "unidade_medida": {
      "type": "string",
      "description": "Unidade de medida"
    },
    "estoque_anterior": {
      "type": "number",
      "description": "Saldo antes da movimentação"
    },
    "estoque_atual": {
      "type": "number",
      "description": "Saldo após a movimentação"
    },
    "reservado_anterior": {
      "type": "number",
      "default": 0,
      "description": "Reservado antes da movimentação"
    },
    "reservado_atual": {
      "type": "number",
      "default": 0,
      "description": "Reservado após a movimentação"
    },
    "disponivel_anterior": {
      "type": "number",
      "default": 0,
      "description": "Disponível antes da movimentação"
    },
    "disponivel_atual": {
      "type": "number",
      "default": 0,
      "description": "Disponível após a movimentação"
    },
    "data_movimentacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da movimentação"
    },
    "documento": {
      "type": "string",
      "description": "Número do documento (NF, OP, etc)"
    },
    "motivo": {
      "type": "string",
      "description": "Motivo da movimentação"
    },
    "lote": {
      "type": "string",
      "description": "Número do lote (se controla lote)"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "description": "Data de validade do lote"
    },
    "localizacao_origem": {
      "type": "string",
      "description": "Localização de origem (almoxarifado, corredor, prateleira)"
    },
    "localizacao_destino": {
      "type": "string",
      "description": "Localização de destino"
    },
    "empresa_origem_id": {
      "type": "string",
      "description": "Empresa origem (em transferências)"
    },
    "empresa_destino_id": {
      "type": "string",
      "description": "Empresa destino (em transferências)"
    },
    "transferencia_id": {
      "type": "string",
      "description": "ID da transferência entre filiais"
    },
    "centro_custo_id": {
      "type": "string",
      "description": "Centro de custo vinculado"
    },
    "centro_custo_nome": {
      "type": "string"
    },
    "responsavel": {
      "type": "string",
      "description": "Usuário responsável"
    },
    "responsavel_id": {
      "type": "string"
    },
    "valor_unitario": {
      "type": "number",
      "description": "Valor unitário do produto"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total da movimentação"
    },
    "custo_medio": {
      "type": "number",
      "description": "Custo médio após a movimentação"
    },
    "status_integracao": {
      "type": "string",
      "enum": [
        "pendente",
        "sincronizado",
        "erro"
      ],
      "default": "sincronizado",
      "description": "Status de sincronização entre grupo e empresa"
    },
    "observacoes": {
      "type": "string"
    },
    "aprovado": {
      "type": "boolean",
      "default": true,
      "description": "Se a movimentação foi aprovada"
    },
    "aprovador": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "produto_descricao",
    "tipo_movimento",
    "quantidade",
    "data_movimentacao",
    "empresa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}