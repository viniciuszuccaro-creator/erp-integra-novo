{
  "name": "ArquivoRemessaRetorno",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico do arquivo"
    },
    "banco_id": {
      "type": "string",
      "description": "ID do banco vinculado"
    },
    "banco_codigo": {
      "type": "string",
      "description": "C\u00f3digo do banco (341, 001, 237, etc)"
    },
    "banco_nome": {
      "type": "string",
      "description": "Nome do banco"
    },
    "conta_bancaria_id": {
      "type": "string",
      "description": "ID da conta banc\u00e1ria vinculada"
    },
    "tipo_arquivo": {
      "type": "string",
      "enum": [
        "Remessa",
        "Retorno"
      ],
      "description": "Tipo do arquivo CNAB"
    },
    "numero_arquivo": {
      "type": "number",
      "description": "N\u00famero sequencial do arquivo"
    },
    "data_geracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de gera\u00e7\u00e3o do arquivo"
    },
    "data_processamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de processamento (retorno)"
    },
    "layout_cnab": {
      "type": "string",
      "enum": [
        "CNAB240",
        "CNAB400"
      ],
      "default": "CNAB400",
      "description": "Layout do arquivo CNAB"
    },
    "quantidade_titulos": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de t\u00edtulos no arquivo"
    },
    "valor_total": {
      "type": "number",
      "default": 0,
      "description": "Valor total dos t\u00edtulos"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo gerado/importado"
    },
    "arquivo_nome": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "conteudo_arquivo": {
      "type": "string",
      "description": "Conte\u00fado textual do arquivo CNAB"
    },
    "status": {
      "type": "string",
      "enum": [
        "Gerado",
        "Enviado ao Banco",
        "Processado",
        "Erro",
        "Cancelado"
      ],
      "default": "Gerado",
      "description": "Status do arquivo"
    },
    "titulos_incluidos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo_id": {
            "type": "string"
          },
          "nosso_numero": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "vencimento": {
            "type": "string"
          },
          "cliente_nome": {
            "type": "string"
          },
          "cliente_documento": {
            "type": "string"
          }
        }
      },
      "description": "Lista de t\u00edtulos inclu\u00eddos no arquivo"
    },
    "ocorrencias_retorno": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo_id": {
            "type": "string"
          },
          "nosso_numero": {
            "type": "string"
          },
          "codigo_ocorrencia": {
            "type": "string"
          },
          "descricao_ocorrencia": {
            "type": "string"
          },
          "valor_pago": {
            "type": "number"
          },
          "data_pagamento": {
            "type": "string"
          },
          "valor_tarifa": {
            "type": "number"
          },
          "processado": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Ocorr\u00eancias processadas do arquivo de retorno"
    },
    "usuario_geracao": {
      "type": "string",
      "description": "Usu\u00e1rio que gerou o arquivo"
    },
    "usuario_geracao_id": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "erros_processamento": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "linha": {
            "type": "number"
          },
          "erro": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          }
        }
      },
      "description": "Erros encontrados durante processamento"
    }
  },
  "required": [
    "tipo_arquivo",
    "banco_codigo",
    "empresa_id"
  ]
}