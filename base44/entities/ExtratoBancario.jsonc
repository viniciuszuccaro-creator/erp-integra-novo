{
  "name": "ExtratoBancario",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "banco_id": {
      "type": "string",
      "description": "ID do banco"
    },
    "conta_bancaria_id": {
      "type": "string",
      "description": "ID da conta bancária"
    },
    "data_movimento": {
      "type": "string",
      "format": "date",
      "description": "Data do movimento bancário"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição do lançamento"
    },
    "documento": {
      "type": "string",
      "description": "Número do documento"
    },
    "valor": {
      "type": "number",
      "description": "Valor do movimento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Tipo de movimento"
    },
    "saldo_anterior": {
      "type": "number",
      "description": "Saldo antes do movimento"
    },
    "saldo_posterior": {
      "type": "number",
      "description": "Saldo após o movimento"
    },
    "conciliado": {
      "type": "boolean",
      "default": false,
      "description": "Se já foi conciliado"
    },
    "movimento_vinculado_id": {
      "type": "string",
      "description": "ID do movimento de caixa vinculado"
    },
    "data_conciliacao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi conciliado"
    },
    "conciliacao_id": {
      "type": "string",
      "description": "ID do registro de conciliação"
    },
    "sugestao_ia_id": {
      "type": "string",
      "description": "ID do movimento sugerido pela IA"
    },
    "score_match_ia": {
      "type": "number",
      "default": 0,
      "description": "Score de confiança do match sugerido (0-100)"
    },
    "origem_importacao": {
      "type": "string",
      "enum": [
        "OFX",
        "CNAB",
        "CSV",
        "API",
        "Open Finance",
        "Manual"
      ],
      "description": "Vol 10.4: Como foi importado (inclui Open Finance)"
    },
    "hash_idempotencia": {
      "type": "string",
      "description": "Vol 18.1: Hash para garantir idempotência em importações automatizadas"
    },
    "arquivo_origem": {
      "type": "string",
      "description": "Nome do arquivo de importação"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "data_movimento",
    "valor",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}