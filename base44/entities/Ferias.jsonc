{
  "name": "Ferias",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa do colaborador"
    },
    "colaborador_id": {
      "type": "string"
    },
    "colaborador_nome": {
      "type": "string"
    },
    "periodo_aquisitivo_inicio": {
      "type": "string",
      "format": "date",
      "description": "Início do período aquisitivo"
    },
    "periodo_aquisitivo_fim": {
      "type": "string",
      "format": "date",
      "description": "Fim do período aquisitivo"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de início das férias"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data de fim das férias"
    },
    "data_retorno": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de retorno"
    },
    "dias_solicitados": {
      "type": "number",
      "description": "Quantidade de dias"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Integral",
        "Fracionada 1ª Parcela",
        "Fracionada 2ª Parcela",
        "Fracionada 3ª Parcela"
      ],
      "default": "Integral"
    },
    "venda_ferias": {
      "type": "number",
      "description": "Quantidade de dias vendidos (máx 10)",
      "minimum": 0,
      "maximum": 10
    },
    "abono_pecuniario": {
      "type": "boolean",
      "description": "Venda de 1/3 das férias"
    },
    "adiantamento_13": {
      "type": "boolean",
      "description": "Solicitar adiantamento 13º salário"
    },
    "solicitante": {
      "type": "string"
    },
    "data_solicitacao": {
      "type": "string",
      "format": "date"
    },
    "aprovador": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date"
    },
    "motivo_recusa": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Solicitado",
        "Aprovado",
        "Recusado",
        "Em Gozo",
        "Concluído",
        "Cancelado"
      ],
      "default": "Solicitado"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "colaborador_nome",
    "data_inicio",
    "data_fim",
    "dias_solicitados"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}