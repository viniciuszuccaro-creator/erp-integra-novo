{
  "name": "MovimentacaoEstoque",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa onde ocorreu a movimenta\u00e7\u00e3o"
    },
    "origem_movimento": {
      "type": "string",
      "enum": [
        "compra",
        "producao",
        "pedido",
        "transferencia",
        "ajuste",
        "inventario",
        "nfe",
        "devolucao"
      ],
      "description": "Origem da movimenta\u00e7\u00e3o"
    },
    "origem_documento_id": {
      "type": "string",
      "description": "ID do documento origem (pedido, OP, NF, etc)"
    },
    "tipo_movimento": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "transferencia",
        "reserva",
        "liberacao_reserva",
        "ajuste"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "produto_descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "codigo_produto": {
      "type": "string",
      "description": "C\u00f3digo do produto"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade movimentada"
    },
    "unidade_medida": {
      "type": "string",
      "description": "Unidade de medida"
    },
    "estoque_anterior": {
      "type": "number",
      "description": "Saldo antes da movimenta\u00e7\u00e3o"
    },
    "estoque_atual": {
      "type": "number",
      "description": "Saldo ap\u00f3s a movimenta\u00e7\u00e3o"
    },
    "reservado_anterior": {
      "type": "number",
      "default": 0,
      "description": "Reservado antes da movimenta\u00e7\u00e3o"
    },
    "reservado_atual": {
      "type": "number",
      "default": 0,
      "description": "Reservado ap\u00f3s a movimenta\u00e7\u00e3o"
    },
    "disponivel_anterior": {
      "type": "number",
      "default": 0,
      "description": "Dispon\u00edvel antes da movimenta\u00e7\u00e3o"
    },
    "disponivel_atual": {
      "type": "number",
      "default": 0,
      "description": "Dispon\u00edvel ap\u00f3s a movimenta\u00e7\u00e3o"
    },
    "data_movimentacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da movimenta\u00e7\u00e3o"
    },
    "documento": {
      "type": "string",
      "description": "N\u00famero do documento (NF, OP, etc)"
    },
    "motivo": {
      "type": "string",
      "description": "Motivo da movimenta\u00e7\u00e3o"
    },
    "lote": {
      "type": "string",
      "description": "N\u00famero do lote (se controla lote)"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "description": "Data de validade do lote"
    },
    "localizacao_origem": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o de origem (almoxarifado, corredor, prateleira)"
    },
    "localizacao_destino": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o de destino"
    },
    "empresa_origem_id": {
      "type": "string",
      "description": "Empresa origem (em transfer\u00eancias)"
    },
    "empresa_destino_id": {
      "type": "string",
      "description": "Empresa destino (em transfer\u00eancias)"
    },
    "transferencia_id": {
      "type": "string",
      "description": "ID da transfer\u00eancia entre filiais"
    },
    "centro_custo_id": {
      "type": "string",
      "description": "Centro de custo vinculado"
    },
    "centro_custo_nome": {
      "type": "string"
    },
    "responsavel": {
      "type": "string",
      "description": "Usu\u00e1rio respons\u00e1vel"
    },
    "responsavel_id": {
      "type": "string"
    },
    "valor_unitario": {
      "type": "number",
      "description": "Valor unit\u00e1rio do produto"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total da movimenta\u00e7\u00e3o"
    },
    "custo_medio": {
      "type": "number",
      "description": "Custo m\u00e9dio ap\u00f3s a movimenta\u00e7\u00e3o"
    },
    "status_integracao": {
      "type": "string",
      "enum": [
        "pendente",
        "sincronizado",
        "erro"
      ],
      "default": "sincronizado",
      "description": "Status de sincroniza\u00e7\u00e3o entre grupo e empresa"
    },
    "observacoes": {
      "type": "string"
    },
    "aprovado": {
      "type": "boolean",
      "default": true,
      "description": "Se a movimenta\u00e7\u00e3o foi aprovada"
    },
    "aprovador": {
      "type": "string"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "produto_descricao",
    "tipo_movimento",
    "quantidade",
    "data_movimentacao",
    "empresa_id"
  ]
}