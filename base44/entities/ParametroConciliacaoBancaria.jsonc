{
  "name": "ParametroConciliacaoBancaria",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único"
    },
    "banco_id": {
      "type": "string",
      "description": "ID do banco"
    },
    "conta_bancaria_id": {
      "type": "string",
      "description": "ID da conta bancária"
    },
    "tipo_lancamento": {
      "type": "string",
      "enum": [
        "Crédito",
        "Débito",
        "Ambos"
      ],
      "default": "Ambos"
    },
    "identificadores_matching": {
      "type": "object",
      "properties": {
        "usar_nsu": {
          "type": "boolean",
          "default": true
        },
        "usar_historico": {
          "type": "boolean",
          "default": true
        },
        "usar_convenio": {
          "type": "boolean",
          "default": true
        },
        "usar_nosso_numero": {
          "type": "boolean",
          "default": true
        },
        "usar_codigo_barras": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "prioridade_matching": {
      "type": "string",
      "enum": [
        "Por Valor",
        "Por Data",
        "Por Documento",
        "Combinação Inteligente"
      ],
      "default": "Combinação Inteligente"
    },
    "tolerancia_diferenca_valor": {
      "type": "number",
      "default": 0.01,
      "description": "Tolerância de diferença em valor (R$)"
    },
    "tolerancia_diferenca_dias": {
      "type": "number",
      "default": 2,
      "description": "Tolerância de diferença em dias"
    },
    "conta_contabil_nao_identificado": {
      "type": "string",
      "description": "Conta contábil para lançamentos não identificados"
    },
    "usar_ia_aprendizado": {
      "type": "boolean",
      "default": true,
      "description": "Se usa IA para aprender com conciliações anteriores"
    },
    "conciliacao_automatica_ativa": {
      "type": "boolean",
      "default": false,
      "description": "Se faz conciliação automática"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "banco_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}