{
  "name": "ExtratoBancario",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "banco_id": {
      "type": "string",
      "description": "ID do banco"
    },
    "conta_bancaria_id": {
      "type": "string",
      "description": "ID da conta banc\u00e1ria"
    },
    "data_movimento": {
      "type": "string",
      "format": "date",
      "description": "Data do movimento banc\u00e1rio"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do lan\u00e7amento"
    },
    "documento": {
      "type": "string",
      "description": "N\u00famero do documento"
    },
    "valor": {
      "type": "number",
      "description": "Valor do movimento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Tipo de movimento"
    },
    "saldo_anterior": {
      "type": "number",
      "description": "Saldo antes do movimento"
    },
    "saldo_posterior": {
      "type": "number",
      "description": "Saldo ap\u00f3s o movimento"
    },
    "conciliado": {
      "type": "boolean",
      "default": false,
      "description": "Se j\u00e1 foi conciliado"
    },
    "movimento_vinculado_id": {
      "type": "string",
      "description": "ID do movimento de caixa vinculado"
    },
    "data_conciliacao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi conciliado"
    },
    "conciliacao_id": {
      "type": "string",
      "description": "ID do registro de concilia\u00e7\u00e3o"
    },
    "sugestao_ia_id": {
      "type": "string",
      "description": "ID do movimento sugerido pela IA"
    },
    "score_match_ia": {
      "type": "number",
      "default": 0,
      "description": "Score de confian\u00e7a do match sugerido (0-100)"
    },
    "origem_importacao": {
      "type": "string",
      "enum": [
        "OFX",
        "CNAB",
        "CSV",
        "API",
        "Open Finance",
        "Manual"
      ],
      "description": "Vol 10.4: Como foi importado (inclui Open Finance)"
    },
    "hash_idempotencia": {
      "type": "string",
      "description": "Vol 18.1: Hash para garantir idempot\u00eancia em importa\u00e7\u00f5es automatizadas"
    },
    "arquivo_origem": {
      "type": "string",
      "description": "Nome do arquivo de importa\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "data_movimento",
    "valor",
    "tipo"
  ]
}