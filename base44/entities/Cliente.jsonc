{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa propriet\u00e1ria"
    },
    "empresa_dona_id": {
      "type": "string",
      "description": "Empresa que cadastrou/\u00e9 dona do cliente"
    },
    "empresas_compartilhadas_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das empresas que podem atender este cliente"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do cliente"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Pessoa F\u00edsica",
        "Pessoa Jur\u00eddica"
      ],
      "description": "Tipo de cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo",
        "Prospect",
        "Bloqueado"
      ],
      "default": "Prospect"
    },
    "status_fiscal_receita": {
      "type": "string",
      "enum": [
        "Ativa",
        "Inapta",
        "Suspensa",
        "Baixada",
        "N\u00e3o Verificado"
      ],
      "default": "N\u00e3o Verificado",
      "description": "Status na Receita Federal consultado por IA"
    },
    "motivo_inatividade": {
      "type": "string",
      "description": "Motivo de inativa\u00e7\u00e3o/bloqueio"
    },
    "nome": {
      "type": "string",
      "description": "Nome do cliente ou Raz\u00e3o Social"
    },
    "razao_social": {
      "type": "string"
    },
    "nome_fantasia": {
      "type": "string"
    },
    "cpf": {
      "type": "string",
      "description": "CPF (apenas PF)"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ \u00fanico do cliente"
    },
    "rg": {
      "type": "string",
      "description": "RG (apenas PF)"
    },
    "inscricao_estadual": {
      "type": "string",
      "description": "IE (apenas PJ)"
    },
    "inscricao_municipal": {
      "type": "string"
    },
    "cnae_principal": {
      "type": "string",
      "description": "CNAE principal (consultado via IA)"
    },
    "ramo_atividade": {
      "type": "string",
      "description": "Ramo de atividade (sugerido por IA)"
    },
    "porte_empresa": {
      "type": "string",
      "enum": [
        "MEI",
        "Micro",
        "Pequena",
        "M\u00e9dia",
        "Grande"
      ],
      "description": "Porte da empresa (sugerido por IA)"
    },
    "segmento_cliente_id": {
      "type": "string",
      "description": "ID do segmento do cliente"
    },
    "regiao_atendimento_id": {
      "type": "string",
      "description": "ID da regi\u00e3o de atendimento do cliente"
    },
    "regiao_atendimento_nome": {
      "type": "string",
      "description": "Nome da regi\u00e3o (snapshot)"
    },
    "origem_cadastro": {
      "type": "string",
      "enum": [
        "ERP",
        "Portal",
        "Site",
        "Marketplace",
        "Chatbot",
        "WhatsApp",
        "API",
        "E-commerce"
      ],
      "default": "ERP",
      "description": "Origem do cadastro"
    },
    "status_validacao_kyc": {
      "type": "string",
      "enum": [
        "Pendente",
        "Em An\u00e1lise",
        "Aprovado",
        "Reprovado"
      ],
      "default": "Pendente",
      "description": "Status de valida\u00e7\u00e3o KYC/KYB"
    },
    "risco_cadastro_ia": {
      "type": "string",
      "enum": [
        "Baixo",
        "M\u00e9dio",
        "Alto"
      ],
      "default": "Baixo",
      "description": "Risco de cadastro calculado por IA"
    },
    "data_validacao_kyc": {
      "type": "string",
      "format": "date-time",
      "description": "Data da valida\u00e7\u00e3o KYC"
    },
    "endereco_principal": {
      "type": "object",
      "properties": {
        "cep": {
          "type": "string"
        },
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "pais": {
          "type": "string",
          "default": "Brasil"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "mapa_url": {
          "type": "string"
        }
      }
    },
    "contatos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "cargo": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Telefone",
              "WhatsApp",
              "E-mail",
              "Celular"
            ]
          },
          "valor": {
            "type": "string"
          },
          "principal": {
            "type": "boolean",
            "default": false
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "M\u00faltiplos contatos do cliente"
    },
    "contatos_b2b_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos contatos B2B vinculados"
    },
    "historico_comunicacao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "WhatsApp",
              "E-mail",
              "Telefone",
              "Reuni\u00e3o",
              "Visita"
            ]
          },
          "assunto": {
            "type": "string"
          },
          "resumo": {
            "type": "string"
          },
          "responsavel": {
            "type": "string"
          },
          "anexo_url": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de comunica\u00e7\u00f5es"
    },
    "condicao_comercial": {
      "type": "object",
      "properties": {
        "tabela_preco_id": {
          "type": "string"
        },
        "tabela_preco_nome": {
          "type": "string"
        },
        "forma_pagamento_padrao_id": {
          "type": "string"
        },
        "forma_pagamento_padrao_nome": {
          "type": "string"
        },
        "percentual_desconto": {
          "type": "number"
        },
        "condicao_pagamento": {
          "type": "string",
          "enum": [
            "\u00c0 Vista",
            "7 dias",
            "15 dias",
            "30 dias",
            "45 dias",
            "60 dias",
            "Parcelado"
          ],
          "default": "\u00c0 Vista"
        },
        "prazo_pagamento_dias": {
          "type": "number"
        },
        "limite_credito": {
          "type": "number",
          "default": 0
        },
        "limite_credito_grupo": {
          "type": "number",
          "default": 0
        },
        "limite_credito_utilizado": {
          "type": "number",
          "default": 0
        },
        "limite_aprovado_por": {
          "type": "string"
        },
        "limite_aprovado_em": {
          "type": "string",
          "format": "date"
        },
        "vigencia_desconto_ate": {
          "type": "string",
          "format": "date"
        },
        "dia_vencimento_preferencial": {
          "type": "number"
        },
        "situacao_credito": {
          "type": "string",
          "enum": [
            "OK",
            "Alerta",
            "Bloqueado"
          ],
          "default": "OK"
        }
      }
    },
    "locais_entrega": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "apelido": {
            "type": "string"
          },
          "tipo_endereco": {
            "type": "string",
            "enum": [
              "Entrega",
              "Cobran\u00e7a",
              "Matriz",
              "Obra",
              "Outro"
            ],
            "default": "Entrega"
          },
          "cep": {
            "type": "string"
          },
          "logradouro": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "complemento": {
            "type": "string"
          },
          "bairro": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "mapa_url": {
            "type": "string"
          },
          "horario_inicio": {
            "type": "string"
          },
          "horario_fim": {
            "type": "string"
          },
          "janela_entrega_preferencial": {
            "type": "string",
            "enum": [
              "Manh\u00e3",
              "Tarde",
              "Noite",
              "Indiferente"
            ],
            "default": "Indiferente"
          },
          "tipo_descarga": {
            "type": "string",
            "enum": [
              "Manual",
              "Empilhadeira",
              "Munck",
              "Outro"
            ],
            "default": "Manual"
          },
          "contato_nome": {
            "type": "string"
          },
          "contato_telefone": {
            "type": "string"
          },
          "observacoes": {
            "type": "string"
          },
          "principal": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "M\u00faltiplos endere\u00e7os de entrega"
    },
    "configuracao_fiscal": {
      "type": "object",
      "properties": {
        "regime_tributario": {
          "type": "string",
          "enum": [
            "Simples Nacional",
            "Lucro Presumido",
            "Lucro Real",
            "MEI"
          ],
          "default": "Simples Nacional"
        },
        "cfop_padrao_venda": {
          "type": "string",
          "default": "5102"
        },
        "isento_ipi": {
          "type": "boolean",
          "default": false
        },
        "isento_icms": {
          "type": "boolean",
          "default": false
        },
        "contribuinte_icms": {
          "type": "boolean",
          "default": true
        },
        "tipo_contribuinte": {
          "type": "string",
          "enum": [
            "1 - Contribuinte",
            "2 - Isento",
            "9 - N\u00e3o Contribuinte"
          ],
          "default": "1 - Contribuinte"
        },
        "substituicao_tributaria_especial": {
          "type": "boolean",
          "default": false
        },
        "utilizar_nfe_interna": {
          "type": "boolean",
          "default": false
        },
        "nfe_interna_aprovado_por": {
          "type": "string"
        },
        "nfe_interna_aprovado_em": {
          "type": "string",
          "format": "date-time"
        },
        "observacoes_fiscais": {
          "type": "string"
        }
      }
    },
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Contrato Social",
              "Certid\u00e3o Negativa",
              "Inscri\u00e7\u00e3o Estadual",
              "Comprovante Endere\u00e7o",
              "Refer\u00eancia Comercial",
              "Proposta Comercial",
              "RG",
              "CPF",
              "Outros"
            ]
          },
          "nome_arquivo": {
            "type": "string"
          },
          "url_arquivo": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date"
          },
          "data_validade": {
            "type": "string",
            "format": "date"
          },
          "observacao": {
            "type": "string"
          },
          "upload_por": {
            "type": "string"
          }
        }
      },
      "description": "Documentos anexados"
    },
    "vendedor_responsavel": {
      "type": "string",
      "description": "V21.5: Nome do vendedor (preenchido autom\u00e1tico)"
    },
    "vendedor_responsavel_id": {
      "type": "string",
      "description": "V21.5: ID do vendedor (preenchido autom\u00e1tico com usu\u00e1rio logado)"
    },
    "indicador_nome": {
      "type": "string",
      "description": "V21.5: Nome de quem indicou (Representante/Construtor/Arquiteto/Engenheiro)"
    },
    "indicador_id": {
      "type": "string",
      "description": "V21.5: ID do indicador no cadastro de Representantes"
    },
    "tipo_indicador": {
      "type": "string",
      "enum": [
        "Representante Comercial",
        "Construtor",
        "Arquiteto",
        "Engenheiro",
        "Influenciador",
        "Parceiro",
        "Outro"
      ],
      "description": "V21.5: Tipo do indicador (snapshot do Representante)"
    },
    "percentual_comissao_indicador": {
      "type": "number",
      "default": 0,
      "description": "V21.5: % de comiss\u00e3o do indicador (snapshot)"
    },
    "representante_id": {
      "type": "string",
      "description": "ID do representante vinculado"
    },
    "classificacao_abc": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "Novo"
      ],
      "default": "Novo",
      "description": "Classifica\u00e7\u00e3o autom\u00e1tica por volume de compras"
    },
    "valor_compras_12meses": {
      "type": "number",
      "default": 0
    },
    "data_primeira_compra": {
      "type": "string",
      "format": "date"
    },
    "data_ultima_compra": {
      "type": "string",
      "format": "date"
    },
    "quantidade_pedidos": {
      "type": "number",
      "default": 0
    },
    "ticket_medio": {
      "type": "number",
      "default": 0
    },
    "dias_sem_comprar": {
      "type": "number",
      "default": 0,
      "description": "Dias desde \u00faltima compra (calculado por IA)"
    },
    "risco_churn": {
      "type": "string",
      "enum": [
        "Baixo",
        "M\u00e9dio",
        "Alto",
        "Cr\u00edtico"
      ],
      "default": "Baixo",
      "description": "Risco de perda calculado por IA"
    },
    "produtos_mais_comprados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "quantidade_total": {
            "type": "number"
          },
          "ultima_compra": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "Top 10 produtos mais comprados"
    },
    "score_pagamento": {
      "type": "number",
      "default": 100,
      "description": "Score de 0-100 baseado em hist\u00f3rico de pagamento"
    },
    "score_confianca_ia": {
      "type": "number",
      "default": 50,
      "description": "Score de confian\u00e7a gerado pela IA (0-100)"
    },
    "score_saude_cliente": {
      "type": "number",
      "default": 100,
      "description": "Score de sa\u00fade do relacionamento (0-100)"
    },
    "dias_atraso_medio": {
      "type": "number",
      "default": 0
    },
    "pontos_fidelidade": {
      "type": "number",
      "default": 0
    },
    "cashback_disponivel": {
      "type": "number",
      "default": 0
    },
    "proxima_acao": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "format": "date"
        },
        "descricao": {
          "type": "string"
        },
        "responsavel": {
          "type": "string"
        }
      },
      "description": "Pr\u00f3xima a\u00e7\u00e3o do CRM"
    },
    "canal_preferencial": {
      "type": "string",
      "enum": [
        "Portal",
        "WhatsApp",
        "E-mail",
        "Telefone",
        "Presencial"
      ],
      "description": "Canal de comunica\u00e7\u00e3o preferencial calculado por IA"
    },
    "uso_portal": {
      "type": "object",
      "properties": {
        "total_acessos": {
          "type": "number",
          "default": 0
        },
        "ultimo_acesso": {
          "type": "string",
          "format": "date-time"
        },
        "tempo_medio_sessao_min": {
          "type": "number"
        },
        "abas_mais_usadas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dispositivo_preferencial": {
          "type": "string",
          "enum": [
            "Desktop",
            "Mobile",
            "Tablet"
          ]
        }
      },
      "description": "M\u00e9tricas de uso do portal"
    },
    "uso_canais": {
      "type": "object",
      "properties": {
        "total_whatsapp": {
          "type": "number",
          "default": 0
        },
        "total_email": {
          "type": "number",
          "default": 0
        },
        "total_telefone": {
          "type": "number",
          "default": 0
        },
        "total_portal": {
          "type": "number",
          "default": 0
        },
        "canal_mais_usado": {
          "type": "string"
        }
      },
      "description": "IA de Prefer\u00eancia de Canal"
    },
    "pode_ver_portal": {
      "type": "boolean",
      "default": false,
      "description": "Se tem acesso ao Portal do Cliente"
    },
    "pode_ver_financeiro_no_portal": {
      "type": "boolean",
      "default": true,
      "description": "Se pode ver boletos/contas no portal"
    },
    "pode_aprovar_orcamento_portal": {
      "type": "boolean",
      "default": false,
      "description": "Se pode aprovar or\u00e7amentos pelo portal"
    },
    "pode_atualizar_cadastro_portal": {
      "type": "boolean",
      "default": true,
      "description": "Se pode atualizar dados pelo portal"
    },
    "portal_usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio no portal (se cadastrado)"
    },
    "lgpd_autorizacoes": {
      "type": "object",
      "properties": {
        "autoriza_comunicacao_comercial": {
          "type": "boolean",
          "default": false
        },
        "autoriza_email_marketing": {
          "type": "boolean",
          "default": false
        },
        "autoriza_whatsapp_marketing": {
          "type": "boolean",
          "default": false
        },
        "autoriza_sms": {
          "type": "boolean",
          "default": false
        },
        "data_aceite_termos": {
          "type": "string",
          "format": "date-time"
        },
        "ip_aceite": {
          "type": "string"
        }
      },
      "description": "Autoriza\u00e7\u00f5es LGPD"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}