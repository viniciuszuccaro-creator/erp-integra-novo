{
  "name": "Cargo",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa"
    },
    "codigo": {
      "type": "string",
      "description": "Código único do cargo"
    },
    "nome_cargo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "nivel_hierarquico": {
      "type": "string",
      "enum": [
        "Estagiário",
        "Auxiliar",
        "Assistente",
        "Analista",
        "Coordenador",
        "Gerente",
        "Diretor",
        "CEO",
        "Operacional"
      ],
      "default": "Operacional"
    },
    "departamento_padrao_id": {
      "type": "string"
    },
    "salario_base_referencia": {
      "type": "number"
    },
    "cbo": {
      "type": "string"
    },
    "requisitos": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_cargo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}