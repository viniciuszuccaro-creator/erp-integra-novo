{
  "name": "ContaBancariaEmpresa",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa propriet\u00e1ria"
    },
    "banco_id": {
      "type": "string",
      "description": "ID do banco"
    },
    "agencia": {
      "type": "string",
      "description": "N\u00famero da ag\u00eancia"
    },
    "agencia_digito": {
      "type": "string",
      "description": "D\u00edgito verificador da ag\u00eancia"
    },
    "numero_conta": {
      "type": "string",
      "description": "N\u00famero da conta"
    },
    "conta_digito": {
      "type": "string",
      "description": "D\u00edgito verificador da conta"
    },
    "tipo_conta": {
      "type": "string",
      "enum": [
        "Corrente",
        "Poupan\u00e7a",
        "Aplica\u00e7\u00e3o",
        "Sal\u00e1rio"
      ],
      "default": "Corrente"
    },
    "moeda": {
      "type": "string",
      "default": "BRL",
      "description": "Moeda da conta"
    },
    "titular": {
      "type": "string",
      "description": "Nome do titular"
    },
    "cpf_cnpj_titular": {
      "type": "string",
      "description": "CPF/CNPJ do titular"
    },
    "finalidade": {
      "type": "string",
      "enum": [
        "Operacional",
        "Folha",
        "Tributos",
        "Investimento",
        "Cobran\u00e7a"
      ],
      "default": "Operacional",
      "description": "Finalidade da conta"
    },
    "permite_recebimento_boleto": {
      "type": "boolean",
      "default": false
    },
    "permite_recebimento_pix": {
      "type": "boolean",
      "default": false
    },
    "chave_pix": {
      "type": "string",
      "description": "Chave PIX da conta"
    },
    "tipo_chave_pix": {
      "type": "string",
      "enum": [
        "CPF",
        "CNPJ",
        "E-mail",
        "Telefone",
        "Aleat\u00f3ria"
      ],
      "description": "Tipo de chave PIX"
    },
    "convenio_cobranca": {
      "type": "string",
      "description": "N\u00famero do conv\u00eanio para cobran\u00e7a"
    },
    "carteira_cobranca": {
      "type": "string",
      "description": "Carteira para emiss\u00e3o de boletos"
    },
    "codigo_beneficiario": {
      "type": "string",
      "description": "C\u00f3digo do benefici\u00e1rio"
    },
    "integracao_conciliacao": {
      "type": "object",
      "properties": {
        "ativa": {
          "type": "boolean",
          "default": false
        },
        "tipo": {
          "type": "string",
          "enum": [
            "API",
            "OFX",
            "CNAB",
            "Open Banking"
          ]
        },
        "api_key": {
          "type": "string"
        },
        "ultima_sincronizacao": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "saldo_atual": {
      "type": "number",
      "default": 0,
      "description": "Saldo atual da conta"
    },
    "saldo_disponivel": {
      "type": "number",
      "default": 0,
      "description": "Saldo dispon\u00edvel"
    },
    "limite_cheque_especial": {
      "type": "number",
      "default": 0
    },
    "conta_padrao": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 a conta padr\u00e3o da empresa"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "banco_id",
    "agencia",
    "numero_conta"
  ]
}