{
  "name": "SessaoUsuario",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa da sess\u00e3o"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "grupo_id": {
      "type": "string",
      "description": "ID do grupo (se contexto grupo)"
    },
    "contexto": {
      "type": "string",
      "enum": [
        "empresa",
        "grupo"
      ],
      "default": "empresa",
      "description": "Contexto da sess\u00e3o"
    },
    "token_sessao": {
      "type": "string",
      "description": "Token \u00fanico da sess\u00e3o (JWT session ID)"
    },
    "refresh_token_id": {
      "type": "string",
      "description": "ID do refresh token vinculado"
    },
    "data_hora_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de in\u00edcio da sess\u00e3o"
    },
    "data_hora_ultimo_acesso": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo acesso"
    },
    "data_hora_expiracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de expira\u00e7\u00e3o"
    },
    "duracao_segundos": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o total da sess\u00e3o em segundos"
    },
    "tempo_inatividade_segundos": {
      "type": "number",
      "description": "Tempo desde \u00faltimo acesso em segundos"
    },
    "timeout_inatividade_minutos": {
      "type": "number",
      "default": 60,
      "description": "Timeout de inatividade configurado (minutos)"
    },
    "ip_address": {
      "type": "string",
      "description": "Endere\u00e7o IP"
    },
    "ip_localizacao": {
      "type": "string",
      "description": "Geolocaliza\u00e7\u00e3o do IP"
    },
    "user_agent": {
      "type": "string",
      "description": "Navegador e dispositivo"
    },
    "dispositivo_tipo": {
      "type": "string",
      "enum": [
        "Desktop",
        "Mobile",
        "Tablet",
        "API",
        "Desconhecido"
      ],
      "description": "Tipo de dispositivo"
    },
    "sistema_operacional": {
      "type": "string",
      "description": "Sistema operacional"
    },
    "navegador": {
      "type": "string",
      "description": "Navegador utilizado"
    },
    "dispositivo_id": {
      "type": "string",
      "description": "ID \u00fanico do dispositivo (fingerprint)"
    },
    "dispositivo_confiavel": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 dispositivo confi\u00e1vel (j\u00e1 usado antes)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativa",
        "Expirada",
        "Encerrada",
        "Bloqueada",
        "Revogada"
      ],
      "default": "Ativa",
      "description": "Status da sess\u00e3o"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se a sess\u00e3o est\u00e1 ativa"
    },
    "tipo_autenticacao": {
      "type": "string",
      "enum": [
        "Senha",
        "MFA Email",
        "MFA WhatsApp",
        "MFA SMS",
        "Biometria",
        "SSO"
      ],
      "description": "Tipo de autentica\u00e7\u00e3o usada"
    },
    "mfa_validado": {
      "type": "boolean",
      "default": false,
      "description": "Se passou por MFA"
    },
    "mfa_metodo": {
      "type": "string",
      "enum": [
        "Email",
        "WhatsApp",
        "SMS",
        "Authenticator"
      ],
      "description": "M\u00e9todo de MFA usado"
    },
    "tentativas_login": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de tentativas at\u00e9 conseguir logar"
    },
    "suspeita_fraude": {
      "type": "boolean",
      "default": false,
      "description": "Se h\u00e1 suspeita de fraude"
    },
    "motivos_suspeita": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Motivos de suspeita (IP novo, hor\u00e1rio incomum, etc.)"
    },
    "nivel_risco": {
      "type": "string",
      "enum": [
        "Baixo",
        "M\u00e9dio",
        "Alto",
        "Cr\u00edtico"
      ],
      "default": "Baixo",
      "description": "N\u00edvel de risco calculado pela IA"
    },
    "keep_alive": {
      "type": "boolean",
      "default": false,
      "description": "Se o usu\u00e1rio marcou 'Manter conectado'"
    },
    "sessoes_simultaneas_permitidas": {
      "type": "number",
      "default": 3,
      "description": "N\u00famero m\u00e1ximo de sess\u00f5es simult\u00e2neas"
    },
    "outras_sessoes_ativas": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de outras sess\u00f5es ativas do mesmo usu\u00e1rio"
    },
    "acoes_realizadas": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de a\u00e7\u00f5es realizadas na sess\u00e3o"
    },
    "paginas_visitadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de p\u00e1ginas visitadas"
    },
    "ultima_pagina": {
      "type": "string",
      "description": "\u00daltima p\u00e1gina acessada"
    },
    "tokens_refresh_usados": {
      "type": "number",
      "default": 0,
      "description": "Quantas vezes o refresh token foi usado"
    },
    "data_hora_encerramento": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de encerramento"
    },
    "motivo_encerramento": {
      "type": "string",
      "enum": [
        "Logout Normal",
        "Timeout Inatividade",
        "Logout Remoto",
        "Sess\u00e3o Revogada",
        "Erro",
        "Expira\u00e7\u00e3o Token",
        "Logout Todas Sess\u00f5es",
        "Admin For\u00e7ou"
      ],
      "description": "Motivo do encerramento"
    },
    "encerrado_por_admin": {
      "type": "boolean",
      "default": false,
      "description": "Se foi encerrada por um administrador"
    },
    "admin_id": {
      "type": "string",
      "description": "ID do admin que encerrou (se aplic\u00e1vel)"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude do login"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude do login"
    },
    "ip_diferente_ultima_sessao": {
      "type": "boolean",
      "default": false,
      "description": "Se o IP \u00e9 diferente da \u00faltima sess\u00e3o"
    },
    "horario_login_incomum": {
      "type": "boolean",
      "default": false,
      "description": "Se o hor\u00e1rio de login \u00e9 incomum para este usu\u00e1rio"
    },
    "primeiro_acesso_dispositivo": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 primeiro acesso neste dispositivo"
    },
    "metricas_uso": {
      "type": "object",
      "properties": {
        "modulos_acessados": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entidades_criadas": {
          "type": "number",
          "default": 0
        },
        "entidades_editadas": {
          "type": "number",
          "default": 0
        },
        "relatorios_gerados": {
          "type": "number"
        },
        "tempo_medio_pagina_segundos": {
          "type": "number"
        }
      },
      "description": "M\u00e9tricas de uso da sess\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a sess\u00e3o"
    }
  },
  "required": [
    "usuario_id",
    "token_sessao",
    "data_hora_inicio",
    "ip_address"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}