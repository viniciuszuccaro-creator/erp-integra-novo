{
  "name": "TipoFrete",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo do tipo de frete"
    },
    "nome": {
      "type": "string",
      "description": "Nome do tipo de frete"
    },
    "descricao": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "CIF",
        "FOB",
        "Retira",
        "Cortesia",
        "Outro"
      ],
      "default": "CIF",
      "description": "Tipo de frete"
    },
    "responsavel_pagamento": {
      "type": "string",
      "enum": [
        "Remetente",
        "Destinat\u00e1rio",
        "Terceiro"
      ],
      "default": "Remetente"
    },
    "calculo_frete": {
      "type": "string",
      "enum": [
        "Fixo",
        "Por Peso",
        "Por Volume",
        "Por Dist\u00e2ncia",
        "Tabela",
        "Negociado"
      ],
      "default": "Tabela"
    },
    "valor_fixo": {
      "type": "number",
      "default": 0,
      "description": "Valor fixo do frete (se aplic\u00e1vel)"
    },
    "valor_por_kg": {
      "type": "number",
      "default": 0
    },
    "valor_por_km": {
      "type": "number",
      "default": 0
    },
    "valor_minimo": {
      "type": "number",
      "default": 0,
      "description": "Valor m\u00ednimo de frete"
    },
    "icone": {
      "type": "string",
      "description": "\u00cdcone representativo"
    },
    "cor": {
      "type": "string",
      "description": "Cor de identifica\u00e7\u00e3o (hex)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo"
  ]
}