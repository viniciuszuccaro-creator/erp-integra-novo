{
  "name": "MoedaIndice",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único (BRL, USD, EUR, SELIC, IPCA, CDI)"
    },
    "nome": {
      "type": "string",
      "description": "Nome completo — único por grupo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Moeda",
        "Índice Econômico"
      ],
      "description": "Tipo"
    },
    "simbolo": {
      "type": "string",
      "description": "Símbolo (R$, $, €, %)"
    },
    "valor_atual": {
      "type": "number",
      "description": "Valor/cotação atual"
    },
    "data_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da última atualização"
    },
    "fonte_dados": {
      "type": "string",
      "description": "Fonte (BCB, IBGE, API Awesome)"
    },
    "atualiza_automaticamente": {
      "type": "boolean",
      "default": false,
      "description": "Se atualiza via IA/API automática"
    },
    "frequencia_atualizacao": {
      "type": "string",
      "enum": [
        "Tempo Real",
        "Diário",
        "Semanal",
        "Mensal"
      ],
      "description": "Frequência de atualização"
    },
    "historico_valores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date"
          },
          "valor": {
            "type": "number"
          }
        }
      },
      "description": "Histórico de cotações"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "codigo",
    "nome",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}