{
  "name": "SegmentoCliente",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro \u00fanico compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico do segmento"
    },
    "nome_segmento": {
      "type": "string",
      "description": "Nome do segmento \u2014 \u00fanico por grupo"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_segmento": {
      "type": "string",
      "enum": [
        "Industrial",
        "Comercial",
        "Constru\u00e7\u00e3o Civil",
        "Consumidor Final",
        "Governo",
        "Outro"
      ],
      "default": "Comercial"
    },
    "caracteristicas": {
      "type": "object",
      "properties": {
        "ticket_medio_esperado": {
          "type": "number"
        },
        "prazo_pagamento_comum": {
          "type": "number"
        },
        "frequencia_compra": {
          "type": "string",
          "enum": [
            "Alta",
            "M\u00e9dia",
            "Baixa"
          ]
        },
        "sazonalidade": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "politica_comercial_padrao": {
      "type": "object",
      "properties": {
        "tabela_preco_sugerida_id": {
          "type": "string"
        },
        "desconto_maximo_permitido": {
          "type": "number"
        },
        "prazo_pagamento_padrao": {
          "type": "string"
        }
      }
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_segmento"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}