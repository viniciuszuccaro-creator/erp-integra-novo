{
  "name": "Marca",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da marca"
    },
    "nome_marca": {
      "type": "string",
      "description": "Nome da marca — único por grupo"
    },
    "descricao": {
      "type": "string"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ único do fabricante"
    },
    "pais_origem": {
      "type": "string",
      "default": "Brasil"
    },
    "site": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Aço",
        "Ferramentas",
        "EPIs",
        "Elétricos",
        "Hidráulica",
        "Outro"
      ]
    },
    "fornecedor_id": {
      "type": "string"
    },
    "certificacoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome_marca"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}