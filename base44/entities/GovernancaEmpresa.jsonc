{
  "name": "GovernancaEmpresa",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico"
    },
    "nivel_conformidade": {
      "type": "string",
      "enum": [
        "B\u00e1sico",
        "ISO27001",
        "LGPD",
        "SOX",
        "Custom"
      ],
      "default": "B\u00e1sico",
      "description": "N\u00edvel de conformidade adotado"
    },
    "auditoria_automatica": {
      "type": "boolean",
      "default": true,
      "description": "Se audita automaticamente todas as a\u00e7\u00f5es"
    },
    "backup_automatico": {
      "type": "boolean",
      "default": true,
      "description": "Se realiza backup autom\u00e1tico"
    },
    "backup_periodo_dias": {
      "type": "number",
      "default": 1,
      "description": "Periodicidade do backup em dias"
    },
    "backup_horario": {
      "type": "string",
      "default": "02:00",
      "description": "Hor\u00e1rio do backup (HH:MM)"
    },
    "backup_retencao_dias": {
      "type": "number",
      "default": 30,
      "description": "Dias de reten\u00e7\u00e3o dos backups"
    },
    "ultimo_backup": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo backup"
    },
    "retencao_logs_dias": {
      "type": "number",
      "default": 365,
      "description": "Dias de reten\u00e7\u00e3o dos logs"
    },
    "retencao_documentos_anos": {
      "type": "number",
      "default": 5,
      "description": "Anos de reten\u00e7\u00e3o de documentos fiscais"
    },
    "exigir_mfa": {
      "type": "boolean",
      "default": false,
      "description": "Exigir autentica\u00e7\u00e3o de dois fatores"
    },
    "mfa_metodos_permitidos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Email",
          "WhatsApp",
          "SMS",
          "Authenticator"
        ]
      },
      "description": "M\u00e9todos de MFA permitidos"
    },
    "sessao_timeout_minutos": {
      "type": "number",
      "default": 60,
      "description": "Timeout de sess\u00e3o em minutos"
    },
    "tentativas_login_max": {
      "type": "number",
      "default": 5,
      "description": "Tentativas m\u00e1ximas de login antes de bloquear"
    },
    "bloquear_ips_suspeitos": {
      "type": "boolean",
      "default": true,
      "description": "Se bloqueia IPs com comportamento suspeito"
    },
    "ips_bloqueados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de IPs bloqueados"
    },
    "ia_seguranca_ativa": {
      "type": "boolean",
      "default": false,
      "description": "Se usa IA para detectar anomalias"
    },
    "ia_alerta_nivel": {
      "type": "string",
      "enum": [
        "Baixo",
        "M\u00e9dio",
        "Alto",
        "Cr\u00edtico"
      ],
      "default": "M\u00e9dio",
      "description": "N\u00edvel de sensibilidade dos alertas IA"
    },
    "politicas_senha": {
      "type": "object",
      "properties": {
        "tamanho_minimo": {
          "type": "number",
          "default": 8
        },
        "exigir_maiusculas": {
          "type": "boolean",
          "default": true
        },
        "exigir_numeros": {
          "type": "boolean",
          "default": true
        },
        "exigir_especiais": {
          "type": "boolean",
          "default": false
        },
        "trocar_senha_dias": {
          "type": "number",
          "default": 90
        },
        "historico_senhas": {
          "type": "number",
          "default": 3
        }
      }
    },
    "criptografia_dados_sensiveis": {
      "type": "boolean",
      "default": true,
      "description": "Se criptografa dados sens\u00edveis (CPF, CNPJ, sal\u00e1rios)"
    },
    "algoritmo_criptografia": {
      "type": "string",
      "default": "AES-256",
      "description": "Algoritmo de criptografia utilizado"
    },
    "certificacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "numero_certificado": {
            "type": "string"
          },
          "data_emissao": {
            "type": "string",
            "format": "date"
          },
          "data_validade": {
            "type": "string",
            "format": "date"
          },
          "arquivo_url": {
            "type": "string"
          }
        }
      },
      "description": "Certifica\u00e7\u00f5es de compliance"
    },
    "proxima_auditoria": {
      "type": "string",
      "format": "date",
      "description": "Data da pr\u00f3xima auditoria externa"
    },
    "responsavel_compliance": {
      "type": "string",
      "description": "Respons\u00e1vel pela conformidade"
    },
    "responsavel_compliance_id": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se ativo"
    }
  },
  "required": [
    "empresa_id",
    "nivel_conformidade"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}