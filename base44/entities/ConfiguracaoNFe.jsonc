{
  "name": "ConfiguracaoNFe",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo num\u00e9rico sequencial \u00fanico"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "eNotas",
        "NFe.io",
        "Focus NFe",
        "Outro"
      ],
      "default": "eNotas",
      "description": "Provedor de NF-e"
    },
    "api_url": {
      "type": "string",
      "description": "URL da API do provedor"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API"
    },
    "certificado_digital_url": {
      "type": "string",
      "description": "URL do certificado A1"
    },
    "senha_certificado": {
      "type": "string",
      "description": "Senha do certificado digital"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "Produ\u00e7\u00e3o",
        "Homologa\u00e7\u00e3o"
      ],
      "default": "Homologa\u00e7\u00e3o",
      "description": "Ambiente de emiss\u00e3o"
    },
    "serie_nfe": {
      "type": "string",
      "default": "1",
      "description": "S\u00e9rie da NF-e"
    },
    "proximo_numero": {
      "type": "number",
      "default": 1,
      "description": "Pr\u00f3ximo n\u00famero de NF-e"
    },
    "emitir_automatico": {
      "type": "boolean",
      "default": false,
      "description": "Se emite automaticamente ap\u00f3s faturamento"
    },
    "enviar_email_automatico": {
      "type": "boolean",
      "default": true,
      "description": "Se envia email com DANFE automaticamente"
    },
    "ultima_emissao": {
      "type": "string",
      "format": "date-time"
    },
    "total_emissoes": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "provedor"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}