{
  "name": "DocumentacaoTecnica",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou (cadastro único compartilhado no grupo)"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único do documento"
    },
    "titulo": {
      "type": "string",
      "description": "Título do documento — único por grupo"
    },
    "modulo": {
      "type": "string",
      "description": "Módulo do sistema relacionado"
    },
    "versao": {
      "type": "string",
      "description": "Versão do sistema (ex: V21.5)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Certificado",
        "README",
        "Checklist",
        "Manifesto",
        "Validação",
        "Status",
        "Guia"
      ],
      "default": "Certificado",
      "description": "Tipo do documento"
    },
    "conteudo_markdown": {
      "type": "string",
      "description": "Conteúdo completo do documento em markdown"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Arquivado",
        "Em Revisão"
      ],
      "default": "Ativo"
    },
    "data_certificacao": {
      "type": "string",
      "format": "date",
      "description": "Data da certificação/criação"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para filtro e busca"
    }
  },
  "required": [
    "titulo",
    "modulo",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}