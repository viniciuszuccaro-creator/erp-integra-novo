{
  "name": "Colaborador",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_alocada_id": {
      "type": "string",
      "description": "Empresa onde trabalha atualmente"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do colaborador"
    },
    "nome_completo": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "rg": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "email_corporativo": {
      "type": "string",
      "format": "email"
    },
    "telefone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date"
    },
    "data_admissao": {
      "type": "string",
      "format": "date"
    },
    "cargo": {
      "type": "string"
    },
    "cargo_id": {
      "type": "string"
    },
    "departamento": {
      "type": "string",
      "enum": [
        "Administrativo",
        "Comercial",
        "Financeiro",
        "RH",
        "Operacional",
        "TI",
        "Log\u00edstica",
        "Compras",
        "Produ\u00e7\u00e3o"
      ]
    },
    "departamento_id": {
      "type": "string"
    },
    "turno_id": {
      "type": "string"
    },
    "salario": {
      "type": "number"
    },
    "tipo_contrato": {
      "type": "string",
      "enum": [
        "CLT",
        "PJ",
        "Est\u00e1gio",
        "Tempor\u00e1rio"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "F\u00e9rias",
        "Afastado",
        "Desligado"
      ],
      "default": "Ativo"
    },
    "endereco": {
      "type": "string"
    },
    "dados_bancarios": {
      "type": "object",
      "properties": {
        "banco": {
          "type": "string"
        },
        "agencia": {
          "type": "string"
        },
        "conta": {
          "type": "string"
        },
        "tipo_conta": {
          "type": "string",
          "enum": [
            "Corrente",
            "Poupan\u00e7a",
            "Sal\u00e1rio"
          ]
        },
        "pix_chave": {
          "type": "string"
        }
      }
    },
    "centro_custo_id": {
      "type": "string"
    },
    "centro_custo_nome": {
      "type": "string"
    },
    "pode_apontar_producao": {
      "type": "boolean",
      "default": false
    },
    "pode_dirigir": {
      "type": "boolean",
      "default": false
    },
    "cnh_numero": {
      "type": "string"
    },
    "cnh_categoria": {
      "type": "string"
    },
    "cnh_validade": {
      "type": "string",
      "format": "date"
    },
    "aso_validade": {
      "type": "string",
      "format": "date"
    },
    "competencias": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vincular_a_usuario_id": {
      "type": "string"
    },
    "dias_ferias_disponiveis": {
      "type": "number",
      "default": 30
    },
    "dias_ferias_vencimento": {
      "type": "string",
      "format": "date"
    },
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "CPF",
              "RG",
              "Carteira de Trabalho",
              "Contrato",
              "Exame Admissional",
              "Exame Peri\u00f3dico",
              "CNH",
              "Certificado",
              "Outros"
            ]
          },
          "nome_arquivo": {
            "type": "string"
          },
          "url_arquivo": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date"
          },
          "data_validade": {
            "type": "string",
            "format": "date"
          },
          "observacao": {
            "type": "string"
          }
        }
      }
    },
    "historico_salario": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "salario_anterior": {
            "type": "number"
          },
          "salario_novo": {
            "type": "number"
          },
          "data": {
            "type": "string",
            "format": "date"
          },
          "motivo": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          }
        }
      }
    },
    "historico_cargos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cargo_anterior": {
            "type": "string"
          },
          "cargo_novo": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date"
          },
          "motivo": {
            "type": "string"
          }
        }
      }
    },
    "beneficios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Vale Transporte",
              "Vale Refei\u00e7\u00e3o",
              "Vale Alimenta\u00e7\u00e3o",
              "Plano de Sa\u00fade",
              "Plano Odontol\u00f3gico",
              "Seguro de Vida",
              "Outros"
            ]
          },
          "valor": {
            "type": "number"
          },
          "ativo": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "treinamentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date"
          },
          "carga_horaria": {
            "type": "number"
          },
          "certificado_url": {
            "type": "string"
          }
        }
      }
    },
    "avaliacoes_desempenho": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date"
          },
          "nota": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "competencias": {
            "type": "object"
          },
          "observacoes": {
            "type": "string"
          },
          "avaliador": {
            "type": "string"
          }
        }
      }
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_completo",
    "cpf",
    "data_admissao",
    "cargo",
    "departamento"
  ]
}