{
  "name": "Oportunidade",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa respons\u00e1vel pela oportunidade"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da oportunidade"
    },
    "descricao": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "cliente_email": {
      "type": "string"
    },
    "cliente_telefone": {
      "type": "string"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Indica\u00e7\u00e3o",
        "Site",
        "Telefone",
        "E-mail",
        "Visita",
        "Evento",
        "Rede Social",
        "Outros"
      ],
      "description": "Origem da oportunidade"
    },
    "responsavel": {
      "type": "string",
      "description": "Vendedor respons\u00e1vel"
    },
    "responsavel_id": {
      "type": "string"
    },
    "etapa": {
      "type": "string",
      "enum": [
        "Prospec\u00e7\u00e3o",
        "Contato Inicial",
        "Qualifica\u00e7\u00e3o",
        "Proposta",
        "Negocia\u00e7\u00e3o",
        "Fechamento",
        "Ganho",
        "Perdido"
      ],
      "default": "Prospec\u00e7\u00e3o"
    },
    "valor_estimado": {
      "type": "number"
    },
    "probabilidade": {
      "type": "number",
      "description": "% de chance de fechar",
      "minimum": 0,
      "maximum": 100
    },
    "data_abertura": {
      "type": "string",
      "format": "date"
    },
    "data_previsao": {
      "type": "string",
      "format": "date",
      "description": "Previs\u00e3o de fechamento"
    },
    "data_fechamento": {
      "type": "string",
      "format": "date"
    },
    "data_ultima_interacao": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima intera\u00e7\u00e3o"
    },
    "dias_sem_contato": {
      "type": "number",
      "description": "Dias desde a \u00faltima intera\u00e7\u00e3o",
      "default": 0
    },
    "motivo_perda": {
      "type": "string"
    },
    "concorrente": {
      "type": "string"
    },
    "produtos_interesse": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "necessidades": {
      "type": "string"
    },
    "orcamento_cliente": {
      "type": "number"
    },
    "prazo_decisao": {
      "type": "string"
    },
    "proxima_acao": {
      "type": "string"
    },
    "data_proxima_acao": {
      "type": "string",
      "format": "date"
    },
    "observacoes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Em Andamento",
        "Ganho",
        "Perdido",
        "Cancelado"
      ],
      "default": "Aberto"
    },
    "score": {
      "type": "number",
      "description": "Score do lead (0-100)",
      "default": 50
    },
    "temperatura": {
      "type": "string",
      "enum": [
        "Frio",
        "Morno",
        "Quente"
      ],
      "default": "Morno",
      "description": "Temperatura do lead"
    },
    "quantidade_interacoes": {
      "type": "number",
      "default": 0,
      "description": "Total de intera\u00e7\u00f5es registradas"
    },
    "tempo_ciclo_dias": {
      "type": "number",
      "description": "Tempo desde abertura at\u00e9 fechamento"
    },
    "follow_ups_agendados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "E-mail",
              "WhatsApp",
              "Liga\u00e7\u00e3o",
              "Reuni\u00e3o"
            ]
          },
          "mensagem": {
            "type": "string"
          },
          "enviado": {
            "type": "boolean",
            "default": false
          },
          "data_envio": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Follow-ups autom\u00e1ticos agendados"
    },
    "pedido_gerado_id": {
      "type": "string",
      "description": "ID do pedido gerado a partir desta oportunidade"
    },
    "orcamento_gerado_id": {
      "type": "string",
      "description": "ID do or\u00e7amento gerado"
    },
    "historico_mudancas_etapa": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "etapa_anterior": {
            "type": "string"
          },
          "etapa_nova": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de mudan\u00e7as de etapa"
    }
  },
  "required": [
    "titulo",
    "cliente_nome",
    "origem",
    "responsavel",
    "data_abertura"
  ]
}