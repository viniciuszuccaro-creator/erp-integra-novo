{
  "name": "Departamento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial (se criado no grupo)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se criado na empresa)"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa",
      "description": "Indica se foi criado no grupo ou na empresa"
    },
    "nome_departamento": {
      "type": "string",
      "description": "Nome do departamento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do departamento"
    },
    "tipo_departamento": {
      "type": "string",
      "enum": [
        "Administrativo",
        "Comercial",
        "Financeiro",
        "RH",
        "Operacional",
        "TI",
        "Log\u00edstica",
        "Compras",
        "Produ\u00e7\u00e3o",
        "Outro"
      ],
      "default": "Operacional",
      "description": "Tipo de departamento"
    },
    "departamento_pai_id": {
      "type": "string",
      "description": "ID do departamento pai (para hierarquia)"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel pelo departamento"
    },
    "centro_custo_vinculado_id": {
      "type": "string",
      "description": "ID do centro de custo vinculado"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_departamento"
  ]
}