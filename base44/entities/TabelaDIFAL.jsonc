{
  "name": "TabelaDIFAL",
  "type": "object",
  "properties": {
    "uf_origem": {
      "type": "string",
      "description": "UF de origem da mercadoria"
    },
    "uf_destino": {
      "type": "string",
      "description": "UF de destino da mercadoria"
    },
    "aliquota_interna_origem": {
      "type": "number",
      "description": "Al\u00edquota interna do estado de origem (%)"
    },
    "aliquota_interna_destino": {
      "type": "number",
      "description": "Al\u00edquota interna do estado de destino (%)"
    },
    "aliquota_interestadual": {
      "type": "number",
      "description": "Al\u00edquota interestadual aplic\u00e1vel (%)"
    },
    "fcp_percentual": {
      "type": "number",
      "default": 0,
      "description": "% do Fundo de Combate \u00e0 Pobreza"
    },
    "ano_vigencia": {
      "type": "number",
      "description": "Ano de vig\u00eancia desta tabela"
    },
    "data_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o pela IA"
    },
    "fonte_dados": {
      "type": "string",
      "description": "Fonte da informa\u00e7\u00e3o (Confaz, Sefaz, etc)"
    },
    "atualizado_por_ia": {
      "type": "boolean",
      "default": true,
      "description": "Se foi atualizado automaticamente pela IA"
    },
    "validado": {
      "type": "boolean",
      "default": false,
      "description": "Se foi validado por um humano"
    },
    "validado_por": {
      "type": "string"
    },
    "validado_em": {
      "type": "string",
      "format": "date-time"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "uf_origem",
    "uf_destino",
    "aliquota_interna_destino",
    "aliquota_interestadual",
    "ano_vigencia"
  ]
}