{
  "name": "MonitoramentoSistema",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se específico)"
    },
    "tenant_id": {
      "type": "string",
      "description": "Vol 20.1/23.3: ID do tenant SaaS"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da coleta"
    },
    "metrica_tipo": {
      "type": "string",
      "enum": [
        "CPU",
        "Memória",
        "Latência",
        "Requisições",
        "Erros",
        "Uptime",
        "Database",
        "Storage",
        "Integrações",
        "Jobs"
      ],
      "description": "Tipo de métrica"
    },
    "modulo": {
      "type": "string",
      "description": "Vol 23.3: Módulo monitorado (Comercial, Financeiro, Estoque, etc.) para erros por módulo"
    },
    "cpu_uso_percent": {
      "type": "number",
      "description": "% de uso de CPU"
    },
    "memoria_uso_mb": {
      "type": "number",
      "description": "Memória usada em MB"
    },
    "memoria_disponivel_mb": {
      "type": "number",
      "description": "Memória disponível em MB"
    },
    "latencia_media_ms": {
      "type": "number",
      "description": "Latência média de requisições em ms"
    },
    "latencia_p95_ms": {
      "type": "number",
      "description": "Latência percentil 95 em ms"
    },
    "latencia_p99_ms": {
      "type": "number",
      "description": "Vol 23.3: Latência percentil 99 em ms (outliers)"
    },
    "requisicoes_por_segundo": {
      "type": "number",
      "description": "Taxa de requisições/segundo"
    },
    "requisicoes_total": {
      "type": "number",
      "description": "Total de requisições no período"
    },
    "requisicoes_sucesso": {
      "type": "number",
      "description": "Requisições bem-sucedidas"
    },
    "requisicoes_erro": {
      "type": "number",
      "description": "Requisições com erro"
    },
    "taxa_erro_percent": {
      "type": "number",
      "description": "% de taxa de erro"
    },
    "erros_por_modulo": {
      "type": "object",
      "additionalProperties": true,
      "description": "Vol 23.3: Contagem de erros por módulo (ex: {Comercial: 5, Financeiro: 2})"
    },
    "consultas_lentas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "query_id": {
            "type": "string"
          },
          "tempo_ms": {
            "type": "number"
          },
          "modulo": {
            "type": "string"
          },
          "entidade": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Vol 23.3: Consultas lentas registradas"
    },
    "uptime_percent": {
      "type": "number",
      "description": "% de uptime"
    },
    "downtime_segundos": {
      "type": "number",
      "description": "Tempo de inatividade em segundos"
    },
    "usuarios_ativos": {
      "type": "number",
      "description": "Usuários ativos no momento"
    },
    "sessoes_simultaneas": {
      "type": "number",
      "description": "Sessões simultâneas"
    },
    "database_conexoes_ativas": {
      "type": "number",
      "description": "Conexões ativas no banco"
    },
    "database_queries_por_segundo": {
      "type": "number",
      "description": "Queries por segundo"
    },
    "database_tempo_medio_query_ms": {
      "type": "number",
      "description": "Tempo médio de query em ms"
    },
    "storage_usado_gb": {
      "type": "number",
      "description": "Storage usado em GB"
    },
    "storage_disponivel_gb": {
      "type": "number",
      "description": "Storage disponível em GB"
    },
    "cache_hit_rate_percent": {
      "type": "number",
      "description": "% de acerto do cache"
    },
    "jobs_atrasados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "nome_job": {
            "type": "string"
          },
          "data_prevista": {
            "type": "string",
            "format": "date-time"
          },
          "minutos_atraso": {
            "type": "number"
          }
        }
      },
      "description": "Vol 23.3: Jobs agendados atrasados"
    },
    "apis_indisponiveis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome_api": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "ultima_verificacao": {
            "type": "string",
            "format": "date-time"
          },
          "status_code": {
            "type": "number"
          },
          "erro": {
            "type": "string"
          }
        }
      },
      "description": "Vol 23.3: APIs externas indisponíveis no momento da coleta"
    },
    "alertas_gerados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "severidade": {
            "type": "string",
            "enum": [
              "Info",
              "Warning",
              "Error",
              "Critical"
            ]
          },
          "mensagem": {
            "type": "string"
          },
          "valor_metrica": {
            "type": "number"
          },
          "modulo": {
            "type": "string"
          },
          "acao_recomendada": {
            "type": "string",
            "description": "Vol 23.3: Ação recomendada para resolver o alerta"
          }
        }
      },
      "description": "Alertas gerados nesta coleta"
    },
    "status_geral": {
      "type": "string",
      "enum": [
        "Saudável",
        "Atenção",
        "Crítico",
        "Offline"
      ],
      "default": "Saudável",
      "description": "Status geral do sistema"
    },
    "intervalo_coleta_segundos": {
      "type": "number",
      "default": 60,
      "description": "Intervalo de coleta das métricas"
    }
  },
  "required": [
    "timestamp",
    "metrica_tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}