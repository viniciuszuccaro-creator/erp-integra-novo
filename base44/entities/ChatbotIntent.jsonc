{
  "name": "ChatbotIntent",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (multiempresa)"
    },
    "codigo": {
      "type": "string",
      "description": "Código numérico sequencial único"
    },
    "nome_intent": {
      "type": "string",
      "description": "Nome da intenção (ex: 2_via_boleto, status_pedido)"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição da intenção"
    },
    "frases_treinamento": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Frases de exemplo para treinar a IA"
    },
    "palavras_chave": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palavras‑chave equivalentes (de ChatbotIntents)"
    },
    "tipo_intent": {
      "type": "string",
      "enum": [
        "consulta",
        "transação",
        "suporte",
        "comercial",
        "outro"
      ],
      "description": "Classificação do intent"
    },
    "acao_automatica": {
      "type": "string",
      "enum": [
        "consultar_boleto",
        "consultar_pedido",
        "criar_orcamento",
        "falar_vendedor",
        "consultar_estoque",
        "nenhuma",
        "custom"
      ],
      "description": "Ação padrão quando o intent é acionado"
    },
    "entidade_vinculada": {
      "type": "string",
      "description": "Entidade relacionada (ContaReceber, Pedido, Entrega, etc)"
    },
    "escalar_vendedor": {
      "type": "boolean",
      "default": false
    },
    "origem_dados": {
      "type": "string",
      "description": "Entidade fonte dos dados (ex: ContaReceber, Pedido, Cliente)"
    },
    "exige_autenticacao": {
      "type": "boolean",
      "default": false,
      "description": "Se exige autenticação do usuário"
    },
    "canais_permitidos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Site",
          "WhatsApp",
          "Portal",
          "App",
          "Chatbot Widget"
        ]
      },
      "description": "Canais onde esta intent é permitida"
    },
    "resposta_template": {
      "type": "string",
      "description": "Template/Resposta padrão"
    },
    "acoes_automaticas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo_acao": {
            "type": "string"
          },
          "parametros": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "description": "Ações automáticas ao processar esta intent"
    },
    "fluxo_fallback": {
      "type": "string",
      "enum": [
        "Chamar Humano",
        "Registrar Chamado",
        "Redirecionar FAQ",
        "Finalizar"
      ],
      "default": "Chamar Humano",
      "description": "Fluxo quando não consegue processar"
    },
    "prioridade": {
      "type": "number",
      "default": 100,
      "description": "Prioridade de matching (maior = mais prioritário)"
    },
    "taxa_confianca_minima": {
      "type": "number",
      "default": 0.7,
      "description": "Taxa mínima de confiança para processar (0-1)"
    },
    "total_acionamentos": {
      "type": "number",
      "default": 0,
      "description": "Total de vezes que foi acionada"
    },
    "taxa_sucesso": {
      "type": "number",
      "default": 0,
      "description": "Taxa de sucesso (%)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_intent",
    "descricao"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}