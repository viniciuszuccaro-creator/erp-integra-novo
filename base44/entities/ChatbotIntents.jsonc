{
  "name": "ChatbotIntents",
  "type": "object",
  "properties": {
    "nome_intent": {
      "type": "string",
      "description": "Nome \u00fanico do intent (ex: 2_via_boleto, rastrear_entrega)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do que o intent faz"
    },
    "palavras_chave": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palavras-chave que disparam o intent"
    },
    "tipo_intent": {
      "type": "string",
      "enum": [
        "consulta",
        "transacao",
        "suporte",
        "comercial"
      ],
      "description": "Tipo do intent"
    },
    "requer_autenticacao": {
      "type": "boolean",
      "default": false,
      "description": "Se requer que o cliente esteja autenticado"
    },
    "acao_automatica": {
      "type": "string",
      "enum": [
        "consultar_boleto",
        "consultar_pedido",
        "criar_orcamento",
        "falar_vendedor",
        "consultar_estoque",
        "nenhuma"
      ],
      "description": "A\u00e7\u00e3o a ser executada automaticamente"
    },
    "entidade_vinculada": {
      "type": "string",
      "description": "Entidade relacionada (ContaReceber, Pedido, Entrega, etc)"
    },
    "resposta_padrao": {
      "type": "string",
      "description": "Resposta padr\u00e3o quando detectado"
    },
    "escalar_vendedor": {
      "type": "boolean",
      "default": false,
      "description": "Se deve escalar para vendedor respons\u00e1vel"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Normal",
        "Alta",
        "Urgente"
      ],
      "default": "Normal"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome_intent",
    "palavras_chave",
    "tipo_intent"
  ]
}