{
  "name": "SetorAtividade",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do setor"
    },
    "nome": {
      "type": "string",
      "description": "Nome do setor"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "Revenda",
        "Produ\u00e7\u00e3o",
        "Servi\u00e7o",
        "Consumo Interno",
        "Log\u00edstica"
      ],
      "default": "Revenda"
    },
    "icone": {
      "type": "string"
    },
    "cor": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome"
  ]
}