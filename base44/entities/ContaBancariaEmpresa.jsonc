{
  "name": "ContaBancariaEmpresa",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa proprietária"
    },
    "codigo": {
      "type": "string",
      "description": "Código sequencial único da conta bancária"
    },
    "banco_id": {
      "type": "string",
      "description": "ID do banco"
    },
    "agencia": {
      "type": "string",
      "description": "Número da agência"
    },
    "agencia_digito": {
      "type": "string",
      "description": "Dígito verificador da agência"
    },
    "numero_conta": {
      "type": "string",
      "description": "Número da conta"
    },
    "conta_digito": {
      "type": "string",
      "description": "Dígito verificador da conta"
    },
    "tipo_conta": {
      "type": "string",
      "enum": [
        "Corrente",
        "Poupança",
        "Aplicação",
        "Salário"
      ],
      "default": "Corrente"
    },
    "moeda": {
      "type": "string",
      "default": "BRL",
      "description": "Moeda da conta"
    },
    "titular": {
      "type": "string",
      "description": "Nome do titular"
    },
    "cpf_cnpj_titular": {
      "type": "string",
      "description": "CPF/CNPJ do titular"
    },
    "finalidade": {
      "type": "string",
      "enum": [
        "Operacional",
        "Folha",
        "Tributos",
        "Investimento",
        "Cobrança"
      ],
      "default": "Operacional",
      "description": "Finalidade da conta"
    },
    "permite_recebimento_boleto": {
      "type": "boolean",
      "default": false
    },
    "permite_recebimento_pix": {
      "type": "boolean",
      "default": false
    },
    "chave_pix": {
      "type": "string",
      "description": "Chave PIX da conta"
    },
    "tipo_chave_pix": {
      "type": "string",
      "enum": [
        "CPF",
        "CNPJ",
        "E-mail",
        "Telefone",
        "Aleatória"
      ],
      "description": "Tipo de chave PIX"
    },
    "convenio_cobranca": {
      "type": "string",
      "description": "Número do convênio para cobrança"
    },
    "carteira_cobranca": {
      "type": "string",
      "description": "Carteira para emissão de boletos"
    },
    "codigo_beneficiario": {
      "type": "string",
      "description": "Código do beneficiário"
    },
    "integracao_conciliacao": {
      "type": "object",
      "properties": {
        "ativa": {
          "type": "boolean",
          "default": false
        },
        "tipo": {
          "type": "string",
          "enum": [
            "API",
            "OFX",
            "CNAB",
            "Open Banking"
          ]
        },
        "api_key": {
          "type": "string"
        },
        "ultima_sincronizacao": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "saldo_atual": {
      "type": "number",
      "default": 0,
      "description": "Saldo atual da conta"
    },
    "saldo_disponivel": {
      "type": "number",
      "default": 0,
      "description": "Saldo disponível"
    },
    "limite_cheque_especial": {
      "type": "number",
      "default": 0
    },
    "conta_padrao": {
      "type": "boolean",
      "default": false,
      "description": "Se é a conta padrão da empresa"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "banco_id",
    "agencia",
    "numero_conta"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}