{
  "name": "Departamento",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "origem_escopo": {
      "type": "string",
      "enum": [
        "grupo",
        "empresa"
      ],
      "default": "empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do departamento"
    },
    "nome_departamento": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "tipo_departamento": {
      "type": "string",
      "enum": [
        "Administrativo",
        "Comercial",
        "Financeiro",
        "RH",
        "Operacional",
        "TI",
        "Log\u00edstica",
        "Compras",
        "Produ\u00e7\u00e3o",
        "Outro"
      ],
      "default": "Operacional"
    },
    "departamento_pai_id": {
      "type": "string"
    },
    "responsavel_id": {
      "type": "string"
    },
    "centro_custo_vinculado_id": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome_departamento"
  ]
}