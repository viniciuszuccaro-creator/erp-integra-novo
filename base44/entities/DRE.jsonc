{
  "name": "DRE",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (null se for consolidado)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Individual",
        "Consolidado"
      ],
      "default": "Individual",
      "description": "Se é de uma empresa ou do grupo todo"
    },
    "periodo": {
      "type": "string",
      "description": "Período (YYYY-MM)"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de início do período"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data de fim do período"
    },
    "receita_bruta": {
      "type": "number",
      "default": 0,
      "description": "Receita bruta do período"
    },
    "deducoes_impostos": {
      "type": "number",
      "default": 0,
      "description": "Deduções e impostos sobre vendas"
    },
    "receita_liquida": {
      "type": "number",
      "default": 0,
      "description": "Receita líquida (bruta - deduções)"
    },
    "cpv": {
      "type": "number",
      "default": 0,
      "description": "Custo dos Produtos Vendidos"
    },
    "lucro_bruto": {
      "type": "number",
      "default": 0,
      "description": "Lucro bruto (receita líquida - CPV)"
    },
    "despesas_administrativas": {
      "type": "number",
      "default": 0
    },
    "despesas_comerciais": {
      "type": "number",
      "default": 0
    },
    "despesas_financeiras": {
      "type": "number",
      "default": 0
    },
    "outras_despesas_operacionais": {
      "type": "number",
      "default": 0
    },
    "despesas_operacionais_total": {
      "type": "number",
      "default": 0,
      "description": "Total de despesas operacionais"
    },
    "lucro_operacional": {
      "type": "number",
      "default": 0,
      "description": "Lucro operacional (bruto - despesas operacionais)"
    },
    "outras_receitas": {
      "type": "number",
      "default": 0
    },
    "outras_despesas": {
      "type": "number",
      "default": 0
    },
    "resultado_nao_operacional": {
      "type": "number",
      "default": 0
    },
    "lucro_antes_tributos": {
      "type": "number",
      "default": 0,
      "description": "LAIR"
    },
    "ir_csll": {
      "type": "number",
      "default": 0,
      "description": "IR e CSLL"
    },
    "lucro_liquido": {
      "type": "number",
      "default": 0,
      "description": "Lucro líquido final"
    },
    "margem_bruta_percentual": {
      "type": "number",
      "description": "(Lucro bruto / Receita líquida) * 100"
    },
    "margem_operacional_percentual": {
      "type": "number",
      "description": "(Lucro operacional / Receita líquida) * 100"
    },
    "margem_liquida_percentual": {
      "type": "number",
      "description": "(Lucro líquido / Receita líquida) * 100"
    },
    "detalhamento": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON com detalhamento por conta/centro de custo"
    },
    "empresas_consolidadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das empresas incluídas na consolidação"
    },
    "gerado_automaticamente": {
      "type": "boolean",
      "default": true,
      "description": "Se foi calculado automaticamente"
    },
    "data_geracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de geração"
    },
    "usuario_geracao": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "periodo",
    "data_inicio",
    "data_fim"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.group_id": "{{user.data.group_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}