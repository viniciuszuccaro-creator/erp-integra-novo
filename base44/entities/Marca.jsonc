{
  "name": "Marca",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico da marca"
    },
    "nome_marca": {
      "type": "string",
      "description": "Nome da marca/fabricante"
    },
    "descricao": {
      "type": "string"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ do fabricante"
    },
    "pais_origem": {
      "type": "string",
      "default": "Brasil"
    },
    "site": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "A\u00e7o",
        "Ferramentas",
        "EPIs",
        "El\u00e9tricos",
        "Hidr\u00e1ulica",
        "Outro"
      ]
    },
    "fornecedor_id": {
      "type": "string"
    },
    "certificacoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome_marca"
  ]
}