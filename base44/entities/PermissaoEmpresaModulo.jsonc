{
  "name": "PermissaoEmpresaModulo",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico da permiss\u00e3o"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "Dashboard",
        "Comercial e Vendas",
        "Financeiro e Cont\u00e1bil",
        "Estoque e Almoxarifado",
        "Compras e Suprimentos",
        "Expedi\u00e7\u00e3o e Log\u00edstica",
        "Produ\u00e7\u00e3o e Manufatura",
        "Recursos Humanos",
        "Fiscal e Tribut\u00e1rio",
        "Cadastros Gerais",
        "CRM - Relacionamento",
        "Agenda e Calend\u00e1rio",
        "Relat\u00f3rios e An\u00e1lises",
        "Contratos",
        "Gest\u00e3o de Empresas",
        "Controle de Acesso",
        "Integra\u00e7\u00f5es",
        "Configura\u00e7\u00f5es"
      ],
      "description": "M\u00f3dulo do sistema"
    },
    "submodulo": {
      "type": "string",
      "description": "Subm\u00f3dulo espec\u00edfico (ex: Clientes, Pedidos, Notas Fiscais)"
    },
    "aba": {
      "type": "string",
      "description": "Aba espec\u00edfica dentro do subm\u00f3dulo"
    },
    "nivel_acesso": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Visualizar",
        "Editar",
        "Criar",
        "Excluir",
        "Aprovar"
      ],
      "default": "Nenhum",
      "description": "N\u00edvel de acesso concedido"
    },
    "data_concessao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de concess\u00e3o da permiss\u00e3o"
    },
    "data_alteracao": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima altera\u00e7\u00e3o"
    },
    "alterado_por": {
      "type": "string",
      "description": "Usu\u00e1rio que fez a \u00faltima altera\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a permiss\u00e3o est\u00e1 ativa"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "usuario_id",
    "empresa_id",
    "modulo",
    "nivel_acesso"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}