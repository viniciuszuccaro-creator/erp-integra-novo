{
  "name": "IAConfig",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID do grupo empresarial"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se configura\u00e7\u00e3o espec\u00edfica)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo sequencial \u00fanico da configura\u00e7\u00e3o de IA"
    },
    "chave": {
      "type": "string",
      "description": "Chave \u00fanica da configura\u00e7\u00e3o"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "Comercial",
        "Producao",
        "Logistica",
        "Financeiro",
        "CRM",
        "Estoque",
        "Geral"
      ],
      "description": "M\u00f3dulo que usa esta IA"
    },
    "funcionalidade": {
      "type": "string",
      "description": "Ex: leitura_projeto, upsell, refugo, roteirizacao"
    },
    "objetivo": {
      "type": "string",
      "description": "Vol 19.1: Objetivo claro da IA \u2014 o que ela faz e por qu\u00ea"
    },
    "dados_usados": {
      "type": "string",
      "description": "Vol 19.1: Descri\u00e7\u00e3o dos dados consumidos pela IA"
    },
    "limites": {
      "type": "string",
      "description": "Vol 19.1: O que a IA N\u00c3O pode fazer (limites expl\u00edcitos)"
    },
    "periodicidade": {
      "type": "string",
      "enum": [
        "Tempo Real",
        "Por Evento",
        "Hor\u00e1ria",
        "Di\u00e1ria",
        "Semanal",
        "Mensal",
        "Sob Demanda"
      ],
      "default": "Sob Demanda",
      "description": "Vol 19.1: Periodicidade de execu\u00e7\u00e3o"
    },
    "acao_permitida": {
      "type": "string",
      "enum": [
        "Sugerir",
        "Classificar",
        "Resumir",
        "Prever",
        "Detectar Anomalia",
        "Automatizar (com aprova\u00e7\u00e3o)",
        "Automatizar (sem aprova\u00e7\u00e3o)"
      ],
      "default": "Sugerir",
      "description": "Vol 19.1: N\u00edvel m\u00e1ximo de a\u00e7\u00e3o permitida \u00e0 IA"
    },
    "risco_nivel": {
      "type": "string",
      "enum": [
        "Baixo",
        "M\u00e9dio",
        "Alto",
        "Cr\u00edtico"
      ],
      "default": "M\u00e9dio",
      "description": "Vol 19.1: N\u00edvel de risco associado a esta IA"
    },
    "explicacao_habilitada": {
      "type": "boolean",
      "default": true,
      "description": "Vol 19.1: Se a IA deve fornecer explica\u00e7\u00e3o para suas sugest\u00f5es"
    },
    "aprovacao_humana_obrigatoria": {
      "type": "boolean",
      "default": true,
      "description": "Vol 19.1: Se decis\u00f5es cr\u00edticas exigem aprova\u00e7\u00e3o humana antes de executar"
    },
    "responsavel": {
      "type": "string",
      "description": "Vol 19.1: Nome do respons\u00e1vel por esta IA"
    },
    "responsavel_id": {
      "type": "string",
      "description": "Vol 19.1: ID do usu\u00e1rio respons\u00e1vel"
    },
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se a IA est\u00e1 ativa"
    },
    "modo_treinamento": {
      "type": "boolean",
      "default": false,
      "description": "Se est\u00e1 em modo de treinamento"
    },
    "modelo_base": {
      "type": "string",
      "description": "Nome do modelo (GPT-4, GPT-4o, Custom)",
      "default": "GPT-4o"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "OpenAI",
        "Azure OpenAI",
        "Custom",
        "Local"
      ],
      "default": "OpenAI"
    },
    "endpoint_url": {
      "type": "string",
      "description": "URL do endpoint da IA"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API"
    },
    "limite_tokens": {
      "type": "number",
      "default": 8192,
      "description": "Limite de tokens por requisi\u00e7\u00e3o"
    },
    "confianca_minima": {
      "type": "number",
      "default": 75,
      "description": "% m\u00ednimo de confian\u00e7a para aceitar resultado"
    },
    "temperatura": {
      "type": "number",
      "default": 0.7,
      "description": "Temperatura do modelo (0-1)"
    },
    "timeout_segundos": {
      "type": "number",
      "default": 60,
      "description": "Timeout da requisi\u00e7\u00e3o"
    },
    "empresas_habilitadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vol 19.1: Opt-in por empresa \u2014 IDs das empresas autorizadas"
    },
    "usuarios_autorizados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos usu\u00e1rios autorizados"
    },
    "configuracoes_especificas": {
      "type": "object",
      "additionalProperties": true,
      "description": "Configura\u00e7\u00f5es espec\u00edficas por funcionalidade"
    },
    "total_execucoes": {
      "type": "number",
      "default": 0,
      "description": "Total de execu\u00e7\u00f5es"
    },
    "total_sucesso": {
      "type": "number",
      "default": 0,
      "description": "Total de execu\u00e7\u00f5es bem-sucedidas"
    },
    "total_erro": {
      "type": "number",
      "default": 0,
      "description": "Total de erros"
    },
    "taxa_sucesso_percentual": {
      "type": "number",
      "description": "% de taxa de sucesso"
    },
    "custo_total_estimado": {
      "type": "number",
      "default": 0,
      "description": "Custo total estimado de uso da IA"
    },
    "ultima_execucao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima execu\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "chave",
    "modulo",
    "funcionalidade"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}